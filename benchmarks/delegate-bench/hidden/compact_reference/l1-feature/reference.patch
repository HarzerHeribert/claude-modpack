+class Duration(ParamType[timedelta]):
+    """A length of time: a whole number of seconds (``120``) or
+    ``<integer><unit>`` groups with the units ``d``, ``h``, ``m`` and ``s``, each
+    at most once and in that order, without spaces (``1h30m``). Converts to a
+    :class:`datetime.timedelta`.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+    _pattern = re.compile(r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", re.IGNORECASE)
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if value.isascii() and value.isdigit():
+            return timedelta(seconds=int(value))
+
+        m = self._pattern.fullmatch(value) if value else None
+
+        if m is None or not any(m.groups()):
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value), param, ctx
+            )
+
+        days, hours, minutes, seconds = (int(g or 0) for g in m.groups())
+        return timedelta(days=days, hours=hours, minutes=minutes, seconds=seconds)
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
