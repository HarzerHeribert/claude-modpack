+
+@pytest.mark.parametrize(
+    ("value", "seconds"),
+    [("120", 120), ("2d", 172800), ("1h30m", 5400), ("45S", 45), ("1d2h3m4s", 93784)],
+)
+def test_duration(value, seconds):
+    assert click.Duration().convert(value, None, None) == __import__("datetime").timedelta(seconds=seconds)
+
+
+@pytest.mark.parametrize("value", ["", "-5", "1.5h", "5x", "1m1h", "1h1h", "1h 30m"])
+def test_duration_invalid(value):
