+import click
+
+
+@click.command()
+@click.option("--human", is_flag=True, default=False, show_default=True, help="Show sizes as KiB, MiB, ...")
+@click.argument("sizes", nargs=-1, type=int)
+def cli(human, sizes):
+    """Print each size in bytes, or with --human, formatted."""
+    for size in sizes:
+        click.echo(click.format_filesize(size) if human else size)
