+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes for display, in units of 1024: ``B``,
+    ``KiB``, ``MiB``, ``GiB`` or ``TiB``. Above 1024 bytes the value has one
+    decimal, rounded half up.
+
+    :param num_bytes: A non-negative number of bytes.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    i = 0
+
+    while i < 3 and num_bytes >= 1024 ** (i + 2):
+        i += 1
+
+    tenths = (num_bytes * 10 + 1024 ** (i + 1) // 2) // 1024 ** (i + 1)
+
+    if tenths >= 10240 and i < 3:
+        i += 1
+        tenths = (num_bytes * 10 + 1024 ** (i + 1) // 2) // 1024 ** (i + 1)
+
+    return f"{tenths // 10}.{tenths % 10} {units[i]}"
+
+
