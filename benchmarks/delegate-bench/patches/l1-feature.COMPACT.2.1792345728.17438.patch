+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most once and in
+    that order, without spaces. Units are case-insensitive. A
+    :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    # Group 1 is the plain seconds form, groups 2-5 are days, hours,
+    # minutes, and seconds. ASCII keeps IGNORECASE from matching
+    # characters such as "\u017f" that case-fold to "s".
+    _pattern = re.compile(
+        r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The empty string matches the pattern with every group unset.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                total, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+
+                try:
+                    return timedelta(
+                        days=days,
+                        hours=hours,
+                        minutes=minutes,
+                        seconds=total + seconds,
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
