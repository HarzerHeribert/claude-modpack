+class Duration(ParamType[timedelta]):
+    """The Duration type converts length of time strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``"120"``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes) and ``s`` (seconds). Each unit may
+    appear at most once, in that order, with no spaces. Units are
+    case-insensitive, so ``"2d"``, ``"1h30m"``, ``"45S"`` and
+    ``"1d2h3m4s"`` are all valid. A ``timedelta`` is passed through
+    unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    # Either a bare number of seconds, or the d, h, m, s groups in order.
+    # re.ASCII keeps IGNORECASE from matching non-ASCII lookalikes such as
+    # "ſ" for "s", and [0-9] excludes non-ASCII digits.
+    _pattern = re.compile(
+        r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # An empty string matches with every group unset.
+        if match is not None and match.lastindex is not None:
+            try:
+                total, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=total + seconds
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
