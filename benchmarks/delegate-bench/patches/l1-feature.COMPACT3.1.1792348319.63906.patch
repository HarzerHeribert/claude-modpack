+_duration_re = re.compile(
+    r"(?P<plain>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups with the units ``d``
+    (days), ``h`` (hours), ``m`` (minutes) and ``s`` (seconds),
+    such as ``2d``, ``1h30m`` or ``1d2h3m4s``. Each unit may appear
+    at most once and in that order, without spaces. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, which is not a duration.
+        if match is not None and match.group():
+            try:
+                parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                return timedelta(
+                    days=parts["days"],
+                    hours=parts["hours"],
+                    minutes=parts["minutes"],
+                    seconds=parts["plain"] + parts["seconds"],
+                )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
