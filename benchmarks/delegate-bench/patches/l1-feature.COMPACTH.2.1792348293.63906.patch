@@ -579,6 +581,64 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_seconds_re = re.compile(r"(?P<seconds>[0-9]+)")
+_duration_units_re = re.compile(
+    r"(?:(?P<days>[0-9]+)[dD])?"
+    r"(?:(?P<hours>[0-9]+)[hH])?"
+    r"(?:(?P<minutes>[0-9]+)[mM])?"
+    r"(?:(?P<seconds>[0-9]+)[sS])?"
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may appear at most once and only in that order, with no spaces, such
+    as ``2d``, ``1h30m``, ``90m``, or ``1d2h3m4s``. Units are
+    case-insensitive. A :class:`~datetime.timedelta` is passed through
+    unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = None
+
+        if isinstance(value, str) and value:
+            match = _duration_seconds_re.fullmatch(value)
+
+            if match is None:
+                match = _duration_units_re.fullmatch(value)
+
+        if match is not None:
+            try:
+                return timedelta(
+                    **{unit: int(n) for unit, n in match.groupdict("0").items()}
+                )
+            except (OverflowError, ValueError):
+                # The value is too large for timedelta, or has more digits
+                # than int() accepts.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
