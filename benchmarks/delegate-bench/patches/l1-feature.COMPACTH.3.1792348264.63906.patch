@@ -579,6 +581,61 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<plain>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta` object.
+
+    The value is either a whole number of seconds, like ``120``, or one or
+    more groups of a whole number followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each
+    unit may appear at most once, in that order, without spaces. Units are
+    case-insensitive. For example, ``2d``, ``1h30m``, ``45S``, and
+    ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                amounts = {k: int(v) for k, v in match.groupdict("0").items()}
+                # A plain number is mutually exclusive with the unit groups.
+                amounts["seconds"] += amounts.pop("plain")
+
+                try:
+                    return timedelta(**amounts)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
