@@ -579,6 +581,61 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most once, in that
+    order, without spaces. Units are case-insensitive. Negative and decimal
+    values are not accepted. A :class:`~datetime.timedelta` value is passed
+    through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, which is not a duration.
+        if match is not None and any(match.groups()):
+            try:
+                units = {k: int(v) for k, v in match.groupdict("0").items()}
+                return timedelta(
+                    days=units["days"],
+                    hours=units["hours"],
+                    minutes=units["minutes"],
+                    seconds=units["total"] + units["seconds"],
+                )
+            except (OverflowError, ValueError):
+                # Too many digits for int(), or too large for timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
