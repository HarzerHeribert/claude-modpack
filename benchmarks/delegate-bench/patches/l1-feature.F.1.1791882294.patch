+class Duration(ParamType[timedelta]):
+    """The Duration type converts a duration string into a
+    :class:`datetime.timedelta`.
+
+    Accepts either a whole number of seconds made only of ASCII digits, such
+    as ``"120"``, or one or more ``<integer><unit>`` groups with units ``d``,
+    ``h``, ``m`` and ``s``. Each unit may appear at most once and must appear
+    in that order, with no spaces. Units are case-insensitive. For example,
+    ``"2d"``, ``"1h30m"``, ``"45s"`` and ``"1d2h3m4s"`` are valid.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"""
+        (?P<seconds_only>[0-9]+)
+        |
+        (?=[0-9dhms])
+        (?:(?P<days>[0-9]+)d)?
+        (?:(?P<hours>[0-9]+)h)?
+        (?:(?P<minutes>[0-9]+)m)?
+        (?:(?P<seconds>[0-9]+)s)?
+        """,
+        re.ASCII | re.IGNORECASE | re.VERBOSE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                groups = match.groupdict()
+
+                try:
+                    if groups["seconds_only"] is not None:
+                        return timedelta(seconds=int(groups["seconds_only"]))
+
+                    return timedelta(
+                        days=int(groups["days"] or 0),
+                        hours=int(groups["hours"] or 0),
+                        minutes=int(groups["minutes"] or 0),
+                        seconds=int(groups["seconds"] or 0),
+                    )
+                except (OverflowError, ValueError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
