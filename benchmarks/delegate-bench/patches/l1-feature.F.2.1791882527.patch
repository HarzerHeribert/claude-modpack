+_DURATION_SECONDS_RE = re.compile(r"[0-9]+", re.ASCII)
+_DURATION_UNITS_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Accepts either a whole number of seconds (e.g. ``"120"``), or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and ``s``
+    (e.g. ``"2d"``, ``"1h30m"``, ``"1d2h3m4s"``). Units must appear at most
+    once each and in that order, with no spaces. Matching is case-insensitive.
+
+    A `timedelta` value is returned unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if _DURATION_SECONDS_RE.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            match = _DURATION_UNITS_RE.fullmatch(value)
+
+            if match is not None:
+                parts = {k: int(v) for k, v in match.groupdict().items() if v}
+
+                if parts:
+                    return timedelta(**parts)
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
