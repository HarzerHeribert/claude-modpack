+class Duration(ParamType[timedelta]):
+    """The duration type converts a value into a :class:`~datetime.timedelta`.
+
+    A value is either a whole number of seconds like ``120`` or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), ``s`` (seconds). Each unit may appear at
+    most once, in that order, with no spaces, like ``2d``, ``1h30m`` or
+    ``1d2h3m4s``. Units are case-insensitive. A
+    :class:`~datetime.timedelta` value is passed through unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<whole>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+                whole = parts.pop("whole")
+
+                if whole is not None:
+                    parts["seconds"] = whole
+
+                try:
+                    return timedelta(
+                        **{unit: int(n) for unit, n in parts.items() if n is not None}
+                    )
+                except (OverflowError, ValueError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
