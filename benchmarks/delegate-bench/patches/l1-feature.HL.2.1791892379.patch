+class Duration(ParamType[timedelta]):
+    """Convert a duration string to a ``timedelta``.
+
+    Accepts a whole number of seconds (``"120"``), or one or more
+    ``<integer><unit>`` groups with units ``d``, ``h``, ``m``, and ``s``
+    (days, hours, minutes, seconds), each at most once and in that order
+    (``"2d"``, ``"1h30m"``, ``"1d2h3m4s"``). Units are case-insensitive and
+    no spaces are allowed. A ``timedelta`` value is returned unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<whole>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+
+                try:
+                    if parts["whole"] is not None:
+                        return timedelta(seconds=int(parts["whole"]))
+
+                    return timedelta(
+                        **{unit: int(n) for unit, n in parts.items() if n is not None}
+                    )
+                except (OverflowError, ValueError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
