+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+    ],
+)
+def test_duration_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    value = timedelta(hours=3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "1.5",
+        "1.5h",
+        "5x",
+        "1h1h",
+        "30m1h",
+        "1h 30m",
+        " 5",
+        "h",
+        "99999999999d",
+        "\u017f5",
+        "5\u017f",
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_cli(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cmd(timeout):
+        click.echo(timeout)
+
+    result = runner.invoke(cmd, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output == "1:30:00\n"
+
+    result = runner.invoke(cmd, ["--timeout", "soon"])
+    assert result.exit_code == 2
+    assert "'soon' is not a valid duration." in result.output
+
+    result = runner.invoke(cmd, ["--help"])
+    assert "--timeout DURATION" in result.output
