+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    Two formats are accepted, case-insensitively and without spaces:
+
+    -   A whole number of seconds, such as ``120``.
+    -   One or more ``<integer><unit>`` groups using the units ``d``
+        (days), ``h`` (hours), ``m`` (minutes) and ``s`` (seconds). Each
+        unit may appear at most once and they must be in that order, such
+        as ``2d``, ``1h30m`` or ``1d2h3m4s``.
+
+    A :class:`datetime.timedelta` value is returned unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = self._pattern.fullmatch(value)
+
+                if match is not None and any(g is not None for g in match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(g or 0) for g in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
