@@ -330,3 +331,81 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("120", datetime.timedelta(seconds=120)),
+        ("0", datetime.timedelta(0)),
+        ("2d", datetime.timedelta(days=2)),
+        ("1h30m", datetime.timedelta(hours=1, minutes=30)),
+        ("45S", datetime.timedelta(seconds=45)),
+        ("1d2h3m4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", datetime.timedelta(minutes=90)),
+        ("1H30M", datetime.timedelta(hours=1, minutes=30)),
+        ("1D2h3M4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+    ],
+)
+def test_duration_valid(value, expected):
+    assert click.Duration().convert(value, None, None) == expected
+
+
+def test_duration_timedelta_passthrough():
+    td = datetime.timedelta(minutes=5)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "1.5",
+        "1.5h",
+        "5w",
+        "5x",
+        "1h2h",
+        "30m1h",
+        "4s3m",
+        " 5",
+        "5 ",
+        "1h 30m",
+        "h",
+        "5\n",
+        "\u0665",
+        5,
+        object(),
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert not result.exception
+    assert result.output.strip() == repr(datetime.timedelta(hours=1, minutes=30))
+
+    result = runner.invoke(cli, ["--timeout", "5w"])
+    assert result.exit_code == 2
+    assert "'5w' is not a valid duration." in result.output
+
+
+def test_duration_help(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "DURATION" in result.output
