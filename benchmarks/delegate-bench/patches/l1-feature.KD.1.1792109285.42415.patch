+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``1h30m``. The units are ``d``
+    (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each
+    unit may appear at most once and in that order. Units are
+    case-insensitive, and spaces are not allowed.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?=.)(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                try:
+                    total, days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days,
+                        hours=hours,
+                        minutes=minutes,
+                        seconds=total + seconds,
+                    )
+                except (OverflowError, ValueError):
+                    # Too many digits for int(), or too large for timedelta.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
