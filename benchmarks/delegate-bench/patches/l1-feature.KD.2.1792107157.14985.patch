+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("0", datetime.timedelta(0)),
+        ("120", datetime.timedelta(seconds=120)),
+        ("2d", datetime.timedelta(days=2)),
+        ("1h30m", datetime.timedelta(hours=1, minutes=30)),
+        ("45S", datetime.timedelta(seconds=45)),
+        ("1d2h3m4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H3M4S", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", datetime.timedelta(minutes=90)),
+        ("2h5s", datetime.timedelta(hours=2, seconds=5)),
+        ("0d", datetime.timedelta(0)),
+        ("007m", datetime.timedelta(minutes=7)),
+        (datetime.timedelta(hours=3), datetime.timedelta(hours=3)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_unchanged():
+    value = datetime.timedelta(microseconds=1500)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        " ",
+        "-5",
+        "-5s",
+        "+5",
+        "1.5",
+        "1.5h",
+        "1e3",
+        "5x",
+        "1w",
+        "h",
+        "1h1h",
+        "30m1h",
+        "1s1d",
+        "1h 30m",
+        " 120",
+        "120 ",
+        "120\n",
+        "1d-2h",
+        "\u0661\u0662",  # Non-ASCII digits.
+        "1\u017f",  # Long s, which folds to "s" without re.ASCII.
+        f"{'9' * 20}d",  # Overflows timedelta.
+        "9" * 5000,  # Too many digits for int.
+        120,
+        1.5,
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="1m30s")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "2h"])
+    assert result.exit_code == 0, result.output
+    assert result.output == f"{datetime.timedelta(hours=2)!r}\n"
+
+    result = runner.invoke(cli, [])
+    assert result.output == f"{datetime.timedelta(minutes=1, seconds=30)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "2x"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout': '2x' is not a valid duration." in (
+        result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
+def test_duration_info_dict():
+    assert click.Duration().to_info_dict() == {
+        "param_type": "Duration",
+        "name": "duration",
+    }
