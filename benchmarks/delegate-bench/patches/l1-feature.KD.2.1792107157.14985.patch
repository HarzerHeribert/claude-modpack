+# Either a bare number of seconds, or one or more <integer><unit> groups with
+# the units in decreasing order. The lookahead rejects the empty string.
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?=.)(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`datetime.timedelta`.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups with the units ``d``, ``h``, ``m``,
+    and ``s``. Each unit may appear at most once and in that order, without
+    spaces. Units are case-insensitive, so ``2d``, ``1h30m``, ``45S``, and
+    ``1d2h3m4s`` are all valid.
+
+    A :class:`datetime.timedelta` value is passed through unchanged.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict(default="0")
+
+                try:
+                    return timedelta(
+                        days=int(parts["days"]),
+                        hours=int(parts["hours"]),
+                        minutes=int(parts["minutes"]),
+                        seconds=int(parts["seconds"]) + int(parts["total"]),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
