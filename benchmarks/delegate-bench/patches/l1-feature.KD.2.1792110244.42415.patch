@@ -579,6 +581,67 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_DURATION_SECONDS_RE = re.compile(r"[0-9]+")
+_DURATION_UNITS_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d``, ``h``, ``m``,
+    and ``s``, like ``2d`` or ``1h30m``. Each unit may appear at most once,
+    in that order, without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def _try_to_convert_duration(self, value: t.Any) -> timedelta | None:
+        if not isinstance(value, str):
+            return None
+
+        if _DURATION_SECONDS_RE.fullmatch(value):
+            return timedelta(seconds=int(value))
+
+        match = _DURATION_UNITS_RE.fullmatch(value)
+
+        # The units pattern also matches the empty string.
+        if match is None or not value:
+            return None
+
+        return timedelta(
+            **{unit: int(amount) for unit, amount in match.groupdict("0").items()}
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        try:
+            converted = self._try_to_convert_duration(value)
+        except (OverflowError, ValueError):
+            # Too large for timedelta, or too many digits for int().
+            converted = None
+
+        if converted is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value), param, ctx
+            )
+
+        return converted
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
