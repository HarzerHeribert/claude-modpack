+_duration_re = re.compile(
+    r"(?P<plain>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    # ASCII keeps IGNORECASE from matching look-alikes such as "ſ" for "s".
+    re.IGNORECASE | re.ASCII,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta`.
+
+    The value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``1h30m``. The units are ``d``,
+    ``h``, ``m``, and ``s`` for days, hours, minutes, and seconds. Each
+    unit may appear at most once and in that order, without spaces. Units
+    are case-insensitive. A ``timedelta`` is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The empty string matches the unit form with every group missing, a
+        # non-empty match always captures at least one amount.
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                amounts = match.groupdict()
+                plain = amounts.pop("plain")
+
+                if plain is not None:
+                    amounts["seconds"] = plain
+
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in amounts.items()
+                            if amount is not None
+                        }
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
