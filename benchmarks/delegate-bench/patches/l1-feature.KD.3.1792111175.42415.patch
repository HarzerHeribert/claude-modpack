@@ -579,6 +581,61 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` for days, ``h`` for
+    hours, ``m`` for minutes, and ``s`` for seconds. Each unit may appear at
+    most once and in that order, without spaces, like ``1h30m`` or
+    ``1d2h3m4s``. Units are case-insensitive.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                total, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+
+                try:
+                    return timedelta(
+                        days=days,
+                        hours=hours,
+                        minutes=minutes,
+                        seconds=total + seconds,
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
