+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), or ``s`` (seconds). Each unit may appear at
+    most once, in that order, like ``90m``, ``1h30m``, or ``1d2h3m4s``.
+    Units are case-insensitive. Signs, decimals, and spaces are not accepted.
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+")
+    _units_re = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        # ASCII prevents Unicode case folding from accepting lookalike units,
+        # like the long s (U+017F) matching "s".
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                if match is not None:
+                    days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
