         return "DateTime"
 
 
+# Either a bare whole number of seconds, or unit groups in d, h, m, s order with
+# each unit at most once. The lookahead rejects the empty string, and ASCII mode
+# keeps case folding from matching look-alikes such as the long s.
+_duration_re = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?=.)(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of a whole number followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes and ``s`` for seconds. Each
+    unit may appear at most once, in that order, without spaces, like
+    ``1h30m`` or ``1d2h3m4s``. Units are case-insensitive.
+
+    A ``timedelta`` value, such as a default, is passed through unchanged.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                try:
+                    amounts = {
+                        unit: int(amount)
+                        for unit, amount in match.groupdict().items()
+                        if amount is not None
+                    }
+
+                    if "bare" in amounts:
+                        amounts["seconds"] = amounts.pop("bare")
+
+                    return timedelta(**amounts)
+                # Too many digits for int(), or out of timedelta's range.
+                except (ValueError, OverflowError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
