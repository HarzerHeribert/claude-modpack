@@ -579,6 +581,64 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    # ASCII keeps IGNORECASE from matching look-alikes such as "ſ" for "s".
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and in that order, without spaces, like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            text = value
+
+            # A bare whole number is a count of seconds.
+            if text.isascii() and text.isdigit():
+                text += "s"
+
+            match = _duration_re.fullmatch(text)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict("0").items()
+                        }
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
