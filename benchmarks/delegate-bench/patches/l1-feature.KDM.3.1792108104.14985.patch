+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each
+    unit may appear at most once and in that order, with no spaces. Units
+    are case-insensitive, so ``1h30m``, ``1H30M``, and ``90m`` are all
+    valid.
+
+    A ``timedelta`` value is returned unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?:(?P<d>[0-9]+)d)?(?:(?P<h>[0-9]+)h)?"
+        r"(?:(?P<m>[0-9]+)m)?(?:(?P<s>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            # The unit groups are all optional, so the pattern also matches
+            # the empty string. Require at least one group to be present.
+            if match is not None and match.lastindex is not None:
+                try:
+                    return timedelta(
+                        days=int(match["d"] or 0),
+                        hours=int(match["h"] or 0),
+                        minutes=int(match["m"] or 0),
+                        seconds=int(match["bare"] or match["s"] or 0),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
