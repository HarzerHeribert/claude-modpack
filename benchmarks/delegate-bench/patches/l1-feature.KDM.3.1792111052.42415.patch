+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``1h30m``. The units are ``d``,
+    ``h``, ``m``, and ``s``, for days, hours, minutes, and seconds. Each
+    unit may appear at most once and in that order, with no spaces between
+    groups. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+                total = parts.pop("total")
+
+                if total is not None:
+                    parts = {"seconds": total}
+
+                try:
+                    return timedelta(
+                        **{unit: int(n) for unit, n in parts.items() if n is not None}
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
