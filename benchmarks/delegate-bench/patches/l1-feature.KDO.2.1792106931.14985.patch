+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta`.
+
+    The value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``1h30m``. The units are ``d``,
+    ``h``, ``m`` and ``s``, case-insensitive, each used at most once and in
+    that order. Spaces, signs, and decimals are not accepted. A
+    ``timedelta`` is passed through unchanged.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A whole number on its own is a count of seconds.
+            if value.isascii() and value.isdigit():
+                text = f"{value}s"
+            else:
+                text = value
+
+            match = _duration_re.fullmatch(text)
+
+            # The pattern also matches the empty string, where no group is set.
+            if match is not None and any(match.groups()):
+                amounts = {
+                    unit: int(amount)
+                    for unit, amount in match.groupdict(default="0").items()
+                }
+
+                try:
+                    return timedelta(**amounts)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
