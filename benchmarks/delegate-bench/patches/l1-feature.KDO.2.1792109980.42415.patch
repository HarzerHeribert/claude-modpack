+_duration_seconds_re = re.compile(r"[0-9]+", re.ASCII)
+# re.ASCII keeps IGNORECASE from matching non-ASCII lookalikes, like the long
+# s (U+017F) case-folding to "s".
+_duration_units_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear
+    at most once, units must be given in that order, and no spaces are
+    allowed, like ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are
+    case-insensitive.
+
+    A :class:`~datetime.timedelta` value, like a default, is passed through
+    unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        parts: dict[str, str] = {}
+
+        if isinstance(value, str):
+            if _duration_seconds_re.fullmatch(value):
+                parts = {"seconds": value}
+            else:
+                match = _duration_units_re.fullmatch(value)
+
+                if match is not None:
+                    parts = {
+                        unit: amount
+                        for unit, amount in match.groupdict().items()
+                        if amount is not None
+                    }
+
+        # An empty string matches with no group set, so it fails here too.
+        if parts:
+            try:
+                amounts = {unit: int(amount) for unit, amount in parts.items()}
+                return timedelta(**amounts)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+
