@@ -579,6 +581,60 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta`.
+
+    A value is either a whole number of seconds, like ``120``, or one
+    or more integer amounts each followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes and ``s`` for seconds. Each
+    unit appears at most once, in that order, without spaces. Units are
+    case-insensitive. For example ``2d``, ``1h30m``, ``45S`` or
+    ``1d2h3m4s``.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            # The unit alternative also matches the empty string.
+            if match is not None and any(match.groups()):
+                amounts = {
+                    unit: int(match[unit] or 0)
+                    for unit in ("days", "hours", "minutes", "seconds")
+                }
+                amounts["seconds"] += int(match["bare"] or 0)
+
+                try:
+                    return timedelta(**amounts)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
