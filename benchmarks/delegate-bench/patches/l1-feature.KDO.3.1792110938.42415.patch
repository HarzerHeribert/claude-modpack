+# Either a bare number of seconds, or d/h/m/s groups in that order. ASCII mode
+# keeps IGNORECASE from matching look-alikes such as "ſ" (long s) for "s".
+_duration_re = re.compile(
+    r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+    re.IGNORECASE | re.ASCII,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``2d`` or ``1h30m``. The units are
+    ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each
+    unit may appear at most once, in that order. Units are case-insensitive,
+    and spaces are not allowed.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = None
+
+        # The empty string matches the pattern, since every group is optional.
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+        if match is not None:
+            bare, days, hours, minutes, seconds = (
+                int(group or 0) for group in match.groups()
+            )
+
+            try:
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=bare + seconds
+                )
+            except OverflowError:
+                # Too large for timedelta, reported like any other bad value.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
