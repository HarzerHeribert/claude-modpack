+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    value = timedelta(minutes=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-5s",
+        "+5",
+        "1.5",
+        "1.5h",
+        "5w",
+        "h",
+        "1h30",
+        "1h1h",
+        "30m1h",
+        "1h 30m",
+        " 5",
+        "5\n",
+        "\u0661\u0662",
+        "9999999999d",
+        120,
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="30s", show_default=True)
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.output == f"{timedelta(hours=1, minutes=30)!r}\n"
+
+    result = runner.invoke(cli, [])
+    assert result.output == f"{timedelta(seconds=30)!r}\n"
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+    assert "[default: 30s]" in result.output
+
+    result = runner.invoke(cli, ["--timeout", "1x"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--timeout': '1x' is not a valid duration." in result.output
+    )
