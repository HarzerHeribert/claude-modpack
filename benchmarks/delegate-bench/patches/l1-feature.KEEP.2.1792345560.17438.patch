@@ -579,6 +581,67 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    # ASCII keeps case folding to plain letters, so "\u017f" (long s) is not "s".
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`datetime.timedelta`.
+
+    The value is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most once and
+    units must be given in that order, without spaces. Units are
+    case-insensitive.
+
+    A :class:`datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare whole number is a count of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = _duration_re.fullmatch(text)
+
+            # The pattern also matches the empty string, without any group.
+            if match is not None and match.lastindex is not None:
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict().items()
+                            if amount is not None
+                        }
+                    )
+                except (OverflowError, ValueError):
+                    # Too many digits for int(), or too large for timedelta.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
