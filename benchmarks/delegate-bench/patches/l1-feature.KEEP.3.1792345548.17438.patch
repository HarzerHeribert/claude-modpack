 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,66 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    # A bare whole number of seconds, or <integer><unit> groups in d, h, m, s
+    # order. The lookahead rejects the empty string, which the all-optional
+    # groups would otherwise match.
+    r"(?P<plain_seconds>[0-9]+)"
+    r"|(?=.)(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    # ASCII keeps IGNORECASE from matching non-ASCII lookalikes, like U+017F
+    # (long s) for "s".
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit can be used at most once, in
+    that order, without spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is returned unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            parts = match.groupdict(default="0")
+
+            try:
+                return timedelta(
+                    days=int(parts["days"]),
+                    hours=int(parts["hours"]),
+                    minutes=int(parts["minutes"]),
+                    seconds=int(parts["seconds"]) + int(parts["plain_seconds"]),
+                )
+            except OverflowError:
+                # Too large for timedelta, such as "1000000000d".
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
