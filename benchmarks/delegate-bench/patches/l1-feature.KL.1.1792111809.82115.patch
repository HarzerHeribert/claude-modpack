+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear
+    at most once, in that order, without spaces. Units are
+    case-insensitive. For example, ``2d``, ``1h30m``, ``90m``, and
+    ``1d2h3m4s`` are all valid.
+
+    A `timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<seconds_only>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The all-optional unit groups also match an empty string.
+        if match is not None and any(match.groups()):
+            if match["seconds_only"] is not None:
+                parts = {"seconds": int(match["seconds_only"])}
+            else:
+                parts = {
+                    unit: int(amount)
+                    for unit, amount in match.groupdict().items()
+                    if amount is not None
+                }
+
+            try:
+                return timedelta(**parts)
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
