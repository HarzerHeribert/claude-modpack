+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), like
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most
+    once and in that order, without spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # ASCII only, so that non-ASCII digits and case folds (like the
+    # Kelvin sign matching "k") are rejected.
+    _pattern = re.compile(
+        r"(?P<plain>\d+)"
+        r"|(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m)?(?:(?P<s>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+        parts: dict[str, str] = {}
+
+        if match is not None:
+            parts = {k: v for k, v in match.groupdict().items() if v is not None}
+
+        # The pattern also matches the empty string, with no group set.
+        if parts:
+            try:
+                return timedelta(
+                    days=int(parts.get("d", 0)),
+                    hours=int(parts.get("h", 0)),
+                    minutes=int(parts.get("m", 0)),
+                    seconds=int(parts.get("plain", parts.get("s", 0))),
+                )
+            except (OverflowError, ValueError):
+                # Out of range for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
