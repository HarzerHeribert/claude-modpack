+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Two formats are accepted. A whole number of seconds, such as ``120``,
+    or one or more ``<integer><unit>`` groups using the units ``d``, ``h``,
+    ``m`` and ``s`` (days, hours, minutes, seconds). Each unit may appear at
+    most once and they must be given in that order, without spaces, for
+    example ``2d``, ``90m`` or ``1h30m``. Units are case-insensitive.
+
+    Negative values and decimals are not accepted.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"\d+", re.ASCII)
+    _units_re = re.compile(
+        r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if self._seconds_re.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            match = self._units_re.fullmatch(value)
+
+            if match is not None and any(g is not None for g in match.groups()):
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
