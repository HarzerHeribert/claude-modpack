+class Duration(ParamType[timedelta]):
+    """The ``Duration`` type converts a duration string into a
+    :class:`datetime.timedelta`. It accepts either a whole number of
+    seconds (``120``) or one or more ``<integer><unit>`` groups using the
+    units ``d``, ``h``, ``m`` and ``s``, each at most once and in that
+    order, with no spaces. Units are case-insensitive. Examples are
+    ``2d``, ``1h30m``, ``45S``, ``1d2h3m4s`` and ``90m``.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if _DURATION_SECONDS_RE.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = _DURATION_UNITS_RE.fullmatch(value)
+
+                if match is not None and any(g is not None for g in match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(g) if g is not None else 0 for g in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
