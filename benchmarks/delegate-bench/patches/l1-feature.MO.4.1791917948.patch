+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Accepted formats are a whole number of seconds made of digits only
+    (``120``), or one or more ``<integer><unit>`` groups using the units
+    ``d``, ``h``, ``m`` and ``s``. Each unit may appear at most once, in that
+    order, without spaces, and units are case-insensitive. For example
+    ``2d``, ``1h30m``, ``45S``, ``1d2h3m4s`` or ``90m``.
+
+    A `timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if re.fullmatch(r"[0-9]+", value):
+                    return timedelta(seconds=int(value))
+
+                match = _duration_re.fullmatch(value)
+
+                if match is not None:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
