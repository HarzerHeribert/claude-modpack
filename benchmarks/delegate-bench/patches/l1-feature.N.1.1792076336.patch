+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each
+    unit may appear at most once, in that order, with no spaces between
+    groups. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``45s``, and ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        # ASCII prevents non-ASCII digits, and case folding such as "ſ" to "s".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare integer is a number of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = self._pattern.fullmatch(text)
+
+            # The pattern matches an empty string, require at least one group.
+            if match is not None and any(match.groups()):
+                try:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict("0").items()}
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
