@@ -579,6 +581,61 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each
+    unit may appear at most once and units must be in that order, with no
+    spaces in between. Units are case-insensitive. For example: ``2d``,
+    ``1h30m``, ``45s``, ``1d2h3m4s``, or ``90m``.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The empty string matches the pattern without matching any group.
+        if match is not None and match.lastindex is not None:
+            try:
+                amounts = {
+                    unit: int(amount)
+                    for unit, amount in match.groupdict(default="0").items()
+                }
+                amounts["seconds"] += amounts.pop("total")
+                return timedelta(**amounts)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
