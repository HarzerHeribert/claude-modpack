+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be
+    used at most once and they must appear in that order, without
+    spaces, like ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                groups: dict[str, str | None] = {"seconds": value}
+            else:
+                match = self._pattern.fullmatch(value)
+                groups = match.groupdict() if match is not None else {}
+
+            parts = {k: v for k, v in groups.items() if v is not None}
+
+            # The pattern matches the empty string, which has no parts.
+            if parts:
+                try:
+                    return timedelta(**{k: int(v) for k, v in parts.items()})
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
