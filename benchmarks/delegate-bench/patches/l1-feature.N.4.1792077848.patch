+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more integer and unit pairs, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once,
+    and they must appear in that order. Units are case-insensitive, and
+    spaces are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # Either a bare number of seconds, or optional d, h, m, s groups in
+    # that order. An empty string matches with every group unset.
+    _pattern = re.compile(
+        r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None and any(match.groups()):
+            try:
+                bare, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=bare + seconds
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
