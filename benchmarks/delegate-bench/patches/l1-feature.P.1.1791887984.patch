+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    The value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be given at most once and
+    units must appear in that order, without spaces. Units are
+    case-insensitive. Negative and fractional values are not accepted.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _units_re = re.compile(
+        r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", re.ASCII | re.IGNORECASE
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                if match is not None and any(match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (ValueError, OverflowError):
+                # Too many digits for int(), or too large for timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
