+_duration_re = re.compile(
+    r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta`.
+
+    The value is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d``,
+    ``h``, ``m``, and ``s``, such as ``2d`` or ``1h30m``. Each unit
+    may be given at most once, in that order, with no spaces. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare whole number is a count of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = _duration_re.fullmatch(text)
+
+            if match is not None and match[0]:
+                try:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+                except (OverflowError, ValueError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
