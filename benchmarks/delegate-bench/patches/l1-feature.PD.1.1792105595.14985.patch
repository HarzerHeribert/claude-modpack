+# Either a bare number of seconds, or unit groups in d, h, m, s order. The
+# lookahead rejects the empty string, which every optional group would match.
+# ASCII keeps IGNORECASE from matching non-ASCII lookalikes such as "ſ" for "s".
+_duration_re = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?=[0-9])(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``1h30m``. Each
+    unit may appear at most once, in that order, with no spaces. Units are
+    case-insensitive. A ``timedelta`` value is returned unchanged.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                try:
+                    amounts = {
+                        unit: int(amount)
+                        for unit, amount in match.groupdict(default="0").items()
+                    }
+                    # "bare" and "seconds" never both match, so adding them
+                    # picks whichever one the value used.
+                    return timedelta(
+                        days=amounts["days"],
+                        hours=amounts["hours"],
+                        minutes=amounts["minutes"],
+                        seconds=amounts["seconds"] + amounts["bare"],
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int().
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
