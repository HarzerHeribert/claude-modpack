+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more integers each followed by a unit, like ``1h30m``. The units are
+    ``d`` (days), ``h`` (hours), ``m`` (minutes) and ``s`` (seconds). Each
+    unit may appear at most once and they must be given in that order. Units
+    are case-insensitive and spaces are not allowed.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        # ASCII keeps case folding from matching non-ASCII letters, like the
+        # long s "ſ" for "s".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every group is optional, so the pattern also matches an empty string.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                # Too many digits for int(), or too large for timedelta.
+                try:
+                    parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                    return timedelta(
+                        days=parts["days"],
+                        hours=parts["hours"],
+                        minutes=parts["minutes"],
+                        seconds=parts["seconds"] + parts["bare"],
+                    )
+                except (ValueError, OverflowError):
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+
