+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups with the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``, ``1h30m``,
+    or ``1d2h3m4s``. Each unit may appear at most once and in that order,
+    with no spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # ASCII mode keeps the digits and the case-insensitive unit letters
+    # ASCII-only: Unicode case folding would otherwise let ``ſ`` match ``s``.
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every unit group is optional, so the pattern also matches the empty
+        # string, which must be rejected separately.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+                bare = parts.pop("bare")
+
+                if bare is not None:
+                    parts["seconds"] = bare
+
+                try:
+                    return timedelta(
+                        **{unit: int(n) for unit, n in parts.items() if n is not None}
+                    )
+                except (OverflowError, ValueError):
+                    # Out of range for timedelta, or too many digits for int().
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
