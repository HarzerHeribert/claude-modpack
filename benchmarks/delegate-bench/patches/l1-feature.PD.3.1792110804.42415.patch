@@ -579,6 +581,68 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_seconds_re = re.compile(r"[0-9]+")
+_duration_units_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` for days, ``h``
+    for hours, ``m`` for minutes, and ``s`` for seconds, like ``1h30m``.
+    Each unit may be used at most once, and units must appear in that order.
+    Units are case-insensitive, and spaces are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        parts: dict[str, str] = {}
+
+        if isinstance(value, str):
+            if _duration_seconds_re.fullmatch(value):
+                parts["seconds"] = value
+            else:
+                match = _duration_units_re.fullmatch(value)
+
+                if match is not None:
+                    parts = {
+                        unit: amount
+                        for unit, amount in match.groupdict().items()
+                        if amount is not None
+                    }
+
+        if parts:
+            try:
+                return timedelta(
+                    **{unit: int(amount) for unit, amount in parts.items()}
+                )
+            except (OverflowError, ValueError):
+                # The amount exceeds the range of timedelta, or the digit
+                # limit of int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
