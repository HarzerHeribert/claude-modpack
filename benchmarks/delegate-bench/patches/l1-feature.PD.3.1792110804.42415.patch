+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("007", timedelta(seconds=7)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+        ("0h0s", timedelta(0)),
+        (timedelta(minutes=5), timedelta(minutes=5)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passes_through():
+    value = timedelta(hours=3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        pytest.param("", id="empty"),
+        pytest.param("-5", id="negative-seconds"),
+        pytest.param("-1h", id="negative-unit"),
+        pytest.param("+5", id="plus-sign"),
+        pytest.param("1.5", id="decimal-seconds"),
+        pytest.param("1.5h", id="decimal-unit"),
+        pytest.param("5x", id="unknown-unit"),
+        pytest.param("5w", id="weeks-unit"),
+        pytest.param("h", id="unit-without-number"),
+        pytest.param("1h1h", id="repeated-unit"),
+        pytest.param("30m1h", id="out-of-order"),
+        pytest.param("1s1m", id="out-of-order-seconds"),
+        pytest.param("1h30", id="trailing-bare-number"),
+        pytest.param(" 1h", id="leading-space"),
+        pytest.param("1h ", id="trailing-space"),
+        pytest.param("1h 30m", id="inner-space"),
+        pytest.param("1 h", id="space-before-unit"),
+        pytest.param("120\n", id="trailing-newline"),
+        pytest.param("\u0661\u0662", id="non-ascii-digits"),
+        pytest.param("1000000000d", id="timedelta-overflow"),
+        pytest.param("9" * 5000, id="too-many-digits"),
+        pytest.param(120, id="int"),
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output == f"{timedelta(hours=1, minutes=30)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--timeout': '30m1h' is not a valid duration."
+        in result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
