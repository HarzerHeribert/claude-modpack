+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        # A bare whole number is a number of seconds.
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta()),
+        ("007", timedelta(seconds=7)),
+        # Each unit on its own.
+        ("2d", timedelta(days=2)),
+        ("5h", timedelta(hours=5)),
+        ("90m", timedelta(minutes=90)),
+        ("45s", timedelta(seconds=45)),
+        # Units combine in order, and any of them can be skipped.
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("2h5s", timedelta(hours=2, seconds=5)),
+        # Units are case-insensitive.
+        ("45S", timedelta(seconds=45)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1h30M", timedelta(hours=1, minutes=30)),
+        # A timedelta passes through unchanged.
+        (timedelta(minutes=3), timedelta(minutes=3)),
+        (timedelta(seconds=-1), timedelta(seconds=-1)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        pytest.param("", id="empty"),
+        pytest.param("-5", id="negative-seconds"),
+        pytest.param("-1h", id="negative-unit"),
+        pytest.param("1.5", id="decimal-seconds"),
+        pytest.param("1.5h", id="decimal-unit"),
+        pytest.param("5x", id="unknown-unit"),
+        pytest.param("5w", id="weeks-not-supported"),
+        pytest.param("abc", id="not-a-number"),
+        pytest.param("h", id="unit-without-number"),
+        pytest.param("1hm", id="unit-missing-number"),
+        pytest.param("1h1h", id="repeated-unit"),
+        pytest.param("1h2H", id="repeated-unit-other-case"),
+        pytest.param("30m1h", id="out-of-order"),
+        pytest.param("1s1d", id="out-of-order-ends"),
+        pytest.param("1h 30m", id="inner-space"),
+        pytest.param(" 120", id="leading-space"),
+        pytest.param("120 ", id="trailing-space"),
+        pytest.param("1m30", id="trailing-number-without-unit"),
+        pytest.param("\N{SUPERSCRIPT TWO}", id="non-ascii-digit"),
+        pytest.param("1\N{LATIN SMALL LETTER LONG S}", id="non-ascii-unit"),
+        pytest.param("999999999999d", id="timedelta-overflow"),
+        pytest.param("1" * 5000, id="too-many-digits"),
+        pytest.param(120, id="int"),
+        pytest.param(1.5, id="float"),
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="30s")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output == f"{timedelta(seconds=30)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output == f"{timedelta(hours=1, minutes=30)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--timeout': '30m1h' is not a valid duration."
+        in result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
+def test_duration_info_dict():
+    assert click.Duration().to_info_dict() == {
+        "param_type": "Duration",
+        "name": "duration",
+    }
+
