+# ASCII keeps IGNORECASE from matching non-ASCII lookalikes of the units, such
+# as the long s (U+017F) for "s".
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d``, ``h``, ``m``, and
+    ``s``. Each unit may appear at most once, in that order, with no spaces,
+    like ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The pattern matches the empty string, which is not a duration.
+        if isinstance(value, str) and value:
+            text = value
+
+            # A bare whole number is a number of seconds.
+            if text.isdigit():
+                text = f"{text}s"
+
+            match = _duration_re.fullmatch(text)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict("0").items()
+                        }
+                    )
+                except (ValueError, OverflowError):
+                    # Too many digits for int(), or too large for timedelta.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
