+_duration_re = re.compile(
+    r"(?P<bare>\d+)"
+    r"|(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``1h30m`` or
+    ``1d2h3m4s``. Each unit may appear at most once, in that order, with no
+    spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The empty string matches the pattern with every group missing.
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        days=int(match["days"] or 0),
+                        hours=int(match["hours"] or 0),
+                        minutes=int(match["minutes"] or 0),
+                        seconds=int(match["bare"] or match["seconds"] or 0),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
