+# Either a bare number of seconds, or ``d``, ``h``, ``m``, ``s`` groups in that
+# order, each at most once. The lookahead stops the all-optional groups from
+# matching an empty string.
+_duration_re = re.compile(
+    r"(?P<bare>\d+)"
+    r"|(?=\d)(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes) and ``s`` (seconds), like ``2d``, ``1h30m`` or
+    ``1d2h3m4s``. Each unit may appear at most once and in that order, without
+    spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = None
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+        if match is not None:
+            try:
+                parts = {
+                    unit: int(amount)
+                    for unit, amount in match.groupdict().items()
+                    if amount is not None
+                }
+
+                if "bare" in parts:
+                    parts["seconds"] = parts.pop("bare")
+
+                return timedelta(**parts)
+            except (OverflowError, ValueError):
+                # Too many digits for int(), or too large for timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
