+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+        ("007s", timedelta(seconds=7)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    value = timedelta(hours=3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        # Empty or missing a number.
+        "",
+        "h",
+        # Negative, signed, and decimal numbers.
+        "-5",
+        "-5s",
+        "+5",
+        "1.5",
+        "1.5h",
+        # Unknown units.
+        "1x",
+        "1w",
+        "1ms",
+        # Repeated units.
+        "1h1h",
+        "1s2s",
+        # Units out of order.
+        "1m1h",
+        "4s1d",
+        # A bare number after a unit.
+        "1h30",
+        # Spaces.
+        " 5",
+        "5 ",
+        "1h 30m",
+        "5\n",
+        # Non-ASCII digits.
+        "\N{ARABIC-INDIC DIGIT FIVE}",
+        # Beyond the range of int parsing or timedelta.
+        "9" * 5000,
+        "99999999999999999d",
+        # Not a string or timedelta.
+        120,
+        True,
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default=timedelta(minutes=5))
+    def cli(timeout):
+        click.echo(repr(timeout), nl=False)
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0, result.output
+    assert result.output == repr(timedelta(hours=1, minutes=30))
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert result.output == repr(timedelta(minutes=5))
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout': '30m1h' is not a valid duration." in (
+        result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
