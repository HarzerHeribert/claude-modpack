+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit, like ``1h30m``. The units
+    are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may appear at most once, in that order. Units are
+    case-insensitive, and spaces are not allowed.
+
+    A `timedelta` value, such as a default, is passed through unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<seconds>\d+)"
+        r"|(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m)?(?:(?P<s>\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = None
+
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+        if match is not None:
+            parts = {k: v for k, v in match.groupdict().items() if v is not None}
+
+            # Huge numbers exceed int's digit limit or timedelta's range.
+            try:
+                return timedelta(
+                    days=int(parts.get("d", 0)),
+                    hours=int(parts.get("h", 0)),
+                    minutes=int(parts.get("m", 0)),
+                    seconds=int(parts.get("seconds", parts.get("s", 0))),
+                )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
