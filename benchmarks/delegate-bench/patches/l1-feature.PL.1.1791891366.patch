+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be used
+    at most once, in that order, without spaces, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # Either a whole number of seconds, or unit groups in d, h, m, s order.
+    # re.ASCII keeps IGNORECASE from matching look-alikes such as the long s
+    # (U+017F), which casefolds to "s".
+    _pattern = re.compile(
+        r"(?P<whole>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The empty string matches the pattern with no groups set, so skip it.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+                whole = parts.pop("whole")
+
+                if whole is not None:
+                    parts["seconds"] = whole
+
+                try:
+                    return timedelta(
+                        **{unit: int(n) for unit, n in parts.items() if n is not None}
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
