+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), or ``s`` (seconds). Each unit may be used
+    at most once, in that order, without spaces. Units are case-insensitive,
+    so ``2d``, ``1h30m``, ``45S``, and ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # Restrict to ASCII so case folding cannot match non-ASCII lookalikes,
+    # such as "\u017f" (long s) for "s".
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The unit groups are all optional, so an empty string matches too.
+        if match is not None and match.group(0):
+            parts = {k: int(v) for k, v in match.groupdict(default="0").items()}
+
+            try:
+                return timedelta(
+                    days=parts["days"],
+                    hours=parts["hours"],
+                    minutes=parts["minutes"],
+                    seconds=parts["total"] + parts["seconds"],
+                )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
