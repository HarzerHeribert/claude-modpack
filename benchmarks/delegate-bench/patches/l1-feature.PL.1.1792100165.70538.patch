+# Each unit is optional, but units must appear in this order and at most once.
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each
+    unit may appear at most once and in that order, without spaces. Units
+    are case-insensitive. For example ``2d``, ``1h30m``, ``90m``, or
+    ``1d2h3m4s``.
+
+    Negative and fractional values are not accepted.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every unit is optional, so the pattern also matches the empty string.
+        if isinstance(value, str) and value:
+            # A bare integer is a number of seconds.
+            text = f"{value}s" if value.isdigit() else value
+            match = _duration_re.fullmatch(text)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict("0").items()}
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
