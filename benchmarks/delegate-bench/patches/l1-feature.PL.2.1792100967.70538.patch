+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of a whole number followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear at
+    most once and units must be given in that order, without spaces, like
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            groups = match.groupdict()
+            total = groups.pop("total")
+
+            try:
+                if total is not None:
+                    return timedelta(seconds=int(total))
+
+                parts = {unit: int(n) for unit, n in groups.items() if n is not None}
+
+                # An empty string matches with every group unset.
+                if parts:
+                    return timedelta(**parts)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
