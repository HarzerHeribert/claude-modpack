+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most once and in
+    that order, without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _units_re: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                groups: dict[str, str | None] = {"seconds": value}
+            else:
+                match = self._units_re.fullmatch(value)
+                groups = {} if match is None else match.groupdict()
+
+            # The unit groups are all optional, so an empty string also
+            # matches the pattern, without capturing anything.
+            parts = {unit: int(n) for unit, n in groups.items() if n is not None}
+
+            if parts:
+                try:
+                    return timedelta(**parts)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
