+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each unit
+    may be given at most once, units must be in that order, and spaces are
+    not allowed, like ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are
+    case-insensitive.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+")
+    _units_re = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def _try_to_convert_duration(self, value: str) -> timedelta | None:
+        if self._seconds_re.fullmatch(value):
+            return timedelta(seconds=int(value))
+
+        match = self._units_re.fullmatch(value)
+
+        if match is None:
+            return None
+
+        parts = {k: int(v) for k, v in match.groupdict().items() if v is not None}
+
+        # An empty string matches with every group absent.
+        if not parts:
+            return None
+
+        return timedelta(**parts)
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                converted = self._try_to_convert_duration(value)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                converted = None
+
+            if converted is not None:
+                return converted
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
