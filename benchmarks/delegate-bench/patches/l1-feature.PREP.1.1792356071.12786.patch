+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", datetime.timedelta(seconds=120)),
+        ("0", datetime.timedelta(0)),
+        ("2d", datetime.timedelta(days=2)),
+        ("1h30m", datetime.timedelta(hours=1, minutes=30)),
+        ("45S", datetime.timedelta(seconds=45)),
+        ("1d2h3m4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H3M4S", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", datetime.timedelta(minutes=90)),
+        ("2d30s", datetime.timedelta(days=2, seconds=30)),
+        ("0h", datetime.timedelta(0)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    value = datetime.timedelta(minutes=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "+5",
+        "1.5",
+        "1.5h",
+        "1w",
+        "abc",
+        "h",
+        "1hm",
+        "1h1h",
+        "30m1h",
+        "1s1d",
+        "1h 30m",
+        " 120",
+        "120 ",
+        "120\n",
+        "5\u017f",  # LATIN SMALL LETTER LONG S case-folds to "s"
+        "\u0661\u0662",  # ARABIC-INDIC DIGITS
+        "9" * 20,
+        "9" * 20 + "d",
+        "9" * 5000,
+        120,
+        None,
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="5m", show_default=True)
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+    assert "[default: 5m]" in result.output
+
+    result = runner.invoke(cli, [])
+    assert result.output == "datetime.timedelta(seconds=300)\n"
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.output == "datetime.timedelta(seconds=5400)\n"
+
+    result = runner.invoke(cli, ["--timeout", "1x"])
+    assert result.exit_code == 2
+    assert "'1x' is not a valid duration." in result.output
