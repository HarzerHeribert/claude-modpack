+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`datetime.timedelta`.
+
+    The value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), such as
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most
+    once and in that order, without spaces. Units are case-insensitive.
+    Negative numbers and decimals are not accepted.
+
+    A :class:`datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    # ASCII mode keeps IGNORECASE from matching non-ASCII lookalikes of the
+    # unit letters, such as "ſ" for "s".
+    _pattern = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, which is not a duration.
+        if match is not None and match[0]:
+            if match["total"] is not None:
+                parts = {"seconds": match["total"]}
+            else:
+                parts = {k: v for k, v in match.groupdict().items() if v is not None}
+
+            try:
+                return timedelta(**{k: int(v) for k, v in parts.items()})
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
