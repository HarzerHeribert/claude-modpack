@@ -579,6 +581,65 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be
+    used at most once, in that order, without spaces. Units are
+    case-insensitive.
+
+    A ``timedelta`` value is returned unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                try:
+                    return timedelta(seconds=int(value))
+                except OverflowError:
+                    pass
+            else:
+                match = _duration_re.fullmatch(value)
+
+                if value and match is not None:
+                    days, hours, minutes, seconds = (
+                        int(group) if group is not None else 0
+                        for group in match.groups()
+                    )
+
+                    try:
+                        return timedelta(
+                            days=days, hours=hours, minutes=minutes, seconds=seconds
+                        )
+                    except OverflowError:
+                        pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
