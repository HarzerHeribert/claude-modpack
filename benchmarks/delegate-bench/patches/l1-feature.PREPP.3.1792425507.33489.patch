+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more groups of an integer followed by a unit, such as
+    ``1h30m``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be given at most once,
+    in that order, with no spaces. Units are case-insensitive. A
+    ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.5.1
+    """
+
+    name = "duration"
+
+    # A whole number of seconds, or <integer><unit> groups in d, h, m, s order.
+    _pattern = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match: re.Match[str] | None = None
+
+        # The pattern also matches the empty string, which is not a duration.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+        if match is not None:
+            try:
+                return timedelta(
+                    days=int(match["days"] or 0),
+                    hours=int(match["hours"] or 0),
+                    minutes=int(match["minutes"] or 0),
+                    seconds=int(match["total"] or match["seconds"] or 0),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
