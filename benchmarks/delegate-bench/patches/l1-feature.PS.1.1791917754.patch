         return "DateTime"
 
 
+# Either a bare whole number of seconds, or integer-unit groups in d, h, m, s
+# order. ASCII-only so Unicode digits and case folds (like "ſ" for "s") are
+# rejected.
+_duration_re = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit, like ``1h30m``. The
+    units are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may be given at most once, in that order, without
+    spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The unit alternative also matches the empty string.
+        if match is not None and value:
+            parts = match.groupdict(default="0")
+
+            try:
+                return timedelta(
+                    days=int(parts["days"]),
+                    hours=int(parts["hours"]),
+                    minutes=int(parts["minutes"]),
+                    seconds=int(parts["bare"]) + int(parts["seconds"]),
+                )
+            except (OverflowError, ValueError):
+                # Out of timedelta's range, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
