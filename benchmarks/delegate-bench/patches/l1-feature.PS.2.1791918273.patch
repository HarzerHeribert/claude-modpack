+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of a whole number followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may appear at most once and in that order, without spaces. Units are
+    case-insensitive. For example ``2d``, ``1h30m``, ``45S``, and
+    ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # Either plain seconds, or d/h/m/s groups in that order. ASCII mode keeps
+    # IGNORECASE from matching look-alikes such as "ſ" (long s) for "s".
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<plain>[0-9]+)"
+        r"|(?:(?P<d>[0-9]+)d)?(?:(?P<h>[0-9]+)h)?"
+        r"(?:(?P<m>[0-9]+)m)?(?:(?P<s>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every group is optional, so the empty string must be rejected here.
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None and value:
+            parts = match.groupdict(default="0")
+
+            try:
+                return timedelta(
+                    days=int(parts["d"]),
+                    hours=int(parts["h"]),
+                    minutes=int(parts["m"]),
+                    seconds=int(parts["s"]) + int(parts["plain"]),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
