+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), such as
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most
+    once and units must be given in that order, without spaces. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # An empty string matches the pattern with every group empty.
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None and value:
+            try:
+                return timedelta(
+                    days=int(match["days"] or 0),
+                    hours=int(match["hours"] or 0),
+                    minutes=int(match["minutes"] or 0),
+                    seconds=int(match["total"] or match["seconds"] or 0),
+                )
+            # Values too large for int() or timedelta are invalid too.
+            except (ValueError, OverflowError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
