 from gettext import ngettext
 
@@ -579,6 +581,65 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_seconds_re = re.compile(r"[0-9]+")
+_duration_units_re = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+    # ASCII keeps IGNORECASE from matching non-ASCII letters like "ſ" as "s".
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be used
+    at most once and in that order, with no spaces. Units are
+    case-insensitive. For example, ``2d``, ``1h30m``, ``45S``, and
+    ``1d2h3m4s`` are valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if _duration_seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = _duration_units_re.fullmatch(value)
+
+                # No group matched for an empty string.
+                if match is not None and match.lastindex is not None:
+                    days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
