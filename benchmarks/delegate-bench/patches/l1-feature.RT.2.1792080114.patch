+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Accepted values are a whole number of seconds, such as ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and
+    ``s``, such as ``2d``, ``1h30m``, ``45S`` or ``1d2h3m4s``. Each unit may
+    appear at most once and units must be given in that order. Units are case
+    insensitive and spaces, signs and decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and value:
+                days, hours, minutes, seconds = (
+                    int(g) if g else 0 for g in match.groups()
+                )
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
