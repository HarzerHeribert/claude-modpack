+def test_duration_passthrough():
+    delta = datetime.timedelta(hours=3)
+    assert click.Duration().convert(delta, None, None) is delta
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", datetime.timedelta(seconds=120)),
+        ("0", datetime.timedelta(0)),
+        ("2d", datetime.timedelta(days=2)),
+        ("1h30m", datetime.timedelta(hours=1, minutes=30)),
+        ("45S", datetime.timedelta(seconds=45)),
+        ("1d2h3m4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", datetime.timedelta(minutes=90)),
+        ("1H30M", datetime.timedelta(hours=1, minutes=30)),
+    ],
+)
+def test_duration_valid(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "1.5h",
+        "1.5",
+        "5x",
+        "1h1h",
+        "1m1h",
+        "1h 30m",
+        " 1h",
+        "1h ",
+        "h",
+        "abc",
+        "١٢",
+        "١h",
+        None,
+        5,
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert "is not a valid duration." in exc_info.value.message
+    assert repr(value) in exc_info.value.message
+
+
+def test_duration_command(runner):
+    @click.command()
+    @click.option("--wait", type=click.Duration())
+    def cli(wait):
+        click.echo(repr(wait))
+
+    result = runner.invoke(cli, ["--help"])
+    assert "DURATION" in result.output
+
+    result = runner.invoke(cli, ["--wait", "1h30m"])
+    assert result.output.strip() == repr(datetime.timedelta(hours=1, minutes=30))
+
+    result = runner.invoke(cli, ["--wait", "5x"])
+    assert result.exit_code == 2
+    assert "is not a valid duration." in result.output
