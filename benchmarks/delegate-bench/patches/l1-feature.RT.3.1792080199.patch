 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,58 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_DURATION_RE = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+)
+_DURATION_SECONDS_RE = re.compile(r"[0-9]+")
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Two formats are accepted. A whole number of seconds, such as ``90``, or
+    one or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes) and ``s`` (seconds), such as ``1h30m`` or
+    ``2d``. Each unit may appear at most once and they must be given in that
+    order. Units are case-insensitive and spaces, signs and fractions are not
+    allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if _DURATION_SECONDS_RE.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = _DURATION_RE.fullmatch(value)
+
+                if match is not None and any(g is not None for g in match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(g or 0) for g in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
