+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1H", timedelta(hours=1)),
+        ("0s", timedelta(0)),
+        ("1D2h", timedelta(days=1, hours=2)),
+    ],
+)
+def test_duration_valid(value, expected):
+    assert click.Duration().convert(value, None, None) == expected
+
+
+def test_duration_timedelta_passthrough():
+    td = timedelta(minutes=5)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "+5",
+        "1.5",
+        "1.5h",
+        "1x",
+        "h",
+        "1h1h",
+        "1m1h",
+        "1h 30m",
+        " 120",
+        "120 ",
+        "120\n",
+        "1h30",
+        120,
+        None,
+        "١٢",
+        "99999999999d",
+        "9" * 30,
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--wait", type=click.Duration())
+    def cli(wait):
+        click.echo(repr(wait))
+
+    result = runner.invoke(cli, ["--wait", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(timedelta(hours=1, minutes=30))
+
+    result = runner.invoke(cli, ["--help"])
+    assert "DURATION" in result.output
