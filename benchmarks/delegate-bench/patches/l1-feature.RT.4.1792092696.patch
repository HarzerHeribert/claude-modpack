+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Accepted strings are either a whole number of seconds (``120``) or one
+    or more ``<integer><unit>`` groups using the units ``d``, ``h``, ``m``
+    and ``s``, each at most once and in that order, without spaces and case
+    insensitive (``2d``, ``1h30m``, ``45S``). A `timedelta` is passed
+    through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<d>[0-9]+)d)?(?:(?P<h>[0-9]+)h)?"
+        r"(?:(?P<m>[0-9]+)m)?(?:(?P<s>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and any(v is not None for v in match.groups()):
+                return timedelta(
+                    days=int(match["d"] or 0),
+                    hours=int(match["h"] or 0),
+                    minutes=int(match["m"] or 0),
+                    seconds=int(match["s"] or 0),
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
