+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1H30M", timedelta(hours=1, minutes=30)),
+        ("2D", timedelta(days=2)),
+    ],
+)
+def test_duration_valid(value, expect):
+    result = click.Duration().convert(value, None, None)
+    assert result == expect
+    assert isinstance(result, timedelta)
+
+
+def test_duration_passthrough():
+    td = timedelta(minutes=3)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "-5", "-1h", "1.5h", "1.5", "5w", "1h2h", "30m1h", "1h 30m", " 5", "5 ",
+     "h", "1d1d", "s1", "٣", 5, None],
+)  # fmt: skip
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+    assert f"{value!r} is not a valid duration." in exc_info.value.message
+
+
+def test_duration_cli(runner):
+    seen = []
+
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        seen.append(timeout)
+
+    result = runner.invoke(cli, ["--help"])
+    assert "DURATION" in result.output
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert seen == [timedelta(hours=1, minutes=30)]
+
+    result = runner.invoke(cli, ["--timeout", "5w"])
+    assert result.exit_code == 2
+    assert "'5w' is not a valid duration." in result.output
