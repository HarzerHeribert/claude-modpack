+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A string is either a whole number of seconds (``"120"``) or one or more
+    ``<integer><unit>`` groups with units ``d``, ``h``, ``m``, ``s``. Each
+    unit may appear at most once and in that order, with no spaces. Units are
+    case-insensitive. For example ``"2d"``, ``"1h30m"``, ``"1d2h3m4s"``.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if re.fullmatch(r"[0-9]+", value):
+                    return timedelta(seconds=int(value))
+
+                match = self._pattern.fullmatch(value)
+
+                if match is not None:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
