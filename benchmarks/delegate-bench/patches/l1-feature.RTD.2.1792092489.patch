+class Duration(ParamType[timedelta]):
+    """Converts a string to a :class:`datetime.timedelta`.
+
+    Accepts either a whole number of seconds (``120``) or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and
+    ``s``, each at most once and in that order, with no spaces, such as
+    ``2d``, ``1h30m`` or ``1d2h3m4s``. Units are case-insensitive.
+    Negative and fractional values are not accepted. A
+    :class:`datetime.timedelta` is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m)?(?:(?P<s>\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            if re.fullmatch(r"[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                return timedelta(
+                    days=int(match["d"] or 0),
+                    hours=int(match["h"] or 0),
+                    minutes=int(match["m"] or 0),
+                    seconds=int(match["s"] or 0),
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
