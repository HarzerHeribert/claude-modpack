diff --git a/tests/test_types.py b/tests/test_types.py
index 63992cc..3c63c48 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -330,3 +330,74 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+def test_duration_timedelta_passthrough():
+    import datetime
+
+    td = datetime.timedelta(minutes=5)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("120", {"seconds": 120}),
+        ("0", {}),
+        ("0s", {}),
+        ("2d", {"days": 2}),
+        ("3h", {"hours": 3}),
+        ("4m", {"minutes": 4}),
+        ("5s", {"seconds": 5}),
+        ("1h30m", {"hours": 1, "minutes": 30}),
+        ("1d2h3m4s", {"days": 1, "hours": 2, "minutes": 3, "seconds": 4}),
+        ("45S", {"seconds": 45}),
+        ("1H30M", {"hours": 1, "minutes": 30}),
+        ("90m", {"minutes": 90}),
+    ],
+)
+def test_duration_valid(value, expected):
+    import datetime
+
+    result = click.Duration().convert(value, None, None)
+    assert result == datetime.timedelta(**expected)
+    assert isinstance(result, datetime.timedelta)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "1.5",
+        "1.5h",
+        "5x",
+        "3w",
+        "1h2h",
+        "30m1h",
+        "1h 30m",
+        " 5",
+        "h",
+        "١٢",
+        "5\n",
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_cli(runner):
+    @click.command()
+    @click.option("--t", type=click.Duration())
+    def cli(t):
+        click.echo(repr(t))
+
+    result = runner.invoke(cli, ["--t", "1h30m"])
+    assert result.output.strip() == "datetime.timedelta(seconds=5400)"
+    result = runner.invoke(cli, ["--t", "1h2h"])
+    assert "'1h2h' is not a valid duration." in result.output
+    assert "DURATION" in runner.invoke(cli, ["--help"]).output
