+class Duration(ParamType[timedelta]):
+    """A parameter that accepts a duration and converts it to a
+    :class:`datetime.timedelta`.
+
+    The value is either a whole number of seconds (``120``) or one or
+    more ``<integer><unit>`` groups using the units ``d``, ``h``, ``m``
+    and ``s``, each at most once and in that order, without spaces and
+    case-insensitive (``1h30m``, ``2d``, ``45S``). A
+    :class:`~datetime.timedelta` is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if re.fullmatch(r"[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and any(g is not None for g in match.groups()):
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
