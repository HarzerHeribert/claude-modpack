+# re.ASCII keeps IGNORECASE from also matching non-ASCII letters that fold to
+# a unit, such as "ſ" (LATIN SMALL LETTER LONG S) for "s".
+_DURATION_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), like ``2d``, ``1h30m``,
+    or ``1d2h3m4s``. Each unit may be given at most once, units must appear
+    in that order, and spaces are not allowed. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every group in the pattern is optional, so rule out "" separately.
+        if isinstance(value, str) and value:
+            # A bare number is a count of seconds.
+            match = _DURATION_RE.fullmatch(f"{value}s" if value.isdigit() else value)
+
+            if match is not None:
+                parts = {k: int(v) for k, v in match.groupdict("0").items()}
+
+                try:
+                    return timedelta(**parts)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
