+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Accepted strings are either a whole number of seconds, such as ``120``,
+    or one or more ``<integer><unit>`` groups with the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes) and ``s`` (seconds). Each unit may appear
+    at most once, in that order, without spaces, and units are case
+    insensitive. For example ``2d``, ``1h30m`` or ``1d2h3m4s``.
+
+    An existing `datetime.timedelta` is returned unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            if re.fullmatch("[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
