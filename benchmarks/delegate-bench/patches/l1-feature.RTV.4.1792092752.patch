+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds (``120``) or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and ``s``
+    (days, hours, minutes, seconds). Each unit may appear at most once and
+    units must be given in that order, without spaces. Units are case
+    insensitive. Examples are ``2d``, ``1h30m``, ``45S`` and ``1d2h3m4s``.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+    _seconds_pattern = re.compile(r"[0-9]+")
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if self._seconds_pattern.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if value and match is not None:
+                groups = match.groupdict()
+                return timedelta(**{k: int(v) for k, v in groups.items() if v})
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
