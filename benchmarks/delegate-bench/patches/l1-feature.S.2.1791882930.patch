+class Duration(ParamType[timedelta]):
+    """Converts a duration string to a :class:`datetime.timedelta`.
+
+    Accepts either a whole number of seconds (``120``) or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and ``s``,
+    each at most once and in that order, without spaces (``1h30m``). Units
+    are case-insensitive. A :class:`~datetime.timedelta` is passed through
+    unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+")
+    _groups_re = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._groups_re.fullmatch(value)
+
+                if match is not None and any(match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(g or 0) for g in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
