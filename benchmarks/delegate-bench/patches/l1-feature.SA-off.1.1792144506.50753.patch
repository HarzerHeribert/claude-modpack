@@ -579,6 +581,66 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+# Either a bare number of seconds, or one or more <integer><unit> groups
+# with the units d, h, m, s, each at most once and in that order.
+_duration_re = re.compile(
+    r"(?P<seconds_only>[0-9]+)"
+    r"|(?=[0-9])"  # At least one group must be present.
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes) and ``s`` (seconds), such as ``2d``,
+    ``90m`` or ``1h30m``. Each unit may appear at most once and units
+    must be given in that order. Units are case-insensitive. Spaces,
+    signs and decimals are not allowed.
+
+    A :class:`datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            groups = match.groupdict()
+            seconds_only = groups.pop("seconds_only")
+
+            if seconds_only is not None:
+                groups["seconds"] = seconds_only
+
+            try:
+                return timedelta(**{k: int(v) for k, v in groups.items() if v})
+            except (OverflowError, ValueError):
+                # Too many digits for int(), or too large for timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
