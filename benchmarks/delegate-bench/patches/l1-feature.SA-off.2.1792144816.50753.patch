+_DURATION_SECONDS_RE = re.compile(r"[0-9]+")
+_DURATION_UNITS_RE = re.compile(
+    r"(?:(?P<d>[0-9]+)d)?(?:(?P<h>[0-9]+)h)?(?:(?P<m>[0-9]+)m)?(?:(?P<s>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more ``<integer><unit>`` groups, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once, the
+    units must be given in that order, and no spaces are allowed. Units are
+    case-insensitive.
+
+    A :class:`datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if _DURATION_SECONDS_RE.fullmatch(value) is not None:
+                    return timedelta(seconds=int(value))
+
+                match = _DURATION_UNITS_RE.fullmatch(value)
+
+                if match is not None and match.lastindex is not None:
+                    parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                    return timedelta(
+                        days=parts["d"],
+                        hours=parts["h"],
+                        minutes=parts["m"],
+                        seconds=parts["s"],
+                    )
+            except (OverflowError, ValueError):
+                # The numbers are too large for int() or timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
