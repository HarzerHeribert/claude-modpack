+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("0", timedelta(0)),
+        ("120", timedelta(seconds=120)),
+        ("007", timedelta(seconds=7)),
+        ("2d", timedelta(days=2)),
+        ("5h", timedelta(hours=5)),
+        ("90m", timedelta(minutes=90)),
+        ("45s", timedelta(seconds=45)),
+        ("45S", timedelta(seconds=45)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1H30M", timedelta(hours=1, minutes=30)),
+        ("2d12h", timedelta(days=2, hours=12)),
+        ("1m30s", timedelta(minutes=1, seconds=30)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2h3M4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("0d0h0m0s", timedelta(0)),
+    ],
+)
+def test_duration(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [timedelta(seconds=5), timedelta(days=-1), timedelta(0)],
+)
+def test_duration_timedelta_passthrough(value):
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        pytest.param("", id="empty"),
+        pytest.param("-5", id="negative seconds"),
+        pytest.param("-5m", id="negative unit"),
+        pytest.param("+5", id="explicit sign"),
+        pytest.param("1.5", id="decimal seconds"),
+        pytest.param("1.5h", id="decimal unit"),
+        pytest.param("5w", id="unknown unit"),
+        pytest.param("5x", id="unknown suffix"),
+        pytest.param("abc", id="letters"),
+        pytest.param("h", id="unit without number"),
+        pytest.param("1hm", id="unit missing number"),
+        pytest.param("1h30", id="trailing number"),
+        pytest.param("1h1h", id="repeated unit"),
+        pytest.param("1m2m", id="repeated unit 2"),
+        pytest.param("1m1h", id="out of order"),
+        pytest.param("4s3m2h1d", id="reversed"),
+        pytest.param("1h 30m", id="inner space"),
+        pytest.param(" 120", id="leading space"),
+        pytest.param("120 ", id="trailing space"),
+        pytest.param("120\n", id="trailing newline"),
+        pytest.param("\u0661\u0662", id="non-ascii digits"),
+        pytest.param("9999999999d", id="overflow"),
+        pytest.param(120, id="int"),
+        pytest.param(b"120", id="bytes"),
+    ],
+)
+def test_duration_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="1m30s")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+    result = runner.invoke(cli, [])
+    assert result.output == f"{timedelta(seconds=90)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "2h"])
+    assert result.output == f"{timedelta(hours=2)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "2 h"])
+    assert result.exit_code == 2
+    assert "'2 h' is not a valid duration." in result.output
+
