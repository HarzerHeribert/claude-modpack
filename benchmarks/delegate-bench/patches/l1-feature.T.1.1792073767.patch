+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups with no spaces between them. The
+    units are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may appear at most once, and units must appear in
+    that order. Units are case-insensitive. For example, ``2d``,
+    ``1h30m``, ``90m``, and ``1d2h3m4s`` are all valid.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                parts: tuple[str | None, ...] = (None, None, None, value)
+            elif (match := self._pattern.fullmatch(value)) is not None:
+                parts = match.groups()
+            else:
+                parts = ()
+
+            if any(part is not None for part in parts):
+                days, hours, minutes, seconds = (int(part or 0) for part in parts)
+
+                try:
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
