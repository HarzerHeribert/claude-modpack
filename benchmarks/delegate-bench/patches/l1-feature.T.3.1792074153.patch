@@ -579,6 +581,57 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_DURATION_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit, such as ``1h30m``. The
+    units are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may appear at most once, in that order, and units
+    are case-insensitive. Spaces, signs, and decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The unit pattern matches the empty string, which isn't a duration.
+        if isinstance(value, str) and value:
+            if value.isascii() and value.isdigit():
+                units = {"seconds": value}
+            elif (match := _DURATION_RE.fullmatch(value)) is not None:
+                units = {k: v for k, v in match.groupdict().items() if v is not None}
+            else:
+                units = {}
+
+            if units:
+                try:
+                    return timedelta(**{unit: int(n) for unit, n in units.items()})
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
