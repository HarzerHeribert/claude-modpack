@@ -4,11 +4,13 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
 import uuid
 from datetime import datetime
+from datetime import timedelta
 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,59 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may appear at most once and units must be given in that order, without
+    spaces. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``90m``, and ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = _duration_re.fullmatch(value)
+
+                if match is not None and value:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict(default="0").items()}
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
