+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear at
+    most once and in that order, without spaces, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. Units are case-insensitive. A ``timedelta`` value is
+    passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<plain>[0-9]+)"
+        r"|(?=[0-9])"
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            try:
+                amounts = {k: int(v) for k, v in match.groupdict("0").items()}
+                # A plain number is seconds, and never appears alongside units.
+                amounts["seconds"] += amounts.pop("plain")
+                return timedelta(**amounts)
+            except (ValueError, OverflowError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
