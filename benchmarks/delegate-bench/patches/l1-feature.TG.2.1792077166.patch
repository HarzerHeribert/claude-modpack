@@ -579,6 +581,64 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_DURATION_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`datetime.timedelta`.
+
+    The value is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups with no spaces between them,
+    such as ``2d``, ``1h30m``, or ``1d2h3m4s``. The units are ``d``
+    (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each
+    unit may appear at most once and in that order. Units are
+    case-insensitive. Negative numbers and decimals are not accepted.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare whole number is a count of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = _DURATION_RE.fullmatch(text)
+
+            # Every group is optional, so the empty string matches too.
+            if match is not None and match.group():
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict().items()
+                            if amount is not None
+                        }
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
