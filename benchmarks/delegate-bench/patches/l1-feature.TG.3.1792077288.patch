+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be given
+    at most once, in that order, without spaces, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. Units are case-insensitive.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<total>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        # ASCII keeps case folding from matching characters like "ſ" as "s".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            # The unit alternative also matches the empty string.
+            if match is not None and any(match.groups()):
+                total, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+
+                try:
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=total + seconds
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
