+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be given at most once
+    and in that order, without spaces. Units are case-insensitive.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # ASCII keeps IGNORECASE from letting "s" match the long s "ſ".
+    _pattern = re.compile(
+        r"(?P<plain>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            # The empty string matches with every group unset.
+            if match is not None and any(match.groups()):
+                try:
+                    plain, days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days,
+                        hours=hours,
+                        minutes=minutes,
+                        seconds=plain + seconds,
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
