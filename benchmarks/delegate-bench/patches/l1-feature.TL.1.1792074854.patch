--- a/src/click/types.py
+++ b/src/click/types.py
@@ -4,11 +4,13 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
 import uuid
 from datetime import datetime
+from datetime import timedelta
 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,67 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+# A whole number of seconds, or <integer><unit> groups for the units d, h, m,
+# and s, each at most once and in that order. ASCII mode limits \d to 0-9 and
+# keeps IGNORECASE from matching non-ASCII letters, like U+017F (long s) for s.
+_duration_re = re.compile(
+    r"(?P<plain>\d+)"
+    r"|(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` for days, ``h`` for
+    hours, ``m`` for minutes, and ``s`` for seconds. Each unit may appear at
+    most once and in that order, without spaces. Units are case-insensitive,
+    so ``2d``, ``1h30m``, ``45S``, and ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged. Any
+    other value, including an ``int``, is rejected.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every group of the unit form is optional, so the pattern also
+        # matches the empty string, which is not a duration.
+        if isinstance(value, str) and value:
+            match = _duration_re.fullmatch(value)
+
+            if match is not None:
+                units = match.groupdict(default="0")
+
+                try:
+                    return timedelta(
+                        days=int(units["days"]),
+                        hours=int(units["hours"]),
+                        minutes=int(units["minutes"]),
+                        # A plain number is a count of seconds.
+                        seconds=int(units["plain"]) + int(units["seconds"]),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int().
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
