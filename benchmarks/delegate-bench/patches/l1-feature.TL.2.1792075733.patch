+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta`.
+
+    The value is either a whole number of seconds, like ``"90"``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), like
+    ``"1h30m"``. Units are case-insensitive, each may appear at most once,
+    and they must be given in that order without spaces. A
+    :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _units_re: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # Integer parsing rejects overlong digit strings with
+            # ValueError, and timedelta rejects huge values with
+            # OverflowError. Both are invalid durations.
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                if match is not None and any(match.groups()):
+                    days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (ValueError, OverflowError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
