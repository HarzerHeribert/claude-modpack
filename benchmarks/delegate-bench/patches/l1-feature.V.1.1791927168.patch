+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups with the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and in that order, without spaces. Units are
+    case-insensitive. For example, ``2d``, ``1h30m``, ``90m``, and
+    ``1d2h3m4s`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+    """
+
+    name = "duration"
+
+    # Either a bare number of seconds, or d/h/m/s groups in that order. The
+    # lookahead stops the all-optional groups from matching an empty string.
+    # [0-9] and re.ASCII keep out non-ASCII digits and case-folded
+    # look-alikes such as "\u017f" (long s) matching "s".
+    _pattern = re.compile(
+        r"(?P<total_seconds>[0-9]+)"
+        r"|(?=[0-9])"
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            try:
+                parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                return timedelta(
+                    days=parts["days"],
+                    hours=parts["hours"],
+                    minutes=parts["minutes"],
+                    seconds=parts["seconds"] + parts["total_seconds"],
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
