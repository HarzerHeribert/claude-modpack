+_DURATION_RE = re.compile(
+    r"(?P<plain>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once
+    and units must be given in that order, without spaces. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _DURATION_RE.fullmatch(value) if isinstance(value, str) else None
+
+        # The unit groups are all optional, so an empty string matches.
+        if match is not None and any(match.groups()):
+            parts = match.groupdict()
+
+            try:
+                return timedelta(
+                    days=int(parts["days"] or 0),
+                    hours=int(parts["hours"] or 0),
+                    minutes=int(parts["minutes"] or 0),
+                    seconds=int(parts["plain"] or parts["seconds"] or 0),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
