+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more groups of an integer followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes) and ``s`` (seconds). Each unit may
+    appear at most once and in that order, without spaces, such as
+    ``2d``, ``1h30m`` or ``1d2h3m4s``. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _units_re = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        # ASCII prevents case-insensitive matches such as "ſ" for "s".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def _try_to_convert_duration(self, value: str) -> timedelta | None:
+        if value.isascii() and value.isdigit():
+            groups = {"seconds": value}
+        else:
+            match = self._units_re.fullmatch(value)
+
+            # The pattern matches the empty string, every group omitted.
+            if not value or match is None:
+                return None
+
+            groups = match.groupdict()
+
+        try:
+            return timedelta(
+                **{unit: int(n) for unit, n in groups.items() if n is not None}
+            )
+        except (OverflowError, ValueError):
+            # Out of range for timedelta, or too many digits for int().
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            converted = self._try_to_convert_duration(value)
+
+            if converted is not None:
+                return converted
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
