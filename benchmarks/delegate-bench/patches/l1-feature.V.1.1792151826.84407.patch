+class Duration(ParamType[timedelta]):
+    """Parses a duration into a :class:`datetime.timedelta`. Accepts a
+    whole number of seconds (``120``) or ``d``, ``h``, ``m``, ``s``
+    groups, each at most once and in that order, case-insensitive
+    (``1h30m``, ``2d``, ``1d2h3m4s``).
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m)?(?:(?P<s>\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if value.isascii() and value.isdigit():
+            return timedelta(seconds=int(value))
+
+        match = self._pattern.fullmatch(value) if value else None
+
+        if match is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return timedelta(
+            days=int(match["d"] or 0),
+            hours=int(match["h"] or 0),
+            minutes=int(match["m"] or 0),
+            seconds=int(match["s"] or 0),
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
