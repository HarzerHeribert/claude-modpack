+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and they must be given in that order, without
+    spaces. Units are case-insensitive. For example: ``2d``, ``1h30m``,
+    ``45S``, ``1d2h3m4s``, ``90m``.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<plain>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The all-optional unit groups also match the empty string.
+        if match is not None and any(match.groups()):
+            parts = match.groupdict()
+            plain = parts.pop("plain")
+
+            try:
+                if plain is not None:
+                    return timedelta(seconds=int(plain))
+
+                return timedelta(**{k: int(v) for k, v in parts.items() if v})
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
