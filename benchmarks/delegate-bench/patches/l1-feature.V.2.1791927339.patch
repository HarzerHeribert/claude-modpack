+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more integers each followed by a unit: ``d`` for days, ``h`` for
+    hours, ``m`` for minutes, and ``s`` for seconds. Each unit may appear at
+    most once, units must appear in that order, and units are
+    case-insensitive. For example, ``2d``, ``1h30m``, ``45S``, and
+    ``1d2h3m4s`` are all valid. Spaces, signs, and decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<bare>\d+)"
+        r"|(?:(?P<days>\d+)d)?"
+        r"(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?"
+        r"(?:(?P<seconds>\d+)s)?",
+        # ASCII keeps \d to 0-9 and stops "s" from case-matching "ſ".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every unit group is optional, so the pattern also matches "".
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None and value:
+            parts = match.groupdict(default="0")
+
+            try:
+                return timedelta(
+                    days=int(parts["days"]),
+                    hours=int(parts["hours"]),
+                    minutes=int(parts["minutes"]),
+                    seconds=int(parts["seconds"]) + int(parts["bare"]),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
