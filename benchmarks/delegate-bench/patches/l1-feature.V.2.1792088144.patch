+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of an integer followed by a unit, like ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear
+    at most once, in that order, with no spaces. Units are
+    case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # ASCII keeps lookalikes such as "\u017f" (long s) from matching "s"
+    # under IGNORECASE, and non-ASCII digits from matching [0-9].
+    _pattern = re.compile(
+        r"(?P<seconds_only>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The unit groups are all optional, so the empty string matches.
+        if match is not None and value:
+            parts = match.groupdict()
+            seconds_only = parts.pop("seconds_only")
+
+            if seconds_only is not None:
+                parts = {"seconds": seconds_only}
+
+            try:
+                return timedelta(
+                    **{unit: int(n) for unit, n in parts.items() if n is not None}
+                )
+            # Too large for timedelta, or too many digits for int.
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
