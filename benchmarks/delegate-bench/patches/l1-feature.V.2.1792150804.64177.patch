+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be used at most once,
+    in that order, without spaces. Units are case insensitive.
+    """
+
+    name = "duration"
+
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<plain>\d+)"
+        r"|(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        # ASCII keeps \d to 0-9 and stops IGNORECASE from matching
+        # non-ASCII lookalikes such as "\u017f" (long s) for "s".
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The pattern also matches the empty string, which is not valid.
+        if isinstance(value, str) and value:
+            match = self._pattern.fullmatch(value)
+
+            if match is not None:
+                try:
+                    parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                    # At most one of "plain" and "seconds" is non-zero.
+                    return timedelta(
+                        days=parts["days"],
+                        hours=parts["hours"],
+                        minutes=parts["minutes"],
+                        seconds=parts["plain"] + parts["seconds"],
+                    )
+                except (OverflowError, ValueError):
+                    # Too many digits for int, or too large for timedelta.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
