+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H", timedelta(days=1, hours=2)),
+        ("90m", timedelta(minutes=90)),
+        (timedelta(hours=5), timedelta(hours=5)),
+    ],
+)
+def test_duration_valid(value, expected):
+    assert click.Duration().convert(value, None, None) == expected
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "-5", "-1h", "1.5h", "1.5", "5x", "h", "1s1h", "1h1h", "1h 30m", " 5", "5\n"],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter, match="is not a valid duration."):
+        click.Duration().convert(value, None, None)
+
+
+def test_duration_message_and_metavar(runner):
+    @click.command()
+    @click.option("--t", type=click.Duration())
+    def cli(t):
+        click.echo(repr(t))
+
+    result = runner.invoke(cli, ["--t", "bad"])
+    assert "'bad' is not a valid duration." in result.output
+    assert "DURATION" in runner.invoke(cli, ["--help"]).output
+    assert click.Duration().name == "duration"
