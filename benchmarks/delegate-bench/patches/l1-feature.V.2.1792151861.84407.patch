+class Duration(ParamType[timedelta]):
+    """Converts a duration string into a :class:`datetime.timedelta`.
+
+    A value is either a whole number of seconds (``"120"``) or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and ``s``,
+    each at most once and in that order, with no spaces. Units are case
+    insensitive, for example ``"2d"``, ``"1h30m"`` or ``"1d2h3m4s"``. A
+    :class:`~datetime.timedelta` is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<d>[0-9]+)d)?(?:(?P<h>[0-9]+)h)?"
+        r"(?:(?P<m>[0-9]+)m)?(?:(?P<s>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and value:
+                parts = {k: int(v) for k, v in match.groupdict().items() if v}
+                return timedelta(
+                    days=parts.get("d", 0),
+                    hours=parts.get("h", 0),
+                    minutes=parts.get("m", 0),
+                    seconds=parts.get("s", 0),
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class OptionHelpExtra(t.TypedDict, total=False):
     envvars: tuple[str, ...]
     default: str
