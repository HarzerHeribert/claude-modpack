+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta``
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear
+    at most once, in that order, without spaces. Units are not case
+    sensitive.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            parts: dict[str, str] | None
+
+            if value.isascii() and value.isdigit():
+                parts = {"seconds": value}
+            elif value and (match := self._pattern.fullmatch(value)):
+                parts = {k: v for k, v in match.groupdict().items() if v is not None}
+            else:
+                parts = None
+
+            if parts is not None:
+                try:
+                    return timedelta(**{k: int(v) for k, v in parts.items()})
+                except (OverflowError, ValueError):
+                    # Too large for timedelta or for int's digit limit.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
