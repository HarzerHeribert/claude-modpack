@@ -579,6 +581,61 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?=.)(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more groups of a whole number followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be
+    given at most once, units must appear in that order, and spaces are not
+    allowed. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``90m``, and ``1d2h3m4s`` are valid durations.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            total, days, hours, minutes, seconds = match.groups(default="0")
+
+            try:
+                return timedelta(
+                    days=int(days),
+                    hours=int(hours),
+                    minutes=int(minutes),
+                    seconds=int(total) + int(seconds),
+                )
+            except (OverflowError, ValueError):
+                # The number is too large for timedelta, or has more digits
+                # than int() allows.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
