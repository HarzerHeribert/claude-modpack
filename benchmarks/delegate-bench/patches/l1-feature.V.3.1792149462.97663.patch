+# Either a whole number of seconds, or one or more of the units d, h, m, s,
+# each at most once and in that order. The lookahead stops the all-optional
+# second branch from matching an empty string. ASCII mode keeps digits to
+# 0-9 and stops IGNORECASE from matching non-ASCII letters like "ſ" for "s".
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?=.)"
+    r"(?:(?P<d>[0-9]+)d)?"
+    r"(?:(?P<h>[0-9]+)h)?"
+    r"(?:(?P<m>[0-9]+)m)?"
+    r"(?:(?P<s>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more integer and unit pairs with the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds), such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most once and
+    units must be given in that order, without spaces. Units are
+    case-insensitive.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            parts = match.groupdict()
+
+            try:
+                if parts["total"] is not None:
+                    return timedelta(seconds=int(parts["total"]))
+
+                return timedelta(
+                    days=int(parts["d"] or 0),
+                    hours=int(parts["h"] or 0),
+                    minutes=int(parts["m"] or 0),
+                    seconds=int(parts["s"] or 0),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
