         return "DateTime"
 
 
+# Either a bare number of seconds, or <integer><unit> groups for days,
+# hours, minutes and seconds, each optional but in that order.
+_DURATION_RE = re.compile(
+    r"(?P<bare>\d+)"
+    r"|(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups without spaces, such as
+    ``2d``, ``1h30m`` or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes) and ``s`` (seconds). Each unit may appear at
+    most once, in that order, and units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _DURATION_RE.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, which has no groups.
+        if match is not None and any(match.groups()):
+            days, hours, minutes, seconds, bare = (
+                group or "0"
+                for group in match.group("days", "hours", "minutes", "seconds", "bare")
+            )
+
+            # Too many digits for int() or too large for timedelta.
+            try:
+                return timedelta(
+                    days=int(days),
+                    hours=int(hours),
+                    minutes=int(minutes),
+                    seconds=int(seconds) + int(bare),
+                )
+            except (ValueError, OverflowError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
