+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and units must be given in that order, without
+    spaces. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``45s``, and ``1d2h3m4s`` are all valid.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+")
+    _units_re = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        # ASCII prevents non-ASCII letters, such as "ſ", from case-folding
+        # to a unit.
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                # The pattern also matches the empty string.
+                if value and match is not None:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+            except (ValueError, OverflowError):
+                # The number is too large for int or timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
