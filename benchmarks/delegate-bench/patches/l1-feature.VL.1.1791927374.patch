+# Either a whole number of seconds, or one or more <integer><unit> groups with
+# the units in d, h, m, s order. The lookahead keeps the second alternative from
+# matching the empty string. [0-9] rather than \d excludes non-ASCII digits.
+_duration_re = re.compile(
+    r"(?P<plain_seconds>[0-9]+)"
+    r"|(?=[0-9])"
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``1h30m``. The units are ``d``
+    (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may appear at most once and in that order, without spaces. Units are
+    case-insensitive.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            try:
+                amounts = {unit: int(n) for unit, n in match.groupdict("0").items()}
+                return timedelta(
+                    days=amounts["days"],
+                    hours=amounts["hours"],
+                    minutes=amounts["minutes"],
+                    seconds=amounts["seconds"] + amounts["plain_seconds"],
+                )
+            except (ValueError, OverflowError):
+                # The number has too many digits for int() or is out of the
+                # range timedelta can represent.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
