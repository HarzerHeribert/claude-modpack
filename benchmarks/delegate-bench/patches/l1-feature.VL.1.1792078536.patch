+# Units are optional but must appear in d, h, m, s order. The alternative
+# matches a bare number of seconds.
+_duration_re = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?|([0-9]+)",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more groups of an integer followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), or ``s`` (seconds). Each unit may
+    appear at most once, in that order, without spaces. Units are case
+    insensitive. For example, ``2d``, ``1h30m``, ``90m``, and
+    ``1d2h3m4s`` are valid.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if value and match is not None:
+            try:
+                days, hours, minutes, seconds, bare_seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+                return timedelta(
+                    days=days,
+                    hours=hours,
+                    minutes=minutes,
+                    seconds=seconds + bare_seconds,
+                )
+            except (OverflowError, ValueError):
+                # The number is too large for int() or timedelta.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
