+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit, like ``2d``, ``1h30m``,
+    or ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once, in
+    that order, without spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # Plain seconds, or unit groups in order. The ``(?=[0-9])`` lookahead
+    # stops the all-optional unit groups from matching an empty string.
+    # ``re.ASCII`` keeps ``re.IGNORECASE`` from matching non-ASCII look-alikes
+    # of the units, such as the long s ``ſ`` for ``s``.
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?P<seconds_only>[0-9]+)"
+        r"|(?=[0-9])"
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            amounts = match.groupdict()
+            seconds_only = amounts.pop("seconds_only")
+
+            if seconds_only is not None:
+                amounts["seconds"] = seconds_only
+
+            try:
+                return timedelta(
+                    **{
+                        unit: int(amount)
+                        for unit, amount in amounts.items()
+                        if amount is not None
+                    }
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
