+class Duration(ParamType[timedelta]):
+    """Converts a duration to a :class:`datetime.timedelta`. A value is
+    either a whole number of seconds (``120``) or a combination of
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m`` and
+    ``s``, each at most once and in that order (``1h30m``). Units are
+    case-insensitive. A :class:`~datetime.timedelta` passes through.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", re.IGNORECASE | re.ASCII
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and value:
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(_("{value!r} is not a valid duration.").format(value=value), param, ctx)
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
