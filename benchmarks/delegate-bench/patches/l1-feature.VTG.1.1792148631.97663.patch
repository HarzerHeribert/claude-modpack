+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be given at most once,
+    and they must appear in that order. Units are case-insensitive, and
+    spaces are not allowed.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?"
+        r"(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?"
+        r"(?:(?P<seconds>\d+)s)?",
+        # ASCII prevents non-ASCII digits, and characters such as "ſ" that
+        # case-fold to a unit letter, from matching.
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare whole number is a number of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = self._pattern.fullmatch(text)
+
+            if text and match is not None:
+                amounts = match.groupdict(default="0")
+
+                try:
+                    return timedelta(**{unit: int(n) for unit, n in amounts.items()})
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
