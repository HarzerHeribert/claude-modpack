+# ASCII so that \d only matches 0-9 and the case-insensitive unit letters
+# don't match lookalikes such as "ſ" (long s).
+_DURATION_RE = re.compile(
+    r"(?=\d)(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of a whole number followed by a unit: ``d`` for days, ``h``
+    for hours, ``m`` for minutes and ``s`` for seconds. Each unit may be
+    given at most once and in that order, without spaces, like ``2d``,
+    ``1h30m`` or ``1d2h3m4s``. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            # A bare number is seconds, the same as giving the "s" unit.
+            match = _DURATION_RE.fullmatch(value + "s" if value.isdigit() else value)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict("0").items()
+                        }
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
