+class Duration(ParamType[timedelta]):
+    """Converts a string such as ``90``, ``45s`` or ``1d2h3m4s`` to a
+    :class:`datetime.timedelta`. A bare integer is a number of seconds;
+    otherwise the value is made of ``d``, ``h``, ``m`` and ``s`` groups,
+    each at most once and in that order.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m)?(?:(?P<s>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if re.fullmatch(r"[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match is not None and value:
+                parts = match.groupdict(default="0")
+                return timedelta(
+                    days=int(parts["d"]),
+                    hours=int(parts["h"]),
+                    minutes=int(parts["m"]),
+                    seconds=int(parts["s"]),
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
