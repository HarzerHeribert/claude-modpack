@@ -330,3 +331,65 @@ def test_param_type_subclass_omitting_input_parameter():
     doubling = DoublingType()
     assert doubling("21") == 42
     assert doubling(None) is None
+
+
+@pytest.mark.parametrize(
+    ("value", "seconds"),
+    [
+        ("120", 120),
+        ("0", 0),
+        ("2d", 2 * 86400),
+        ("1h30m", 5400),
+        ("45S", 45),
+        ("1d2h3m4s", 86400 + 7200 + 180 + 4),
+        ("90m", 5400),
+        ("1D2H", 86400 + 7200),
+    ],
+)
+def test_duration_valid(value, seconds):
+    assert click.Duration().convert(value, None, None) == datetime.timedelta(
+        seconds=seconds
+    )
+
+
+def test_duration_timedelta_passthrough():
+    td = datetime.timedelta(minutes=3)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "1.5",
+        "1.5h",
+        "5x",
+        "1s1h",
+        "1h1h",
+        "1h 30m",
+        " 5",
+        "5 ",
+        "h",
+        "5\n",
+        "٣s",
+    ],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_cli_and_metavar():
+    @click.command()
+    @click.option("-d", type=click.Duration())
+    def cli(d):
+        click.echo(repr(d))
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["-d", "1h30m"])
+    assert result.output.strip() == repr(datetime.timedelta(minutes=90))
+    assert "DURATION" in runner.invoke(cli, ["--help"]).output
+    assert click.Duration().name == "duration"
