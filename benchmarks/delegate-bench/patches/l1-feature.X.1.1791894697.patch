+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more ``<integer><unit>`` groups using the units ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear at
+    most once and in that order, with no spaces between groups. Units are
+    case-insensitive. For example ``2d``, ``1h30m``, ``45S``, ``90m``, and
+    ``1d2h3m4s`` are all valid.
+
+    Negative values, decimals, unknown, repeated, or out-of-order units, and
+    spaces are rejected. A :class:`~datetime.timedelta` value is passed through
+    unchanged.
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"\d+", re.ASCII)
+    _units_re = re.compile(
+        r"(?:(?P<days>\d+)d)?"
+        r"(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?"
+        r"(?:(?P<seconds>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                if match is not None:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
