+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into ``timedelta`` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit, like ``1h30m``. The units
+    are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds).
+    Each unit may appear at most once, and units must appear in that order.
+    Units are case-insensitive, and spaces are not allowed.
+
+    Examples of valid values are ``120``, ``2d``, ``1h30m``, ``45S``,
+    ``1d2h3m4s``, and ``90m``.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<seconds_only>[0-9]+)"
+        r"|(?=[0-9])"
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            parts = {
+                unit: int(amount)
+                for unit, amount in match.groupdict().items()
+                if amount is not None
+            }
+
+            if "seconds_only" in parts:
+                parts["seconds"] = parts.pop("seconds_only")
+
+            try:
+                return timedelta(**parts)
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
