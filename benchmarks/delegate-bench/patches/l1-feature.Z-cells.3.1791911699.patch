+# Each unit group is optional, so the empty string also matches and must be
+# rejected separately. ASCII mode keeps "[0-9]" and the case-insensitive unit
+# letters from matching other Unicode characters, such as "\u017f" for "s".
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups, such as ``1h30m``. The units are
+    ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds).
+    Each unit may be given at most once and in that order. Units are
+    case-insensitive, and spaces, signs, and decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            if value.isascii() and value.isdigit():
+                parts = {"seconds": value}
+            elif (match := _duration_re.fullmatch(value)) is not None:
+                parts = match.groupdict(default="0")
+            else:
+                parts = None
+
+            if parts is not None:
+                try:
+                    return timedelta(**{k: int(v) for k, v in parts.items()})
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
