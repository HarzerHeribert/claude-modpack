@@ -579,6 +581,55 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_DURATION_UNITS_RE = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more integers each followed by a unit, such as ``1h30m``. The
+    units are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may be used at most once and they must be given
+    in that order. Units are case-insensitive, and spaces, signs, and
+    decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = _DURATION_UNITS_RE.fullmatch(value)
+
+                if match is not None:
+                    d, h, m, s = (int(g or 0) for g in match.groups())
+                    return timedelta(days=d, hours=h, minutes=m, seconds=s)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
