+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups with the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may be used at most once and units must appear in that order, without
+    spaces. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``45s``, ``1d2h3m4s``, and ``90m`` are all valid.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+")
+    _units_re = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The units pattern matches the empty string, so exclude it here.
+        if isinstance(value, str) and value:
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._units_re.fullmatch(value)
+
+                if match is not None:
+                    days, hours, minutes, seconds = (
+                        int(group or 0) for group in match.groups()
+                    )
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=seconds
+                    )
+            except (OverflowError, ValueError):
+                # The value is too large for timedelta, or has too many
+                # digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
