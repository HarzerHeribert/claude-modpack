@@ -579,6 +581,62 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE | re.ASCII,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    The value is either a whole number of seconds, such as ``120``, or
+    one or more groups of an integer followed by a unit, such as ``2d``
+    or ``1h30m``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once,
+    in that order, without spaces. Units are case-insensitive.
+
+    A ``timedelta`` value is returned unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The empty string matches the pattern with every group omitted.
+        if match is not None and value:
+            try:
+                parts = {k: int(v) for k, v in match.groupdict(0).items()}
+                # At most one of "total" and "seconds" matched.
+                return timedelta(
+                    days=parts["days"],
+                    hours=parts["hours"],
+                    minutes=parts["minutes"],
+                    seconds=parts["seconds"] + parts["total"],
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
