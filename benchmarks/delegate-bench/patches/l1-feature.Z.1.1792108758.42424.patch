+# Either a whole number of seconds, or integer groups with the units d, h, m, s,
+# each at most once and in that order.
+_DURATION_RE = re.compile(
+    r"(?P<plain>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more integer groups with the units ``d`` (days), ``h`` (hours),
+    ``m`` (minutes) and ``s`` (seconds), such as ``2d``, ``1h30m``
+    or ``1d2h3m4s``. Each unit may appear at most once and in that order.
+    Units are case-insensitive. Spaces, signs and decimals are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # An empty string matches the pattern with no groups, so reject it.
+        if isinstance(value, str) and value:
+            match = _DURATION_RE.fullmatch(value)
+
+            if match is not None:
+                parts = match.groupdict()
+
+                try:
+                    return timedelta(
+                        days=int(parts["days"] or 0),
+                        hours=int(parts["hours"] or 0),
+                        minutes=int(parts["minutes"] or 0),
+                        seconds=int(parts["plain"] or parts["seconds"] or 0),
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
