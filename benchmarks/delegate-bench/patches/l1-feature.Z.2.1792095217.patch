+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more integers each followed by a unit, such as ``2d``, ``1h30m``,
+    or ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours),
+    ``m`` (minutes), and ``s`` (seconds). Each unit may be used at most
+    once and units must be given in that order. Units are case-insensitive.
+    Spaces, signs, and decimals are not accepted.
+
+    A ``timedelta`` value, such as a default, is passed through unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, so require a group.
+        if match is not None and any(match.groups()):
+            parts = match.groupdict(default="0")
+
+            try:
+                return timedelta(
+                    days=int(parts["days"]),
+                    hours=int(parts["hours"]),
+                    minutes=int(parts["minutes"]),
+                    seconds=int(parts["seconds"]) + int(parts["bare"]),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
