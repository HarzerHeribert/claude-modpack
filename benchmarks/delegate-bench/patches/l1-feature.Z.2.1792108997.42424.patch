+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups with no spaces between them, such
+    as ``2d``, ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and in that order. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    # ASCII so that only 0-9 are digits and IGNORECASE does not let other
+    # characters fold to a unit, such as "ſ" (long s) to "s".
+    _pattern = re.compile(
+        r"(?P<plain>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # The unit groups are all optional, so the pattern matches an empty
+        # string, which is not a valid duration.
+        match = self._pattern.fullmatch(value) if isinstance(value, str) else None
+
+        if value and match is not None:
+            parts = match.groupdict()
+            plain = parts.pop("plain")
+
+            if plain is not None:
+                parts["seconds"] = plain
+
+            try:
+                return timedelta(
+                    **{unit: int(n) for unit, n in parts.items() if n is not None}
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
