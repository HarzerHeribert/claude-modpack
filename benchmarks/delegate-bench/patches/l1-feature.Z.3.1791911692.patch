+_DURATION_RE = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once and units must be given in that order, without
+    spaces, such as ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are
+    case-insensitive.
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _DURATION_RE.fullmatch(value)
+
+            # Every group is optional, so an empty match is not a duration.
+            if match is not None and any(match.groups()):
+                try:
+                    return timedelta(
+                        days=int(match["days"] or 0),
+                        hours=int(match["hours"] or 0),
+                        minutes=int(match["minutes"] or 0),
+                        seconds=int(match["seconds"] or match["bare"] or 0),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
