+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of a whole number followed by a unit, like ``1h30m``.
+    The units are ``d`` (days), ``h`` (hours), ``m`` (minutes), and
+    ``s`` (seconds). Each unit may be used at most once, in that order,
+    without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            # A bare whole number is a number of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = self._pattern.fullmatch(text)
+
+            if match is not None:
+                units = {k: int(v) for k, v in match.groupdict().items() if v}
+
+                try:
+                    return timedelta(**units)
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
