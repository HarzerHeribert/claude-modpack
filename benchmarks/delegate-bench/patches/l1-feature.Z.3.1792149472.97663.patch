@@ -4,11 +4,13 @@ import abc
 import collections.abc as cabc
 import enum
 import os
+import re
 import stat
 import sys
 import typing as t
 import uuid
 from datetime import datetime
+from datetime import timedelta
 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,67 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"""
+    (?=[0-9])  # Not empty, and starts with a number.
+    (?:
+        (?P<plain_seconds>[0-9]+)
+        |
+        (?:(?P<days>[0-9]+)d)?
+        (?:(?P<hours>[0-9]+)h)?
+        (?:(?P<minutes>[0-9]+)m)?
+        (?:(?P<seconds>[0-9]+)s)?
+    )
+    """,
+    re.ASCII | re.IGNORECASE | re.VERBOSE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups, such as ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may be given at most once
+    and in that order, without spaces. Units are case-insensitive.
+
+    A :class:`~datetime.timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        if match is not None:
+            try:
+                return timedelta(
+                    days=int(match["days"] or 0),
+                    hours=int(match["hours"] or 0),
+                    minutes=int(match["minutes"] or 0),
+                    seconds=int(match["seconds"] or match["plain_seconds"] or 0),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
