+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours),
+    ``m`` (minutes), and ``s`` (seconds). Each unit may be given at most
+    once and in that order, without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _units_re: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def _parse(self, value: str) -> timedelta | None:
+        if value.isascii() and value.isdigit():
+            return timedelta(seconds=int(value))
+
+        match = self._units_re.fullmatch(value)
+
+        # The empty string matches the pattern with every group unset.
+        if match is None or not value:
+            return None
+
+        return timedelta(
+            **{unit: int(n) for unit, n in match.groupdict().items() if n is not None}
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                converted = self._parse(value)
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                converted = None
+
+            if converted is not None:
+                return converted
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
