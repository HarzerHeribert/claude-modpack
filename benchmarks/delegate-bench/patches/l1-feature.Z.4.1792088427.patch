+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more groups of an integer followed by a unit. The units are ``d``
+    (days), ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each
+    unit may appear at most once, in that order, with no spaces between
+    groups. Units are case-insensitive. For example, ``2d``, ``1h30m``,
+    ``45S``, and ``1d2h3m4s`` are all valid.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = self._pattern.fullmatch(value)
+
+                if match is not None and any(match.groups()):
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
