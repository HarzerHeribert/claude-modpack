@@ -579,6 +581,55 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+    r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more groups of an integer followed by a unit, such as ``2d``, ``1h30m``,
+    or ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once, in that
+    order, without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = _duration_re.fullmatch(value)
+
+                if match is not None:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict(default="0").items()}
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
