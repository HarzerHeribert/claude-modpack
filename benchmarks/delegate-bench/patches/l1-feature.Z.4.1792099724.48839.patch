+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may
+    appear at most once, units must appear in that order, and spaces are
+    not allowed. Units are case-insensitive. For example, ``2d``,
+    ``1h30m``, ``45S``, and ``1d2h3m4s`` are valid, while ``1.5h``,
+    ``-5m``, ``30m1h``, and ``1h 30m`` are not.
+
+    A :class:`~datetime.timedelta` value is returned unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern: t.ClassVar[re.Pattern[str]] = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        # ASCII prevents case folding from matching "ſ" or "K" as units.
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # Every group is optional, so the empty string must be rejected here.
+        if isinstance(value, str) and value:
+            # A bare whole number is a number of seconds.
+            text = f"{value}s" if value.isascii() and value.isdigit() else value
+            match = self._pattern.fullmatch(text)
+
+            if match is not None:
+                try:
+                    return timedelta(
+                        **{
+                            unit: int(amount)
+                            for unit, amount in match.groupdict().items()
+                            if amount is not None
+                        }
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
