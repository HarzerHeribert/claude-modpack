+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into `timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more groups of an integer followed by a unit, like ``1h30m``. The units
+    are ``d`` (days), ``h`` (hours), ``m`` (minutes), and ``s``
+    (seconds). Each unit may appear at most once and units must be given in
+    that order. Units are case-insensitive and spaces are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                parts = {"seconds": value}
+            elif (match := self._pattern.fullmatch(value)) is not None:
+                parts = {k: v for k, v in match.groupdict().items() if v is not None}
+            else:
+                parts = {}
+
+            if parts:
+                try:
+                    return timedelta(**{k: int(v) for k, v in parts.items()})
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
