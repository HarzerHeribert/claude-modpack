+_duration_re = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, like ``120``, or one
+    or more groups of a whole number followed by a unit: ``d`` for days,
+    ``h`` for hours, ``m`` for minutes, and ``s`` for seconds. Each unit
+    may be given at most once, in that order, without spaces, like
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            # The empty string matches, but sets no group.
+            if match is not None and match.lastindex is not None:
+                try:
+                    parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                    return timedelta(
+                        days=parts["days"],
+                        hours=parts["hours"],
+                        minutes=parts["minutes"],
+                        seconds=parts["seconds"] + parts["total"],
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
