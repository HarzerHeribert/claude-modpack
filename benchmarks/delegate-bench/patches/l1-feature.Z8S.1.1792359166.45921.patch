@@ -579,6 +581,63 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`datetime.timedelta`.
+
+    The value is either a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), such as
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Each unit may be given at most
+    once, units must appear in that order, and spaces are not allowed.
+    Units are case-insensitive.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            parts: dict[str, str | None]
+
+            if value.isascii() and value.isdigit():
+                parts = {"seconds": value}
+            elif (match := _duration_re.fullmatch(value)) is not None:
+                parts = match.groupdict()
+            else:
+                parts = {}
+
+            try:
+                amounts = {k: int(v) for k, v in parts.items() if v is not None}
+
+                if amounts:
+                    return timedelta(**amounts)
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
