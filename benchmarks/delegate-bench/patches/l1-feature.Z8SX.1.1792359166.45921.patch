@@ -579,6 +581,66 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"""
+    (?P<plain>[0-9]+)
+    |
+    (?:(?P<days>[0-9]+)d)?
+    (?:(?P<hours>[0-9]+)h)?
+    (?:(?P<minutes>[0-9]+)m)?
+    (?:(?P<seconds>[0-9]+)s)?
+    """,
+    re.IGNORECASE | re.VERBOSE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a length of time into a
+    :class:`~datetime.timedelta` object.
+
+    The value is either a whole number of seconds, such as ``120``, or
+    one or more groups of a whole number followed by a unit: ``d`` for
+    days, ``h`` for hours, ``m`` for minutes, and ``s`` for seconds.
+    Each unit may appear at most once, in that order, with no spaces,
+    such as ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            # An empty string matches with every group unset.
+            if match is not None and any(match.groups()):
+                parts = match.groupdict()
+
+                try:
+                    return timedelta(
+                        days=int(parts["days"] or 0),
+                        hours=int(parts["hours"] or 0),
+                        minutes=int(parts["minutes"] or 0),
+                        seconds=int(parts["plain"] or parts["seconds"] or 0),
+                    )
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
