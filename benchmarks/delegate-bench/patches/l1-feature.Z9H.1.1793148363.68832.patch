@@ -579,6 +581,56 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"([0-9]+)|(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into ``datetime.timedelta``
+    objects.
+
+    The value is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours),
+    ``m`` (minutes), and ``s`` (seconds). Each unit may appear at most
+    once, in that order, without spaces. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = _duration_re.fullmatch(value)
+
+            if match is not None and any(match.groups()):
+                plain, days, hours, minutes, seconds = (
+                    int(group or 0) for group in match.groups()
+                )
+
+                try:
+                    return timedelta(
+                        days=days, hours=hours, minutes=minutes, seconds=plain + seconds
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
