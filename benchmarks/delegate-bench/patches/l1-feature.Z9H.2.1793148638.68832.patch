+# A whole number of seconds, or one or more of days, hours, minutes, and
+# seconds, in that order. ASCII mode keeps IGNORECASE from also matching
+# non-ASCII letters that fold to "s", such as "\u017f".
+_DURATION_RE = re.compile(
+    r"(?P<total>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A duration is either a whole number of seconds, such as ``120``, or
+    one or more groups of an integer followed by a unit: ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds). Each unit
+    may appear at most once and in that order, without spaces, such as
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Units are case-insensitive.
+    Values are not normalized, so ``90m`` is valid.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _DURATION_RE.fullmatch(value) if isinstance(value, str) else None
+
+        # The pattern also matches the empty string, which is not valid.
+        if match is not None and value:
+            try:
+                return timedelta(
+                    days=int(match["days"] or 0),
+                    hours=int(match["hours"] or 0),
+                    minutes=int(match["minutes"] or 0),
+                    seconds=int(match["total"] or match["seconds"] or 0),
+                )
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
