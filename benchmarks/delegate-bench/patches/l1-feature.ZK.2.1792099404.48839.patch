+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of a whole number followed by a unit, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be used
+    at most once, units must appear in that order, and units are
+    case-insensitive. Spaces, signs, and decimals are not allowed.
+
+    A ``timedelta`` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?"
+        r"(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?"
+        r"(?:(?P<seconds>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            parts: dict[str, str] = {}
+
+            if value.isascii() and value.isdigit():
+                parts["seconds"] = value
+            elif (match := self._pattern.fullmatch(value)) is not None:
+                # The pattern also matches the empty string, with no groups set.
+                parts = {k: v for k, v in match.groupdict().items() if v is not None}
+
+            if parts:
+                try:
+                    return timedelta(**{k: int(v) for k, v in parts.items()})
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
