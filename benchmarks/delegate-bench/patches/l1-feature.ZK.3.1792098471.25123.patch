+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into ``datetime.timedelta``
+    objects.
+
+    A value is either a whole number of seconds, like ``120``, or one
+    or more ``<integer><unit>`` groups using the units ``d`` (days),
+    ``h`` (hours), ``m`` (minutes), and ``s`` (seconds), like
+    ``2d``, ``1h30m``, or ``1d2h3m4s``. Each unit may appear at most
+    once, units must be in that order, and spaces are not allowed. Units
+    are case-insensitive.
+
+    A ``timedelta`` value is returned unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str) and value:
+            try:
+                if value.isascii() and value.isdigit():
+                    return timedelta(seconds=int(value))
+
+                match = self._pattern.fullmatch(value)
+
+                if match is not None:
+                    return timedelta(
+                        **{k: int(v or 0) for k, v in match.groupdict().items()}
+                    )
+            except (OverflowError, ValueError):
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
