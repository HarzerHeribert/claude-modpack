         return "DateTime"
 
 
+# Every group is optional, so this also matches the empty string. ASCII
+# mode keeps \d to 0-9 and stops IGNORECASE from matching "ſ" as "s".
+_DURATION_RE = re.compile(
+    r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into :class:`~datetime.timedelta`
+    objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more ``<integer><unit>`` groups with no spaces, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be used
+    at most once, the units must appear in that order, and they are
+    case-insensitive. A ``timedelta`` value is returned unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def _try_to_convert_duration(self, value: str) -> timedelta | None:
+        try:
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = _DURATION_RE.fullmatch(value)
+
+            if match is None or not value:
+                return None
+
+            return timedelta(
+                **{unit: int(n) for unit, n in match.groupdict().items() if n}
+            )
+        except (ValueError, OverflowError):
+            # Too many digits for int(), or too large for timedelta.
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            converted = self._try_to_convert_duration(value)
+
+            if converted is not None:
+                return converted
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
