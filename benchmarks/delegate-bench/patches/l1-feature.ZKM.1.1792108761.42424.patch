@@ -579,6 +581,59 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+# Either a bare whole number of seconds, or <integer><unit> groups in d, h, m,
+# s order. re.ASCII keeps IGNORECASE from also matching non-ASCII letters,
+# such as "ſ" (long s) for "s".
+_duration_re = re.compile(
+    r"(?P<bare>[0-9]+)"
+    r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+    re.ASCII | re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`~datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one or
+    more groups of an integer followed by a unit: ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may appear at
+    most once and in that order, with no spaces. Units are case-insensitive.
+    For example, ``2d``, ``1h30m``, ``45S``, and ``90m`` are all valid.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        match = _duration_re.fullmatch(value) if isinstance(value, str) else None
+
+        # The empty string matches too, with every group unset.
+        if match is not None and any(match.groups()):
+            try:
+                bare, days, hours, minutes, seconds = map(int, match.groups("0"))
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=bare + seconds
+                )
+            except (ValueError, OverflowError):
+                # More digits than int() accepts, or out of timedelta's range.
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
