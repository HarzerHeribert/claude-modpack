+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    A value is either a whole number of seconds, such as ``120``, or one
+    or more groups of an integer followed by a unit, such as ``2d``,
+    ``1h30m``, or ``1d2h3m4s``. The units are ``d`` (days), ``h``
+    (hours), ``m`` (minutes), and ``s`` (seconds). Each unit may be used
+    at most once, units must appear in that order, and no spaces are
+    allowed. Units are case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            match = self._pattern.fullmatch(value)
+
+            # The unit groups are all optional, so an empty string matches.
+            if match is not None and any(match.groups()):
+                try:
+                    parts = {k: int(v) for k, v in match.groupdict("0").items()}
+                    parts["seconds"] += parts.pop("bare")
+                    return timedelta(**parts)
+                except (OverflowError, ValueError):
+                    # Too large for timedelta, or too many digits for int.
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
