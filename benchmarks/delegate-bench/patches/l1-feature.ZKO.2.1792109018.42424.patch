 import stat
 import sys
 import typing as t
 import uuid
 from datetime import datetime
+from datetime import timedelta
 from gettext import gettext as _
 from gettext import ngettext
 
@@ -579,6 +581,62 @@ class DateTime(ParamType[datetime]):
         return "DateTime"
 
 
+_duration_re = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?",
+    re.IGNORECASE,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts duration strings into
+    :class:`datetime.timedelta` objects.
+
+    A value is either a whole number of seconds, like ``120``, or one or
+    more ``<integer><unit>`` groups, like ``2d``, ``1h30m``, or
+    ``1d2h3m4s``. The units are ``d`` (days), ``h`` (hours), ``m``
+    (minutes), and ``s`` (seconds). Each unit may appear at most once,
+    and they must appear in that order. Units are case-insensitive, and
+    no spaces are allowed.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                try:
+                    return timedelta(seconds=int(value))
+                except OverflowError:
+                    pass
+
+            match = _duration_re.fullmatch(value)
+
+            if value and match is not None:
+                try:
+                    return timedelta(
+                        **{k: int(v) for k, v in match.groupdict().items() if v}
+                    )
+                except OverflowError:
+                    pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
