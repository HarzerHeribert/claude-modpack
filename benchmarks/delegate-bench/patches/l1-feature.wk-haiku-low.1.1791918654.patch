+class Duration(ParamType[timedelta]):
+    """Convert a duration string into a :class:`datetime.timedelta`.
+
+    Accepted formats are a whole number of seconds (``"120"``), or one or more
+    ``<integer><unit>`` groups where the unit is ``d``, ``h``, ``m`` or ``s``
+    (days, hours, minutes, seconds). Units are case-insensitive, each may appear
+    at most once, and they must appear in that order (e.g. ``"1h30m"``). Spaces
+    and negative or fractional values are not allowed.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _unit_pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if re.fullmatch(r"[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            match = self._unit_pattern.fullmatch(value)
+
+            if match is not None and any(match.groups()):
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
