+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("45s", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+        ("1D2H", timedelta(days=1, hours=2)),
+        ("3h", timedelta(hours=3)),
+        ("10s", timedelta(seconds=10)),
+    ],
+)
+def test_duration_valid(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_timedelta_passthrough():
+    value = timedelta(minutes=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "-5",
+        "-1h",
+        "1.5",
+        "1.5h",
+        "5w",
+        "1h2h",
+        "30m1h",
+        "1s1m",
+        "1h 30m",
+        " 5",
+        "h",
+        "abc",
+    ],
+)
+def test_duration_invalid(value):
+    message = re.escape(f"{value!r} is not a valid duration.")
+    with pytest.raises(click.BadParameter, match=message):
+        click.Duration().convert(value, None, None)
+
+
+def test_duration_option(runner):
+    @click.command()
+    @click.option("--wait", type=click.Duration())
+    def cmd(wait):
+        click.echo(repr(wait))
+
+    result = runner.invoke(cmd, ["--wait", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output.strip() == repr(timedelta(hours=1, minutes=30))
+
+    result = runner.invoke(cmd, ["--help"])
+    assert "DURATION" in result.output
+
+    result = runner.invoke(cmd, ["--wait", "abc"])
+    assert result.exit_code == 2
+    assert "is not a valid duration." in result.output
