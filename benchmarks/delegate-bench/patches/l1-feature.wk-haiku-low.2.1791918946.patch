+class Duration(ParamType[timedelta]):
+    """Convert a duration string to a :class:`datetime.timedelta`.
+
+    Accepts either a whole number of seconds (``"120"``), or one or more
+    ``<integer><unit>`` groups with units ``d``, ``h``, ``m``, ``s`` in that
+    order, each at most once, case-insensitive (``"1h30m"``, ``"2d"``).
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+    )
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value.isascii() and value.isdigit():
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if match and any(match.groups()):
+                days, hours, minutes, seconds = (
+                    int(g) if g is not None else 0 for g in match.groups()
+                )
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(f"{value!r} is not a valid duration.", param, ctx)
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
