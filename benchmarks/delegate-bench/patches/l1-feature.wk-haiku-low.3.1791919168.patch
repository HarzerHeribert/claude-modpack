+class Duration(ParamType[timedelta]):
+    """Convert a duration string to a :class:`datetime.timedelta`.
+
+    Accepts either a whole number of seconds (``"120"``) or one or more
+    ``<integer><unit>`` groups with units ``d``, ``h``, ``m`` and ``s``,
+    each at most once and in that order (``"2d"``, ``"1h30m"``,
+    ``"1d2h3m4s"``). Units are case-insensitive.
+
+    .. versionadded:: 8.5.0
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"[0-9]+", re.ASCII)
+    _groups_re = re.compile(
+        r"(?:[0-9]+d)?(?:[0-9]+h)?(?:[0-9]+m)?(?:[0-9]+s)?", re.ASCII | re.IGNORECASE
+    )
+    _group_re = re.compile(r"([0-9]+)([dhms])", re.ASCII | re.IGNORECASE)
+
+    def convert(
+        self, value: timedelta | str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if self._seconds_re.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            if value and self._groups_re.fullmatch(value):
+                units = {"d": 0, "h": 0, "m": 0, "s": 0}
+
+                for amount, unit in self._group_re.findall(value):
+                    units[unit.lower()] = int(amount)
+
+                return timedelta(
+                    days=units["d"],
+                    hours=units["h"],
+                    minutes=units["m"],
+                    seconds=units["s"],
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
