+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Accepts either a whole number of seconds (``"120"``) or one or more
+    ``<integer><unit>`` groups using the units ``d``, ``h``, ``m``, ``s``,
+    each at most once and in that order (``"1h30m"``). Case-insensitive.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", re.IGNORECASE
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if re.fullmatch(r"[0-9]+", value):
+                return timedelta(seconds=int(value))
+
+            m = self._pattern.fullmatch(value)
+
+            if value and m is not None:
+                d, h, mi, s = (int(g) if g else 0 for g in m.groups())
+                return timedelta(days=d, hours=h, minutes=mi, seconds=s)
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class DateTimeInfoDict(ParamTypeInfoDict):
     formats: cabc.Sequence[str]
 
