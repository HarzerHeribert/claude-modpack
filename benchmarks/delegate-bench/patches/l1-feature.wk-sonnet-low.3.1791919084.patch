+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("120", timedelta(seconds=120)),
+        ("0", timedelta(0)),
+        ("2d", timedelta(days=2)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("45S", timedelta(seconds=45)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("90m", timedelta(minutes=90)),
+    ],
+)
+def test_duration_valid(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_duration_passthrough():
+    td = timedelta(seconds=5)
+    assert click.Duration().convert(td, None, None) is td
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "", "-5", "-1h", "1.5h", "1.5", "5x", "abc", "1h1h", "30m1h", "1h 30m",
+        " 1h", "1h ", "h", "1hm", "1h\n", "١٢", "١h", 120, object(),
+    ],
+)  # fmt: skip
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_overflow():
+    with pytest.raises(click.BadParameter, match="is not a valid duration"):
+        click.Duration().convert("999999999999999d", None, None)
+
+
+def test_duration_cli_and_help(runner):
+    @click.command()
+    @click.option("--t", type=click.Duration())
+    def cli(t):
+        click.echo(repr(t))
+
+    result = runner.invoke(cli, ["--t", "1x"])
+    assert result.exit_code == 2
+    assert "'1x' is not a valid duration." in result.output
+    assert "DURATION" in runner.invoke(cli, ["--help"]).output
