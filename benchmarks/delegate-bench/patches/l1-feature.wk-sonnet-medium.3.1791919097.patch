+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Accepted formats are a whole number of seconds, such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d``, ``h``,
+    ``m`` and ``s`` (days, hours, minutes, seconds). Each unit may appear
+    at most once and they must be in that order, with no spaces. Units are
+    case-insensitive. Examples: ``2d``, ``1h30m``, ``45S``, ``1d2h3m4s``.
+
+    An existing `timedelta` is passed through unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+    _seconds_pattern = re.compile(r"[0-9]+")
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if self._seconds_pattern.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            # An empty string matches the pattern but has no groups.
+            if match is not None and value:
+                return timedelta(
+                    **{k: int(v) for k, v in match.groupdict().items() if v}
+                )
+
+        self.fail(f"{value!r} is not a valid duration.", param, ctx)
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
