+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Two formats are accepted, case-insensitively and without spaces:
+
+    -   A whole number of seconds, such as ``120``.
+    -   One or more ``<integer><unit>`` groups using the units ``d``, ``h``,
+        ``m`` and ``s``, each at most once and in that order, such as ``2d``,
+        ``1h30m`` or ``1d2h3m4s``.
+
+    An existing `timedelta` is returned unchanged.
+    """
+
+    name = "duration"
+
+    _seconds_re = re.compile(r"\d+", re.ASCII)
+    _groups_re = re.compile(
+        r"(?:(?P<days>\d+)d)?(?:(?P<hours>\d+)h)?"
+        r"(?:(?P<minutes>\d+)m)?(?:(?P<seconds>\d+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            try:
+                if self._seconds_re.fullmatch(value):
+                    return timedelta(seconds=int(value))
+
+                match = self._groups_re.fullmatch(value)
+
+                if match is not None and any(v is not None for v in match.groups()):
+                    parts = match.groupdict()
+                    return timedelta(**{k: int(v) for k, v in parts.items() if v})
+            except (OverflowError, ValueError):
+                # Too large for timedelta, or too many digits for int().
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
