+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `timedelta` objects.
+
+    Accepted values are a whole number of seconds such as ``120``, or
+    one or more ``<integer><unit>`` groups using the units ``d``, ``h``,
+    ``m`` and ``s``, each at most once and in that order, such as
+    ``1h30m``. Units are case-insensitive and spaces are not allowed.
+    A `timedelta` is returned unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if re.fullmatch(r"[0-9]+", value):
+                try:
+                    return timedelta(seconds=int(value))
+                except OverflowError:
+                    pass
+            else:
+                match = self._pattern.fullmatch(value)
+
+                if match is not None and any(match.groups()):
+                    try:
+                        return timedelta(
+                            **{k: int(v) for k, v in match.groupdict().items() if v}
+                        )
+                    except OverflowError:
+                        pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
