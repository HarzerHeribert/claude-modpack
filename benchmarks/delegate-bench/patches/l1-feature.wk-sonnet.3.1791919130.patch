+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings into `datetime.timedelta` objects.
+
+    Two formats are accepted, case-insensitively and without spaces:
+
+    -   A whole number of seconds, such as ``120``.
+    -   One or more ``<integer><unit>`` groups using the units ``d``, ``h``,
+        ``m`` and ``s``. Each unit may appear at most once and they must be
+        given in that order, such as ``2d``, ``1h30m`` or ``1d2h3m4s``.
+
+    A `timedelta` value is passed through unchanged.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?",
+        re.IGNORECASE,
+    )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, str):
+            if value and all(c in "0123456789" for c in value):
+                return timedelta(seconds=int(value))
+
+            match = self._pattern.fullmatch(value)
+
+            if value and match is not None:
+                days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+                return timedelta(
+                    days=days, hours=hours, minutes=minutes, seconds=seconds
+                )
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
