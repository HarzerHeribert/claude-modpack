+def test_get_text_stream():
+    runner = CliRunner()
+    with runner.isolation() as (out, _, _):
+        stream = _get_text_stream("stdout", encoding="utf-8")
+        stream.write("hello")
+        stream.flush()
+        assert out.getvalue() == b"hello"
+
