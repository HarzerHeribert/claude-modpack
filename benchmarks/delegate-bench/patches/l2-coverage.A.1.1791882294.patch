+class _NoEmptyWrites:
+    """A stream that rejects empty writes of any type, so it isn't detected as
+    either text or binary, but accepts any non-empty data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _NoEmptyWrites()
+    click.echo(b"hello", file=stream)
+    assert stream.data == [b"hello\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    import io
+
+    stream = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=stream, nl=False)
+    assert stream.getvalue() == b"abc"
+
