+class TestKeepOpenFile:
+    def test_repr_and_getattr(self, tmp_path):
+        path = tmp_path / "f.txt"
+        path.write_text("content")
+
+        with open(path) as f:
+            kf = _KeepOpenFile(f)
+            assert repr(kf) == repr(f)
+            assert kf.name == f.name
+
+            with kf as entered:
+                assert entered is kf
+                assert entered.read() == "content"
+
+            # Leaving the block does not close the file.
+            assert not f.closed
+            # An explicit close is passed through.
+            kf.close()
+            assert f.closed
+
