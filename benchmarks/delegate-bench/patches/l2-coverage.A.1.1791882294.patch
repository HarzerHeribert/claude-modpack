+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "x.txt").write_text("")
+    (tmp_path / "y.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=False)) == [
+        os.path.join("a", "x.txt")
+    ]
+    assert sorted(_expand_args(["**/*.txt"])) == [os.path.join("a", "x.txt"), "y.txt"]
