+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "<stream>"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+class TestPacifyFlushWrapper:
+    def test_flush(self):
+        stream = _FlushStream()
+        wrapper = _PacifyFlushWrapper(stream)
+        wrapper.flush()
+        assert stream.flushed
+
+    def test_getattr_proxies(self):
+        stream = _FlushStream()
+        assert _PacifyFlushWrapper(stream).name == "<stream>"
+
+    def test_broken_pipe_suppressed(self):
+        wrapper = _PacifyFlushWrapper(_FlushStream(BrokenPipeError(errno.EPIPE, "x")))
+        wrapper.flush()
+
+    def test_other_error_raised(self):
+        wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io error")))
+
+        with pytest.raises(OSError) as exc_info:
+            wrapper.flush()
+
+        assert exc_info.value.errno == errno.EIO
+
