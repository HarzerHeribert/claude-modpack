+class TestLazyFile:
+    def test_repr_unopened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{path}' w>"
+        assert not path.exists()
+
+    def test_repr_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        f = lf.open()
+        try:
+            assert repr(lf) == repr(f)
+            # Opening again returns the same file.
+            assert lf.open() is f
+        finally:
+            lf.close()
+
+    def test_write_and_context_manager(self, tmp_path):
+        path = tmp_path / "out.txt"
+        with _LazyFile(path, "w") as lf:
+            lf.write("hello")
+        assert path.read_text() == "hello"
+
+    def test_read_checks_file_early(self, tmp_path):
+        with pytest.raises(OSError):
+            _LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_read_iter(self, tmp_path):
+        path = tmp_path / "in.txt"
+        path.write_text("a\nb\n")
+        lf = _LazyFile(path, "r")
+        try:
+            assert list(lf) == ["a\n", "b\n"]
+        finally:
+            lf.close()
+
+    def test_close_unopened(self, tmp_path):
+        lf = _LazyFile(tmp_path / "out.txt", "w")
+        # Nothing was opened, closing does nothing.
+        lf.close()
+        lf.close_intelligently()
+        assert lf._f is None
+
+    def test_open_error_raises_file_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "missing_dir" / "out.txt", "w")
+        with pytest.raises(click.FileError) as exc_info:
+            lf.open()
+        assert "missing_dir" in exc_info.value.ui_filename
+
+    def test_atomic(self, tmp_path):
+        path = tmp_path / "out.txt"
+        path.write_text("old")
+        lf = _LazyFile(path, "w", atomic=True)
+        lf.write("new")
+        assert path.read_text() == "old"
+        lf.close()
+        assert path.read_text() == "new"
+
+    @pytest.mark.parametrize("mode", ["r", "w"])
+    def test_dash_uses_standard_stream(self, mode):
+        runner = CliRunner()
+        with runner.isolation(input="data") as (out, _, _):
+            lf = _LazyFile("-", mode)
+            assert lf._f is not None
+            assert not lf.should_close
+            # The standard stream is not closed when leaving the block.
+            with lf:
+                pass
+            assert not lf._f.closed
+            assert repr(lf) == repr(lf._f)
+
+            if mode == "r":
+                assert lf.read() == "data"
+            else:
+                lf.write("hello")
+                lf.flush()
+                assert out.getvalue() == b"hello"
+
