+class TestGetAppDir:
+    @pytest.mark.parametrize(
+        ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+    )
+    def test_windows(self, monkeypatch, roaming, key):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv(key, os.path.join("base", key))
+        assert click.get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+            "base", key, "Foo Bar"
+        )
+
+    def test_windows_no_env(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.delenv("APPDATA", raising=False)
+        assert click.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~"), "Foo Bar"
+        )
+
+    def test_force_posix(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        assert click.get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser(
+            "~/.foo-bar"
+        )
+
+    def test_darwin(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "darwin")
+        assert click.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+        )
+
+    def test_linux_xdg(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.setenv("XDG_CONFIG_HOME", os.path.join("xdg", "config"))
+        assert click.get_app_dir("Foo Bar") == os.path.join(
+            "xdg", "config", "foo-bar"
+        )
+
+    def test_linux_default(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+        assert click.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/.config"), "foo-bar"
+        )
