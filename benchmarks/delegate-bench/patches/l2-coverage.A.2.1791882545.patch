+class _TextOnlyWriter:
+    """A stream that rejects empty bytes probes but stores anything else,
+    so ``_find_binary_writer`` does not find a binary writer.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("not binary")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_no_binary_writer():
+    stream = _TextOnlyWriter()
+    click.echo(b"data", file=stream)
+    assert stream.data == ["", b"data\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytes_binary_writer():
+    stream = io.BytesIO()
+    click.echo(b"data", file=stream)
+    click.echo(bytearray(b"more"), file=stream, nl=False)
+    assert stream.getvalue() == b"data\nmore"
+
+
+def test_echo_empty_flushes():
+    stream = _TextOnlyWriter()
+    click.echo(None, file=stream, nl=False)
+    assert stream.data == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_and_color():
+    stream = io.StringIO()
+    click.echo(123, file=stream)
+    click.echo(click.style("x", fg="red"), file=stream, color=True)
+    click.echo(click.style("y", fg="red"), file=stream)
+    assert stream.getvalue() == f"123\n{click.style('x', fg='red')}\ny\n"
+
