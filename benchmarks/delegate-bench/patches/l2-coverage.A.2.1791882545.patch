+def test_open_file_dash_keeps_open():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _, _):
+        f = click.open_file("-", "w")
+        assert isinstance(f, click.utils._KeepOpenFile)
+
+        with f:
+            f.write("dash")
+            f.flush()
+
+        assert not f.closed
+
