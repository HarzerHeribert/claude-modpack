+def test_keep_open_file_proxy(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("content")
+
+    with open(path) as raw:
+        kof = click.utils._KeepOpenFile(raw)
+        assert repr(kof) == repr(raw)
+        assert kof.name == raw.name
+
+        with kof as f:
+            assert f is kof
+            assert f.read() == "content"
+
+        assert not raw.closed
