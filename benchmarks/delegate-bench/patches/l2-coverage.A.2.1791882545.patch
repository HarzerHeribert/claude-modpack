+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "fake"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_ok():
+    wrapped = _FlushRaiser()
+    wrapper = click.utils._PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapped.flushed
+    assert wrapper.name == "fake"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = _FlushRaiser(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
