+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(name):
+    runner = CliRunner()
+
+    with runner.isolation(input=b"in") as (out, err, _):
+        stream = click.utils._get_binary_stream(name)
+
+        if name == "stdin":
+            assert stream.read() == b"in"
+        else:
+            stream.write(b"x")
+            stream.flush()
+
+    if name != "stdin":
+        assert (out if name == "stdout" else err).getvalue() == b"x"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        click.utils._get_binary_stream("bad")
+
