+def test_expand_args_glob_not_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert click.utils._expand_args(["**/*.txt"], glob_recursive=True) == [
+        os.path.join("sub", "a.txt")
+    ]
+    assert click.utils._expand_args(["*.txt"], glob_recursive=False) == ["*.txt"]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
