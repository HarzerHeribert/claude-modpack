+class _TextOnlyProbeWriter:
+    """Rejects the empty bytes probe used to detect binary streams, but
+    otherwise accepts anything written to it. Empty probe writes are not
+    recorded.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("no binary probe")
+
+        if value:
+            self.written.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyProbeWriter()
+    click.echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    f = io.BytesIO()
+    click.echo(bytearray(b"hello"), file=f, nl=False)
+    assert f.getvalue() == b"hello"
+
+
+def test_echo_no_message_no_newline_flushes_only():
+    f = _TextOnlyProbeWriter()
+    click.echo(file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
