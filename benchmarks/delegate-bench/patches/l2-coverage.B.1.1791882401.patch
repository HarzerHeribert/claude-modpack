+def test_detect_program_name_defaults_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_defaults_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(
+        sys, "argv", [os.path.join("site-packages", "example", "cli.py")]
+    )
+    assert click.utils._detect_program_name() == "python -m example.cli"
+
