+def test_format_filename():
+    assert utils.format_filename("/a/b/c.txt") == "/a/b/c.txt"
+    assert utils.format_filename("/a/b/c.txt", shorten=True) == "c.txt"
+    assert utils.format_filename(b"/a/b/c.txt", shorten=True) == "c.txt"
+    assert utils.format_filename("bad\udcff") == "bad�"
+
