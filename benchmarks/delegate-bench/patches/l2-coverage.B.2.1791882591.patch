+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = utils._safecall(add)
+    assert wrapped(1, 2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert utils._safecall(fail)() is None
+
+
+def test_make_str_bytes():
+    assert utils.make_str(b"hello") == "hello"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    # Falls back to UTF-8, replacing anything that is still invalid.
+    assert utils.make_str(b"caf\xc3\xa9") == "caf\xe9"
+    assert utils.make_str(b"bad\xff") == "bad�"
+
+
+def test_make_str_other():
+    assert utils.make_str(42) == "42"
+    assert utils.make_str("text") == "text"
+
+
+def test_make_default_short_help_exact_length_not_last_word():
+    # The first word fills max_length exactly but more words follow, so
+    # the help is truncated with "..." and no words fit.
+    assert utils._make_default_short_help("abcde fgh", max_length=5) == "..."
+
+
+def test_make_default_short_help_exact_length_last_word():
+    assert utils._make_default_short_help("abc de", max_length=6) == "abc de"
+
+
+def test_lazy_file_dash_stream(capsys):
+    lf = utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Closing intelligently must not close stdout.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    # Opening again returns the already opened file.
+    assert lf.open() is lf._f
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_error(tmp_path):
+    path = tmp_path / "missing" / "out.txt"
+    lf = utils._LazyFile(path, "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+    # Closing a file that was never opened does nothing.
+    lf.close()
+
+
+def test_lazy_file_read_mode_checks_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_keep_open_file_repr_and_close():
+    f = io.StringIO("a\nb\n")
+    kf = utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as inner:
+        assert inner is kf
+        assert list(kf) == ["a\n", "b\n"]
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_open(capsys):
+    with utils.open_file("-", "w") as f:
+        assert isinstance(f, utils._KeepOpenFile)
+        f.write("out")
+        f.flush()
+
+    assert not f.closed
+    assert capsys.readouterr().out == "out"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+
+    with utils.open_file(path, "w") as f:
+        assert not isinstance(f, utils._KeepOpenFile)
+        f.write("plain")
+
+    assert path.read_text() == "plain"
+
