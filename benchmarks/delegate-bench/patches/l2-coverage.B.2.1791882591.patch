+class _TextOnlyBytesSink:
+    """A file-like object that is not detected as a binary writer, but
+    still accepts non-empty bytes when written directly.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    sink = _TextOnlyBytesSink()
+    utils.echo(b"raw", file=sink)
+    assert sink.data == [b"raw\n"]
+    assert sink.flushed == 1
+
+
+def test_echo_bytearray_to_binary():
+    out = io.BytesIO()
+    utils.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_object_and_none():
+    out = io.StringIO()
+    utils.echo(123, file=out)
+    utils.echo(None, file=out)
+    utils.echo(None, file=out, nl=False)
+    assert out.getvalue() == "123\n\n"
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(utils, "_default_text_stderr", lambda: None)
+    utils.echo("nothing")
+    utils.echo("nothing", err=True)
+
+
+def test_echo_strips_ansi_and_keeps_color():
+    out = io.StringIO()
+    utils.echo("\x1b[31mred\x1b[0m", file=out)
+    assert out.getvalue() == "red\n"
+
+    out = io.StringIO()
+    utils.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "\x1b[31mred\x1b[0m\n"
+
