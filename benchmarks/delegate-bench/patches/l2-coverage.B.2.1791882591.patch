+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(monkeypatch, name):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, name, io.TextIOWrapper(buffer))
+    assert utils._get_binary_stream(name) is buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        utils._get_binary_stream("bogus")
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(monkeypatch, name):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, name, io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = utils._get_text_stream(name, encoding="utf-8")
+    stream.write("hi")
+    stream.flush()
+    assert buffer.getvalue() == b"hi"
+
+
+def test_get_text_stream_stdin(monkeypatch):
+    buffer = io.BytesIO(b"input\n")
+    monkeypatch.setattr(sys, "stdin", io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = utils._get_text_stream("stdin", encoding="utf-8")
+    assert stream.read() == "input\n"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        utils._get_text_stream("bogus")
+
