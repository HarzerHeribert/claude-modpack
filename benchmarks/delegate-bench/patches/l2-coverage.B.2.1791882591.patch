+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    wrapper = utils._PacifyFlushWrapper(_FlushRaises(None))
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = utils._PacifyFlushWrapper(
+        _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/my-app", "--flag"])
+    assert utils._detect_program_name() == "my-app"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert utils._expand_args(["[bad"]) == ["[bad"]
+
