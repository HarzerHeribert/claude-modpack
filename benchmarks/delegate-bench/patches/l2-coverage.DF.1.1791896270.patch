+class TestLazyFile:
+    def test_repr_unopened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        assert lf._f is None
+        assert lf.should_close
+        # Closing an unopened file does nothing.
+        lf.close()
+        assert not path.exists()
+
+    def test_repr_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        f = lf.open()
+        # Opening again returns the same object.
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+        lf.write("hello")
+        lf.close_intelligently()
+        assert f.closed
+        assert path.read_text() == "hello"
+
+    def test_dash_uses_stdout(self, capsys):
+        lf = _LazyFile("-", "w")
+        assert lf._f is not None
+        assert not lf.should_close
+        lf.write("hi")
+        lf.flush()
+        # Does not close stdout.
+        lf.close_intelligently()
+
+        with lf as entered:
+            assert entered is lf
+
+        assert not lf._f.closed
+        assert capsys.readouterr().out == "hi"
+
+    def test_read_checks_file_early(self, tmp_path):
+        with pytest.raises(OSError):
+            _LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "missing-dir" / "out.txt", "w")
+
+        with pytest.raises(click.FileError):
+            lf.open()
+
+    def test_context_manager_closes(self, tmp_path):
+        path = tmp_path / "data.txt"
+        path.write_text("a\nb\n")
+
+        with _LazyFile(path, "r") as lf:
+            assert list(lf) == ["a\n", "b\n"]
+            f = lf._f
+
+        assert f.closed
+
