+class TestDetectProgramName:
+    def test_defaults_from_sys(self, monkeypatch):
+        main = types.ModuleType("__main__")
+        main.__package__ = None
+        monkeypatch.setitem(sys.modules, "__main__", main)
+        monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+        assert _detect_program_name() == "app.py"
+
+    def test_module_from_sys_argv(self, monkeypatch):
+        main = types.ModuleType("__main__")
+        main.__package__ = "pkg"
+        monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "__main__.py")])
+        assert _detect_program_name("", _main=main) == "python -m pkg"
+
+    def test_relative_package(self):
+        main = types.ModuleType("__main__")
+        main.__package__ = ".pkg"
+        assert (
+            _detect_program_name(os.path.join("pkg", "cli.py"), _main=main)
+            == "python -m pkg.cli"
+        )
+
