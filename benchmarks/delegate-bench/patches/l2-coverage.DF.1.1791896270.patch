+class TestExpandArgs:
+    def test_no_user_no_env(self, monkeypatch):
+        monkeypatch.setenv("CLICK_TEST_VAR", "value")
+        assert _expand_args(["~", "$CLICK_TEST_VAR"], user=False, env=False) == [
+            "~",
+            "$CLICK_TEST_VAR",
+        ]
+
+    def test_glob_re_error(self, monkeypatch):
+        def bad_glob(pattern, recursive=False):
+            raise re.error("bad pattern")
+
+        monkeypatch.setattr(glob, "glob", bad_glob)
+        assert _expand_args(["[bad"]) == ["[bad"]
+
+    def test_glob_matches(self, tmp_path, monkeypatch):
+        (tmp_path / "a.txt").touch()
+        (tmp_path / "b.txt").touch()
+        monkeypatch.chdir(tmp_path)
+        assert sorted(_expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+
+    def test_glob_not_recursive(self, tmp_path, monkeypatch):
+        sub = tmp_path / "sub"
+        sub.mkdir()
+        (sub / "c.txt").touch()
+        monkeypatch.chdir(tmp_path)
+        assert _expand_args(["**/c.txt"], glob_recursive=False) == [
+            os.path.join("sub", "c.txt")
+        ]
