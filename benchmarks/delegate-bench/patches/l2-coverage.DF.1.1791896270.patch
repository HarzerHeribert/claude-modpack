+class TestGetAppDir:
+    def test_windows_roaming(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv("APPDATA", "/roaming")
+        assert get_app_dir("Foo Bar") == os.path.join("/roaming", "Foo Bar")
+
+    def test_windows_local(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv("LOCALAPPDATA", "/local")
+        assert get_app_dir("Foo Bar", roaming=False) == os.path.join(
+            "/local", "Foo Bar"
+        )
+
+    def test_windows_no_env(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.delenv("APPDATA", raising=False)
+        assert get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~"), "Foo Bar"
+        )
+
+    def test_force_posix(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        assert get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser(
+            "~/.foo-bar"
+        )
+
+    def test_darwin(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "darwin")
+        assert get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+        )
+
+    def test_xdg(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.setenv("XDG_CONFIG_HOME", "/xdg")
+        assert get_app_dir("Foo Bar") == os.path.join("/xdg", "foo-bar")
+
+    def test_linux_default(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+        assert get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/.config"), "foo-bar"
+        )
