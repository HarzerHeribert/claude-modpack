+class _BytesOnlyIfNonEmpty:
+    """A stream that rejects the empty bytes probe used to detect a
+    binary writer, and has no ``buffer``, but still accepts writes.
+    """
+
+    def __init__(self):
+        self.parts = []
+        self.flushed = 0
+
+    def write(self, data):
+        if isinstance(data, (bytes, bytearray)) and not data:
+            raise TypeError("probe rejected")
+
+        if data:
+            self.parts.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _BytesOnlyIfNonEmpty()
+    click.echo(b"data", file=stream)
+    assert stream.parts == [b"data\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytes_to_binary_stream():
+    stream = io.BytesIO()
+    click.echo(bytearray(b"x"), file=stream, nl=False)
+    assert stream.getvalue() == b"x"
+
+
+def test_echo_empty_flushes_only():
+    stream = _BytesOnlyIfNonEmpty()
+    click.echo("", file=stream, nl=False)
+    assert stream.parts == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_and_color():
+    stream = io.StringIO()
+    click.echo(123, file=stream)
+    click.echo("\x1b[31mred\x1b[0m", file=stream, color=False)
+    click.echo("\x1b[31mred\x1b[0m", file=stream, color=True, nl=False)
+    assert stream.getvalue() == "123\nred\n\x1b[31mred\x1b[0m"
+
