+class TestKeepOpenFile:
+    def test_repr_and_proxy(self):
+        f = io.StringIO("data")
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+        assert kf.read() == "data"
+
+    def test_with_does_not_close(self):
+        f = io.StringIO("a\nb\n")
+
+        with _KeepOpenFile(f) as kf:
+            assert list(kf) == ["a\n", "b\n"]
+
+        assert not f.closed
+        kf.close()
+        assert f.closed
