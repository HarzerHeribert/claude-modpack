+class _FlushRaises:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.err is not None:
+            raise self.err
+
+
+class TestPacifyFlushWrapper:
+    def test_flush_ok(self):
+        stream = io.StringIO()
+        w = _PacifyFlushWrapper(stream)
+        w.flush()
+        w.write("x")
+        assert stream.getvalue() == "x"
+
+    def test_epipe_suppressed(self):
+        w = _PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "pipe")))
+        w.flush()
+        assert w.name == "wrapped"
+
+    def test_other_oserror_raised(self):
+        w = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+
+        with pytest.raises(OSError) as exc_info:
+            w.flush()
+
+        assert exc_info.value.errno == errno.EIO
+
