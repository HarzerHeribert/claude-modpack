+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hits max_length before the last word.
+        ("ab cd ef", 5, "ab..."),
+        # The first word alone is already too long.
+        ("abcdefghij", 5, "..."),
+        # Exactly hits max_length on the first word with more following.
+        ("abcde fgh", 5, "..."),
+        # Exactly hits max_length on the last word, no truncation.
+        ("ab cd", 5, "ab cd"),
+        # Sentence end before the limit.
+        ("Hello. World is big", 45, "Hello."),
+        # No-rewrap marker is dropped.
+        ("\b\nsome words", 45, "some words"),
+        # Only the first paragraph is considered.
+        ("first para\n\nsecond para", 45, "first para"),
+        ("   ", 45, ""),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
