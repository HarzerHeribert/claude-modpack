+class _FlushRaises:
+    def __init__(self, err=None):
+        self.err = err
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.err is not None:
+            raise self.err
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRaises()
+    w = click.utils._PacifyFlushWrapper(wrapped)
+    assert w.wrapped is wrapped
+    w.flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    w = click.utils._PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "")))
+    w.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    w = click.utils._PacifyFlushWrapper(_FlushRaises(OSError(errno.EBADF, "bad")))
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_getattr():
+    w = click.utils._PacifyFlushWrapper(_FlushRaises())
+    assert w.name == "wrapped"
+
+    with pytest.raises(AttributeError):
+        w.missing  # noqa: B018
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_package(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "__main__.py")])
+    assert click.utils._detect_program_name(_main=main) == "python -m example"
+
