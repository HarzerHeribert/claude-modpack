+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+from click.exceptions import FileError
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+        ("café".encode(sys.getfilesystemencoding()), "café"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"a\xffb") == "a�b"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches exactly max_length before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long.
+        ("abcdefghij klm", 5, "..."),
+        # Only whitespace.
+        (" \n\t ", 45, ""),
+        # Only the "no rewrap" marker.
+        ("\b", 45, ""),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazyfile_stdout(capsys):
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    assert lf.should_close is False
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazyfile_repr_and_close(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    # Closing an unopened file is a no-op.
+    lf.close()
+    assert lf._f is None
+
+    f = lf.open()
+    # Opening again returns the same file.
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("data")
+    lf.close_intelligently()
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keepopenfile_proxy():
+    f = io.StringIO()
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as inner:
+        assert inner is kf
+        inner.write("abc")
+
+    assert not f.closed
+    assert f.getvalue() == "abc"
+    kf.close()
+    assert f.closed
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text-only stream without a binary buffer can't accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(b"data", file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_bytearray_no_newline():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_object_and_empty():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    click.echo(file=out, nl=False)
+    assert out.getvalue() == "123\n"
+
+
+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(name):
+    assert click.utils._get_binary_stream(name) is not None
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(name):
+    stream = click.utils._get_text_stream(name)
+    assert stream is not None
+    assert hasattr(stream, "write")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    # The file isn't created until it's accessed.
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils.open_file(path, "w") as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        f.write("eager")
+
+    assert path.read_text() == "eager"
+
+
+def test_open_file_stdout_keep_open(capsys):
+    with click.utils.open_file("-", "w") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        f.write("out")
+        f.flush()
+
+    assert not f.closed
+    assert capsys.readouterr().out == "out"
+
