+class _BytesOnlyWriter:
+    """A stream that rejects empty probe writes, so echo can't find a
+    binary writer, but still accepts real bytes."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = False
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+        self.data.append(data)
+        return len(data)
+
+    def flush(self):
+        self.flushed = True
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _BytesOnlyWriter()
+    echo(b"hello", file=t.cast(t.IO[t.Any], f))
+
+    assert f.data == [b"hello\n"]
+    assert f.flushed
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")  # type: ignore[arg-type]
+
+
+def test_get_text_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert _get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")  # type: ignore[arg-type]
+
