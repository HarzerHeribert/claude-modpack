+
+def test_safecall_returns_result():
+    assert _safecall(lambda a, b=0: a + b)(1, b=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_make_str_non_bytes():
+    assert make_str(42) == "42"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+def test_short_help_exact_length_not_last_word():
+    # "aaaaa bbbb" fills the limit exactly but more words follow.
+    assert _make_default_short_help("aaaaa bbbb cc", 10) == "aaaaa..."
+
+
+def test_short_help_single_long_word():
+    assert _make_default_short_help("abcdefghijklmnop", 5) == "..."
+
+
+def test_lazyfile_dash_uses_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = _LazyFile("-", "w")
+
+    assert lf._f is stream
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+
+    lf.close_intelligently()
+    assert not stream.closed
+
+
+def test_lazyfile_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+
+def test_keepopenfile_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
