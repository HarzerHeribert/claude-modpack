+class _FailingFlush:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        raise self.err
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    failing = _FailingFlush(OSError(errno.EPIPE, "pipe"))
+    wrapper = _PacifyFlushWrapper(t.cast(t.IO[t.Any], failing))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    failing = _FailingFlush(OSError(errno.EIO, "io"))
+    wrapper = _PacifyFlushWrapper(t.cast(t.IO[t.Any], failing))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_flushes_and_proxies():
+    stream = io.StringIO()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    wrapper.write("text")
+
+    assert wrapper.wrapped is stream
+    assert stream.getvalue() == "text"
+
