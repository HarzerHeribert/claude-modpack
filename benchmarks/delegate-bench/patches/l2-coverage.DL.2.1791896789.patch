+class _FlushRaises:
+    def __init__(self, exc: Exception | None = None) -> None:
+        self.exc = exc
+        self.flushed = False
+        self.written = []
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+    def write(self, value):
+        self.written.append(value)
+
+
+def _pacify(inner: _FlushRaises) -> _PacifyFlushWrapper:
+    return _PacifyFlushWrapper(t.cast("t.IO[t.Any]", inner))
+
+
+def test_pacify_flush_wrapper_flushes():
+    inner = _FlushRaises()
+    _pacify(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    _pacify(inner).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _pacify(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    inner = _FlushRaises()
+    wrapper = _pacify(inner)
+    wrapper.write("x")
+    assert inner.written == ["x"]
+    assert wrapper.wrapped is inner
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_expand_args_without_user_or_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
