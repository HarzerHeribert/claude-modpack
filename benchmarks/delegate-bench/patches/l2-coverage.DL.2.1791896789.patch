+def test_echo_bytes_without_binary_writer():
+    class PickyWriter:
+        """Rejects the empty probe writes used to detect a binary writer,
+        so no binary stream is found and bytes are written directly.
+        """
+
+        def __init__(self):
+            self.data = []
+
+        def write(self, value):
+            if not value:
+                raise ValueError("empty write")
+
+            self.data.append(value)
+
+        def flush(self):
+            pass
+
+    out = PickyWriter()
+    echo(b"hi", file=t.cast("t.IO[t.Any]", out))
+    assert out.data == [b"hi\n"]
+
