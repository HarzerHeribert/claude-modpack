+def test_get_text_stream(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    assert _get_text_stream("stdout") is fake_stdout
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")  # type: ignore[arg-type]
+
+
+def test_deprecated_get_text_stream_alias():
+    with pytest.deprecated_call():
+        func = click.utils.get_text_stream
+
+    assert func is _get_text_stream
+
