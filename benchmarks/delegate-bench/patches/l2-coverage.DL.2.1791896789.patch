+def _fake_stdout(monkeypatch: pytest.MonkeyPatch) -> io.TextIOWrapper:
+    """Replace ``sys.stdout`` with an in-memory, correctly configured text
+    stream so stream lookups are deterministic regardless of capture mode.
+
+    Must be called from the test body, not a fixture: pytest's capture
+    reinstalls its own ``sys.stdout`` when the test call phase starts.
+    """
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    def boom():
+        raise ValueError("nope")
+
+    assert _safecall(boom)() is None
+
+
+def test_make_str_non_bytes():
+    assert make_str(42) == "42"
+    assert make_str("text") == "text"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str("héllo".encode()) == "héllo"
+
+
+def test_make_str_bytes_undecodable(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"ab\xffcd") == "ab�cd"
+
+
+def test_short_help_exact_length_not_last_word():
+    # "aaaa bbbb" reaches max_length exactly but more words follow.
+    assert _make_default_short_help("aaaa bbbb cccc", 9) == "aaaa..."
+
+
+def test_short_help_first_word_too_long():
+    assert _make_default_short_help("abcdefghij rest", 5) == "..."
+
+
+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+    assert lf._f is fake_stdout
+    assert lf.should_close is False
+    assert repr(lf) == repr(fake_stdout)
+
+    with lf as f:
+        f.write("hello")
+
+    # The standard stream is borrowed, so it must stay open.
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert t.cast(io.BytesIO, fake_stdout.buffer).getvalue() == b"hello"
+
+
+def test_lazyfile_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    # Closing an unopened lazy file is a no-op.
+    lf.close()
+    assert lf._f is None
+
+    lf.write("data")
+    try:
+        assert repr(lf) == repr(lf._f)
+    finally:
+        lf.close()
+
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr():
+    stream = io.StringIO()
+    assert repr(_KeepOpenFile(stream)) == repr(stream)
+
