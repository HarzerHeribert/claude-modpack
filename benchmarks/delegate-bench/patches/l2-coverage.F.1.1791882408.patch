+def test_echo_bytes_to_text_only_stream_falls_through_to_write():
+    # A text-only stream has no binary writer, so echo() falls through to a
+    # plain write() of the bytes, which the text stream rejects.
+    writer = _TextOnlyWriter()
+    with pytest.raises(TypeError):
+        utils.echo(b"raw", file=writer, nl=False)
+
