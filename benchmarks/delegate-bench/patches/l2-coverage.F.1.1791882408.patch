+def test_expand_args_glob_recursive_flag(tmp_path, monkeypatch):
+    (tmp_path / "d" / "e").mkdir(parents=True)
+    (tmp_path / "d" / "e" / "f.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert utils._expand_args(["**/f.txt"]) == [os.path.join("d", "e", "f.txt")]
+    assert utils._expand_args(["**/f.txt"], glob_recursive=False) == ["**/f.txt"]
+
+
+def test_expand_args_invalid_glob_treated_as_empty(monkeypatch):
+    def raise_re_error(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", raise_re_error)
+    assert utils._expand_args(["[bad"]) == ["[bad"]
+
