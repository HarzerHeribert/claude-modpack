+def test_make_default_short_help_truncates_at_max_length():
+    # Reaching exactly max_length on a non-final word truncates with "...".
+    help_text = "a" * 20 + " " + "b" * 24 + " ccc"
+    assert utils._make_default_short_help(help_text) == "a" * 20 + "..."
+
+
+def test_make_default_short_help_truncate_removes_all_words():
+    # Truncation leaves no words to keep, so only the suffix remains.
+    assert utils._make_default_short_help("a" * 43 + " b c") == "..."
