+class _TextOnlyWriter:
+    """A text-only writer: it rejects bytes and has no binary buffer."""
+
+    def write(self, value):
+        if not isinstance(value, str):
+            raise TypeError("text only")
+
+    def flush(self):
+        pass
+
+
+class _FlushError:
+    def __init__(self, error):
+        self.error = error
+
+    def flush(self):
+        raise self.error
+
+    def write(self, value):
+        pass
+
+
+def test_safecall_returns_value():
+    @utils._safecall
+    def add(a, b):
+        return a + b
+
+    assert add(1, 2) == 3
+    assert add.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    @utils._safecall
+    def boom():
+        raise ValueError("nope")
+
+    assert boom() is None
+
