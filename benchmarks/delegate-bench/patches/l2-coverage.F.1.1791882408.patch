+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapper = utils._PacifyFlushWrapper(_FlushError(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()  # must not raise
+
+
+def test_pacify_flush_wrapper_reraises_other_oserror():
+    wrapper = utils._PacifyFlushWrapper(_FlushError(OSError(errno.EIO, "io")))
+    with pytest.raises(OSError):
+        wrapper.flush()
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    buf = StringIO()
+    wrapper = utils._PacifyFlushWrapper(buf)
+    assert wrapper.wrapped is buf
+    wrapper.write("abc")
+    assert buf.getvalue() == "abc"
+    wrapper.flush()
+
