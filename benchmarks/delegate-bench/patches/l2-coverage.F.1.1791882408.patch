+def test_format_filename_bytes_pathlike_shorten():
+    class BytesPath:
+        def __fspath__(self):
+            return b"/x/y.bin"
+
+    assert utils.format_filename(BytesPath()) == "/x/y.bin"
+    assert utils.format_filename(BytesPath(), shorten=True) == "y.bin"
