+def test_lazy_file_close_intelligently_keeps_borrowed_file(capsys):
+    lf = utils._LazyFile("-", "w")
+    lf.close_intelligently()
+    # stdout is borrowed (should_close False) and must stay usable.
+    print("still open", file=sys.stdout)
+    assert capsys.readouterr().out == "still open\n"
+
