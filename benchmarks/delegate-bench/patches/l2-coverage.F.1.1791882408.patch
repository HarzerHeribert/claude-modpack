+def test_lazy_file_stdout_dash_write(capsys):
+    lf = utils._LazyFile("-", "w")
+    assert lf.name == "-"
+    assert lf.should_close is False
+    lf.write("hi")
+    lf.close_intelligently()
+    assert capsys.readouterr().out == "hi"
+
+
+def test_lazy_file_dash_context_manager_keeps_stream_open(capsys):
+    with utils._LazyFile("-", "w") as f:
+        f.write("ok")
+    # Leaving the context must not close stdout.
+    print("after", file=sys.stdout)
+    assert capsys.readouterr().out == "okafter\n"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    f = lf.open()
+    try:
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close()
+
+
+def test_lazy_file_close_without_open_is_noop(tmp_path):
+    lf = utils._LazyFile(tmp_path / "x.txt", "w")
+    lf.close()  # _f is None, must not raise
+    assert lf._f is None
+
