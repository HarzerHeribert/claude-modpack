+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Word exactly reaches max_length without sentence end -> truncate.
+        ("aaa bbb ccc ddd", 7, "aaa..."),
+        # First word alone too long -> empty prefix plus suffix.
+        ("abcdefghij klm", 5, "..."),
+        # Leading no-rewrap marker is removed.
+        ("\b\nhello world", 45, "hello world"),
+        # Only the marker present -> empty.
+        ("\b", 45, ""),
+        # Empty help.
+        ("", 45, ""),
+        # Sentence end inside limit truncates without ellipsis.
+        ("One two. Three four five", 45, "One two."),
+        # Multi-paragraph: only first paragraph counts.
+        ("First para.\n\nSecond para here.", 45, "First para."),
+    ],
+)
