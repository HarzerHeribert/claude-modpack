+def test_echo_bytes_without_binary_writer_uses_write():
+    class Sink:
+        # Rejects the empty-bytes probe used by _is_binary_writer so the
+        # stream is treated as text (no binary writer found), but accepts
+        # real bytes payloads written directly by echo().
+        def __init__(self):
+            self.chunks = []
+
+        def write(self, s):
+            if s == b"":
+                raise TypeError("text only")
+            self.chunks.append(s)
+
+        def flush(self):
+            pass
+
+    sink = Sink()
+    u.echo(b"plain", file=sink)
+    # Ignore the empty probe write made by _is_binary_writer.
+    assert [c for c in sink.chunks if c] == [b"plain\n"]
+
