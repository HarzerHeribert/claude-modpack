+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo   Bar\tBaz  ", "foo-bar-baz"),
+        ("foo", "foo"),
+    ],
+)
+def test_posixify(name, expected):
+    assert _posixify(name) == expected
+
