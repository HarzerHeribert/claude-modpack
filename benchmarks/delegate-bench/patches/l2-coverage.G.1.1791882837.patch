+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+
+    try:
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+    finally:
+        lf.close()
+
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_unopened_does_nothing(tmp_path):
+    path = tmp_path / "never.txt"
+    lf = _LazyFile(path, "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not path.exists()
+
+
+def test_lazy_file_open_returns_same_file(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with _LazyFile(path, "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+
+    assert f.closed
+
+
+def test_lazy_file_read_missing_file_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "no" / "such" / "dir.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename.endswith("dir.txt")
+
+
+def test_lazy_file_dash_does_not_close_stdout(capfd):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("to stdout")
+        f.flush()
+
+    # Leaving the block did not close the standard stream.
+    assert not lf._f.closed
+    assert "to stdout" in capfd.readouterr().out
+
+
+def test_keep_open_file_repr_and_exit():
+    buf = io.StringIO()
+    kof = _KeepOpenFile(buf)
+    assert repr(kof) == repr(buf)
+
+    with kof as f:
+        f.write("data")
+
+    assert not buf.closed
+    assert buf.getvalue() == "data"
+    kof.close()
+    assert buf.closed
+
+
+def test_echo_bytes_to_text_only_stream_without_buffer():
+    # No binary writer can be found, so the bytes fall through to the text
+    # stream's write, which rejects them.
+    out = io.StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=out)
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_empty_flushes_only():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_converted_to_str():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
