+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+        (b"bytes", "bytes"),
+    ],
+)
+def test_make_str(value, expected):
+    assert make_str(value) == expected
+
+
+def test_make_str_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    assert make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hits max length before the last word.
+        ("abc def ghi", 7, "abc..."),
+        # Exactly hits max length on the last word, no truncation.
+        ("abc def", 7, "abc def"),
+        # First word alone is too long.
+        ("abcdefghijkl more", 5, "..."),
+        # Only a no-rewrap marker.
+        ("\b", 45, ""),
+        ("", 45, ""),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
