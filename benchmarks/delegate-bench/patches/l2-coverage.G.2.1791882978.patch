+import errno
+import glob
+import io
+import os
+import re
+import sys
+from types import ModuleType
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        # Falls back to UTF-8 when the filesystem encoding fails.
+        (b"caf\xc3\xa9", "café"),
+        # Bytes that are not valid UTF-8 either are replaced.
+        (b"caf\xff", "caf�"),
+    ],
+)
+def test_make_str_fallback_decode(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaching the limit exactly before the last word truncates.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # Reaching the limit exactly on the last word needs no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghijkl", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash_uses_stdout(monkeypatch):
+    out = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert not lf.should_close
+    assert repr(lf) == repr(lf._f)
+
+    with lf:
+        lf.write("hello")
+
+    # Leaving the block must not close the borrowed stream.
+    assert not out.closed
+    assert out.getvalue() == "hello"
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_before_open_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer cannot receive bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = click.utils._get_text_stream("stdout", encoding="utf-8")
+    stream.write("hello")
+    stream.flush()
+    assert buffer.getvalue() == b"hello"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_get_app_dir_windows_roaming(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", os.path.join("roaming", "dir"))
+    assert click.get_app_dir("Foo Bar") == os.path.join("roaming", "dir", "Foo Bar")
+
+
+def test_get_app_dir_windows_local(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv("LOCALAPPDATA", os.path.join("local", "dir"))
+    assert click.get_app_dir("Foo Bar", roaming=False) == os.path.join(
+        "local", "dir", "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_force_posix(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    assert click.get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser(
+        "~/.foo-bar"
+    )
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_xdg(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", os.path.join("xdg", "config"))
+    assert click.get_app_dir("Foo Bar") == os.path.join("xdg", "config", "foo-bar")
+
+
+def test_get_app_dir_xdg_default(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/.config"), "foo-bar"
+    )
+
+
+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "fake"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = click.utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    # Other attributes are proxied to the wrapped stream.
+    assert wrapper.name == "fake"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    stream = _FlushStream(OSError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(stream).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    stream = _FlushStream(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(stream).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "path", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_expand_args_without_user_or_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
