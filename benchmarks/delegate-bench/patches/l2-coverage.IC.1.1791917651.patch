+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_MORE", "value")
+    result = _expand_args(
+        ["~/nope-xyz", "$CLICK_TEST_MORE"], user=False, env=False
+    )
