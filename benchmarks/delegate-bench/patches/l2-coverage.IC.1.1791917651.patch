+def test_keep_open_file_repr_and_context(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as inner:
+            assert inner is kf
+            assert inner.readline() == "a\n"
+
+        assert not f.closed
+        assert list(kf) == ["b\n"]
