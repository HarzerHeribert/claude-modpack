+class _BytesOnlyNonEmpty:
+    """A stream that looks like a text writer to Click's detection, but
+    accepts non-empty bytes.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("no empty bytes")
+        if data:
+            self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _BytesOnlyNonEmpty()
+    click.echo(b"hello", file=stream)
+    assert stream.written == [b"hello\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"hi"), file=out, nl=False)
+    assert out.getvalue() == b"hi"
+
+
+def test_echo_empty_without_newline_flushes():
+    stream = _BytesOnlyNonEmpty()
+    click.echo("", file=stream, nl=False)
+    assert stream.written == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_is_stringified():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
+
+def test_echo_no_stdout(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.echo("nothing")
+    click.echo("nothing", err=True)
+
+
+def test_echo_strips_ansi_for_non_tty():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out)
+    assert out.getvalue() == "red\n"
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "\x1b[31mred\x1b[0m\n"
+
