+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_passthrough():
+    inner = _FlushRaises()
+    w = _PacifyFlushWrapper(inner)
+    w.flush()
+    assert inner.flushed
+    assert w.name == "wrapped"
+    assert w.wrapped is inner
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    w = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "Broken pipe")))
+    w.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    w = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "I/O error")))
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
