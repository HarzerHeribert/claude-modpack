+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaching exactly max_length before the last word truncates.
+        ("ab cd ef", 5, "ab..."),
+        # A single first word longer than max_length leaves only "...".
+        ("abcdefghij", 5, "..."),
+        ("abcdefghij klm", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edge_cases(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
