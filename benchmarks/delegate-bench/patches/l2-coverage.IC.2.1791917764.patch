+class _FailingFlush:
+    def __init__(self, error):
+        self.error = error
+        self.name = "failing"
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    wrapper = _PacifyFlushWrapper(_FailingFlush(None))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FailingFlush(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    error = OSError(errno.EIO, "io")
+    wrapper = _PacifyFlushWrapper(_FailingFlush(error))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value is error
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapped = _FailingFlush(None)
+    wrapper = _PacifyFlushWrapper(wrapped)
+    assert wrapper.wrapped is wrapped
+    assert wrapper.name == "failing"
+
