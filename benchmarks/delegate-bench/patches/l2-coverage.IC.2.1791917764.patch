+class _BytesOnlyRecorder:
+    """A file-like object that is not detected as a binary writer but
+    still accepts bytes when there is actual content to write.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise TypeError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _BytesOnlyRecorder()
+    echo(b"hello", file=out)
+    assert out.written == [b"hello\n"]
+    assert out.flushed == 1
+
+
+def test_echo_bytearray_without_newline_to_binary():
+    out = io.BytesIO()
+    echo(bytearray(b"raw"), file=out, nl=False)
+    assert out.getvalue() == b"raw"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = _get_text_stream("stdout")
+    stream.write("text")
+    stream.flush()
+    assert buffer.getvalue() == b"text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
