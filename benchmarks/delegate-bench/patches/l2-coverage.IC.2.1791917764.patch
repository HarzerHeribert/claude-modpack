+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo \t Bar  Baz ", "foo-bar-baz"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(value, expected):
