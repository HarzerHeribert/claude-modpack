+def test_lazy_file_stdout(monkeypatch):
+    buffer = io.BytesIO()
+    stdout = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # Exiting the context does not close a standard stream.
+    assert not lf.closed
+    assert repr(lf) == repr(lf._f)
+    assert buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close()
+    assert path.exists()
+
+
+def test_lazy_file_close_intelligently_not_opened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    # Nothing was opened, so closing is a no-op.
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_keep_open_file_context_does_not_close():
+    f = io.StringIO()
+
+    with _KeepOpenFile(f) as kf:
+        kf.write("data")
+
+    assert not f.closed
+    assert f.getvalue() == "data"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_lazy_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    f = open_file(path, "w", lazy=True, atomic=True)
+
+    with f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
