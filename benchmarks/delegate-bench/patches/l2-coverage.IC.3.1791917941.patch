+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped-stream"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    buf = io.StringIO()
+    wrapper = _PacifyFlushWrapper(buf)
+    wrapper.write("proxied")
+    assert wrapper.getvalue() == "proxied"
+    assert _PacifyFlushWrapper(_FlushRaises()).name == "wrapped-stream"
+
