+def test_lazy_file_dash_write(runner):
+    with runner.isolation() as (out, _err, _):
+        lf = _LazyFile("-", "w")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+        lf.flush()
+        # The standard stream is borrowed, so it must not be closed.
+        lf.close_intelligently()
+        assert not lf._f.closed
+        assert out.getvalue() == b"hello"
+
+
+def test_lazy_file_dash_read(runner):
+    with runner.isolation(input="line1\nline2\n"):
+        with _LazyFile("-", "r") as lf:
+            assert lf.should_close is False
+            assert list(lf) == ["line1\n", "line2\n"]
+
+        assert not lf._f.closed
+
