+class _TextOnlyProbe:
+    """A stream without a binary buffer that refuses the empty-bytes probe
+    done by ``_find_binary_writer``, but records anything else written.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("binary probe rejected")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    probe = _TextOnlyProbe()
+    click.echo(b"raw", file=probe)
+    assert probe.written[-1] == b"raw\n"
+    assert probe.flushed == 1
+
+
+def test_echo_bytearray_without_binary_writer():
+    probe = _TextOnlyProbe()
+    click.echo(bytearray(b"raw"), file=probe, nl=False)
+    assert probe.written[-1] == bytearray(b"raw")
+
+
+def test_echo_object_converted_to_str():
+    buf = io.StringIO()
+    click.echo(123, file=buf)
+    assert buf.getvalue() == "123\n"
+
+
+def test_echo_empty_flushes_only():
+    probe = _TextOnlyProbe()
+    click.echo(None, file=probe, nl=False)
+    assert probe.written == []
+    assert probe.flushed == 1
+
