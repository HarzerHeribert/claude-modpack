+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("data")
+    kf = utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as entered:
+        assert entered is kf
+        assert entered.read() == "data"
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
