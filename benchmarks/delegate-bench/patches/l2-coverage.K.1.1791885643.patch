+def test_lazy_file_dash_uses_stdout(monkeypatch):
+    buffer = io.BytesIO()
+    stdout = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    lf = utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert not lf.should_close
+    assert repr(lf) == repr(lf._f)
+
+    lf.write("hello")
+    lf.flush()
+    # Exiting does not close a stream the lazy file did not open.
+    with lf:
+        pass
+
+    assert not stdout.closed
+    assert buffer.getvalue() == b"hello"
+
