+class _TextOnlyBytesSink:
+    """Rejects the empty probes used to detect a binary writer, but still
+    accepts the real payload, so ``echo`` falls back to ``file.write``.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        if not data:
+            raise TypeError("no empty writes")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    sink = _TextOnlyBytesSink()
+    click.echo(b"hello", file=sink)  # type: ignore[arg-type]
+    assert sink.written == [b"hello\n"]
+    assert sink.flushes == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_empty_message_only_flushes():
+    sink = _TextOnlyBytesSink()
+    click.echo("", file=sink, nl=False)  # type: ignore[arg-type]
+    assert sink.written == []
+    assert sink.flushes == 1
+
