+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = _FlushRaises()
+    wrapper = utils._PacifyFlushWrapper(inner)  # type: ignore[arg-type]
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    wrapper = utils._PacifyFlushWrapper(inner)  # type: ignore[arg-type]
+    wrapper.flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    wrapper = utils._PacifyFlushWrapper(inner)  # type: ignore[arg-type]
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
