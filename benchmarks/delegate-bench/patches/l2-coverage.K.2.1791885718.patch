+def test_expand_args_glob(tmp_path, monkeypatch):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "c.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+    assert sorted(_expand_args(["**/*.txt"])) == [
+        "a.txt",
+        "b.txt",
+        os.path.join("sub", "c.txt"),
+    ]
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=False)) == [
+        os.path.join("sub", "c.txt")
+    ]
+    assert _expand_args(["*.missing"]) == ["*.missing"]
+
+
+def test_expand_args_invalid_glob_pattern(monkeypatch):
+    def raise_re_error(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", raise_re_error)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
