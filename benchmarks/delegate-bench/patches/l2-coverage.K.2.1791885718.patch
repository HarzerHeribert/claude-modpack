+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_normal_flush_and_proxy():
+    inner = _FlushRaises(None)
+    wrapper = _PacifyFlushWrapper(inner)  # type: ignore[arg-type]
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "broken")))  # type: ignore[arg-type]
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io error")))  # type: ignore[arg-type]
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
