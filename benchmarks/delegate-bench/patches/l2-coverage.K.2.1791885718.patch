+def test_lazy_file_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    with _LazyFile(path, "w", atomic=True) as lf:
+        lf.write("new")
+        assert path.read_text() == "old"
+    assert path.read_text() == "new"
