+def test_get_text_stream_stderr_custom_encoding(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stderr", io.TextIOWrapper(buffer, encoding="utf-8"))
+    text = _get_text_stream("stderr", encoding="latin-1", errors="replace")
+    text.write("é")
+    text.flush()
+    assert buffer.getvalue() == b"\xe9"
