+def test_get_text_stream_stdout(monkeypatch):
+    stream, buffer = _fake_stdout(monkeypatch)
+    text = _get_text_stream("stdout")
+    text.write("text")
+    text.flush()
+    stream.flush()
+    assert buffer.getvalue() == b"text"
+
