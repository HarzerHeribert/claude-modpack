+class _TextOnlyEmptyWriter:
+    """Rejects empty bytes, so it doesn't look binary, but accepts all
+    other writes. It has no ``buffer``, so no binary writer is found.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("not binary")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _TextOnlyEmptyWriter()
+    echo(b"raw", file=out)  # type: ignore[arg-type]
+    assert out.written[-1] == b"raw\n"
+    assert out.flushed >= 1
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    echo(b"bin", file=out)
+    echo(bytearray(b"arr"), file=out, nl=False)
+    assert out.getvalue() == b"bin\narr"
+
+
+def test_echo_object_and_empty():
+    out = io.StringIO()
+    echo(123, file=out)
+    echo(None, file=out, nl=False)
+    echo(file=out)
+    assert out.getvalue() == "123\n\n"
+
+
+def test_echo_color_strip():
+    out = io.StringIO()
+    echo("\x1b[31mred\x1b[0m", file=out, color=False)
+    echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "red\n\x1b[31mred\x1b[0m\n"
+
