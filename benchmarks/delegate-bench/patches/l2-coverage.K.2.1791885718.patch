+def test_open_file_stdout_kept_open(monkeypatch):
+    stream, buffer = _fake_stdout(monkeypatch)
+    f = open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+    with f:
+        f.write("out")
+    f.flush()
+    assert not stream.closed
