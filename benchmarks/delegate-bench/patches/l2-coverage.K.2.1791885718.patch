+def _fake_stdout(monkeypatch):
+    """Replace ``sys.stdout`` with a real text wrapper over a byte buffer.
+
+    This must be called from the test body rather than a fixture, since
+    pytest's output capturing resets ``sys.stdout`` after fixture setup.
+    """
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream, buffer
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Lots   of\tSpace ", "lots-of-space"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(value, expected):
+    assert _posixify(value) == expected
+
