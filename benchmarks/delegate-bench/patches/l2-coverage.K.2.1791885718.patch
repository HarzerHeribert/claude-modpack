+def test_keep_open_file_repr_and_proxy():
+    inner = io.StringIO("abc")
+    kof = _KeepOpenFile(inner)
+    assert repr(kof) == repr(inner)
+    assert kof.read() == "abc"
+    with kof as f:
+        assert f is kof
+    assert not inner.closed
+    kof.close()
+    assert inner.closed
