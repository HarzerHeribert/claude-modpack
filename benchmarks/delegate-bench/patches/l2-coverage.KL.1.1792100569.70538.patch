+class _FlushFailingStream:
+    def __init__(self, errno_):
+        self.errno_ = errno_
+        self.written = []
+
+    def write(self, value):
+        self.written.append(value)
+
+    def flush(self):
+        if self.errno_ is not None:
+            raise OSError(self.errno_, os.strerror(self.errno_))
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    stream = _FlushFailingStream(None)
+    _PacifyFlushWrapper(stream).flush()
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    _PacifyFlushWrapper(_FlushFailingStream(errno.EPIPE)).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushFailingStream(errno.EIO))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    stream = _FlushFailingStream(errno.EPIPE)
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.write("hello")
+
+    assert stream.written == ["hello"]
+    assert wrapper.errno_ == errno.EPIPE
+
+
+def test_detect_program_name_defaults_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/example/__main__.py", "--flag"])
+    assert _detect_program_name() == "python -m example"
+
+
+def test_detect_program_name_defaults_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/app.py"])
+    assert _detect_program_name() == "app.py"
+
+
+def test_expand_args_without_user_and_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_recursive(monkeypatch, tmp_path):
+    (tmp_path / "a" / "b").mkdir(parents=True)
+    (tmp_path / "a" / "b" / "deep.txt").touch()
+    (tmp_path / "top.txt").touch()
+    monkeypatch.chdir(tmp_path)
+
+    assert sorted(_expand_args(["**/*.txt"])) == [
+        os.path.join("a", "b", "deep.txt"),
+        "top.txt",
+    ]
+    # Without recursion "**" only matches a single directory level.
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == ["**/*.txt"]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad", "other"]) == ["[bad", "other"]
