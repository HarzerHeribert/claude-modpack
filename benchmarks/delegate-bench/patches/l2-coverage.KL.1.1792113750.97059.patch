+@pytest.mark.parametrize(
+    ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+)
+def test_get_app_dir_windows(monkeypatch, tmp_path, roaming, key):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.setenv(key, str(tmp_path))
+    assert utils.get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+        tmp_path, "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_without_appdata(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar") == os.path.join(tmp_path, "Foo Bar")
+
+
+def test_get_app_dir_force_posix(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar", force_posix=True) == os.path.join(
+        tmp_path, ".foo-bar"
+    )
+
+
+def test_get_app_dir_darwin(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar") == os.path.join(
+        tmp_path, "Library", "Application Support", "Foo Bar"
+    )
+
+
+def test_get_app_dir_xdg(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar") == os.path.join(tmp_path, "foo-bar")
+
+
+def test_get_app_dir_xdg_default(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar") == os.path.join(tmp_path, ".config", "foo-bar")
