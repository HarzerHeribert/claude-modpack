+class _Flushable:
+    name = "fake"
+
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    wrapped = _Flushable()
+    wrapper = utils._PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapped.flushed == 1
+    assert wrapper.name == "fake"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapped = _Flushable(OSError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapped = _Flushable(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", types.ModuleType("__main__"))
+    monkeypatch.setattr(sys, "argv", ["/usr/local/bin/example.py", "--flag"])
+    assert utils._detect_program_name() == "example.py"
+
+
+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_EXPAND_TEST", "value")
+    arg = "~/$CLICK_EXPAND_TEST"
+    assert utils._expand_args([arg], user=False, env=False) == [arg]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def broken_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", broken_glob)
+    assert utils._expand_args(["[bad"]) == ["[bad"]
