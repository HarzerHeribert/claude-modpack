+def test_echo_bytes_without_binary_writer():
+    class PickyStream:
+        """Rejects empty writes, so it is detected as neither a binary
+        stream nor a stream with a binary buffer."""
+
+        def __init__(self):
+            self.data = []
+
+        def write(self, x):
+            if not x:
+                raise ValueError("empty write")
+            self.data.append(x)
+
+        def flush(self):
+            pass
+
+    stream = PickyStream()
+    click.echo(b"hi", file=stream)
+    assert stream.data == [b"hi\n"]
+
+
+def test_get_binary_stream(monkeypatch):
+    _, buffer = _text_stdout(monkeypatch)
+    assert utils._get_binary_stream("stdout") is buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    stream, _ = _text_stdout(monkeypatch)
+    assert utils._get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")
+
