+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click import utils
+
+
+def _text_stdout(monkeypatch):
+    """Replace ``sys.stdout`` with a plain UTF-8 text stream backed by bytes."""
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8", errors="strict")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream, buffer
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [("Foo Bar", "foo-bar"), ("  Spaced   Out  ", "spaced-out"), ("x", "x")],
+)
+def test_posixify(name, expected):
+    assert utils._posixify(name) == expected
+
+
+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    safe = utils._safecall(add)
+    assert safe(1, b=2) == 3
+    assert safe.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def boom():
+        raise ValueError("nope")
+
+    assert utils._safecall(boom)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [(b"hello", "hello"), ("text", "text"), (42, "42"), (None, "None")],
+)
+def test_make_str(value, expected):
+    assert utils.make_str(value) == expected
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert utils.make_str(b"caf\xc3\xa9") == "café"
+    assert utils.make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaching the limit exactly on a non-final word truncates there.
+        ("abc def ghi", 7, "abc..."),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghij", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("data")
+    lf = utils._LazyFile(path, "r")
+    f = lf.open()
+    try:
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close()
+
+
+def test_lazy_file_dash_uses_stdout(monkeypatch):
+    stream, buffer = _text_stdout(monkeypatch)
+    lf = utils._LazyFile("-", "w")
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not stream.closed
+    stream.flush()
+    assert buffer.getvalue() == b"hello"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
+
+def test_keep_open_file_repr():
+    inner = io.StringIO()
+    assert repr(utils._KeepOpenFile(inner)) == repr(inner)
+
