+def test_lazy_file_dash_uses_standard_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = _LazyFile("-", "w")
+
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+
+    lf.write("hello")
+    lf.close_intelligently()
+
+    assert not stream.closed
+    assert stream.getvalue() == "hello"
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+
