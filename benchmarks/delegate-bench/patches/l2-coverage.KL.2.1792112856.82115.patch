+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_returns_compatible_stream(monkeypatch):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    assert _get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_rewraps_with_encoding(monkeypatch):
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    rv = _get_text_stream("stdout", encoding="latin-1", errors="strict")
+
+    assert rv is not stream
+    rv.write("é")
+    rv.flush()
+    assert buffer.getvalue() == b"\xe9"
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
