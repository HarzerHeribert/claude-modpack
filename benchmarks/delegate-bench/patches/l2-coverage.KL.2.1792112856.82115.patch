+def test_keep_open_file_repr():
+    stream = io.StringIO()
+    f = _KeepOpenFile(stream)
+
+    assert repr(f) == repr(stream)
+
+    with f as inner:
+        inner.write("x")
+
+    assert not stream.closed
+    assert stream.getvalue() == "x"
