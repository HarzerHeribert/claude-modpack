+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff\xfe", "��"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly reaching the limit before the last word truncates.
+        ("Hello world how", 11, "Hello..."),
+        # The first word alone fills the limit, nothing fits before "...".
+        ("abcde fgh", 5, "..."),
+    ],
+)
+def test_make_default_short_help_exact_limit(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
