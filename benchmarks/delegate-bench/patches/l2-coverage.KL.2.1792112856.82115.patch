+class _RejectEmptyWrites:
+    """A stream that is neither a detectable text nor binary writer because
+    it rejects empty probe writes, but accepts real data."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+        return len(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _RejectEmptyWrites()
+    echo(b"hello", file=stream)
+
+    assert stream.data == [b"hello\n"]
+    assert stream.flushed == 1
+
