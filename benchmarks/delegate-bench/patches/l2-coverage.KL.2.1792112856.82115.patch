+class _FlushStream:
+    def __init__(self, error=None):
+        self.error = error
+        self.flushed = 0
+        self.written = []
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+        self.flushed += 1
+
+    def write(self, value):
+        self.written.append(value)
+
+
+def test_pacify_flush_wrapper_flushes():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+
+    assert wrapper.wrapped is stream
+    wrapper.flush()
+    assert stream.flushed == 1
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "broken")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io error")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+
+    wrapper.write("hello")
+    assert stream.written == ["hello"]
+    assert wrapper.flushed == 0
+
