+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "<fake>"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    stream = _FlushStream()
+    wrapper = click.utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    # Other attributes are proxied to the wrapped stream.
+    assert wrapper.name == "<fake>"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushStream(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushStream(OSError(errno.EIO, "I/O error"))
+    )
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    arg = os.path.join("~", "$CLICK_TEST")
+    assert click.utils._expand_args([arg], user=False, env=False) == [arg]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def raise_re_error(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", raise_re_error)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
