+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_safecall_returns_result():
+    wrapped = click.utils._safecall(lambda x: x + 1)
+    assert wrapped(1) == 2
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"caf\xff") == "caf�"
+
+
+def test_make_str_non_bytes():
+    assert click.utils.make_str(42) == "42"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly at the limit but more words follow: truncate with "...".
+        ("ab cd ef", 5, "ab..."),
+        # The first word alone is too long: nothing is kept.
+        ("abcdefghij", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert repr(lf) == repr(stream)
+    lf.write("hello")
+    # A borrowed standard stream is never closed by the lazy file.
+    lf.close_intelligently()
+    assert not stream.closed
+    assert stream.getvalue() == "hello"
+
+
+def test_lazyfile_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keepopenfile_repr_and_close(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    f = click.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+    assert repr(f) == repr(stream)
+    with f:
+        f.write("hi")
+    assert not stream.closed
+    assert stream.getvalue() == "hi"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+    with f:
+        f.write("lazy")
+    assert path.read_text() == "lazy"
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer can't take bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert click.utils._get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+@pytest.mark.parametrize(
+    ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+)
+def test_get_app_dir_windows(monkeypatch, tmp_path, roaming, key):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv(key, str(tmp_path))
+    assert click.utils.get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+        str(tmp_path), "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_force_posix(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    assert click.utils.get_app_dir("Foo Bar", force_posix=True) == (
+        os.path.expanduser("~/.foo-bar")
+    )
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_xdg(monkeypatch, tmp_path):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path))
+    assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+        str(tmp_path), "foo-bar"
+    )
+
+
+def test_get_app_dir_xdg_default(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/.config"), "foo-bar"
+    )
+
