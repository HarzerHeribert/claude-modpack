+def test_lazyfile_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is fake_stdout
+    # The repr of an opened lazy file is the repr of the underlying file.
+    assert repr(lf) == repr(fake_stdout)
+
+    with lf as f:
+        f.write("hello")
+
+    # close_intelligently must not close a borrowed standard stream.
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    try:
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+        lf.write("data")
+    finally:
+        lf.close_intelligently()
+
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing-dir" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keepopenfile_proxies_and_stays_open():
+    inner = io.StringIO("line1\nline2\n")
+    f = _KeepOpenFile(inner)
+    assert repr(f) == repr(inner)
+
+    with f as entered:
+        assert entered is f
+        assert entered.readline() == "line1\n"
+
+    assert not inner.closed
+    assert list(f) == ["line2\n"]
+    f.close()
+    assert inner.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy content")
+
+    assert path.read_text() == "lazy content"
+
+
+def test_open_file_stdout_is_kept_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"out"
+
+
+def test_echo_bytes_to_text_only_stream_raises():
+    # A pure text stream has no binary buffer to fall back to.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_buffer():
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    stream.write("text ")
+    click.echo(b"bytes", file=stream)
+    assert stream.buffer.getvalue() == b"text bytes\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_binary_stream("stdout") is fake_stdout.buffer
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_text_stream("stdout") is fake_stdout
+
