+class _FlushRaiser:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "raiser"
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    inner = io.StringIO()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.write("hello")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hello"
+    assert wrapper.wrapped is inner
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(
+        _FlushRaiser(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+    assert wrapper.name == "raiser"
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaiser(OSError(errno.EBADF, "Bad fd")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_detect_program_name_defaults_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/local/bin/example.py", "--help"])
+    assert _detect_program_name() == "example.py"
+
+
+def test_detect_program_name_defaults_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/example/cli.py"])
+    assert _detect_program_name() == "python -m example.cli"
+
+
+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(
+        ["~/no-such-click-file", "$CLICK_TEST"], user=False, env=False
+    ) == ["~/no-such-click-file", "$CLICK_TEST"]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=True)) == [
+        "b.txt",
+        os.path.join("sub", "a.txt"),
+    ]
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "a.txt")
+    ]
