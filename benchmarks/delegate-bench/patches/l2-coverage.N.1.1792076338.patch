+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly max_length but more words follow: truncate with "...".
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # First word alone is too long: nothing fits before the suffix.
+        ("abcdefghij more", 5, "..."),
+        # Fits exactly as the final word: no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edge_cases(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
