+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", types.ModuleType("__main__"))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "prog.py")])
+    assert click.utils._detect_program_name() == "prog.py"
+
+
+def test_detect_program_name_module_default_path(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "pkg"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "__main__.py")])
+    assert click.utils._detect_program_name() == "python -m pkg"
+
+
+def test_detect_program_name_relative_package():
+    main = types.ModuleType("__main__")
+    main.__package__ = ".pkg"
+    path = os.path.join("pkg", "cli.py")
+    assert click.utils._detect_program_name(path, _main=main) == "python -m pkg.cli"
+
