+def test_echo_bytes_to_text_only_file():
+    # StringIO has no binary writer, so the bytes are passed to the text
+    # stream directly, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_file():
+    out = io.BytesIO()
+    click.echo(b"data", file=out)
+    click.echo(bytearray(b"more"), file=out, nl=False)
+    assert out.getvalue() == b"data\nmore"
+
+
+def test_echo_empty_flushes():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_and_color():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=False)
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "123\nred\n\x1b[31mred\x1b[0m\n"
+
+
+def test_echo_err(capsys):
+    click.echo("to err", err=True)
+    captured = capsys.readouterr()
+    assert captured.err == "to err\n"
+    assert captured.out == ""
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    # Nothing to write to, so nothing happens.
+    click.echo("lost")
+    click.echo("lost", err=True)
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_binary_stream(capsysbinary):
+    stream = click.utils._get_binary_stream("stdout")
+    stream.write(b"bin")
+    stream.flush()
+    assert capsysbinary.readouterr().out == b"bin"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_get_text_stream(capsys):
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("text")
+    stream.flush()
+    assert capsys.readouterr().out == "text"
+
