+def test_format_filename_bytes_and_shorten():
+    assert click.format_filename(b"/a/b/c\xff.txt") == "/a/b/c�.txt"
+    assert click.format_filename(b"/a/b/c.txt", shorten=True) == "c.txt"
+    assert click.format_filename("/a/b/c\udcff.txt", shorten=True) == "c�.txt"
+
