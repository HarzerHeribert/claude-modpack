+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_open_file_lazy_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    f = click.utils.open_file(path, "w", lazy=True, atomic=True)
+
+    with f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_open_file_stdout_keep_open(capsys):
+    f = click.utils.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+
+    with f:
+        f.write("out")
+
+    assert not f.closed
+    f.flush()
+    assert capsys.readouterr().out == "out"
+
