+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_EXPAND", "hello")
+    args = ["~", "$CLICK_TEST_EXPAND"]
+    assert click.utils._expand_args(args, user=False, env=False) == args
+
+
+def test_expand_args_glob_not_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b").mkdir()
+    (tmp_path / "a" / "b" / "deep.txt").write_text("")
+    (tmp_path / "top.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+
+    recursive = click.utils._expand_args(["**/*.txt"])
+    assert os.path.join("a", "b", "deep.txt") in recursive
+    assert "top.txt" in recursive
+
+    flat = click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    # Without recursion "**" only matches one directory level, which
+    # contains no files, so the pattern is returned unchanged.
+    assert flat == ["**/*.txt"]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
