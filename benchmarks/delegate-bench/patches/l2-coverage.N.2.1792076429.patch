+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.extra = "proxied"
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_ok():
+    out = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(out)
+    wrapper.write("hello")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hello"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    wrapper = click.utils._PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = _FlushRaises(OSError(errno.EBADF, "Bad file descriptor"))
+    wrapper = click.utils._PacifyFlushWrapper(wrapped)
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
