+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (b"bytes", "bytes"),
+        ("é".encode(), "é"),
+        (b"bad\xff", "bad�"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches the max length exactly before the last word.
+        ("aaaa bbbb ccc", 9, "aaaa..."),
+        # Reaches the max length exactly on the last word.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # The very first word is too long.
+        ("aaaaaaaaaa b", 5, "..."),
+        ("aaaaaaaaaa", 5, "..."),
+        # Only a no-rewrap marker with following text.
+        ("\b\nfirst line. second", 45, "first line."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
