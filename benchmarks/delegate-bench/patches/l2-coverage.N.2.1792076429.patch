+def test_lazy_file_stdout(capsys):
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # The standard stream must not have been closed.
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close()
+    assert path.exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_getattr_and_iter(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+    lf = click.utils._LazyFile(path)
+    assert lf._f is None
+    assert list(lf) == ["a\n", "b\n"]
+    assert lf.name == os.fspath(path)
+    assert lf.closed is False
+    lf.close_intelligently()
+    assert lf._f.closed
+
+
+def test_keep_open_file_proxies(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("data")
+
+    with open(path) as raw:
+        kof = click.utils._KeepOpenFile(raw)
+        assert repr(kof) == repr(raw)
+        assert kof.name == raw.name
+
+        with kof as f:
+            assert f is kof
+            assert f.read() == "data"
+
+        assert not raw.closed
+        kof.close()
+        assert raw.closed
+
