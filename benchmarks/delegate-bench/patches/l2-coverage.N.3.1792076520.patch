+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush_and_proxy():
+    inner = _FlushRaises()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
