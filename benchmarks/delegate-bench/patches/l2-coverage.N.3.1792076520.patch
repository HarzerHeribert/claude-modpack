+class _TextOnlyAcceptsNonEmptyBytes:
+    """A stream that rejects the empty-bytes probe used to detect binary
+    streams, has no ``buffer``, but still records whatever is written.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("no bytes probe")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _TextOnlyAcceptsNonEmptyBytes()
+    click.utils.echo(b"raw", file=stream)
+    assert stream.written == ["", b"raw\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytes_to_binary_stream():
+    stream = io.BytesIO()
+    click.utils.echo(bytearray(b"abc"), file=stream, nl=False)
+    assert stream.getvalue() == b"abc"
+
+
+def test_echo_empty_no_newline_only_flushes():
+    stream = _TextOnlyAcceptsNonEmptyBytes()
+    click.utils.echo("", file=stream, nl=False)
+    assert stream.written == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_and_none():
+    stream = io.StringIO()
+    click.utils.echo(123, file=stream)
+    click.utils.echo(None, file=stream)
+    assert stream.getvalue() == "123\n\n"
+
+
+def test_echo_strips_and_keeps_ansi():
+    stream = io.StringIO()
+    click.utils.echo("\x1b[31mred\x1b[0m", file=stream)
+    click.utils.echo("\x1b[31mred\x1b[0m", file=stream, color=True)
+    assert stream.getvalue() == "red\n\x1b[31mred\x1b[0m\n"
+
