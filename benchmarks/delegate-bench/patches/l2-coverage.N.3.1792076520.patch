+def test_keep_open_file_proxies():
+    buf = io.StringIO("line1\nline2\n")
+    kf = click.utils._KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    with kf as f:
+        assert f is kf
+        assert list(f) == ["line1\n", "line2\n"]
+    assert not buf.closed
+    assert kf.getvalue() == "line1\nline2\n"
+    kf.close()
+    assert buf.closed
+
