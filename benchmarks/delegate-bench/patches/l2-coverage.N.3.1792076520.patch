+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    sub = tmp_path / "sub"
+    sub.mkdir()
+    (sub / "c.txt").touch()
+    pattern = os.path.join(os.fspath(tmp_path), "**", "*.txt")
+    assert sorted(click.utils._expand_args([pattern])) == sorted(
+        [
+            os.path.join(os.fspath(tmp_path), "a.txt"),
+            os.path.join(os.fspath(tmp_path), "b.txt"),
+            os.path.join(os.fspath(sub), "c.txt"),
+        ]
+    )
+    assert click.utils._expand_args([pattern], glob_recursive=False) == [
+        os.path.join(os.fspath(sub), "c.txt")
+    ]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[a-"]) == ["[a-"]
+
