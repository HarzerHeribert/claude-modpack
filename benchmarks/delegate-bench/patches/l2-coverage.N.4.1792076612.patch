+def test_echo_strip_and_keep_color():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=False)
+    assert out.getvalue() == "red\n"
+
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "\x1b[31mred\x1b[0m\n"
