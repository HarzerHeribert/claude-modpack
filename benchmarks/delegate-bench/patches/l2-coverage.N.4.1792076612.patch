+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(runner, name):
+    with runner.isolation():
+        stream = _get_binary_stream(name)
+
+        if name == "stdin":
+            assert stream.read(0) == b""
+        else:
+            stream.write(b"\xff")
+            stream.flush()
+
