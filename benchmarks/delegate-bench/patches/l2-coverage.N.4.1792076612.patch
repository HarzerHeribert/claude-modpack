+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_open_file_dash_keeps_stream_open(runner):
+    with runner.isolation() as (out, _err, _):
+        f = open_file("-", "w")
+        assert isinstance(f, _KeepOpenFile)
+
+        with f:
+            f.write("hello")
+
+        assert not f.closed
+        f.flush()
+        assert out.getvalue() == b"hello"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("abc")
+
+    with open_file(path) as f:
+        assert not isinstance(f, _KeepOpenFile)
+        assert f.read() == "abc"
+
+    assert f.closed
