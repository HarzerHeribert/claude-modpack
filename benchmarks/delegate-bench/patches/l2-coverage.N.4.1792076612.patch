+def test_echo_bytes_to_text_only_stream():
+    out = io.StringIO()
+
+    # A text-only stream has no binary writer, so bytes reach ``write`` directly.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=out)
+
+
+def test_echo_bytes_without_binary_writer_falls_back_to_write():
+    class Recorder:
+        def __init__(self):
+            self.written = []
+            self.flushed = 0
+
+        def write(self, value):
+            # Reject the empty probe writes used to detect binary streams.
+            if not value:
+                raise TypeError("probe")
+            self.written.append(value)
+
+        def flush(self):
+            self.flushed += 1
+
+    rec = Recorder()
+    click.echo(b"data", file=rec)
+    assert rec.written == [b"data\n"]
+    assert rec.flushed == 1
+
+
+def test_echo_empty_message_only_flushes():
+    class Recorder(io.StringIO):
+        flushed = 0
+
+        def flush(self):
+            type(self).flushed += 1
+            super().flush()
+
+    out = Recorder()
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+    assert Recorder.flushed == 1
+
