+@pytest.mark.parametrize(
+    ("help", "max_length", "expect"),
+    [
+        # Exactly hits the limit before the last word, truncated with "...".
+        ("ab cd ef", 5, "ab..."),
+        # The very first word is too long, nothing but the suffix remains.
+        ("abcdefghij", 5, "..."),
+        # The first word exactly fills the limit with more words following.
+        ("hello world", 5, "..."),
+        # Exactly fits, no truncation needed.
+        ("hello world", 11, "hello world"),
+        # Multiple words need to be removed to fit the suffix.
+        ("aa bb cc dd ee ff gg", 10, "aa bb..."),
+    ],
+)
