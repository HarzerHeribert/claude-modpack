+def test_lazy_file_dash_write(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    # The repr is delegated to the already opened stream.
+    assert repr(lf) == repr(lf._f)
+    # Not opened by the lazy file, so it must not be closed.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    with lf as f:
+        f.write("hello")
+    assert not lf._f.closed
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+
+def test_lazy_file_opens_on_attribute_access(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(os.fspath(path), "w", encoding="utf-8")
+    assert lf._f is None
+    lf.write("data")
+    assert lf._f is not None
+    # Opening again returns the same file.
+    assert lf.open() is lf._f
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert lf._f.closed
+    assert path.read_text(encoding="utf-8") == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
