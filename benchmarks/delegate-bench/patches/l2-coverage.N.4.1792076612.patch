+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.attr = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_ok():
+    wrapped = _FlushRaises(None)
+    p = _PacifyFlushWrapper(wrapped)
+    assert p.wrapped is wrapped
+    p.flush()
+    assert p.attr == "proxied"
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    p = _PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "pipe")))
+    p.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    p = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        p.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_io():
+    buf = io.StringIO()
+    p = _PacifyFlushWrapper(buf)
+    p.write("x")
+    p.flush()
+    assert p.getvalue() == "x"
+
