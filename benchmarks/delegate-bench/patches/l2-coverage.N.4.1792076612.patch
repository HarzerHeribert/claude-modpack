+def test_keep_open_file_proxy():
+    buf = io.StringIO()
+    kof = _KeepOpenFile(buf)
+    assert repr(kof) == repr(buf)
+
+    with kof as f:
+        assert f is kof
+        f.write("a\nb\n")
+
+    assert not buf.closed
+    buf.seek(0)
+    assert list(kof) == ["a\n", "b\n"]
+    kof.close()
+    assert buf.closed
+
