+class _FlushRaises:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.err is not None:
+            raise OSError(self.err, os.strerror(self.err))
+
+
+def test_pacify_flush_wrapper_ok():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(None))
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    click.utils._PacifyFlushWrapper(_FlushRaises(errno.EPIPE)).flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(errno.EIO))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/example-app", "--flag"])
+    assert click.utils._detect_program_name() == "example-app"
+
+
+def test_detect_program_name_module():
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    assert (
+        click.utils._detect_program_name("/path/example/cli.py", _main=main)
+        == "python -m example.cli"
+    )
+    assert (
+        click.utils._detect_program_name("/path/example/__main__.py", _main=main)
+        == "python -m example"
+    )
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(
+        ["~/nothing-here", "$CLICK_TEST"], user=False, env=False
+    ) == ["~/nothing-here", "$CLICK_TEST"]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
+
+def test_deprecated_module_attributes():
+    with pytest.warns(DeprecationWarning, match="click.utils.safecall"):
+        assert click.utils.safecall is click.utils._safecall
+
+
+def test_unknown_module_attribute():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
