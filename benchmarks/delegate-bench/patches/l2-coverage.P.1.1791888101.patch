+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (b"bytes", "bytes"),
+        (b"bad \xff byte", "bad � byte"),
+    ],
+)
+def test_make_str(value, expect):
+    assert click.utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        # Exactly reaches max length before the last word.
+        pytest.param("aaaa bbbb cccc", 9, "aaaa...", id="exact length mid"),
+        # The first word alone is already too long.
+        pytest.param("aaaaaaaaaa bbb", 5, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help_edges(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("hello")
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_open_error(tmp_path):
+    path = tmp_path / "missing" / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename == str(path)
+
+
+def test_lazy_file_read_error_is_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_dash_stdout(monkeypatch):
+    out = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+
+    with lf as f:
+        f.write("hello")
+
+    assert repr(lf) == repr(lf._f)
+    # close_intelligently must not close the borrowed stream.
+    lf._f.write(" world")
+    lf._f.flush()
+    assert out.getvalue() == "hello world"
+
+
+def test_keep_open_file(tmp_path):
+    path = tmp_path / "data.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as raw:
+        kof = click.utils._KeepOpenFile(raw)
+        assert repr(kof) == repr(raw)
+        assert kof.name == raw.name
+
+        with kof as f:
+            assert list(f) == ["a\n", "b\n"]
+
+        assert not raw.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_dash_keeps_open(monkeypatch):
+    out = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    f = click.utils.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+
+    with f:
+        f.write("x")
+
+    assert not out.closed
+
