+class _TextOnlyWriter:
+    """Rejects empty bytes during binary detection, accepts anything else."""
+
+    def __init__(self):
+        self.data = []
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("not binary")
+
+        self.data.append(value)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyWriter()
+    click.utils.echo(b"hello", file=f)
+    assert f.data == ["", b"hello\n"]
+
+
+def test_echo_no_message_no_newline():
+    f = io.StringIO()
+    click.utils.echo(None, file=f, nl=False)
+    assert f.getvalue() == ""
+
+
+def test_echo_no_default_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.utils.echo("lost")
+    click.utils.echo("lost", err=True)
+
+
+def test_get_binary_stream():
+    assert click.utils._get_binary_stream("stdin") is not None
+
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        click.utils._get_binary_stream("bad")
+
+
+def test_get_text_stream():
+    stream = click.utils._get_text_stream("stderr")
+    assert hasattr(stream, "write")
+
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        click.utils._get_text_stream("bad")
+
+
+def test_format_filename_bytes():
+    assert click.utils.format_filename(b"a\xffb") == "a�b"
+    assert click.utils.format_filename(b"/dir/name.txt", shorten=True) == "name.txt"
+
+
+def test_format_filename_surrogate():
+    name = b"a\xffb".decode("utf-8", "surrogateescape")
+    assert click.utils.format_filename(name) == "a�b"
+
