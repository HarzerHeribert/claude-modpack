+def test_keepopenfile_proxies_and_stays_open():
+    buf = io.StringIO("line1\nline2\n")
+    kf = _KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    assert list(kf) == ["line1\n", "line2\n"]
+
+    with kf as f:
+        assert f is kf
+
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "regular.txt"
+    path.write_text("content")
+
+    with open_file(path) as f:
+        assert not isinstance(f, _KeepOpenFile)
+        assert f.read() == "content"
+
+
+def test_open_file_dash_keeps_stream_open(runner):
+    with runner.isolation(input="in\n"):
+        f = open_file("-")
+        assert isinstance(f, _KeepOpenFile)
+
+        with f:
+            assert f.read() == "in\n"
+
+        assert not f.closed
