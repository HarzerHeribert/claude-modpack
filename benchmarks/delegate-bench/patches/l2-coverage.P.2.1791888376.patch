+def test_lazyfile_dash_read(runner):
+    with runner.isolation(input="hello\n"):
+        lf = _LazyFile("-")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        assert lf.read() == "hello\n"
+        # Does not close a borrowed stream.
+        lf.close_intelligently()
+        assert not lf._f.closed
+
+
+def test_lazyfile_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    with lf as f:
+        f.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+
+
+def test_lazyfile_open_twice_returns_same(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("abc")
+    lf = _LazyFile(path)
+    first = lf.open()
+    assert lf.open() is first
+    lf.close()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
