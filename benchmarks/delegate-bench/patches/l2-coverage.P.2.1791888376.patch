+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (b"bytes", "bytes"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expected):
+    assert make_str(value) == expected
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    # Not valid in the filesystem encoding, falls back to UTF-8.
+    assert make_str(b"caf\xc3\xa9") == "café"
+    # Not valid in either, invalid bytes are replaced.
+    assert make_str(b"caf\xff") == "caf�"
+
