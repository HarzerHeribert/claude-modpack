+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    wrapped = _PacifyFlushWrapper(_FlushRaises(None))
+    wrapped.flush()
+    assert wrapped.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapped = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "pipe")))
+    wrapped.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    exc = OSError(errno.EIO, "io")
+    wrapped = _PacifyFlushWrapper(_FlushRaises(exc))
+
+    with pytest.raises(OSError) as info:
+        wrapped.flush()
+
+    assert info.value is exc
+
