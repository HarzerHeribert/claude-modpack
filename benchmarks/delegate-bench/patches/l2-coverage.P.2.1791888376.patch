+def test_short_help_exact_length_not_last_word():
+    # The first two words fill max_length exactly, but more words follow.
+    assert _make_default_short_help("aaaa bbbb cccc", max_length=9) == "aaaa..."
+
+
+def test_short_help_first_word_too_long():
+    assert _make_default_short_help("a" * 50, max_length=10) == "..."
+
+
+def test_short_help_no_rewrap_marker_and_paragraph():
+    text = "\b\nFirst line here.\n\nSecond paragraph."
+    assert _make_default_short_help(text) == "First line here."
+
+
+def test_short_help_empty():
+    assert _make_default_short_help("   \n\n  ") == ""
+
