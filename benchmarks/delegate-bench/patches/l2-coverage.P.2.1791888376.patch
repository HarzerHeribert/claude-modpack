+class _TextOnlyWriter:
+    """Rejects empty writes of either type, so it is not detected as a
+    binary writer, but accepts any non-empty data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _TextOnlyWriter()
+    echo(b"raw", file=out)
+    assert out.data == [b"raw\n"]
+    assert out.flushed == 1
+
+
+def test_echo_bytes_to_binary_file():
+    out = io.BytesIO()
+    echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_object_and_none():
+    out = io.StringIO()
+    echo(123, file=out)
+    echo(None, file=out)
+    echo(file=out, nl=False)
+    assert out.getvalue() == "123\n\n"
+
+
+def test_echo_strips_ansi_for_non_tty():
+    out = io.StringIO()
+    echo("\033[31mred\033[0m", file=out)
+    assert out.getvalue() == "red\n"
+    out = io.StringIO()
+    echo("\033[31mred\033[0m", file=out, color=True)
+    assert out.getvalue() == "\033[31mred\033[0m\n"
+
+
+def test_echo_err(runner):
+    with runner.isolation() as (_, err, _):
+        echo("to stderr", err=True)
+        assert err.getvalue() == b"to stderr\n"
+
