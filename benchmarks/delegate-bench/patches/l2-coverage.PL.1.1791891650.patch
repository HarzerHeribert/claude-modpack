+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _posixify
+from click.utils import _safecall
+from click.utils import make_str
+
+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    assert _safecall(lambda x: x * 2)(21) == 42
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"caf\xc3\xa9", "café"),
+        (b"\xff", "�"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expect
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_default_short_help_exact_length_not_last_word():
+    # The second word lands exactly on the limit, but more words follow.
+    assert _make_default_short_help("ab cd ef", 5) == "ab..."
+
+
+def test_default_short_help_first_word_too_long():
+    assert _make_default_short_help("averyveryverylongword", 5) == "..."
+
+
+def test_lazy_file_dash_uses_standard_stream(monkeypatch):
+    stdin = io.TextIOWrapper(io.BytesIO(b"data\n"), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdin", stdin)
+    lf = _LazyFile("-")
+    assert lf._f is stdin
+    assert not lf.should_close
+    assert repr(lf) == repr(stdin)
+    # A standard stream is never closed by the lazy file.
+    lf.close_intelligently()
+    assert not stdin.closed
+    assert lf.read() == "data\n"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.close()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+class _TextOnlyWriter:
+    """Rejects the empty bytes probe, so echo can't find a binary writer,
+    but records everything else it's given.
+    """
+
+    def __init__(self):
+        self.written = []
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("not a binary stream")
+
+        if data:
+            self.written.append(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _TextOnlyWriter()
+    click.echo(b"hello", file=out)
+    assert out.written == [b"hello\n"]
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_binary_stream("stdfoo")
+
+
+def test_get_text_stream(monkeypatch):
+    stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+    assert _get_text_stream("stdout") is stdout
+
+
+def test_get_text_stream_rewraps_encoding(monkeypatch):
+    stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+    rv = _get_text_stream("stdout", encoding="latin-1")
+    assert rv is not stdout
+    assert rv.encoding == "latin-1"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_text_stream("stdfoo")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    # Opening for writing is deferred until first use.
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
