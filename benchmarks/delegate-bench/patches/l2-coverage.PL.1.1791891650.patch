+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "<stream>"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    stream = _FlushStream()
+    _PacifyFlushWrapper(stream).flush()
+    assert stream.flushed
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    stream = _FlushStream(OSError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(stream).flush()
+
+
+def test_pacify_flush_wrapper_raises_other_errors():
+    stream = _FlushStream(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(stream).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    assert _PacifyFlushWrapper(_FlushStream()).name == "<stream>"
+
+
+@pytest.mark.parametrize(
+    ("package", "argv0", "expect"),
+    [
+        (None, os.path.join("bin", "example.py"), "example.py"),
+        ("example", os.path.join("example", "__main__.py"), "python -m example"),
+    ],
+)
+def test_detect_program_name_defaults(monkeypatch, package, argv0, expect):
+    main = types.ModuleType("__main__")
+    main.__package__ = package
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [argv0])
+    assert _detect_program_name() == expect
+
+
+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
