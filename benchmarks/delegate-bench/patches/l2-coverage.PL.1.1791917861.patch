+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+import typing as t
+
+import pytest
+
+from click import utils
+from click.exceptions import FileError
+
+
+def _patch_stdout(monkeypatch):
+    # Patch inside the test body: pytest's output capture re-binds
+    # sys.stdout after fixture setup, discarding a patch made there.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_safecall_returns_result():
+    def add(a, b):
+        return a + b
+
+    wrapped = utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        pytest.param(b"hello", "hello", id="valid bytes"),
+        pytest.param(b"\xff", "�", id="invalid bytes"),
+        pytest.param(42, "42", id="non-bytes"),
+    ],
+)
+def test_make_str(value, expect):
+    assert utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("12345 789 more", 9, "12345...", id="exact length, not last"),
+        pytest.param("abcdefghijkl more", 10, "...", id="first word too long"),
+        pytest.param("abcdefgh ij kl", 10, "...", id="shrinks to nothing"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazyfile_dash_uses_standard_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = utils._LazyFile("-", "w")
+    assert lf._f is fake_stdout
+    assert not lf.should_close
+    assert repr(lf) == repr(fake_stdout)
+    lf.close_intelligently()
+    assert not fake_stdout.closed
+
+
+def test_lazyfile_unopened_repr_and_lazy_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{utils.format_filename(path)}' w>"
+    assert not path.exists()
+
+    with lf:
+        lf.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keepopenfile_repr_and_iter(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kf = utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as entered:
+            assert entered is kf
+            assert list(kf) == ["a\n", "b\n"]
+
+        assert not f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
