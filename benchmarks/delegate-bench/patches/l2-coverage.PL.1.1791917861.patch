+def test_echo_bytes_without_binary_writer():
+    class TextOnlyEmptyStream:
+        """Rejects empty writes so it is not detected as a binary or text
+        writer, but still accepts the real payload.
+        """
+
+        def __init__(self):
+            self.data = []
+
+        def write(self, value):
+            if not value:
+                raise TypeError("empty write")
+
+            self.data.append(value)
+
+        def flush(self):
+            pass
+
+    stream = TextOnlyEmptyStream()
+    utils.echo(b"hi", file=t.cast("t.IO[t.Any]", stream))
+    assert stream.data == [b"hi\n"]
+
+
+def test_get_binary_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert utils._get_binary_stream("stdout") is fake_stdout.buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert utils._get_text_stream("stdout") is fake_stdout
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")  # type: ignore[arg-type]
+
