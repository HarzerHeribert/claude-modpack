+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "stream"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def _pacify(stream):
+    return utils._PacifyFlushWrapper(t.cast("t.IO[t.Any]", stream))
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = _pacify(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.name == "stream"
+
+
+def test_pacify_flush_wrapper_ignores_epipe():
+    _pacify(_FlushStream(OSError(errno.EPIPE, "broken pipe"))).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _pacify(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError, match="io"):
+        wrapper.flush()
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("path", "to", "app.py")])
+    assert utils._detect_program_name() == "app.py"
+
