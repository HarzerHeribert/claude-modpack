+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is stream
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+
+    lf.write("hi")
+    # A standard stream is borrowed, so it must stay open.
+    lf.close_intelligently()
+    assert not stream.closed
+    stream.flush()
+    assert stream.buffer.getvalue() == b"hi"
+
+
+def test_lazyfile_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    try:
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close()
+
+    assert f.closed
+
+
+def test_lazyfile_context_manager_closes(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils._LazyFile(path, "w") as lf:
+        lf.write("data")
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_keepopenfile_repr_and_context():
+    f = io.StringIO("data")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as entered:
+        assert entered is kf
+        assert entered.read() == "data"
+
+    assert not f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    # Lazy write mode does not create the file until it is used.
+    assert not path.exists()
+
+    f.write("hello")
+    f.close()
+    assert path.read_text() == "hello"
+
