+def test_make_str_decodes_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(b"hello") == "hello"
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    # Not decodable with the filesystem encoding, so UTF-8 is used instead.
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"caf\xc3\xa9") == "café"
+    assert click.utils.make_str(b"\xff") == "�"
+
+
+def test_make_str_non_bytes():
+    assert click.utils.make_str(42) == "42"
+
