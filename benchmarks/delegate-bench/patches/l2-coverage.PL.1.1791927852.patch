+class _Flushable:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "<wrapped>"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    wrapped = _Flushable()
+    wrapper = click.utils._PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapped.flushed
+    # Other attributes are proxied to the wrapped object.
+    assert wrapper.name == "<wrapped>"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _Flushable(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _Flushable(OSError(errno.EIO, "I/O error"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
