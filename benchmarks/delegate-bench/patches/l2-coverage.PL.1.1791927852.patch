+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # The limit is reached exactly mid-sentence, so it is truncated.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long, nothing but the suffix remains.
+        ("abcdefghijkl more", 5, "..."),
+        # A blank help string has no words.
+        ("   \n  ", 45, ""),
+    ],
+)
+def test_make_default_short_help_edge_cases(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
