+class _TextOnlySink:
+    """A file-like object that rejects empty writes, so it is detected as
+    neither a binary nor a text writer, and has no binary buffer.
+    """
+
+    def __init__(self):
+        self.data = []
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+        return len(value)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    sink = _TextOnlySink()
+    click.echo(b"hi", file=sink)
+    assert sink.data == [b"hi\n"]
+
+
+def test_echo_empty_message_only_flushes():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    assert out.getvalue() == ""
+
