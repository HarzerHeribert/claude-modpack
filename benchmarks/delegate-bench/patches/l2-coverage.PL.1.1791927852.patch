+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    # Without arguments, the __main__ module and sys.argv[0] are used.
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("somewhere", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain("example"))
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "__main__.py")])
+    assert click.utils._detect_program_name() == "python -m example"
+
