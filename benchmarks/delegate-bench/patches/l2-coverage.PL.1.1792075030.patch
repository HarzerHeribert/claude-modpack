+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", ["/path/to/app.py", "--flag"])
+    monkeypatch.setitem(sys.modules, "__main__", types.ModuleType("__main__"))
+    assert _detect_program_name() == "app.py"
+
+
+def test_expand_args_without_user_and_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    args = ["~", "$CLICK_TEST_VAR"]
+    assert _expand_args(args, user=False, env=False) == args
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"], user=False, env=False) == ["[bad"]
