+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_result():
+    assert _safecall(lambda a, b=0: a + b)(1, b=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = _safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+def test_make_str_decodes_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str("\N{SNOWMAN}".encode()) == "\N{SNOWMAN}"
+
+
+def test_make_str_invalid_bytes_replaced(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+def test_make_str_non_bytes():
+    assert make_str(42) == "42"
+
+
+@pytest.mark.parametrize(
+    ("text", "max_length", "expected"),
+    [
+        # Length lands exactly on the limit before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long: nothing is kept.
+        ("abcdefghijkl mn", 5, "..."),
+        ("abcdefghijkl", 5, "..."),
+        # Only whitespace.
+        ("   \n  ", 10, ""),
+    ],
+)
+def test_make_default_short_help_edges(text, max_length, expected):
+    assert _make_default_short_help(text, max_length) == expected
+
+
+def test_lazy_file_dash_is_not_closed(runner):
+    with runner.isolation():
+        lf = _LazyFile("-")
+        assert lf.should_close is False
+        assert repr(lf) == repr(sys.stdin)
+        lf.close_intelligently()
+        assert not sys.stdin.closed
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr(runner):
+    with runner.isolation():
+        f = click.open_file("-", "w")
+        assert isinstance(f, _KeepOpenFile)
+        assert repr(f) == repr(f._file)
+
+
+def test_echo_bytes_without_binary_writer():
+    class TextOnly:
+        """Refuses the empty-bytes probe and has no binary buffer, so echo
+        falls back to writing the bytes to the stream directly.
+        """
+
+        def __init__(self):
+            self.data = []
+
+        def write(self, x):
+            if isinstance(x, bytes) and not x:
+                raise TypeError("text only")
+
+            self.data.append(x)
+
+        def flush(self):
+            pass
+
+    out = TextOnly()
+    click.echo(b"hi", file=out)
+    assert out.data[-1] == b"hi\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation() as (stdout, _, _):
+        stream = _get_text_stream("stdout")
+        stream.write("hello")
+        stream.flush()
+        assert stdout.getvalue() == b"hello"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
