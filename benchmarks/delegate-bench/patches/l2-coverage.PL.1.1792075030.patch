+class _Flushable:
+    name = "wrapped-stream"
+
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushes = 0
+
+    def flush(self):
+        self.flushes += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flushes():
+    stream = _Flushable()
+    _PacifyFlushWrapper(stream).flush()
+    assert stream.flushes == 1
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    stream = _Flushable(OSError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(stream).flush()
+    assert stream.flushes == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    stream = _Flushable(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(stream).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    assert _PacifyFlushWrapper(_Flushable()).name == "wrapped-stream"
+
