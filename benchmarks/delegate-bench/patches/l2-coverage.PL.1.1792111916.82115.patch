+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+@pytest.mark.parametrize(
+    ("argv0", "package", "expect"),
+    [
+        (os.path.join("bin", "tool.py"), None, "tool.py"),
+        (os.path.join("example", "__main__.py"), "example", "python -m example"),
+    ],
+)
+def test_detect_program_name_defaults(monkeypatch, argv0, package, expect):
+    monkeypatch.setattr(sys, "argv", [argv0])
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(package))
+    assert _detect_program_name() == expect
+
+
+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_EXPAND", "hello")
+    assert _expand_args(["~", "$CLICK_TEST_EXPAND"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST_EXPAND",
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
