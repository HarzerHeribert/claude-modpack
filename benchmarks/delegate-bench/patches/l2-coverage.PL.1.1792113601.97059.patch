+def _fake_main(package):
+    module = types.ModuleType("__main__")
+    module.__package__ = package
+    return module
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _fake_main(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_default_main(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _fake_main("example"))
+    path = os.path.join("example", "cli.py")
+    assert click.utils._detect_program_name(path) == "python -m example.cli"
+
+
+def test_detect_program_name_default_path(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "__main__.py")])
+    assert (
+        click.utils._detect_program_name(_main=_fake_main("example"))
+        == "python -m example"
+    )
+
