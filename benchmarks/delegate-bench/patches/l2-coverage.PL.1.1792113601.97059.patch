+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click.utils
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_swallows_exceptions():
+    def fail():
+        """Docstring."""
+        raise ValueError("boom")
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+    assert wrapped.__doc__ == "Docstring."
+
+
+def test_safecall_returns_value():
+    assert click.utils._safecall(lambda x, y=1: x + y)(1, y=2) == 3
+
+
+def test_make_str_bytes(monkeypatch):
+    assert click.utils.make_str(b"abc") == "abc"
+    assert click.utils.make_str(42) == "42"
+    # Undecodable with the filesystem encoding falls back to UTF-8.
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str("\N{LATIN SMALL LETTER E WITH ACUTE}".encode()) == (
+        "\N{LATIN SMALL LETTER E WITH ACUTE}"
+    )
+    assert click.utils.make_str(b"\xff") == "�"
+
+
+def test_make_default_short_help_no_rewrap_marker():
+    assert click.utils._make_default_short_help("\b\nShort help text.") == (
+        "Short help text."
+    )
+
+
+def test_make_default_short_help_exact_length_with_more_words():
+    assert click.utils._make_default_short_help("aaaa bbbbb cc", 10) == "aaaa..."
+
+
+def test_make_default_short_help_first_word_too_long():
+    assert click.utils._make_default_short_help("x" * 50, 45) == "..."
+
