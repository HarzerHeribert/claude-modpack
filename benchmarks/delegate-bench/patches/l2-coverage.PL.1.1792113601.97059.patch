+def test_lazy_file_dash_reads_stdin(runner):
+    with runner.isolation(input="hello\n"):
+        lf = click.utils._LazyFile("-")
+        assert lf._f is sys.stdin
+        assert not lf.should_close
+        assert repr(lf) == repr(sys.stdin)
+        assert lf.read() == "hello\n"
+        lf.close_intelligently()
+        assert not sys.stdin.closed
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_keep_open_file_repr_and_close(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("data")
+
+    with open(path) as f:
+        kf = click.utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as entered:
+            assert entered is kf
+            assert kf.read() == "data"
+
+        assert not f.closed
+        kf.close()
+        assert f.closed
+
+
+def test_echo_bytes_to_text_only_stream():
+    with pytest.raises(TypeError):
+        click.utils.echo(b"bytes", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation() as (out, _, _):
+        stream = click.utils._get_text_stream("stdout")
+        assert stream is sys.stdout
+        stream.write("text")
+        stream.flush()
+        assert out.getvalue() == b"text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
