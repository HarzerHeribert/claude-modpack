+def test_safecall_returns_result_and_keeps_metadata():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exceptions():
+    def boom():
+        raise ValueError("nope")
+
+    assert _safecall(boom)() is None
+
+
+def test_make_str_decodes_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str("café".encode()) == "café"
+
+
+def test_make_str_replaces_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9\xff") == "café�"
+
+
+def test_make_str_converts_other_values():
+    assert make_str(42) == "42"
+    assert make_str("text") == "text"
+
+
+def test_make_default_short_help_ignores_no_rewrap_marker():
+    assert _make_default_short_help("\b\nKeep this short.") == "Keep this short."
+
+
+def test_make_default_short_help_exact_length_before_last_word():
+    assert _make_default_short_help("abcde fghi jk", 10) == "abcde..."
+
+
+def test_make_default_short_help_first_word_too_long():
+    assert _make_default_short_help("x" * 50, 45) == "..."
+
+
+def test_lazy_file_dash_uses_stdout(monkeypatch):
+    fake_stdout = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", fake_stdout)
+    lf = _LazyFile("-", "w")
+    assert lf._f is fake_stdout
+    assert lf.should_close is False
+    assert repr(lf) == repr(fake_stdout)
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not fake_stdout.closed
+    assert fake_stdout.getvalue() == "hello"
+
+
+def test_lazy_file_repr_before_and_after_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    with lf:
+        lf.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_echo_bytes_to_text_only_stream_fails():
+    # Without a binary buffer to fall back on, bytes go straight to write().
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_get_text_stream_returns_compatible_stream(monkeypatch):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert _get_text_stream("stdout") is stream
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
