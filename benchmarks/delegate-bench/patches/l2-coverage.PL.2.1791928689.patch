+class _TextOnlyWriter:
+    """Rejects the empty bytes probe echo uses to detect a binary stream,
+    and has no ``buffer``, so echo cannot find a binary writer for it.
+    """
+
+    def __init__(self):
+        self.written = []
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("not a binary stream")
+
+        self.written.append(data)
+        return len(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _TextOnlyWriter()
+    echo(b"hello", file=out)
+    assert out.written[-1] == b"hello\n"
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = _get_text_stream("stdout")
+    stream.write("hello")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
