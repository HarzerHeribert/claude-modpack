+import errno
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click.utils
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _safecall
+from click.utils import echo
+from click.utils import get_app_dir
+from click.utils import make_str
+from click.utils import open_file
+
+
+def _patch_stdout(monkeypatch):
+    # Patch inside the test body: pytest's capture replaces sys.stdout again
+    # when the call phase starts, which would undo a patch made by a fixture.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_safecall_returns_result():
+    def double(x):
+        return x * 2
+
+    wrapped = _safecall(double)
+    assert wrapped(3) == 6
+    assert wrapped.__name__ == "double"
+
+
+def test_safecall_swallows_exception():
+    def boom():
+        raise ValueError("boom")
+
+    assert _safecall(boom)() is None
+
+
+def test_make_str_decodes_bytes():
+    assert make_str(b"hello") == "hello"
+
+
+def test_make_str_falls_back_to_utf8_replace(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    assert make_str(b"bad\xff") == "bad�"
+
+
+def test_make_str_non_bytes():
+    assert make_str(42) == "42"
+
+
+@pytest.mark.parametrize(
+    ("text", "limit", "expected"),
+    [
+        # Exactly hits the limit before the last word, truncate with "...".
+        ("abc def ghi", 7, "abc..."),
+        # The first word alone is longer than the limit.
+        ("Supercalifragilistic word", 10, "..."),
+        # Removing words walks back to the first word without fitting.
+        ("abcdef gh", 8, "..."),
+    ],
+)
+def test_make_default_short_help_truncation(text, limit, expected):
+    assert _make_default_short_help(text, limit) == expected
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(str(path), "w")
+
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+
+    try:
+        assert repr(lf) == repr(lf._f)
+    finally:
+        lf.close()
+
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_dash_uses_stdout_and_stays_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+
+    assert lf._f is fake_stdout
+    assert lf.should_close is False
+    assert repr(lf) == repr(fake_stdout)
+
+    lf.close_intelligently()
+    assert not fake_stdout.closed
+
+
+def test_keep_open_file_repr(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    f = open_file("-", "w")
+
+    assert isinstance(f, _KeepOpenFile)
+    assert repr(f) == repr(fake_stdout)
+
+    with f:
+        f.write("hello")
+
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
