+class _FlushStream(io.StringIO):
+    def __init__(self, error=None):
+        super().__init__()
+        self.error = error
+        self.flushed = False
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    stream = _FlushStream()
+    wrapper = utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = utils._PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = utils._PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    stream = _FlushStream()
+    wrapper = utils._PacifyFlushWrapper(stream)
+    wrapper.write("proxied")
+    assert stream.getvalue() == "proxied"
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    monkeypatch.setitem(sys.modules, "__main__", types.ModuleType("__main__"))
+    assert utils._detect_program_name() == "app.py"
+
