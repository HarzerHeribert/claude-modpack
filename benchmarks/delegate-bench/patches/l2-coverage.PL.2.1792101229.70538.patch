+import errno
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click import utils
+
+
+def test_posixify():
+    assert utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def boom():
+        raise ValueError("boom")
+
+    assert utils._safecall(boom)() is None
+
+
+def test_make_str_bytes():
+    assert utils.make_str(b"abc") == "abc"
+    assert utils.make_str(42) == "42"
+
+
+def test_make_str_bytes_fallback_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert utils.make_str("é".encode()) == "é"
+    assert utils.make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("text", "max_length", "expected"),
+    [
+        # Exactly reaching the limit before the last word truncates.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghijklmnop", 5, "..."),
+    ],
+)
+def test_make_default_short_help_truncation(text, max_length, expected):
+    assert utils._make_default_short_help(text, max_length) == expected
+
+
+def test_lazy_file_dash_uses_stdout_and_stays_open(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    lf = utils._LazyFile("-", "w")
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+
+    with lf:
+        lf.write("hello")
+
+    lf.close_intelligently()
+    assert not stream.closed
+    assert stream.getvalue() == "hello"
+
+
+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    f = click.open_file("-", "w")
+    assert isinstance(f, utils._KeepOpenFile)
+    assert repr(f) == repr(stream)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
