+class _NoBinaryWriterStream:
+    """Rejects empty writes, so it is detected as neither a binary nor a
+    text writer, but still accepts real data.
+    """
+
+    def __init__(self):
+        self.chunks = []
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.chunks.append(data)
+        return len(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _NoBinaryWriterStream()
+    click.echo(b"hi", file=stream)
+    assert stream.chunks == [b"hi\n"]
+
+
+def test_get_binary_stream(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+    assert utils._get_binary_stream("stdout") is buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream(monkeypatch):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert utils._get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        utils._get_text_stream("bogus")
+
