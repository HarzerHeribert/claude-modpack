+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = utils._LazyFile("-", "w")
+
+    assert lf.should_close is False
+    assert repr(lf) == repr(stream)
+
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not stream.closed
+    assert stream.getvalue() == "hello"
+
+
+def test_lazyfile_write_opens_on_first_access(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+
+    assert not path.exists()
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+
+    with lf:
+        lf.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    lf = utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.filename == os.fspath(tmp_path / "missing" / "out.txt")
+
+
+def test_keepopenfile_proxies_and_stays_open():
+    stream = io.StringIO("line\n")
+    kof = utils._KeepOpenFile(stream)
+
+    assert repr(kof) == repr(stream)
+
+    with kof as f:
+        assert f is kof
+        assert f.read() == "line\n"
+
+    assert not stream.closed
+    kof.close()
+    assert stream.closed
+
