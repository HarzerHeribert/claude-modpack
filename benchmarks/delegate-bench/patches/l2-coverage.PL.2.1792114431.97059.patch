+class _RejectEmptyWrites:
+    """A stream that cannot be probed for binary support, so ``echo`` writes
+    bytes to it directly.
+    """
+
+    def __init__(self):
+        self.written = []
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.written.append(value)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _RejectEmptyWrites()
+    click.echo(b"hello", file=stream)
+    assert stream.written == [b"hello\n"]
+
+
+def test_echo_empty_message_only_flushes():
+    stream = io.StringIO()
+    click.echo("", file=stream, nl=False)
+    assert stream.getvalue() == ""
+
+
