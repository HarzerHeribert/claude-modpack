+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_stream_open(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, utils._KeepOpenFile)
+        f.write("out")
+
+    assert not stream.closed
+    assert stream.getvalue() == "out"
+
