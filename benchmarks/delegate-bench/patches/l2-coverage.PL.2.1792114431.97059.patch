+        pytest.param("aaaa bbbb cccc", 9, "aaaa...", id="exact length, more words"),
+        pytest.param("a" * 50, 45, "...", id="single word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert utils._make_default_short_help(value, max_length) == expect
+
