+def test_get_app_dir_windows_roaming(monkeypatch):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", "/appdata/roaming")
+    monkeypatch.setenv("LOCALAPPDATA", "/appdata/local")
+    assert click.get_app_dir("Foo Bar") == os.path.join("/appdata/roaming", "Foo Bar")
+    assert click.get_app_dir("Foo Bar", roaming=False) == os.path.join(
+        "/appdata/local", "Foo Bar"
