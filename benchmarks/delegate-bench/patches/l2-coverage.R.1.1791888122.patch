+class _FlushingStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.value = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    inner = _FlushingStream()
+    wrapper = utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.value == "proxied"
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    inner = _FlushingStream(OSError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushingStream(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
