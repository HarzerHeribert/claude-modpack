+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Length lands exactly on max_length before the last word.
+        ("ab cd ef", 5, "ab..."),
+        # The first word alone is already too long.
+        ("a" * 50, 45, "..."),
+        # Exactly max_length on the last word, no truncation.
+        ("ab cd", 5, "ab cd"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
