+def test_echo_bytes_without_binary_writer():
+    # A text-only stream has no binary buffer, so the bytes reach the text
+    # stream's write directly, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(b"hello", file=out)
+    assert out.getvalue() == b"hello\n"
+
+
+def test_echo_bytearray_no_newline():
+    out = io.BytesIO()
+    click.echo(bytearray(b"hi"), file=out, nl=False)
+    assert out.getvalue() == b"hi"
+
+
+def test_echo_empty_message_flushes():
+    out = io.StringIO()
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_converted_to_str():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(utils, "_default_text_stderr", lambda: None)
+    assert click.echo("hello") is None
+    assert click.echo("hello", err=True) is None
+
+
+def test_echo_strips_ansi_for_non_tty():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out)
+    assert out.getvalue() == "red\n"
+
+
+def test_echo_keeps_ansi_with_color():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "\x1b[31mred\x1b[0m\n"
+
