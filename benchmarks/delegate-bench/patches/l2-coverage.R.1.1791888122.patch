+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(name, monkeypatch):
+    called = []
+    monkeypatch.setitem(
+        utils.binary_streams, name, lambda: called.append(name) or "stream"
+    )
+    assert utils._get_binary_stream(name) == "stream"
+    assert called == [name]
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")
+
+
+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_text_stream(name, monkeypatch):
+    calls = []
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return "stream"
+
+    monkeypatch.setitem(utils.text_streams, name, opener)
+    assert utils._get_text_stream(name, "latin-1", "replace") == "stream"
+    assert utils._get_text_stream(name) == "stream"
+    assert calls == [("latin-1", "replace"), (None, "strict")]
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")
+
+
+def test_get_text_stream_real():
+    stream = utils._get_text_stream("stderr")
+    assert hasattr(stream, "write")
