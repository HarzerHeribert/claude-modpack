+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    # Opening again returns the same file object.
+    assert lf.open() is lf._f
+    lf.close_intelligently()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_without_open(tmp_path):
+    lf = utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_dash_does_not_close():
+    lf = utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        assert f is lf
+
+    assert not lf._f.closed
+
+
+def test_keep_open_file_repr_and_iter():
+    inner = io.StringIO("a\nb\n")
+    kof = utils._KeepOpenFile(inner)
+    assert repr(kof) == repr(inner)
+    assert list(kof) == ["a\n", "b\n"]
+
+    with kof as f:
+        assert f is kof
+
+    assert not inner.closed
+    assert kof.getvalue() == "a\nb\n"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_dash_keeps_open():
+    f = utils.open_file("-", "w")
+    assert isinstance(f, utils._KeepOpenFile)
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("content")
+
+    with utils.open_file(path) as f:
+        assert f.read() == "content"
+
+    assert f.closed
+
