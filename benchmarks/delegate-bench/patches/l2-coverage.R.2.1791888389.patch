+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "fake"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed += 1
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed == 1
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "Broken pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "I/O error")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    assert wrapper.name == "fake"
+    assert wrapper.wrapped is stream
+
+    with pytest.raises(AttributeError):
+        wrapper.missing  # noqa: B018
+
+
+def test_detect_program_name_defaults_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("path", "to", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_defaults_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(
+        sys, "argv", [os.path.join("path", "example", "__main__.py")]
+    )
+    assert _detect_program_name() == "python -m example"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=True)) == [
+        "b.txt",
+        os.path.join("sub", "a.txt"),
+    ]
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "a.txt")
+    ]
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_module_attributes(name):
+    with pytest.deprecated_call():
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
+
+
+def test_unknown_module_attribute():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
