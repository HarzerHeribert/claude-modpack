+
+def test_safecall_returns_result():
+    assert _safecall(lambda x, y=0: x + y)(1, y=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = _safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str("café".encode()) == "café"
+
+
+def test_make_str_bytes_undecodable(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+def test_make_str_non_bytes():
+    assert make_str(42) == "42"
+
+
+def test_short_help_exact_length_not_last_word():
+    assert _make_default_short_help("aaaa bbbb cccc", max_length=9) == "aaaa..."
+
+
+def test_short_help_first_word_too_long():
+    assert _make_default_short_help("abcdefghij klm", max_length=5) == "..."
+
+
+def test_lazy_file_dash_uses_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = _LazyFile("-", "w")
+
+    assert lf._f is stream
+    assert lf.should_close is False
+    assert repr(lf) == repr(stream)
+
+    lf.close_intelligently()
+    assert not stream.closed
+
+
+def test_lazy_file_unopened_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+
+def test_keep_open_file_repr():
+    stream = io.StringIO()
+    assert repr(_KeepOpenFile(stream)) == repr(stream)
+
+
+class _BytesOnlyWhenNonEmpty:
+    """A sink without a binary buffer that still accepts non-empty bytes."""
+
+    def __init__(self):
+        self.data = []
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("probe rejected")
+        self.data.append(value)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    sink = _BytesOnlyWhenNonEmpty()
+    echo(b"hello", file=sink)
+    assert sink.data[-1] == b"hello\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert _get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
