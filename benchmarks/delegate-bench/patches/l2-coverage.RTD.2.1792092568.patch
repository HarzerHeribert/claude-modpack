+def test_echo_stringio_bytes():
+    # A text stream with no binary buffer falls through to a plain write.
+    class TextOnly:
+        def __init__(self):
+            self.parts = []
+
+        def write(self, s):
+            self.parts.append(s)
+
+        def flush(self):
+            pass
+
+    f = TextOnly()
+    click.echo("a", file=f, nl=False)
+    assert f.parts == ["a"]
+
