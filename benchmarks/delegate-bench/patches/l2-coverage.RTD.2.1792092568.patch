+def test_lazyfile_write(tmp_path):
+    p = tmp_path / "out.txt"
+    lf = utils._LazyFile(p, "w")
+    assert not p.exists()
+    assert "unopened file" in repr(lf)
+    assert "w" in repr(lf)
+    lf.close()  # not opened yet, nothing to do
+    lf.close_intelligently()
+    with lf as f:
+        f.write("data")
+        assert repr(lf) == repr(lf._f)
+    assert p.read_text() == "data"
+    assert lf.closed
+
