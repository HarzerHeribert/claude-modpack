+def test_expand_args(tmp_path, monkeypatch):
+    (tmp_path / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    sub = tmp_path / "sub"
+    sub.mkdir()
+    (sub / "c.txt").write_text("")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("CLICK_TEST_DIR", str(tmp_path))
+
+    base = str(tmp_path)
+    assert sorted(utils._expand_args([f"{base}/*.txt"])) == [
+        f"{base}/a.txt",
+        f"{base}/b.txt",
+    ]
+    assert utils._expand_args(["~/a.txt"]) == [f"{base}/a.txt"]
+    assert utils._expand_args(["~/a.txt"], user=False) == ["~/a.txt"]
+    assert utils._expand_args(["$CLICK_TEST_DIR/a.txt"]) == [f"{base}/a.txt"]
+    assert utils._expand_args(["$CLICK_TEST_DIR/a.txt"], env=False) == [
+        "$CLICK_TEST_DIR/a.txt"
+    ]
+    assert utils._expand_args([f"{base}/nomatch*"]) == [f"{base}/nomatch*"]
+    assert utils._expand_args([f"{base}/**/c.txt"]) == [f"{base}/sub/c.txt"]
+
+
