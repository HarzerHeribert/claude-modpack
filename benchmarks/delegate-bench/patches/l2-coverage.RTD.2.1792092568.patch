+def test_lazyfile_dash(monkeypatch):
+    stdin = io.StringIO("hi")
+    monkeypatch.setattr(sys, "stdin", stdin)
+    lf = utils._LazyFile("-")
+    assert lf.name == "-"
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+    lf.close_intelligently()
+    assert not stdin.closed
+
