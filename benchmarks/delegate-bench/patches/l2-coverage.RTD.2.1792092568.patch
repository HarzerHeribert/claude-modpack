+def test_open_file_variants(tmp_path, monkeypatch):
+    p = tmp_path / "f.txt"
+    with click.open_file(p, "w") as f:
+        f.write("x")
+    assert p.read_text() == "x"
+
+    lf = click.open_file(p, "r", lazy=True)
+    assert isinstance(lf, utils._LazyFile)
+    lf.close()
+
+    with click.open_file(p, "w", atomic=True) as f:
+        f.write("atomic")
+    assert p.read_text() == "atomic"
+
+    out = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    f = click.open_file("-", "w")
+    assert isinstance(f, utils._KeepOpenFile)
+    with f:
+        f.write("z")
+    assert not out.closed
