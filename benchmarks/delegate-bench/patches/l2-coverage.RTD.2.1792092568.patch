+def test_lazyfile_iter_and_getattr(tmp_path):
+    p = tmp_path / "in.txt"
+    p.write_text("a\nb\n")
+    lf = utils._LazyFile(p)
+    assert list(lf) == ["a\n", "b\n"]
+    lf.close()
+    lf2 = utils._LazyFile(p)
+    assert lf2.read() == "a\nb\n"
+    lf2.close()
