+def test_detect_program_name_windows_exe(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils.os, "name", "nt")
+    exe = tmp_path / "tool"
+    (tmp_path / "tool.exe").write_text("")
+    main = types.ModuleType("__main__")
+    main.__package__ = ""
+    assert utils._detect_program_name(str(exe), main) == "tool"
+    # Existing path without .exe: falls through to the "" package check.
+    exe.write_text("")
+    assert utils._detect_program_name(str(exe), main) == "tool"
+    # Non-empty package on "nt" with no exe is a module run.
+    main.__package__ = "pkg"
+    assert utils._detect_program_name(str(exe), main) == "python -m pkg.tool"
+
