+def test_pacify():
+    class W:
+        def __init__(self, err):
+            self.err = err
+            self.x = 4
+
+        def flush(self):
+            if self.err:
+                raise OSError(self.err, "e")
+
+    assert cu._PacifyFlushWrapper(W(None)).flush() is None
+    cu._PacifyFlushWrapper(W(errno.EPIPE)).flush()
+    with pytest.raises(OSError):
+        cu._PacifyFlushWrapper(W(errno.EIO)).flush()
+    assert cu._PacifyFlushWrapper(W(None)).x == 4
+
+
+def _mod(pkg):
+    m = types.ModuleType("m")
+    m.__package__ = pkg
+    return m
+
+
+def test_detect_program_name(monkeypatch, tmp_path):
+    assert cu._detect_program_name("/x/app.py", _mod(None)) == "app.py"
+    assert cu._detect_program_name("/x/app.py", _mod("")) == "app.py"
+    assert cu._detect_program_name("/x/__main__.py", _mod("pkg")) == "python -m pkg"
+    assert cu._detect_program_name("/x/cli.py", _mod("pkg")) == "python -m pkg.cli"
+    monkeypatch.setattr(sys, "argv", ["/y/prog.py"])
+    assert cu._detect_program_name(None, _mod(None)) == "prog.py"
+    assert cu._detect_program_name() is not None
+    # Windows .exe branch
+    monkeypatch.setattr(os, "name", "nt")
+    exe = tmp_path / "tool"
+    (tmp_path / "tool.exe").write_text("")
+    assert cu._detect_program_name(str(exe), _mod("")) == "tool"
+    assert cu._detect_program_name(str(exe), _mod("pkg")) == "python -m pkg.tool"
+    assert cu._detect_program_name(str(tmp_path / "zz"), _mod("")) == "zz"
+    assert cu._detect_program_name(str(tmp_path / "tool.exe"), _mod("")) == "tool.exe"
+
+
+def test_expand_args(monkeypatch, tmp_path):
+    (tmp_path / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("MYD", str(tmp_path))
+    assert cu._expand_args(["~/*.txt"]) == sorted(
+        [str(tmp_path / "a.txt"), str(tmp_path / "b.txt")]
+    ) or len(cu._expand_args(["~/*.txt"])) == 2
+    assert len(cu._expand_args(["$MYD/*.txt"])) == 2
+    assert cu._expand_args(["~/*.txt"], user=False) == ["~/*.txt"]
+    assert cu._expand_args(["$MYD/x"], env=False) == ["$MYD/x"]
+    assert cu._expand_args(["[", "plain"]) == ["[", "plain"]
+    assert cu._expand_args(["**/*.txt"], glob_recursive=False) == ["**/*.txt"]
+    import glob as g
+
+    def bad(*a, **k):
+        import re
+
+        raise re.error("bad")
+
+    monkeypatch.setattr(g, "glob", bad)
+    assert cu._expand_args(["zz"]) == ["zz"]
