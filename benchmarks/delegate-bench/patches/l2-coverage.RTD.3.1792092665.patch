+def test_format_filename():
+    assert cu.format_filename("/a/b.txt", shorten=True) == "b.txt"
+    assert cu.format_filename(b"/a/b.txt") == "/a/b.txt"
+    assert cu.format_filename(b"/a/\xff") == "/a/�"
+    assert cu.format_filename("a\udcff") == "a�"
+
