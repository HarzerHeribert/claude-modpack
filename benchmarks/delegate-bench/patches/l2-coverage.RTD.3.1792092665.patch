+def test_get_app_dir(monkeypatch):
+    monkeypatch.setattr(cu, "WIN", True)
+    monkeypatch.setenv("APPDATA", "/ap")
+    monkeypatch.setenv("LOCALAPPDATA", "/lap")
+    assert cu.get_app_dir("Foo") == os.path.join("/ap", "Foo")
+    assert cu.get_app_dir("Foo", roaming=False) == os.path.join("/lap", "Foo")
+    monkeypatch.delenv("APPDATA")
+    assert cu.get_app_dir("Foo") == os.path.join(os.path.expanduser("~"), "Foo")
+    monkeypatch.setattr(cu, "WIN", False)
+    assert cu.get_app_dir("Foo Bar", force_posix=True).endswith(".foo-bar")
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert cu.get_app_dir("Foo").endswith("Library/Application Support/Foo")
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", "/xdg")
+    assert cu.get_app_dir("Foo Bar") == os.path.join("/xdg", "foo-bar")
+    monkeypatch.delenv("XDG_CONFIG_HOME")
+    assert cu.get_app_dir("Foo Bar").endswith(os.path.join(".config", "foo-bar"))
+
