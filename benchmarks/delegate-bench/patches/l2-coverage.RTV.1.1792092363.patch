+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "stream"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = click.utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.name == "stream"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushStream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushStream(OSError(errno.EBADF, "Bad file descriptor"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
