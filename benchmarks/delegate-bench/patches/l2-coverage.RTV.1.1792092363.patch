+def test_get_text_stream(monkeypatch):
+    calls = []
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return "stream"
+
+    monkeypatch.setattr(click.utils, "text_streams", {"stdout": opener})
+    assert click.utils._get_text_stream("stdout", "latin-1", "replace") == "stream"
+    assert click.utils._get_text_stream("stdout") == "stream"
+    assert calls == [("latin-1", "replace"), (None, "strict")]
+
+
+def test_get_text_stream_real():
+    with CliRunner().isolation() as (out, _, _):
+        stream = click.utils._get_text_stream("stdout")
+        stream.write("text")
+        stream.flush()
+
+    assert out.getvalue() == b"text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        click.utils._get_text_stream("bad")
+
+
+def test_deprecated_get_text_stream_alias():
+    with pytest.warns(DeprecationWarning, match="get_text_stream"):
+        func = click.utils.get_text_stream
+
+    assert func is click.utils._get_text_stream
