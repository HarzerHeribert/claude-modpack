+def test_lazyfile_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    path = tmp_path / "never.txt"
+    lf = click.utils._LazyFile(path, "w")
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazyfile_stdout_is_not_closed():
+    with CliRunner().isolation() as (out, _, _):
+        lf = click.utils._LazyFile("-", "w")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+
+        with lf as f:
+            f.write("hello")
+            f.flush()
+
+        assert not lf._f.closed
+        assert out.getvalue() == b"hello"
+
+
+def test_keepopenfile_repr_and_close(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("x")
+
+    with open(path) as raw:
+        f = click.utils._KeepOpenFile(raw)
+        assert repr(f) == repr(raw)
+
+        with f:
+            assert f.read() == "x"
+
+        assert not raw.closed
+        f.close()
+        assert raw.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy content")
+
+    assert path.read_text() == "lazy content"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "lazy.txt"
+    path.write_text("line1\nline2\n")
+
+    with click.open_file(str(path), lazy=True) as f:
+        assert list(f) == ["line1\n", "line2\n"]
+
+
+def test_open_file_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+
+    with click.open_file(path, "w", atomic=True) as f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_open_file_stdout_keeps_open():
+    with CliRunner().isolation() as (out, _, _):
+        f = click.open_file("-", "w")
+        assert isinstance(f, click.utils._KeepOpenFile)
+        assert repr(f) == repr(f._file)
+
+        with f:
+            f.write("out")
+            f.flush()
+
+        assert not f.closed
+
+    assert out.getvalue() == b"out"
+
