+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_from_argv(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "__main__.py")])
+    assert click.utils._detect_program_name(_main=_MockMain("pkg")) == "python -m pkg"
+
+
+def test_detect_program_name_relative_package():
+    path = os.path.join("pkg", "cli.py")
+    assert (
+        click.utils._detect_program_name(path, _main=_MockMain(".pkg"))
+        == "python -m pkg.cli"
+    )
+
