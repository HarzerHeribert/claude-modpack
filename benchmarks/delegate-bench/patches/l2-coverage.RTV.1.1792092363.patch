+def test_expand_args_glob_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b").mkdir()
+    (tmp_path / "a" / "b" / "c.txt").write_text("")
+    (tmp_path / "top.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    recursive = click.utils._expand_args(["**/*.txt"])
+    assert os.path.join("a", "b", "c.txt") in recursive
+    assert "top.txt" in recursive
+    flat = click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    assert os.path.join("a", "b", "c.txt") not in flat
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
