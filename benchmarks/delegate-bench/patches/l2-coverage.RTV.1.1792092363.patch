+def test_echo_bytes_to_text_only_stream_raises():
+    # No binary buffer can be found, so the bytes are passed through to
+    # the text stream, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_strips_ansi_for_non_tty():
+    out = io.StringIO()
+    click.echo(click.style("hi", fg="red"), file=out)
+    assert out.getvalue() == "hi\n"
+
+
+def test_echo_keeps_ansi_with_color():
+    out = io.StringIO()
+    styled = click.style("hi", fg="red")
+    click.echo(styled, file=out, color=True)
+    assert out.getvalue() == f"{styled}\n"
+
+
+def test_echo_object_and_empty():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == "123\n"
+
