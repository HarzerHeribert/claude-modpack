+import errno
+import glob
+import io
+import re
+import sys
+
+import pytest
+
+import click
+from click import utils
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+
+
+def test_posixify_via_force_posix(monkeypatch):
+    monkeypatch.setattr(utils, "WIN", False)
+    path = utils.get_app_dir("Foo  Bar", force_posix=True)
+    assert path.endswith(".foo-bar")
+
+
+def test_safecall():
+    def boom():
+        raise ValueError
+
+    assert utils._safecall(boom)() is None
+    assert utils._safecall(lambda: 3)() == 3
+
+
+def test_make_str():
+    assert utils.make_str(b"abc") == "abc"
+    assert utils.make_str(12) == "12"
+
+
+def test_make_str_decode_error(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert utils.make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_short_help_break_at_max_length_not_last():
+    text = "a" * 43 + " b c"
+    assert _make_default_short_help(text) == "..."
+
+
+def test_short_help_first_word_too_long():
+    assert _make_default_short_help("a" * 50 + " b") == "..."
+
+
+def test_lazy_file_dash():
+    f = _LazyFile("-", "r")
+    # "-" is opened eagerly and must not be closed by the lazy file.
+    assert f.should_close is False
+    assert f._f is not None
+    f.close_intelligently()
+
+
+def test_lazy_file_repr(tmp_path):
+    p = tmp_path / "x.txt"
+    f = _LazyFile(p, "w")
+    assert repr(f).startswith("<unopened file")
+    f.open()
+    assert "x.txt" in repr(f)
+    f.close()
+
+
+def test_lazy_file_close_unopened_and_context(tmp_path):
+    p = tmp_path / "y.txt"
+    f = _LazyFile(p, "w")
+    f.close()
+    with f:
+        pass
+    assert f._f is None
+
+
+def test_lazy_file_open_error(tmp_path):
+    f = _LazyFile(tmp_path / "no" / "z.txt", "w")
+    with pytest.raises(click.FileError):
+        f.open()
+
+
+def test_lazy_file_iter(tmp_path):
+    p = tmp_path / "r.txt"
+    p.write_text("a\nb\n")
+    f = _LazyFile(p, "r")
+    assert list(f) == ["a\n", "b\n"]
+    f.close()
+
+
+def test_keep_open_file_repr_iter():
+    s = io.StringIO("a\nb\n")
+    k = _KeepOpenFile(s)
+    assert repr(k) == repr(s)
+    assert list(k) == ["a\n", "b\n"]
+
+
+def test_open_file_lazy(tmp_path):
+    f = utils.open_file(tmp_path / "l.txt", "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    f.close()
+
+
+def test_echo_bytes_without_binary_writer():
+    class Sink:
+        def __init__(self):
+            self.data = []
+
+        def write(self, d):
+            if d == b"":
+                raise TypeError
+            self.data.append(d)
+
+        def flush(self):
+            pass
+
+    s = Sink()
+    click.echo(b"hi", file=s, nl=False)
+    assert s.data[-1] == b"hi"
+
+
+def test_unknown_streams():
+    with pytest.warns(DeprecationWarning):
+        gb = utils.get_binary_stream
+    with pytest.warns(DeprecationWarning):
+        gt = utils.get_text_stream
+    with pytest.raises(TypeError):
+        gb("nope")
+    with pytest.raises(TypeError):
+        gt("nope")
+    assert gt("stdout") is not None
+
+
+@pytest.mark.parametrize("roaming", [True, False])
+def test_get_app_dir_windows(monkeypatch, roaming):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", "/ap")
+    monkeypatch.setenv("LOCALAPPDATA", "/lap")
+    expected = "/ap" if roaming else "/lap"
+    assert utils.get_app_dir("X", roaming=roaming) == f"{expected}/X"
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    assert utils.get_app_dir("X").endswith("X")
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert utils.get_app_dir("X").endswith("Library/Application Support/X")
+
+
+def test_get_app_dir_linux(monkeypatch):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", "/xdg")
+    assert utils.get_app_dir("Foo Bar") == "/xdg/foo-bar"
+
+
+def test_pacify_flush_wrapper():
+    class F:
+        def __init__(self, err):
+            self.err = err
+            self.attr = 5
+
+        def flush(self):
+            if self.err is not None:
+                raise OSError(self.err, "x")
+
+    _PacifyFlushWrapper(F(errno.EPIPE)).flush()
+    _PacifyFlushWrapper(F(None)).flush()
+    with pytest.raises(OSError):
+        _PacifyFlushWrapper(F(errno.EIO)).flush()
+    assert _PacifyFlushWrapper(F(None)).attr == 5
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", ["/a/b/prog.py"])
+    expected = _detect_program_name("/a/b/prog.py", _main=sys.modules["__main__"])
+    assert _detect_program_name() == expected
+    name = _detect_program_name(_main=type(sys)("m"))
+    assert name == "prog.py"
+
+
+def test_detect_program_name_windows_exe(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils.os, "name", "nt")
+    main = type(sys)("m")
+    main.__package__ = ""
+    exe = tmp_path / "tool"
+    (tmp_path / "tool.exe").write_text("")
+    assert _detect_program_name(str(exe), _main=main) == "tool"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("FOO_X", "val")
+    assert _expand_args(["~/$FOO_X"], user=False, env=False) == ["~/$FOO_X"]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad(*a, **k):
+        raise re.error("bad")
+
+    monkeypatch.setattr(glob, "glob", bad)
+    assert _expand_args(["[a"]) == ["[a"]
