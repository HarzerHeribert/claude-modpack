+class TestDetectProgramName:
+    def test_defaults_from_sys(self, monkeypatch):
+        class Main:
+            __package__ = None
+
+        monkeypatch.setitem(sys.modules, "__main__", Main)
+        monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "tool.py")])
+        assert _detect_program_name() == "tool.py"
+
+    def test_module_without_package_attribute(self):
+        class Main:
+            pass
+
+        assert _detect_program_name("prog", _main=Main()) == "prog"
+
+    def test_leading_dot_stripped(self):
+        class Main:
+            __package__ = ".pkg"
+
+        assert (
+            _detect_program_name(os.path.join("pkg", "__main__.py"), _main=Main())
+            == "python -m pkg"
+        )
