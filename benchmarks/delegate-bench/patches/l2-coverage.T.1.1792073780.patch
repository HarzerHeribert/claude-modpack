+class TestLazyFile:
+    def test_dash_opens_stream_immediately(self, monkeypatch):
+        buffer = io.BytesIO()
+        stdout = io.TextIOWrapper(buffer, encoding="utf-8")
+        monkeypatch.setattr(sys, "stdout", stdout)
+        lf = _LazyFile("-", "w")
+        assert lf._f is not None
+        assert lf.should_close is False
+        lf.write("hi")
+        lf.flush()
+        # Exiting the context must not close stdout.
+        with lf:
+            pass
+        assert not stdout.closed
+        assert buffer.getvalue() == b"hi"
+        # The repr is that of the wrapped stream.
+        assert repr(lf) == repr(lf._f)
+
+    def test_repr_unopened_and_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        assert not path.exists()
+        f = lf.open()
+        # Opening again returns the same file.
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+        lf.close()
+        assert f.closed
+
+    def test_close_unopened_is_noop(self, tmp_path):
+        lf = _LazyFile(tmp_path / "never.txt", "w")
+        lf.close()
+        lf.close_intelligently()
+        assert not (tmp_path / "never.txt").exists()
+
+    def test_close_intelligently_skips_when_not_owned(self, tmp_path):
+        path = tmp_path / "f.txt"
+        lf = _LazyFile(path, "w")
+        f = lf.open()
+        lf.should_close = False
+        lf.close_intelligently()
+        assert not f.closed
+        lf.should_close = True
+        with lf:
+            lf.write("x")
+        assert f.closed
+        assert path.read_text() == "x"
+
+    def test_read_mode_checks_file_early(self, tmp_path):
+        with pytest.raises(OSError):
+            _LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error_raises_file_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "no-such-dir" / "out.txt", "w")
+        with pytest.raises(FileError) as exc_info:
+            lf.open()
+        assert exc_info.value.filename == lf.name
+
+    def test_getattr_proxies_and_opens(self, tmp_path):
+        path = tmp_path / "f.txt"
+        path.write_text("data")
+        lf = _LazyFile(path, "r")
+        assert lf._f is None
+        assert lf.read() == "data"
+        assert lf._f is not None
+        lf.close()
+
+    def test_atomic_write(self, tmp_path):
+        path = tmp_path / "atomic.txt"
+        with _LazyFile(path, "w", atomic=True) as lf:
+            lf.write("atomic")
+            assert not path.exists()
+        assert path.read_text() == "atomic"
+
