+class TestExpandArgs:
+    def test_no_user_no_env(self, monkeypatch):
+        monkeypatch.setenv("CLICK_TEST_VAR", "expanded")
+        result = _expand_args(
+            ["~/nothing-here-xyz", "$CLICK_TEST_VAR"], user=False, env=False
+        )
+        assert result == ["~/nothing-here-xyz", "$CLICK_TEST_VAR"]
+
+    def test_user_and_env(self, monkeypatch):
+        monkeypatch.setenv("CLICK_TEST_VAR", "expanded-xyz")
+        result = _expand_args(["~", "$CLICK_TEST_VAR"])
+        assert result == [os.path.expanduser("~"), "expanded-xyz"]
+
+    def test_invalid_pattern_returns_itself(self, monkeypatch):
+        def bad_glob(pattern, recursive=False):
+            raise re.error("bad pattern")
+
+        monkeypatch.setattr(glob, "glob", bad_glob)
+        assert _expand_args(["[bad"]) == ["[bad"]
+
+    def test_glob_recursive_flag(self, tmp_path, monkeypatch):
+        (tmp_path / "a" / "b").mkdir(parents=True)
+        (tmp_path / "a" / "b" / "deep.txt").write_text("")
+        (tmp_path / "top.txt").write_text("")
+        monkeypatch.chdir(tmp_path)
+        recursive = _expand_args(["**/*.txt"])
+        assert os.path.join("a", "b", "deep.txt") in recursive
+        assert "top.txt" in recursive
+        non_recursive = _expand_args(["**/*.txt"], glob_recursive=False)
+        assert os.path.join("a", "b", "deep.txt") not in non_recursive
+        assert "top.txt" not in non_recursive
+
