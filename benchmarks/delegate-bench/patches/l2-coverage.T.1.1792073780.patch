+class TestStandardStreams:
+    def test_get_binary_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+            _get_binary_stream("nope")
+
+    def test_get_text_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+            _get_text_stream("nope")
+
+    def test_get_binary_stream(self, monkeypatch):
+        buffer = io.BytesIO()
+        monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer))
+        stream = _get_binary_stream("stdout")
+        assert stream is buffer
+
+    def test_get_text_stream(self, monkeypatch):
+        buffer = io.BytesIO()
+        monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+        stream = _get_text_stream("stdout", encoding="utf-8", errors="replace")
+        stream.write("hello")
+        stream.flush()
+        assert buffer.getvalue() == b"hello"
+
