+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly reaches max_length before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # First word alone is longer than max_length.
+        ("abcdefghijklmnop qrs", 5, "..."),
+        # Fits exactly with no more words.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # Empty help.
+        ("   ", 45, ""),
+        # Only the first paragraph is considered.
+        ("First line.\n\nSecond paragraph.", 45, "First line."),
+        # No-rewrap marker is dropped.
+        ("\b\nsome words here", 45, "some words here"),
+    ],
+)
+def test_make_default_short_help_edge_cases(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
