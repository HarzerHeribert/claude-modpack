+class TestPacifyFlushWrapper:
+    class _Stream:
+        def __init__(self, exc=None):
+            self.exc = exc
+            self.flushed = False
+            self.name = "fake"
+
+        def flush(self):
+            if self.exc is not None:
+                raise self.exc
+            self.flushed = True
+
+    def test_flush_passes_through(self):
+        stream = self._Stream()
+        wrapper = _PacifyFlushWrapper(stream)
+        wrapper.flush()
+        assert stream.flushed
+        assert wrapper.name == "fake"
+
+    def test_broken_pipe_is_suppressed(self):
+        stream = self._Stream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+        _PacifyFlushWrapper(stream).flush()
+
+    def test_other_os_error_is_raised(self):
+        stream = self._Stream(OSError(errno.EIO, "I/O error"))
+        with pytest.raises(OSError) as exc_info:
+            _PacifyFlushWrapper(stream).flush()
+        assert exc_info.value.errno == errno.EIO
+
