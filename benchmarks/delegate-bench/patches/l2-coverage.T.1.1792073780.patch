+class TestEcho:
+    def test_bytes_to_text_only_stream(self):
+        # StringIO has no binary buffer, so the bytes are passed to its
+        # text write method, which rejects them.
+        out = io.StringIO()
+        with pytest.raises(TypeError):
+            echo(b"raw", file=out)
+        assert out.getvalue() == ""
+
+    def test_bytearray_to_binary_stream(self):
+        buffer = io.BytesIO()
+        echo(bytearray(b"abc"), file=buffer, nl=False)
+        assert buffer.getvalue() == b"abc"
+
+    def test_empty_message_only_flushes(self):
+        out = io.StringIO()
+        echo(None, file=out, nl=False)
+        echo("", file=out, nl=False)
+        assert out.getvalue() == ""
+
+    def test_object_message_converted(self):
+        out = io.StringIO()
+        echo(123, file=out)
+        assert out.getvalue() == "123\n"
+
+    def test_strip_ansi_when_not_tty(self):
+        out = io.StringIO()
+        echo("\033[31mred\033[0m", file=out)
+        assert out.getvalue() == "red\n"
+        out = io.StringIO()
+        echo("\033[31mred\033[0m", file=out, color=True)
+        assert out.getvalue() == "\033[31mred\033[0m\n"
+
+    @pytest.mark.parametrize("err", [False, True])
+    def test_no_standard_stream(self, monkeypatch, err):
+        monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+        monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+        # Should silently do nothing.
+        assert echo("hello", err=err) is None
+
+    def test_default_stdout_and_stderr(self, capsys):
+        echo("to out")
+        echo("to err", err=True)
+        captured = capsys.readouterr()
+        assert captured.out == "to out\n"
+        assert captured.err == "to err\n"
+
