+class TestKeepOpenFile:
+    def test_repr_and_proxy(self):
+        inner = io.StringIO("a\nb\n")
+        kof = _KeepOpenFile(inner)
+        assert repr(kof) == repr(inner)
+        assert list(kof) == ["a\n", "b\n"]
+        assert kof.getvalue() == "a\nb\n"
+
+    def test_exit_keeps_open_but_close_passes_through(self):
+        inner = io.StringIO()
+        with _KeepOpenFile(inner) as kof:
+            kof.write("x")
+        assert not inner.closed
+        kof.close()
+        assert inner.closed
+
