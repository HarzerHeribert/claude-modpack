+class _UnclosableStringIO(io.StringIO):
+    """StringIO that remembers whether close was called."""
+
+    closed_called = False
+
+    def close(self):
+        self.closed_called = True
+
+
+def test_lazy_file_dash_write(monkeypatch):
+    out = _UnclosableStringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    lf = _LazyFile("-", "w")
+    assert lf._f is out
+    assert lf.should_close is False
+    assert repr(lf) == repr(out)
+
+    with lf as f:
+        f.write("hello")
+
+    # stdout is not closed by close_intelligently
+    assert not out.closed_called
+    assert out.getvalue() == "hello"
+
+    # explicit close passes through
+    lf.close()
+    assert out.closed_called
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_proxy():
+    f = io.StringIO("line1\nline2\n")
+    kof = _KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+    assert list(kof) == ["line1\n", "line2\n"]
+
+    with kof as k:
+        assert k is kof
+
+    assert not f.closed
+    kof.close()
+    assert f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_open(monkeypatch):
+    out = _UnclosableStringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    f = click.open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+
+    with f:
+        f.write("x")
+
+    assert not out.closed_called
+    assert out.getvalue() == "x"
+
