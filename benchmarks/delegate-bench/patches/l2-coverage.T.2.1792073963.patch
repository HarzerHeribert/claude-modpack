+class _TextOnlyEmptyWriter:
+    """A stream whose binary detection fails, but that still accepts
+    non-empty bytes, so echo falls through to ``file.write``.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if isinstance(data, bytes) and not data:
+            raise TypeError("not binary")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyEmptyWriter()
+    click.echo(b"hello", file=f)
+    assert f.written == ["", b"hello\n"]
+    assert f.flushed >= 1
+
+
+def test_echo_bytearray_to_binary_buffer():
+    buf = io.BytesIO()
+    f = io.TextIOWrapper(buf, encoding="utf-8")
+    click.echo(bytearray(b"abc"), file=f)
+    assert buf.getvalue() == b"abc\n"
+
+
+def test_get_binary_stream(monkeypatch):
+    buf = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buf, encoding="utf-8"))
+    assert _get_binary_stream("stdout") is buf
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream(monkeypatch):
+    out = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", out)
+    assert _get_text_stream("stdout") is out
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+@pytest.mark.parametrize(
+    ("name", "func"),
+    [
+        ("get_text_stream", _get_text_stream),
+        ("get_binary_stream", _get_binary_stream),
+        ("PacifyFlushWrapper", _PacifyFlushWrapper),
+    ],
+)
+def test_deprecated_aliases(name, func):
+    with pytest.warns(DeprecationWarning, match=name):
+        assert getattr(click.utils, name) is func
+
+
+def test_module_getattr_unknown():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
+
