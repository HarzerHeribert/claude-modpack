+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_default_path(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "__main__.py")])
+    assert _detect_program_name(_main=main) == "python -m example"
+
+
+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_not_recursive(monkeypatch, tmp_path):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert _expand_args(["**/*.txt"], glob_recursive=True) == [
+        os.path.join("a", "b.txt")
+    ]
+    assert _expand_args(["*.txt"], glob_recursive=False) == ["*.txt"]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def raise_re_error(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", raise_re_error)
+    assert _expand_args(["[bad"]) == ["[bad"]
