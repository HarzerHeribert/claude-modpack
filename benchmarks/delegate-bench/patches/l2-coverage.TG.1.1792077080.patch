+class _TextOnlyNoEmptyWriter:
+    """A stream that rejects empty writes of any type, so that it is
+    detected as neither a text nor a binary writer, and has no buffer.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushes = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _TextOnlyNoEmptyWriter()
+    click.echo(b"abc", file=stream)
+    assert stream.data == [b"abc\n"]
+    assert stream.flushes == 1
+
+
+def test_echo_bytearray():
+    stream = io.BytesIO()
+    click.echo(bytearray(b"xy"), file=stream, nl=False)
+    assert stream.getvalue() == b"xy"
+
+
+def test_echo_empty_only_flushes():
+    stream = _TextOnlyNoEmptyWriter()
+    click.echo("", file=stream, nl=False)
+    assert stream.data == []
+    assert stream.flushes == 1
+
+
+def test_echo_err(runner):
+    with runner.isolation() as (out, err, _):
+        click.echo("to err", err=True)
+        assert err.getvalue().replace(b"\r\n", b"\n") == b"to err\n"
+        assert out.getvalue() == b""
+
+
+def test_echo_no_stdout(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    # Does not raise when there is no stream to write to.
+    click.echo("nowhere")
+
