+def test_lazyfile_stdout(runner):
+    with runner.isolation() as (out, _, _):
+        lf = click.utils._LazyFile("-", "w")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+        lf.flush()
+        # Does not close the borrowed stream.
+        lf.close_intelligently()
+        assert not lf._f.closed
+        assert out.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+
+    with lf:
+        lf.write("data")
+
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keepopenfile_repr_and_proxy():
+    stream = io.StringIO("a\nb\n")
+    f = click.utils._KeepOpenFile(stream)
+    assert repr(f) == repr(stream)
+    assert f.read(1) == "a"
+
+    with f as inner:
+        assert inner is f
+
+    assert not stream.closed
+    f.close()
+    assert stream.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_stdout_kept_open(runner):
+    with runner.isolation() as (out, _, _):
+        with click.utils.open_file("-", "w") as f:
+            assert isinstance(f, click.utils._KeepOpenFile)
+            f.write("x")
+            f.flush()
+
+        assert not f.closed
+        assert out.getvalue() == b"x"
