+def test_get_binary_stream(runner):
+    with runner.isolation(input="in") as (out, _, _):
+        assert click.utils._get_binary_stream("stdin").read() == b"in"
+        stream = click.utils._get_binary_stream("stdout")
+        stream.write(b"bin")
+        stream.flush()
+        assert out.getvalue() == b"bin"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation(input="text in") as (out, _, _):
+        assert click.utils._get_text_stream("stdin").read() == "text in"
+        stream = click.utils._get_text_stream("stdout", encoding="utf-8")
+        stream.write("text")
+        stream.flush()
+        assert out.getvalue() == b"text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
