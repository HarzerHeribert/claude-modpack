+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaching max_length exactly before the last word truncates.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long.
+        ("abcdefghij", 5, "..."),
+        # Reaching max_length exactly on the last word needs no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash_uses_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    # Not opened by the wrapper, so close_intelligently must not close it.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    lf._f.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close_intelligently()
+    assert f.closed
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO("x")
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_dash_is_kept_open(monkeypatch):
+    _patch_stdout(monkeypatch)
+
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("x")
+
+    assert not f.closed
+
