+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def raise_re_error(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", raise_re_error)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(monkeypatch, tmp_path):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b").mkdir()
+    (tmp_path / "a" / "b" / "c.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    # Without recursion "**" only matches one directory level.
+    assert _expand_args(["**/c.txt"], glob_recursive=False) == ["**/c.txt"]
+    assert _expand_args(["**/c.txt"], glob_recursive=True) == [
+        os.path.join("a", "b", "c.txt")
+    ]
+
