+def _patch_stdout(monkeypatch):
+    # Patch inside the test body, pytest's capture would replace
+    # sys.stdout again after fixture setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_safecall_returns_result():
+    @_safecall
+    def add(a, b):
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    @_safecall
+    def fail():
+        raise ValueError("boom")
+
+    assert fail() is None
+
+
+def test_make_str_str_and_other():
+    assert make_str("abc") == "abc"
+    assert make_str(42) == "42"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"a\xffb") == "a�b"
+
