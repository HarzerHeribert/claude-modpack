+class _TextOnlyRejectsEmptyBytes:
+    """A file without a binary buffer that still accepts non-empty bytes."""
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("no binary")
+
+        self.written.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyRejectsEmptyBytes()
+    echo(b"hello", file=f)
+    # The first write is the binary writer detection probing with "".
+    assert f.written == ["", b"hello\n"]
+    assert f.flushed
+
+
+def test_echo_bytearray_to_binary_file():
+    f = io.BytesIO()
+    echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
+
+def test_echo_empty_flushes_only():
+    f = _TextOnlyRejectsEmptyBytes()
+    echo("", file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
