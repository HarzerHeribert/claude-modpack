+def test_format_filename_variants():
+    assert click.format_filename("/a/b/c.txt", shorten=True) == "c.txt"
+    assert click.format_filename(b"/a/b/c.txt") == "/a/b/c.txt"
+    assert click.format_filename(b"/a/\xff.txt", shorten=True) == "�.txt"
+    assert click.format_filename("/a/\udcff.txt") == "/a/�.txt"
