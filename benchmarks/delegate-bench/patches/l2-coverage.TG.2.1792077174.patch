+def test_lazy_file_dash_does_not_close_stream():
+    out = io.StringIO()
+    stream = types.SimpleNamespace(write=out.write, close=pytest.fail)
+
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setattr(utils, "open_stream", lambda *a, **kw: (stream, False))
+        lf = utils._LazyFile("-", "w")
+
+    assert lf._f is stream
+    assert lf.should_close is False
+    assert lf.open() is stream
+
+    with lf as f:
+        f.write("data")
+
+    assert out.getvalue() == "data"
+
+
+def test_lazy_file_dash_stdout(capsys):
+    lf = utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    lf.close_intelligently()
+    assert not lf._f.closed
+
+
+def test_keep_open_file_repr_and_close():
+    f = io.StringIO("data")
+    kf = utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as k:
+        assert k is kf
+        assert k.read() == "data"
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
