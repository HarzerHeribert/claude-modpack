+class _Recorder:
+    def __init__(self):
+        self.writes = []
+        self.flushes = 0
+
+    def write(self, data):
+        self.writes.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer(monkeypatch):
+    monkeypatch.setattr(utils, "_find_binary_writer", lambda f: None)
+    file = _Recorder()
+    click.echo(b"hello", file=file)
+    assert file.writes == [b"hello\n"]
+    assert file.flushes == 1
+
+
+def test_echo_empty_flushes_only():
+    file = _Recorder()
+    click.echo("", file=file, nl=False)
+    assert file.writes == []
+    assert file.flushes == 1
+
+
+def test_echo_no_default_stream(monkeypatch):
+    monkeypatch.setattr(utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(utils, "_default_text_stderr", lambda: None)
+    assert click.echo("lost") is None
+    assert click.echo("lost", err=True) is None
+
+
+def test_echo_object_and_bytearray():
+    out = io.BytesIO()
+    click.echo(bytearray(b"ab"), file=out)
+    assert out.getvalue() == b"ab\n"
+
+    text = io.StringIO()
+    click.echo(123, file=text)
+    click.echo(None, file=text)
+    assert text.getvalue() == "123\n\n"
+
+
+def test_echo_color_handling():
+    text = io.StringIO()
+    styled = click.style("hi", fg="red")
+    click.echo(styled, file=text, color=False)
+    assert text.getvalue() == "hi\n"
+
+    text = io.StringIO()
+    click.echo(styled, file=text, color=True)
+    assert text.getvalue() == f"{styled}\n"
+
