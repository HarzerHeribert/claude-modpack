+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "fake"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    stream = _FlushStream()
+    wrapper = utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.wrapped is stream
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapper = utils._PacifyFlushWrapper(_FlushStream())
+    assert wrapper.name == "fake"
+
+    with pytest.raises(AttributeError):
+        wrapper.missing  # noqa: B018
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    stream = _FlushStream(OSError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(stream).flush()
+    assert not stream.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    stream = _FlushStream(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(stream).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
