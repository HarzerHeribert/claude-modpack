+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "lazy.txt"
+    path.write_text("line1\nline2\n")
+
+    with click.open_file(path, "r", lazy=True) as f:
+        assert [line.rstrip() for line in f] == ["line1", "line2"]
+
+
+def test_open_file_lazy_read_missing(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.open_file(tmp_path / "missing.txt", "r", lazy=True)
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("plain")
+
+    with click.open_file(path) as f:
+        assert not isinstance(f, utils._KeepOpenFile)
+        assert f.read() == "plain"
+
