+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")
+
+
+def test_get_binary_stream_known(monkeypatch):
+    sentinel = io.BytesIO()
+    monkeypatch.setitem(utils.binary_streams, "stdout", lambda: sentinel)
+    assert utils._get_binary_stream("stdout") is sentinel
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")
+
+
+def test_get_text_stream_known(monkeypatch):
+    calls = []
+    sentinel = io.StringIO()
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return sentinel
+
+    monkeypatch.setitem(utils.text_streams, "stdout", opener)
+    assert utils._get_text_stream("stdout") is sentinel
+    assert utils._get_text_stream("stdout", "latin1", "replace") is sentinel
+    assert calls == [(None, "strict"), ("latin1", "replace")]
+
