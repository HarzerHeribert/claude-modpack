+def test_open_file_dash_keeps_open(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(utils, "open_stream", lambda *a, **kw: (stream, False))
+
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, utils._KeepOpenFile)
+        f.write("x")
+
+    assert not stream.closed
+    assert stream.getvalue() == "x"
