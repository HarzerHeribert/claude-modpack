+@pytest.mark.parametrize(
+    ("help", "expect"),
+    [
+        # A single word longer than the limit leaves nothing but the suffix.
+        ("a" * 50, "..."),
+        # A word that hits the limit exactly with more words after it.
+        ("a" * 45 + " b", "..."),
+        # Hitting the limit exactly on the last word needs no truncation.
+        ("a" * 45, "a" * 45),
+        ("a" * 40 + " bbbb", "a" * 40 + " bbbb"),
+        ("a" * 40 + " bbbb c", "a" * 40 + "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, expect):
+    assert _make_default_short_help(help) == expect
