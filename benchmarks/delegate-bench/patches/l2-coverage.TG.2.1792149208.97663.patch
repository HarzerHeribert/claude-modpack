+class _BytesOnlyWhenNonEmpty:
+    """A stream that fails the binary probe (empty bytes) but still
+    accepts writes, and has no ``buffer`` to fall back to.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data in (b"", ""):
+            raise TypeError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _BytesOnlyWhenNonEmpty()
+    echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    f = io.BytesIO()
+    echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
