+def test_keep_open_file_repr_and_proxy():
+    buf = io.StringIO("x\ny\n")
+    f = _KeepOpenFile(buf)
+    assert repr(f) == repr(buf)
+    assert list(f) == ["x\n", "y\n"]
+    assert f.getvalue() == "x\ny\n"
+
+    with f as inner:
+        assert inner is f
+
+    assert not buf.closed
+    f.close()
+    assert buf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
