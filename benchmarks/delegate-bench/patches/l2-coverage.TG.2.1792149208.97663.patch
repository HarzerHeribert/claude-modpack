+class TestLazyFile:
+    def test_dash_uses_standard_stream(self, monkeypatch):
+        out = io.StringIO()
+        monkeypatch.setattr(sys, "stdout", out)
+        lf = _LazyFile("-", "w")
+        assert lf._f is not None
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+        lf.close_intelligently()
+        assert not lf._f.closed
+
+    def test_repr_unopened_and_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        assert not path.exists()
+        f = lf.open()
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+        lf.close()
+
+    def test_close_unopened_is_noop(self, tmp_path):
+        lf = _LazyFile(tmp_path / "never.txt", "w")
+        lf.close()
+        lf.close_intelligently()
+        assert lf._f is None
+        assert not (tmp_path / "never.txt").exists()
+
+    def test_context_manager_and_iter(self, tmp_path):
+        path = tmp_path / "data.txt"
+        path.write_text("a\nb\n")
+
+        with _LazyFile(path) as lf:
+            assert list(lf) == ["a\n", "b\n"]
+
+        assert lf._f.closed
+
+    def test_read_missing_file_fails_early(self, tmp_path):
+        with pytest.raises(OSError):
+            _LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error_raises_file_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "no_dir" / "out.txt", "w")
+
+        with pytest.raises(FileError):
+            lf.open()
+
