+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "fake"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+class TestPacifyFlushWrapper:
+    def test_flush_passes_through(self):
+        inner = _FlushRaises()
+        wrapper = _PacifyFlushWrapper(inner)
+        wrapper.flush()
+        assert inner.flushed == 1
+
+    def test_flush_ignores_broken_pipe(self):
+        inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+        _PacifyFlushWrapper(inner).flush()
+        assert inner.flushed == 1
+
+    def test_flush_reraises_other_errors(self):
+        inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+        with pytest.raises(OSError) as info:
+            _PacifyFlushWrapper(inner).flush()
+
+        assert info.value.errno == errno.EIO
+
+    def test_proxies_attributes(self):
+        inner = _FlushRaises()
+        wrapper = _PacifyFlushWrapper(inner)
+        assert wrapper.name == "fake"
+        assert wrapper.wrapped is inner
+
