+@pytest.mark.parametrize(
+    ("name", "expect"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo   Bar\tBaz ", "foo-bar-baz"),
+        ("app", "app"),
+        ("", ""),
+    ],
+)
+def test_posixify(name, expect):
