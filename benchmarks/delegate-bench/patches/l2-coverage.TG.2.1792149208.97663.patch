+def test_get_text_stream_stdout(monkeypatch):
+    raw = io.BytesIO()
+    stdout = io.TextIOWrapper(raw, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+    stream = _get_text_stream("stdout")
+    stream.write("hi")
+    stream.flush()
+    assert raw.getvalue() == b"hi"
