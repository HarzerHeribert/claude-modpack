+class _Flushable:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _Flushable()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_Flushable(OSError(errno.EPIPE, "Broken pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = _PacifyFlushWrapper(_Flushable(OSError(errno.EIO, "I/O error")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
