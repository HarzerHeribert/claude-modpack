+def test_expand_args_glob_non_recursive(monkeypatch, tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "b.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=True)) == [
+        "a.txt",
+        os.path.join("sub", "b.txt"),
+    ]
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "b.txt")
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
