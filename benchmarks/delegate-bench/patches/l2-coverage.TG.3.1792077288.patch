+def test_keep_open_file_repr_and_proxy():
+    inner = io.StringIO("a\nb\n")
+    f = _KeepOpenFile(inner)
+    assert repr(f) == repr(inner)
+    assert f.getvalue() == "a\nb\n"
+    assert list(f) == ["a\n", "b\n"]
+
+    with f as entered:
+        assert entered is f
+
+    assert not inner.closed
+    f.close()
+    assert inner.closed
+
