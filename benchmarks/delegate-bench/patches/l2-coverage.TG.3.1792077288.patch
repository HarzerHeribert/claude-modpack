+def test_get_text_stream(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = _get_text_stream("stdout", encoding="utf-8")
+    stream.write("hi")
+    stream.flush()
+    assert buffer.getvalue() == b"hi"
