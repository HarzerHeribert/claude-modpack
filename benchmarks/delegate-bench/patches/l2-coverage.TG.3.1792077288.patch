+class _TextOnlyOnContent:
+    """A writer that fails probes with empty data, so Click can't detect
+    whether it's binary, but accepts real content.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyOnContent()
+    click.echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_no_newline():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_object_converted_to_str():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
+
+def test_echo_empty_flushes_only():
+    f = _TextOnlyOnContent()
+    click.echo(None, file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
+
+def test_echo_color_stripping():
+    out = io.StringIO()
+    click.echo("\033[31mred\033[0m", file=out, color=False)
+    assert out.getvalue() == "red\n"
+
+    out = io.StringIO()
+    click.echo("\033[31mred\033[0m", file=out, color=True)
+    assert out.getvalue() == "\033[31mred\033[0m\n"
+
+
+def test_echo_err(capsys):
+    click.echo("oops", err=True)
+    captured = capsys.readouterr()
+    assert captured.err == "oops\n"
+    assert captured.out == ""
