+def test_lazy_file_dash_uses_stream():
+    lf = _LazyFile("-", "w")
+    assert lf.name == "-"
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    # Leaving the block must not close the standard stream.
+    with lf as f:
+        assert f is lf
+
+    assert not lf._f.closed
+
+
+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(path)}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close_intelligently()
+    assert f.closed
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
