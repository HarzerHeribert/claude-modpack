+def test_keep_open_file_repr_and_proxy():
+    buf = io.StringIO("a\nb\n")
+    kf = _KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    assert kf.getvalue() == "a\nb\n"
+    with kf as f:
+        assert list(f) == ["a\n", "b\n"]
+    assert not buf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+    with f:
+        f.write("lazy")
+    assert path.read_text() == "lazy"
+
