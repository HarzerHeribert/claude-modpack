+class _TextOnlyAcceptsNonEmptyBytes:
+    """A stream that does not look binary (rejects ``b""``) and has no
+    ``buffer``, but still records any non-empty writes."""
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("no empty bytes")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+    def isatty(self):
+        return False
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _TextOnlyAcceptsNonEmptyBytes()
+    click.echo(b"raw", file=stream)
+    # The "" probe from _is_binary_writer is recorded first.
+    assert stream.written[-1] == b"raw\n"
+    assert stream.flushed >= 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_empty_message_only_flushes():
+    out = io.StringIO()
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
