+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.extra = "proxied"
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_passthrough():
+    buf = io.StringIO()
+    wrapper = _PacifyFlushWrapper(buf)
+    wrapper.write("x")
+    wrapper.flush()
+    assert buf.getvalue() == "x"
+
