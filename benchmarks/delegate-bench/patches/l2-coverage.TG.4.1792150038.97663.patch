+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.setenv("CLICK_TEST_VAR", "expanded")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert _expand_args(["~", "$CLICK_TEST_VAR"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST_VAR",
+    ]
+    assert _expand_args(["~", "$CLICK_TEST_VAR"]) == [str(tmp_path), "expanded"]
+
+
+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "b.txt").touch()
+    pattern = os.path.join(str(tmp_path), "**", "*.txt")
+
+    assert sorted(_expand_args([pattern])) == [
+        str(tmp_path / "a.txt"),
+        str(tmp_path / "sub" / "b.txt"),
+    ]
+    assert _expand_args([pattern], glob_recursive=False) == [
+        str(tmp_path / "sub" / "b.txt")
+    ]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
