+def test_detect_program_name_defaults_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/some/path/app.py", "--flag"])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_defaults_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/some/path/example/cli.py"])
+    assert _detect_program_name() == "python -m example.cli"
+
+
+def test_detect_program_name_explicit_path_ignores_argv(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "pkg"
+    monkeypatch.setattr(sys, "argv", ["/unused/other.py"])
+    assert (
+        _detect_program_name("/x/pkg/__main__.py", _main=main) == "python -m pkg"
+    )
+
