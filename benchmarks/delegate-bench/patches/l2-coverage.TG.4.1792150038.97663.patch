+def test_safecall_returns_value():
+    def add(a, b=0):
+        """Add things."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add things."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"hello", "hello"),
+        (b"caf\xc3\xa9", "café"),
+        (b"bad\xff", "bad�"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expect):
+    assert make_str(value) == expect
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+
