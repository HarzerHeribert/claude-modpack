+def test_echo_bytes_to_text_only_stream():
+    # A stream without a binary buffer can't receive bytes, so the write
+    # falls through to the text stream and fails there.
+    with pytest.raises(TypeError):
+        echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    echo(b"data", file=out)
+    echo(bytearray(b"more"), file=out, nl=False)
+    assert out.getvalue() == b"data\nmore"
+
+
+def test_echo_object_and_none():
+    out = io.StringIO()
+    echo(123, file=out)
+    echo(None, file=out)
+    echo(file=out, nl=False)
+    assert out.getvalue() == "123\n\n"
+
+
+def test_echo_strips_ansi_for_non_terminal():
+    out = io.StringIO()
+    echo("\x1b[31mred\x1b[0m", file=out)
+    echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "red\n\x1b[31mred\x1b[0m\n"
+
+
+def test_get_binary_stream(capsysbinary):
+    stream = _get_binary_stream("stdout")
+    stream.write(b"bin")
+    stream.flush()
+    assert capsysbinary.readouterr().out == b"bin"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream(capsys):
+    stream = _get_text_stream("stdout", encoding="utf-8", errors="strict")
+    stream.write("txt")
+    stream.flush()
+    assert capsys.readouterr().out == "txt"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
