+@pytest.mark.parametrize(
+    ("help", "max_length", "expect"),
+    [
+        # Exactly hits the limit before the last word, truncate with "...".
+        ("abc def ghi", 7, "abc..."),
+        # The first word alone exceeds the limit.
+        ("abcdefghij klm", 5, "..."),
+        # Exactly hits the limit on the last word, no truncation.
+        ("abc def", 7, "abc def"),
+        # Empty and whitespace-only help.
+        ("", 45, ""),
+        ("  \n\t ", 45, ""),
+        # Only the first paragraph is considered.
+        ("First para here\n\nSecond paragraph.", 45, "First para here"),
+        # No-rewrap marker is dropped.
+        ("\b\nSome text.", 45, "Some text."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expect):
+    assert _make_default_short_help(help, max_length) == expect
+
