+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "fake"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed += 1
+
+
+def test_pacify_flush_wrapper_passes_through():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed == 1
+    assert wrapper.name == "fake"
+    assert wrapper.wrapped is stream
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "broken")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_missing_attribute():
+    with pytest.raises(AttributeError):
+        _PacifyFlushWrapper(_FlushStream()).nonexistent  # noqa: B018
+
