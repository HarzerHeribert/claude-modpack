+def test_lazy_file_stdout_dash(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not lf.closed
+    with lf:
+        pass
+    assert not lf.closed
+    lf.flush()
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_is_cached(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(str(path), "w")
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+    assert f.closed
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error_raises_file_error(tmp_path):
+    lf = _LazyFile(tmp_path / "no_dir" / "file.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert "file.txt" in exc_info.value.ui_filename
+
+
+def test_keep_open_file_proxies(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+        assert kf.name == f.name
+
+        with kf as entered:
+            assert entered is kf
+
+        assert not f.closed
+        assert list(kf) == ["a\n", "b\n"]
+
