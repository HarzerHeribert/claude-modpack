+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_open_file_lazy_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    f = open_file(path, "w", lazy=True, atomic=True)
+
+    with f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_open_file_dash_keeps_stdout_open(capsys):
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("x")
+
+    assert not f.closed
+    f.flush()
+    assert capsys.readouterr().out == "x"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "r.txt"
+    path.write_text("hi")
+
+    with open_file(path) as f:
+        assert not isinstance(f, _KeepOpenFile)
+        assert f.read() == "hi"
+
+    assert f.closed
+
