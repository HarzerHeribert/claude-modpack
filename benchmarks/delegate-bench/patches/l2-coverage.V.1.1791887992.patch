+
+def _patch_stdout(monkeypatch):
+    # Patched in the test body, pytest's capture replaces sys.stdout again
+    # between fixture setup and the test call.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8", errors="strict")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Spaced \t Out\nApp ", "spaced-out-app"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(name, expected):
+    assert _posixify(name) == expected
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_make_str_bytes():
+    assert make_str(b"hello") == "hello"
+
+
+def test_make_str_bytes_undecodable(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    assert make_str(b"bad\xff") == "bad�"
+
+
+@pytest.mark.parametrize(("value", "expected"), [(42, "42"), ("text", "text")])
+def test_make_str_non_bytes(value, expected):
+    assert make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long.
+        ("abcdefghij klm", 5, "..."),
+        # Fits exactly on the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
