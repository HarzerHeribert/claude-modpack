+class _FlushRecorder:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "recorder"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRecorder()
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapped = _FlushRecorder(OSError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapped = _FlushRecorder(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapped = _FlushRecorder()
+    pacified = _PacifyFlushWrapper(wrapped)
+    assert pacified.name == "recorder"
+    assert pacified.wrapped is wrapped
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/local/bin/example", "--flag"])
+    assert _detect_program_name() == "example"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_UTILS_TEST", "expanded")
+    arg = "~/click-no-such-dir/$CLICK_UTILS_TEST"
+    assert _expand_args([arg], user=False, env=False) == [arg]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
