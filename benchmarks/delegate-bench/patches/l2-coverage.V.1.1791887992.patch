+def test_echo_bytes_without_binary_writer():
+    # StringIO has no binary buffer, so the bytes go to the text write,
+    # which rejects them.
+    out = io.StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=out)
+
+
+def test_echo_bytes_to_binary_file():
+    out = io.BytesIO()
+    click.echo(b"data", file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_binary_stream("stdout") is fake_stdout.buffer
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_text_stream("stdout", encoding="utf-8") is fake_stdout
+
+
+def test_get_text_stream_passes_arguments(monkeypatch):
+    calls = []
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return "stream"
+
+    monkeypatch.setattr(click.utils, "text_streams", {"stdout": opener})
+    assert _get_text_stream("stdout", "latin-1", "replace") == "stream"
+    assert calls == [("latin-1", "replace")]
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_stdout_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert not fake_stdout.closed
+
