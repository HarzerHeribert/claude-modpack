+class TestGetAppDir:
+    @pytest.fixture(autouse=True)
+    def home(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("HOME", str(tmp_path))
+        monkeypatch.setenv("USERPROFILE", str(tmp_path))
+        return tmp_path
+
+    @pytest.mark.parametrize(
+        ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+    )
+    def test_windows(self, monkeypatch, roaming, key):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv(key, "/appdata")
+        assert get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+            "/appdata", "Foo Bar"
+        )
+
+    def test_windows_without_env(self, monkeypatch, home):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.delenv("APPDATA", raising=False)
+        assert get_app_dir("Foo Bar") == os.path.join(str(home), "Foo Bar")
+
+    def test_force_posix(self, monkeypatch, home):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        assert get_app_dir("Foo Bar", force_posix=True) == os.path.join(
+            str(home), ".foo-bar"
+        )
+
+    def test_darwin(self, monkeypatch, home):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "darwin")
+        assert get_app_dir("Foo Bar") == os.path.join(
+            str(home), "Library", "Application Support", "Foo Bar"
+        )
+
+    def test_xdg_config_home(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.setenv("XDG_CONFIG_HOME", "/xdg")
+        assert get_app_dir("Foo Bar") == os.path.join("/xdg", "foo-bar")
+
+    def test_default_config(self, monkeypatch, home):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+        assert get_app_dir("Foo Bar") == os.path.join(str(home), ".config", "foo-bar")
+
