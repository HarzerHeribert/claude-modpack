+class TestLazyFile:
+    def test_stdout(self, capsys):
+        lf = _LazyFile("-", "w")
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+
+        with lf as f:
+            f.write("hello")
+            f.flush()
+
+        # Leaving the block must not close the borrowed standard stream.
+        assert not lf._f.closed
+        assert capsys.readouterr().out == "hello"
+
+    def test_repr_unopened_then_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{path}' w>"
+        assert not path.exists()
+
+        f = lf.open()
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+        lf.write("data")
+        lf.close_intelligently()
+        assert f.closed
+        assert path.read_text() == "data"
+
+    def test_close_unopened_is_noop(self, tmp_path):
+        lf = _LazyFile(tmp_path / "never.txt", "w")
+        lf.close()
+        assert lf._f is None
+        assert not (tmp_path / "never.txt").exists()
+
+    def test_read_iter(self, tmp_path):
+        path = tmp_path / "in.txt"
+        path.write_text("a\nb\n")
+
+        with _LazyFile(path) as lf:
+            assert lf._f is None
+            assert list(lf) == ["a\n", "b\n"]
+
+        assert lf._f.closed
+
+    def test_open_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+        with pytest.raises(click.FileError):
+            lf.open()
+
+
+def test_keep_open_file_proxies(tmp_path):
+    path = tmp_path / "f.txt"
+
+    with open(path, "w") as raw:
+        kof = _KeepOpenFile(raw)
+        assert repr(kof) == repr(raw)
+        assert kof.name == raw.name
+
+        with kof as f:
+            assert f is kof
+            f.write("x")
+
+        assert not raw.closed
+
+    assert path.read_text() == "x"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_lazy_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    f = click.open_file(path, "w", lazy=True, atomic=True)
+
+    with f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
