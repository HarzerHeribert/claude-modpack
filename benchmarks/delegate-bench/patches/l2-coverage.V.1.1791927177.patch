+def test_get_text_stream(monkeypatch):
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    out = _get_text_stream("stdout", encoding="utf-8", errors="strict")
+    out.write("héllo")
+    out.flush()
+    assert buffer.getvalue() == "héllo".encode()
+
