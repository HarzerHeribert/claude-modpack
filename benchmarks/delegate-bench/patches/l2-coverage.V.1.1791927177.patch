+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_default_main(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "__main__.py")])
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain("pkg"))
+    assert _detect_program_name() == "python -m pkg"
+
