+class _TextOnlyAcceptingBytes:
+    """A stream that rejects empty bytes so it is not detected as binary,
+    has no ``buffer``, but still records what is written to it.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("not a binary stream")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyAcceptingBytes()
+    click.echo(b"raw", file=f)
+    # The empty str is from the binary-writer probe, then the raw bytes.
+    assert f.written == ["", b"raw\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary():
+    f = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
+
+def test_echo_empty_flushes_only():
+    f = _TextOnlyAcceptingBytes()
+    click.echo("", file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
