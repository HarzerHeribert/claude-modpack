+def test_get_text_stream(runner):
+    @click.command()
+    def cli():
+        stream = _get_text_stream("stdout")
+        stream.write("text stream")
+        stream.flush()
+
+    result = runner.invoke(cli)
+    assert result.exception is None
+    assert result.output == "text stream"
