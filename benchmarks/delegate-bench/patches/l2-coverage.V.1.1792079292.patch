+def test_lazyfile_stdout(runner):
+    @click.command()
+    def cli():
+        lf = _LazyFile("-", "w")
+        assert not lf.should_close
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+        lf.close_intelligently()
+        # The standard stream was not closed.
+        click.echo(" world")
+
+    result = runner.invoke(cli)
+    assert result.exception is None
+    assert result.output == "hello world\n"
+
+
+def test_lazyfile_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    with lf:
+        lf.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keepopenfile_repr_and_close():
+    f = io.StringIO("data")
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as inner:
+        assert inner is kf
+        assert inner.read() == "data"
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
