+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    result = _expand_args(["~", "$CLICK_TEST_VAR"], user=False, env=False)
+    assert result == ["~", "$CLICK_TEST_VAR"]
+
+
+def test_expand_args_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    result = _expand_args(["~", "$CLICK_TEST_VAR"])
+    assert result == [os.path.expanduser("~"), "value"]
+
