+def test_open_file_dash_keeps_stream_open(runner):
+    @click.command()
+    def cli():
+        with click.open_file("-", "w") as f:
+            assert isinstance(f, _KeepOpenFile)
+            f.write("first")
+
+        click.echo(" second")
+
+    result = runner.invoke(cli)
+    assert result.exception is None
+    assert result.output == "first second\n"
