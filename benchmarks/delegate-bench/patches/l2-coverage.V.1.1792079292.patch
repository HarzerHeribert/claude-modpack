+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    # Other attributes are proxied.
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "pipe")))
+    # A broken pipe is silently ignored.
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
