+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "lazy.txt"
+    path.write_text("content")
+
+    with click.open_file(path, lazy=True) as f:
+        assert f.read() == "content"
+
+
+def test_open_file_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+
+    with click.open_file(path, "w", atomic=True) as f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
