+def test_get_binary_stream():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _, _):
+        stream = click.utils._get_binary_stream("stdout")
+        stream.write(b"bytes")
+        stream.flush()
+        assert out.getvalue() == b"bytes"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _, _):
+        stream = click.utils._get_text_stream("stdout", encoding="utf-8")
+        stream.write("text")
+        stream.flush()
+        assert out.getvalue() == b"text"
+
+
+def test_get_text_stream_passes_arguments(monkeypatch):
+    calls = []
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return "stream"
+
+    monkeypatch.setattr(click.utils, "text_streams", {"stderr": opener})
+    assert click.utils._get_text_stream("stderr", "latin1", "replace") == "stream"
+    assert calls == [("latin1", "replace")]
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
