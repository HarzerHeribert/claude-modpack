+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("1234567890 abc", 10, "...", id="first word fills max"),
+        pytest.param("12345678901 abc", 10, "...", id="first word too long"),
+        pytest.param("one two", 10, "one two", id="no truncation"),
+    ],
+)
+def test_make_default_short_help_edges(value, max_length, expect):
