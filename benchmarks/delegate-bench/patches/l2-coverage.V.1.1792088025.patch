+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    out = click.utils._expand_args(
+        ["~/click-not-found", "$CLICK_TEST-not-found"], user=False, env=False
+    )
+    assert out == ["~/click-not-found", "$CLICK_TEST-not-found"]
+
