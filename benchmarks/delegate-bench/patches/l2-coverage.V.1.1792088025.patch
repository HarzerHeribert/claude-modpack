+class _FlushFails:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        raise self.err
+
+
+def test_pacify_flush_wrapper_passthrough():
+    f = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(f)
+    assert wrapper.wrapped is f
+    wrapper.write("hello")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hello"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushFails(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushFails(OSError(errno.EBADF, "Bad file descriptor"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
