+def test_echo_bytes_to_text_only_file():
+    # A text stream with no binary buffer can't receive bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_empty_flushes():
+    class Recorder(io.StringIO):
+        flushed = False
+
+        def flush(self):
+            self.flushed = True
+            super().flush()
+
+    f = Recorder()
+    click.echo("", file=f, nl=False)
+    assert f.flushed
+    assert f.getvalue() == ""
+
+
+def test_echo_bytes_no_newline():
+    f = io.BytesIO()
+    click.echo(bytearray(b"raw"), file=f, nl=False)
+    assert f.getvalue() == b"raw"
+
+
+def test_echo_none_file(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    # Nothing to write to, so nothing happens.
+    click.echo("hello")
+    click.echo("hello", err=True)
+
