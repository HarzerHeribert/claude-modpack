+def test_keep_open_file_proxy():
+    f = io.StringIO("line\n")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+    assert kf.getvalue() == "line\n"
+
+    with kf as entered:
+        assert entered is kf
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
