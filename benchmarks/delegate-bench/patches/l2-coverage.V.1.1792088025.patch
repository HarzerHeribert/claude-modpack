+def test_lazy_file_dash_read():
+    runner = CliRunner()
+
+    with runner.isolation(input="hello\n"):
+        lf = click.utils._LazyFile("-")
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+        assert lf.read() == "hello\n"
+
+
+def test_lazy_file_dash_write_not_closed():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _, _):
+        with click.utils._LazyFile("-", "w") as lf:
+            lf.write("data")
+
+        # Leaving the block must not close the borrowed stream.
+        assert not lf._f.closed
+        lf.flush()
+        assert out.getvalue() == b"data"
+
+
+def test_lazy_file_repr_and_close(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("content")
+    lf.close()
+    assert f.closed
+    assert path.read_text() == "content"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
