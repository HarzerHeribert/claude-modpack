+def test_module_getattr_unknown():
+    with pytest.raises(AttributeError, match="does_not_exist"):
+        click.utils.does_not_exist  # noqa: B018
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_module_getattr_deprecated(name):
+    with pytest.deprecated_call():
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
