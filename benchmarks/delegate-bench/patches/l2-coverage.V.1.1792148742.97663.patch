+def test_expand_args_glob(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    sub = tmp_path / "sub"
+    sub.mkdir()
+    (sub / "c.txt").touch()
+
+    assert sorted(_expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+    assert sorted(_expand_args(["**/*.txt"])) == [
+        "a.txt",
+        "b.txt",
+        os.path.join("sub", "c.txt"),
+    ]
+    # Without recursion, "**" behaves like "*" and only matches one level.
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "c.txt")
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[invalid"]) == ["[invalid"]
