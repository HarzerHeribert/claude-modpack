+def test_echo_bytes_to_text_only_stream_raises():
+    # A text stream with no binary buffer can't accept bytes, so the bytes are
+    # passed straight to write, which raises.
+    f = StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=f)
+
+
+def test_echo_empty_flushes_only():
+    class Recorder(StringIO):
+        flushed = 0
+
+        def flush(self):
+            self.flushed += 1
+            super().flush()
+
+    f = Recorder()
+    click.echo("", file=f, nl=False)
+    assert f.getvalue() == ""
+    assert f.flushed == 1
+
