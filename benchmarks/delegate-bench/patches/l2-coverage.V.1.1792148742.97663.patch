+def test_lazy_file_dash_uses_standard_stream(runner):
+    with runner.isolation() as (out, _, _):
+        with _LazyFile("-", "w") as lf:
+            assert lf._f is not None
+            assert lf.should_close is False
+            assert repr(lf) == repr(lf._f)
+            lf.write("hello")
+            lf.flush()
+
+        # Leaving the block must not close the borrowed stream.
+        assert not lf._f.closed
+        assert out.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    with lf:
+        lf.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_is_cached(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with _LazyFile(path, "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_read_checks_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
