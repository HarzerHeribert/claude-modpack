+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flushes():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.wrapped is inner
+
+
+def test_pacify_flush_wrapper_swallows_broken_pipe():
+    inner = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    f = StringIO()
+    wrapper = _PacifyFlushWrapper(f)
+    wrapper.write("abc")
+    assert wrapper.getvalue() == "abc"
+    assert _PacifyFlushWrapper(_FlushRaises()).extra == "proxied"
+
