+def test_make_default_short_help_exact_length_not_last_word():
+    # The second word reaches max_length exactly but more words follow, so
+    # it is truncated with "..." instead of returned as is.
+    assert _make_default_short_help("aaaa bbbb cccc", max_length=9) == "aaaa..."
+
+
+def test_make_default_short_help_exact_length_last_word():
+    assert _make_default_short_help("aaaa bbbb", max_length=9) == "aaaa bbbb"
+
+
+def test_make_default_short_help_first_word_too_long():
+    assert _make_default_short_help("abcdefghij more", max_length=5) == "..."
+
