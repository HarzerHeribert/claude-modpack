+def test_get_binary_stream_stdout(runner):
+    with runner.isolation() as (out, _, _):
+        stream = _get_binary_stream("stdout")
+        stream.write(b"\xff\x00")
+        stream.flush()
+        assert out.getvalue() == b"\xff\x00"
+
+
+def test_get_binary_stream_stdin(runner):
+    with runner.isolation(input=b"\xff\x00"):
+        assert _get_binary_stream("stdin").read() == b"\xff\x00"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_stdout(runner):
+    with runner.isolation() as (out, _, _):
+        stream = _get_text_stream("stdout")
+        stream.write("hi")
+        stream.flush()
+        assert out.getvalue() == b"hi"
+
+
+def test_get_text_stream_stdin(runner):
+    with runner.isolation(input="line\n"):
+        assert _get_text_stream("stdin").read() == "line\n"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
