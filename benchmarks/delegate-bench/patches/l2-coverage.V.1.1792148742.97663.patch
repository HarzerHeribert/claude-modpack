+def test_keep_open_file_repr_and_proxy():
+    f = StringIO("abc")
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+    assert kf.read() == "abc"
+
+    with kf as entered:
+        assert entered is kf
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
