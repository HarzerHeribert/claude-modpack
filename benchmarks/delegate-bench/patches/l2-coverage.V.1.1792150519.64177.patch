+@pytest.mark.parametrize(
+    ("filename", "shorten", "expect"),
+    [
+        pytest.param(b"/a/b/c.txt", True, "c.txt", id="bytes shorten"),
+        pytest.param(b"/a/\xff.txt", False, "/a/�.txt", id="invalid bytes"),
+        pytest.param("/a/\udcff.txt", False, "/a/�.txt", id="surrogate"),
+    ],
+)
+def test_format_filename(filename, shorten, expect):
+    assert click.utils.format_filename(filename, shorten=shorten) == expect
+
