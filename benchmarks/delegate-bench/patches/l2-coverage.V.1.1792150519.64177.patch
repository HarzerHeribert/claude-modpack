+class _FlushRaises(io.StringIO):
+    def __init__(self, exc):
+        super().__init__()
+        self.exc = exc
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    wrapped = io.StringIO()
+    pacified = click.utils._PacifyFlushWrapper(wrapped)
+    pacified.write("text")
+    pacified.flush()
+    assert pacified.getvalue() == "text"
+    assert pacified.wrapped is wrapped
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    pacified = click.utils._PacifyFlushWrapper(
+        _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    pacified.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    pacified = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        pacified.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
