+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "prog.py")])
+    assert click.utils._detect_program_name() == "prog.py"
+
+
+def test_detect_program_name_module_default_main(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain("example"))
+    path = os.path.join("example", "__main__.py")
+    assert click.utils._detect_program_name(path) == "python -m example"
+
+
+def test_expand_args_disabled_expansion(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert sorted(click.utils._expand_args(["**/*.txt"], glob_recursive=True)) == [
+        "b.txt",
+        os.path.join("sub", "a.txt"),
+    ]
+    assert click.utils._expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "a.txt")
+    ]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_module_attributes(name):
+    with pytest.deprecated_call(match=f"click.utils.{name}"):
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
+
+
+def test_unknown_module_attribute():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
