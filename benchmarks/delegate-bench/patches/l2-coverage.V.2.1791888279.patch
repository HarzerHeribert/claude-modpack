+def test_lazyfile_dash_does_not_close_stdout(monkeypatch):
+    buffer = io.BytesIO()
+    stdout = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    with click.utils._LazyFile("-", "w", encoding="utf-8") as lf:
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        lf.write("hi")
+        lf.flush()
+
+    assert not stdout.closed
+    assert buffer.getvalue() == b"hi"
+
