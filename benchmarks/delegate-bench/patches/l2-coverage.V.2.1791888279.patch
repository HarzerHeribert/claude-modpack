+def test_lazyfile_open_is_cached(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("data")
+
+    with click.utils._LazyFile(path) as lf:
+        f = lf.open()
+        assert lf.open() is f
+        assert lf.read() == "data"
+
+    assert f.closed
+
