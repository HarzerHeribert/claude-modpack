+class _NoEmptyWriteStream:
+    """A stream that rejects empty writes, so it's detected as neither a
+    text nor a binary stream, but otherwise accepts any data.
+    """
+
+    def __init__(self):
+        self.chunks = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.chunks.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _NoEmptyWriteStream()
+    click.echo(b"abc", file=stream)
+    assert stream.chunks == [b"abc\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
