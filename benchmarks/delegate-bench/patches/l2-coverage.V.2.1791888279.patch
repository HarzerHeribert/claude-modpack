+def test_keepopenfile_repr_and_proxy(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("abc")
+
+    with path.open() as f:
+        kf = click.utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+        assert kf.name == f.name
+
+        with kf as entered:
+            assert entered is kf
+            assert entered.read() == "abc"
+
+        assert not f.closed
+
