+def test_expand_args_non_recursive(tmp_path):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b.txt").write_text("")
+    (tmp_path / "c.txt").write_text("")
+    pattern = os.path.join(str(tmp_path), "**", "*.txt")
+    recursive = click.utils._expand_args([pattern])
+    flat = click.utils._expand_args([pattern], glob_recursive=False)
+    assert os.path.join(str(tmp_path), "c.txt") in recursive
+    assert os.path.join(str(tmp_path), "a", "b.txt") in recursive
+    assert flat == [os.path.join(str(tmp_path), "a", "b.txt")]
