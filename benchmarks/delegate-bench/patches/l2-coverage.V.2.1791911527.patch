+def test_echo_bytes_to_text_only_stream_fails():
+    # A text stream with no binary buffer can't accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_without_newline_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"raw"), file=out, nl=False)
+    assert out.getvalue() == b"raw"
+
+
+def test_echo_empty_flushes_only():
+    class Recorder(io.StringIO):
+        flushed = 0
+
+        def flush(self):
+            self.flushed += 1
+            super().flush()
+
+    f = Recorder()
+    click.echo("", file=f, nl=False)
+    assert f.getvalue() == ""
+    assert f.flushed == 1
+
+
+def test_echo_object_converted_to_str():
+    f = io.StringIO()
+    click.echo(123, file=f)
+    assert f.getvalue() == "123\n"
+
+
+def test_echo_err_and_no_stream(monkeypatch, std_streams):
+    streams = std_streams()
+    click.echo("to stderr", err=True)
+    sys.stderr.flush()
+    assert streams.stderr.buffer.getvalue() == b"to stderr\n"
+
+    monkeypatch.setattr(sys, "stdout", None)
+    # Nothing to write to, so nothing happens.
+    click.echo("dropped")
+
