+def test_keep_open_file_repr_and_proxy():
+    f = io.StringIO("abc")
+    kof = _KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+    assert kof.read() == "abc"
+
+    with kof as inner:
+        assert inner is kof
+
+    assert not f.closed
+    kof.close()
+    assert f.closed
+
