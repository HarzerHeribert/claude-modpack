+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_repr_invalid_name(tmp_path):
+    lf = _LazyFile(os.path.join(str(tmp_path), "bad\udcff.txt"), "w")
+    assert "bad�.txt" in repr(lf)
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    path = tmp_path / "never.txt"
+    lf = _LazyFile(path, "w")
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_open_is_cached(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("x")
+    lf = _LazyFile(path)
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+    assert f.closed
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error_raises_file_error(tmp_path):
+    target = tmp_path / "no-such-dir" / "out.txt"
+    lf = _LazyFile(target, "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename == str(target)
+    assert isinstance(exc_info.value.__cause__, OSError)
+
