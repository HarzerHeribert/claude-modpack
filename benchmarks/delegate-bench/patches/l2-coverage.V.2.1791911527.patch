+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(std_streams, name):
+    streams = std_streams()
+    stream = _get_binary_stream(name)
+    assert stream is getattr(streams, name).buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_text_stream(std_streams, name):
+    std_streams()
+    stream = _get_text_stream(name)
+    assert isinstance(stream, io.TextIOBase)
+    assert stream.encoding == "utf-8"
+
+
+def test_get_text_stream_custom_encoding(std_streams):
+    streams = std_streams()
+    stream = _get_text_stream("stdout", encoding="latin-1", errors="replace")
+    stream.write("café")
+    stream.flush()
+    assert streams.stdout.buffer.getvalue() == b"caf\xe9"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")  # type: ignore[arg-type]
+
