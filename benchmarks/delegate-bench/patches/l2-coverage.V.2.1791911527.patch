+@pytest.fixture
+def std_streams(monkeypatch):
+    """Return a function that replaces the standard streams with in-memory
+    text streams backed by binary buffers, so they can be opened by name
+    without touching the real process streams.
+
+    It must be called in the test body, since pytest's output capturing
+    replaces the streams again after fixtures are set up.
+    """
+
+    def install():
+        stdin = io.TextIOWrapper(io.BytesIO(b"in line\n"), encoding="utf-8")
+        stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+        stderr = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+        monkeypatch.setattr(sys, "stdin", stdin)
+        monkeypatch.setattr(sys, "stdout", stdout)
+        monkeypatch.setattr(sys, "stderr", stderr)
+        return types.SimpleNamespace(stdin=stdin, stdout=stdout, stderr=stderr)
+
+    return install
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Spaced\tOut\nApp  ", "spaced-out-app"),
+        ("simple", "simple"),
+    ],
+)
+def test_posixify(value, expect):
+    assert _posixify(value) == expect
+
+
+def test_safecall_returns_value():
+    @_safecall
+    def add(a, b=1):
+        return a + b
+
+    assert add(1, b=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        """Docstring is kept."""
+        raise ValueError("boom")
+
+    wrapped = _safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+    assert wrapped.__doc__ == "Docstring is kept."
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"hello", "hello"),
+        ("café".encode(), "café"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expect):
+    assert make_str(value) == expect
