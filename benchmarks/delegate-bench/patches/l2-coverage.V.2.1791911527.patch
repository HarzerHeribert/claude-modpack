+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "wrapped"
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    exc = OSError(errno.EIO, "io")
+    wrapper = _PacifyFlushWrapper(_FlushRaises(exc))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value is exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    f = io.StringIO()
+    wrapper = _PacifyFlushWrapper(f)
+    wrapper.write("text")
+    wrapper.flush()
+    assert wrapper.getvalue() == "text"
+    assert wrapper.wrapped is f
+
