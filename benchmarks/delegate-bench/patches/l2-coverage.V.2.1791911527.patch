+def test_lazy_file_stdout_is_not_closed(std_streams):
+    streams = std_streams()
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("to stdout")
+
+    assert not streams.stdout.closed
+    lf._f.flush()
+    streams.stdout.flush()
+    assert streams.stdout.buffer.getvalue() == b"to stdout"
+
+
+def test_lazy_file_stdin(std_streams):
+    streams = std_streams()
+    with _LazyFile("-") as lf:
+        assert lf.read() == "in line\n"
+
+    assert not streams.stdin.closed
+
