+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        pytest.param(b"hello", "hello", id="valid bytes"),
+        pytest.param(b"caf\xc3\xa9", "caf\xe9", id="utf-8 bytes"),
+        pytest.param(b"bad\xff", "bad�", id="invalid bytes replaced"),
+        pytest.param(42, "42", id="int"),
+        pytest.param("text", "text", id="str"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("abc def ghi", 7, "abc...", id="exact length, more words"),
+        pytest.param("abcdefghij klm", 5, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert _make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{format_filename(str(path))}' w>"
+    # Writing doesn't create the file until it is first accessed.
+    assert not path.exists()
+
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_when_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_stdout_is_not_closed(capsys):
+    with _LazyFile("-", "w") as lf:
+        assert lf._f is not None
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+        lf.write("to stdout")
+
+    assert not lf._f.closed
+    lf.flush()
+    assert capsys.readouterr().out == "to stdout"
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer can't accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream(runner):
+    with runner.isolation() as (out, _, _):
+        stream = _get_text_stream("stdout")
+        stream.write("text stream")
+        stream.flush()
+        assert out.getvalue() == b"text stream"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")  # type: ignore[arg-type]
+
