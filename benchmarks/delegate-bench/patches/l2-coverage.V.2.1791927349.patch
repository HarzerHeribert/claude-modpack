+class _FailingFlush:
+    def __init__(self, exc):
+        self.exc = exc
+
+    def flush(self):
+        raise self.exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    f = io.StringIO()
+    wrapper = _PacifyFlushWrapper(f)
+    assert wrapper.wrapped is f
+    wrapper.write("proxied")
+    wrapper.flush()
+    assert f.getvalue() == "proxied"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(
+        _FailingFlush(BrokenPipeError(errno.EPIPE, ""))  # type: ignore[arg-type]
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(
+        _FailingFlush(OSError(errno.EBADF, "bad fd"))  # type: ignore[arg-type]
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+@pytest.mark.parametrize(
+    ("package", "argv0", "expect"),
+    [
+        pytest.param(None, "/bin/example.py", "example.py", id="file"),
+        pytest.param("example", "/x/example/__main__.py", "python -m example", id="m"),
+    ],
+)
+def test_detect_program_name_defaults(monkeypatch, package, argv0, expect):
+    main = types.ModuleType("__main__")
+    main.__package__ = package
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [argv0])
+    assert _detect_program_name() == expect
+
+
+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
