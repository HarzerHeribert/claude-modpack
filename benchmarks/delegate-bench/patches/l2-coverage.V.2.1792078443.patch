+def test_open_file_regular(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("content")
+    with click.open_file(path) as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        assert f.read() == "content"
+    assert f.closed
+
