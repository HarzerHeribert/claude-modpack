+def test_safecall_returns_value():
+    def func(a, b=1):
+        """Docstring."""
+        return a + b
+
+    wrapped = click.utils._safecall(func)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "func"
+    assert wrapped.__doc__ == "Docstring."
+
+
+def test_safecall_swallows_exception():
+    def func():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(func)() is None
