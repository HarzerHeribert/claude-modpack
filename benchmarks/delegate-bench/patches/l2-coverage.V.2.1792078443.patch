+class TestGetAppDir:
+    @pytest.mark.parametrize("roaming", [True, False])
+    def test_windows_env(self, monkeypatch, roaming):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv("APPDATA", "/roaming")
+        monkeypatch.setenv("LOCALAPPDATA", "/local")
+        expected = os.path.join("/roaming" if roaming else "/local", "Foo Bar")
+        assert click.get_app_dir("Foo Bar", roaming=roaming) == expected
+
+    def test_windows_no_env(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.delenv("APPDATA", raising=False)
+        monkeypatch.delenv("LOCALAPPDATA", raising=False)
+        expected = os.path.join(os.path.expanduser("~"), "Foo Bar")
+        assert click.get_app_dir("Foo Bar") == expected
+        assert click.get_app_dir("Foo Bar", roaming=False) == expected
+
+    def test_force_posix(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        expected = os.path.expanduser("~/.foo-bar")
+        assert click.get_app_dir("Foo Bar", force_posix=True) == expected
+
+    def test_darwin(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "darwin")
+        expected = os.path.join(
+            os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+        )
+        assert click.get_app_dir("Foo Bar") == expected
+
+    def test_xdg_config_home(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.setenv("XDG_CONFIG_HOME", "/xdg")
+        assert click.get_app_dir("Foo Bar") == os.path.join("/xdg", "foo-bar")
+
+    def test_default_config_home(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+        expected = os.path.join(os.path.expanduser("~/.config"), "foo-bar")
+        assert click.get_app_dir("Foo Bar") == expected
