+class TestKeepOpenFile:
+    def test_repr_proxies(self):
+        f = io.StringIO()
+        kf = click.utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+    def test_with_block_keeps_file_open(self):
+        f = io.StringIO()
+        with click.utils._KeepOpenFile(f) as kf:
+            kf.write("hello")
+        assert not f.closed
+        assert f.getvalue() == "hello"
+        kf.close()
+        assert f.closed
+
