+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+class TestPacifyFlushWrapper:
+    def test_flush_passes_through(self):
+        inner = _FlushRaiser()
+        wrapper = click.utils._PacifyFlushWrapper(inner)
+        wrapper.flush()
+        assert inner.flushed == 1
+
+    def test_broken_pipe_is_suppressed(self):
+        inner = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+        wrapper = click.utils._PacifyFlushWrapper(inner)
+        wrapper.flush()
+        assert inner.flushed == 1
+
+    def test_other_os_error_is_raised(self):
+        inner = _FlushRaiser(OSError(errno.EIO, "I/O error"))
+        wrapper = click.utils._PacifyFlushWrapper(inner)
+        with pytest.raises(OSError) as exc_info:
+            wrapper.flush()
+        assert exc_info.value.errno == errno.EIO
+
+    def test_getattr_proxies(self):
+        inner = _FlushRaiser()
+        wrapper = click.utils._PacifyFlushWrapper(inner)
+        assert wrapper.wrapped is inner
+        assert wrapper.name == "wrapped"
+
