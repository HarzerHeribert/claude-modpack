+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly reaching max_length before the last word truncates.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # Exactly reaching max_length on the last word needs no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # The first word alone is too long, every word is removed.
+        ("abcdefghijklmnop rest", 10, "..."),
+        # Only whitespace.
+        (" \n\t ", 45, ""),
+        # Only the first paragraph is considered.
+        ("First line.\n\nSecond paragraph.", 45, "First line."),
+        # A leading no-rewrap marker is ignored.
+        ("\b\nHello world", 45, "Hello world"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    result = click.utils._make_default_short_help(help, max_length)
+    assert result == expected
