+class TestLazyFile:
+    def test_repr_unopened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = click.utils._LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        assert lf._f is None
+        assert not path.exists()
+
+    def test_repr_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = click.utils._LazyFile(path, "w")
+        f = lf.open()
+        try:
+            assert repr(lf) == repr(f)
+            # A second open returns the same file object.
+            assert lf.open() is f
+        finally:
+            lf.close()
+
+    def test_write_via_getattr(self, tmp_path):
+        path = tmp_path / "out.txt"
+        with click.utils._LazyFile(path, "w") as lf:
+            lf.write("hello")
+        assert path.read_text() == "hello"
+
+    def test_close_unopened_is_noop(self, tmp_path):
+        lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+        lf.close()
+        lf.close_intelligently()
+        assert lf._f is None
+
+    def test_read_missing_file_raises_early(self, tmp_path):
+        with pytest.raises(FileNotFoundError):
+            click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error_raises_file_error(self, tmp_path):
+        path = tmp_path / "no-such-dir" / "out.txt"
+        lf = click.utils._LazyFile(path, "w")
+        with pytest.raises(FileError) as exc_info:
+            lf.open()
+        assert exc_info.value.ui_filename == os.fspath(path)
+
+    def test_dash_does_not_close_stream(self, runner):
+        with runner.isolation() as (out, _, _):
+            lf = click.utils._LazyFile("-", "w")
+            assert lf.should_close is False
+            assert lf._f is not None
+            with lf:
+                lf.write("hello")
+                lf.flush()
+            assert not lf._f.closed
+            assert repr(lf) == repr(lf._f)
+            assert out.getvalue() == b"hello"
+
