+def test_get_binary_stream(runner):
+    with runner.isolation(input="data") as (out, _, _):
+        assert click.utils._get_binary_stream("stdin").read() == b"data"
+        stream = click.utils._get_binary_stream("stdout")
+        stream.write(b"bytes")
+        stream.flush()
+    assert out.getvalue() == b"bytes"
+
