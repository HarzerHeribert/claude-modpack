+def test_open_file_dash_keeps_stream_open(runner):
+    with runner.isolation(input="data"):
+        with click.open_file("-") as f:
+            assert isinstance(f, click.utils._KeepOpenFile)
+            assert f.read() == "data"
+        assert not f.closed
