+class _EmptyWriteRejecter:
+    """A stream that is neither recognized as binary nor text, because it
+    rejects empty writes, but accepts any non-empty data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+        self.data.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _EmptyWriteRejecter()
+    click.echo(b"hello", file=f)
+    assert f.data == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    f = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
+
+def test_echo_empty_only_flushes():
+    f = _EmptyWriteRejecter()
+    click.echo("", file=f, nl=False)
+    assert f.data == []
+    assert f.flushed == 1
+
