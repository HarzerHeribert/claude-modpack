+def test_lazy_file_dash_not_closed(runner):
+    @click.command()
+    def cli():
+        with click.open_file("-", "w", lazy=True) as f:
+            assert isinstance(f, _LazyFile)
+            assert f.should_close is False
+            assert repr(f) == repr(f._f)
+            f.write("lazy stdout")
+
+        # Leaving the block did not close stdout.
+        assert not f._f.closed
+        click.echo("!")
+
+    result = runner.invoke(cli)
+    assert result.exception is None
+    assert result.output == "lazy stdout!\n"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("content")
+    f = click.open_file(path, lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert f._f is None
+
+    with f:
+        assert f.read() == "content"
+
+    assert f._f.closed
+
+
+def test_open_file_lazy_read_missing(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.open_file(tmp_path / "missing.txt", lazy=True)
+
