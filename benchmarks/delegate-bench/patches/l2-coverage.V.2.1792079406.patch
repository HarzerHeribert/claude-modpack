+def test_make_str_bytes():
+    assert make_str(b"hello") == "hello"
+
+
+def test_make_str_bytes_fallback_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    assert make_str(b"bad \xff") == "bad �"
+
+
+@pytest.mark.parametrize(("value", "expect"), [("text", "text"), (42, "42")])
+def test_make_str_other(value, expect):
