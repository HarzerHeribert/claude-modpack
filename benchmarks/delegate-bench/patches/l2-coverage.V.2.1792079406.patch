+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "fake"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    _PacifyFlushWrapper(stream).flush()
+    assert stream.flushed
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    stream = _FlushStream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    # Must not raise.
+    _PacifyFlushWrapper(stream).flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    stream = _FlushStream(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(stream).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    assert wrapper.name == "fake"
+    assert wrapper.wrapped is stream
+
