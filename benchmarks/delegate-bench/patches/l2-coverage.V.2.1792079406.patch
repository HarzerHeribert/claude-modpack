+@pytest.mark.parametrize(
+    ("package", "argv0", "expect"),
+    [
+        (None, os.path.join("some", "dir", "app.py"), "app.py"),
+        ("example", os.path.join("example", "__main__.py"), "python -m example"),
+    ],
+)
+def test_detect_program_name_defaults(monkeypatch, package, argv0, expect):
+    main = types.ModuleType("__main__")
+    main.__package__ = package
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [argv0])
+    assert _detect_program_name() == expect
+
+
+def test_detect_program_name_empty_path_uses_argv(monkeypatch):
+    monkeypatch.setattr(sys, "argv", ["cli.py"])
+    main = types.ModuleType("__main__")
+    main.__package__ = ""
+    assert _detect_program_name("", _main=main) == "cli.py"
+
