+def test_echo_bytes_without_binary_writer():
+    # A text-only stream with no binary buffer can't accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_get_text_stream(capsys):
+    stream = _get_text_stream("stdout")
+    stream.write("text stream")
+    stream.flush()
+    assert capsys.readouterr().out == "text stream"
+
