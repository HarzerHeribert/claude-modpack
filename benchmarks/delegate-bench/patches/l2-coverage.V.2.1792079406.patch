+def test_keep_open_file_repr():
+    stream = io.StringIO()
+    kf = _KeepOpenFile(stream)
+    assert repr(kf) == repr(stream)
+
+
+def test_keep_open_file_not_closed_by_with():
+    stream = io.StringIO()
+
+    with _KeepOpenFile(stream) as kf:
+        kf.write("x")
+
+    assert not stream.closed
+    assert stream.getvalue() == "x"
+
