+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("data")
+    kof = _KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+
+    with kof as inner:
+        assert inner is kof
+        assert inner.read() == "data"
+
+    assert not f.closed
+    kof.close()
+    assert f.closed
+
