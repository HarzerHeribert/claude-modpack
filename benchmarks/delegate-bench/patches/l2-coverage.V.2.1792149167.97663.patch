+class _BytesOnlyNonEmptyWriter:
+    """A stream that fails the binary/text writer probes (it rejects empty
+    writes) and has no ``buffer``, but accepts real data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushes = 0
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushes += 1
+
+
+@pytest.mark.parametrize("message", [b"raw", bytearray(b"raw")])
+def test_echo_bytes_without_binary_writer(message):
+    stream = _BytesOnlyNonEmptyWriter()
+    click.echo(message, file=stream)
+    assert stream.data == [b"raw\n"]
+    assert stream.flushes == 1
+
