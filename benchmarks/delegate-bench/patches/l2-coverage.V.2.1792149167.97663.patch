+def test_open_file_stdout_is_kept_open():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _err, _output):
+        f = open_file("-", "w")
+        assert isinstance(f, _KeepOpenFile)
+
+        with f:
+            f.write("hi")
+            f.flush()
+
+        assert not f.closed
+        assert out.getvalue() == b"hi"
