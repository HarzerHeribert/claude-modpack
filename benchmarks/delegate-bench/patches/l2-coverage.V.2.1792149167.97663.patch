+def test_lazy_file_stdin_is_not_closed():
+    runner = CliRunner()
+
+    with runner.isolation(input="from stdin\n"):
+        lf = _LazyFile("-", "r")
+        assert not lf.should_close
+        assert lf._f is not None
+
+        with lf as f:
+            assert f.read() == "from stdin\n"
+
+        # The wrapped stream was not closed by the context manager.
+        assert not lf._f.closed
+
+
+def test_lazy_file_stdout_write():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _err, _output):
+        with _LazyFile("-", "w") as lf:
+            lf.write("to stdout")
+            lf.flush()
+
+        assert out.getvalue() == b"to stdout"
+
