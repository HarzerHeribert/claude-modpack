+def test_detect_program_name_defaults_to_sys_main(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    assert click.utils._detect_program_name("/path/to/app.py") == "app.py"
+
+
+def test_detect_program_name_defaults_to_argv(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "cli.py")])
+    assert click.utils._detect_program_name(_main=main) == "python -m example.cli"
+
