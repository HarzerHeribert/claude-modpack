+class _Wrapped:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_and_proxy():
+    wrapped = _Wrapped()
+    w = click.utils._PacifyFlushWrapper(wrapped)  # type: ignore[arg-type]
+    w.flush()
+    assert wrapped.flushed == 1
+    assert w.extra == "proxied"
+    assert w.wrapped is wrapped
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapped = _Wrapped(OSError(errno.EPIPE, "Broken pipe"))
+    w = click.utils._PacifyFlushWrapper(wrapped)  # type: ignore[arg-type]
+    w.flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapped = _Wrapped(OSError(errno.EIO, "I/O error"))
+    w = click.utils._PacifyFlushWrapper(wrapped)  # type: ignore[arg-type]
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
