+def test_open_file_lazy_write(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy data")
+
+    assert path.read_text() == "lazy data"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "lazy.txt"
+    path.write_text("content")
+
+    with click.open_file(path, lazy=True) as f:
+        assert isinstance(f, click.utils._LazyFile)
+        assert f.read() == "content"
+
+
+def test_open_file_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+
+    with click.open_file(path, "w", atomic=True) as f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_format_filename_bytes_and_shorten():
+    assert click.format_filename(b"/a/b/c\xff.txt") == "/a/b/c�.txt"
+    assert click.format_filename(b"/a/b/c.txt", shorten=True) == "c.txt"
+    assert click.format_filename("/a/b/c.txt", shorten=True) == "c.txt"
