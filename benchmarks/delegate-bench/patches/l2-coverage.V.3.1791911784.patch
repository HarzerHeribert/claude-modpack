+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    @click.utils._safecall
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+    assert add.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    calls = []
+
+    @click.utils._safecall
+    def fail():
+        calls.append(True)
+        raise ValueError("boom")
+
+    assert fail() is None
+    assert calls == [True]
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff\xfeabc", "��abc"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word.
+        ("Hello world again", 11, "Hello..."),
+        # The first word alone fills max_length, nothing is left.
+        ("abcde fgh", 5, "..."),
+        # Exactly max_length on the last word needs no truncation.
+        ("Hello world", 11, "Hello world"),
+    ],
+)
+def test_make_default_short_help_exact_length(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_dash_uses_stdin_and_stays_open(monkeypatch):
+    stdin = io.TextIOWrapper(io.BytesIO(b"from stdin\n"), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdin", stdin)
+
+    with click.utils._LazyFile("-") as lf:
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        assert lf.read() == "from stdin\n"
+
+    # close_intelligently must not close a standard stream.
+    assert not lf._f.closed
+    assert not stdin.closed
+
+
+def test_keep_open_file_proxies_and_stays_open():
+    buf = io.StringIO("data")
+    kf = click.utils._KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+
+    with kf as f:
+        assert f is kf
+        assert f.read() == "data"
+
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
+
