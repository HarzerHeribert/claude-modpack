+def test_echo_bytes_without_binary_writer():
+    class RejectEmptyWrites:
+        """A stream where neither the binary nor the text probe succeeds,
+        and which has no ``buffer``, so no binary writer can be found.
+        """
+
+        def __init__(self):
+            self.written = []
+            self.flushed = 0
+
+        def write(self, data):
+            if not data:
+                raise ValueError("empty write")
+            self.written.append(data)
+
+        def flush(self):
+            self.flushed += 1
+
+    f = RejectEmptyWrites()
+    click.echo(b"raw", file=f)  # type: ignore[arg-type]
+    assert f.written == [b"raw\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_empty_message_only_flushes():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_converted_to_str():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
