+import errno
+import glob
+import io
+import os
+import re
+import sys
+from types import ModuleType
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_safecall_returns_result():
+    @click.utils._safecall
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+    assert add.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    @click.utils._safecall
+    def fail():
+        raise ValueError("boom")
+
+    assert fail() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        pytest.param("text", "text", id="str"),
+        pytest.param(42, "42", id="int"),
+        pytest.param("café".encode(), "café", id="bytes"),
+        pytest.param(b"a\xffb", "a�b", id="invalid bytes"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    # Use a UTF-8 filesystem encoding so invalid bytes fail to decode and fall
+    # back to replacement on every platform.
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("123 567 90 abc", 10, "123 567...", id="exact length mid text"),
+        pytest.param("1234567890 abc", 10, "...", id="first word exact length"),
+        pytest.param("12345678901 abc", 10, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(path)}' w>"
+    assert not path.exists()
+    lf.close()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils._LazyFile(path, "w") as lf:
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not path.exists()
+
+
+def test_lazy_file_stdout_not_closed(capsys):
+    with click.utils._LazyFile("-", "w") as lf:
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO()
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as entered:
+        assert entered is kf
+        kf.write("data")
+
+    assert not f.closed
+    assert f.getvalue() == "data"
+
+
+def test_echo_bytes_without_binary_writer():
+    # A text-only stream with no ``buffer`` has no binary writer, so the bytes
+    # are passed to ``write`` directly and the stream rejects them.
+    f = io.StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=f)
+
+    assert f.getvalue() == ""
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(capsys):
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("hello")
+    stream.flush()
+    assert capsys.readouterr().out == "hello"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
+
+def test_open_file_stdout_keeps_open(capsys):
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        assert repr(f) == repr(sys.stdout)
+        f.write("hello")
+
+    assert not sys.stdout.closed
+    assert capsys.readouterr().out == "hello"
+
