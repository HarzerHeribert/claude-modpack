+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word, not at a sentence end.
+        ("ab cd efg", 5, "ab..."),
+        # First word alone reaches max_length with more words after it.
+        ("abcde fgh", 5, "..."),
+        # First word alone is too long.
+        ("abcdefgh ij", 5, "..."),
+        # Fits exactly with the last word.
+        ("ab cd", 5, "ab cd"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
