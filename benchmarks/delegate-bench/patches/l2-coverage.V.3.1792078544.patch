+class _FlushRaiser:
+    def __init__(self, error=None):
+        self.error = error
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushRaiser()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    inner = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaiser(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
