+class _PickyWriter:
+    """Accepts non-empty writes of any type but rejects empty probes, so it
+    looks like neither a binary nor a text writer and has no buffer.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _PickyWriter()
+    click.echo(b"raw", file=out)
+    assert out.data == [b"raw\n"]
+    assert out.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
