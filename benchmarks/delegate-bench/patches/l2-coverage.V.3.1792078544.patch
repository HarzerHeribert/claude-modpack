+def test_lazy_file_dash_uses_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+    assert lf._f is fake_stdout
+    assert lf.should_close is False
+    assert repr(lf) == repr(fake_stdout)
+
+    with lf:
+        lf.write("hello")
+
+    # Leaving the block must not close the borrowed stream.
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_open_returns_cached(tmp_path):
+    lf = _LazyFile(tmp_path / "file.txt", "w")
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+
