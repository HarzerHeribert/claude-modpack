+def test_keep_open_file_repr_and_context(tmp_path):
+    with open(tmp_path / "file.txt", "w") as f:
+        kof = _KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+
+        with kof as entered:
+            assert entered is kof
+            entered.write("x")
+
+        assert not f.closed
+
+    assert (tmp_path / "file.txt").read_text() == "x"
+
