+def test_get_binary_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_binary_stream("stdout") is fake_stdout.buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_text_stream("stdout") is fake_stdout
+
+
+def test_get_text_stream_rewraps(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = _get_text_stream("stdout", encoding="latin-1", errors="replace")
+    assert stream is not fake_stdout
+    stream.write("é")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == b"\xe9"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
