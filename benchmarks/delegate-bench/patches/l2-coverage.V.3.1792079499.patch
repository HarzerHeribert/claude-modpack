+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushRaises()
+    wrapper = utils._PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(inner).flush()
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapper = utils._PacifyFlushWrapper(_FlushRaises())
+    assert wrapper.name == "wrapped"
+
