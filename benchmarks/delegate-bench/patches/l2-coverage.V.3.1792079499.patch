+def test_lazy_file_dash_write(capsys):
+    lf = utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Closing intelligently must not close the borrowed stdout.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_unopened_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_opens_on_attribute_access(tmp_path):
+    path = tmp_path / "out.txt"
+    with utils._LazyFile(path, "w") as lf:
+        lf.write("data")
+        # open() returns the same object once opened.
+        assert lf.open() is lf._f
+        assert repr(lf) == repr(lf._f)
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_error(tmp_path):
+    path = tmp_path / "missing" / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_iter(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+    lf = utils._LazyFile(path, "r")
+    assert list(lf) == ["a\n", "b\n"]
+    lf.close()
+
+
+def test_keep_open_file_repr_and_context():
+    f = io.StringIO("x")
+    kof = utils._KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+    with kof as entered:
+        assert entered is kof
+        assert entered.read() == "x"
+    assert not f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+    with f:
+        f.write("content")
+    assert path.read_text() == "content"
+
