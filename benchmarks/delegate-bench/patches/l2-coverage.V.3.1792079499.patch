+class _BytesOnlyWhenNonEmpty:
+    """A stream that accepts bytes, but fails the empty-bytes probe used to
+    detect binary writers, and exposes no ``buffer``.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("probe")
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _BytesOnlyWhenNonEmpty()
+    click.echo(b"hi", file=f)
+    assert f.data == ["", b"hi\n"]
+    assert f.flushed >= 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    f = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
