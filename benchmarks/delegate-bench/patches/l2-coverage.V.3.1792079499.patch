+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly fills max_length before the last word.
+        ("ab cd ef", 5, "ab..."),
+        # First word exactly fills max_length but more words follow.
+        ("abcde fgh", 5, "..."),
+        # First word alone is too long.
+        ("abcdefgh", 5, "..."),
+        # Exactly fills max_length on the last word, no truncation.
+        ("ab cd", 5, "ab cd"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
