+def test_lazyfile_dash_uses_stdout(capsys):
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # Closing intelligently must leave stdout open.
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazyfile_repr_and_lazy_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert lf._f is None
+    assert lf.should_close is True
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    # Closing an unopened file does nothing.
+    lf.close()
+    assert lf._f is None
+
+    lf.write("data")
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    # Opening again returns the same file object.
+    assert lf.open() is lf._f
+
+    lf.close_intelligently()
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
