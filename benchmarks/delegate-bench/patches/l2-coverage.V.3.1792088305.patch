+def test_get_app_dir_windows_roaming(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", "/roaming")
+    monkeypatch.setenv("LOCALAPPDATA", "/local")
+    assert click.get_app_dir("Foo Bar") == os.path.join("/roaming", "Foo Bar")
+    assert click.get_app_dir("Foo Bar", roaming=False) == os.path.join(
+        "/local", "Foo Bar"
+    )
+    # force_posix has no effect on Windows.
+    assert click.get_app_dir("Foo Bar", force_posix=True) == os.path.join(
+        "/roaming", "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch, tmp_path):
+    monkeypatch.setattr(click.utils, "WIN", True)
