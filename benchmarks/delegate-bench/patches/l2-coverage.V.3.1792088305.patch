+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = _FlushRaiser()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_proxies_writes():
+    inner = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.write("hello")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hello"
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    inner = _FlushRaiser(OSError(errno.EPIPE, "Broken pipe"))
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe_error():
+    inner = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaiser(OSError(errno.EIO, "I/O error"))
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_missing_attribute():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaiser())
+
+    with pytest.raises(AttributeError):
+        wrapper.does_not_exist  # noqa: B018
+
