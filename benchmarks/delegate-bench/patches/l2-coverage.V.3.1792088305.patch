+def test_safecall_returns_value():
+    @click.utils._safecall
+    def add(a, b=1):
+        """Add things."""
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+    assert add.__doc__ == "Add things."
+
+
+def test_safecall_swallows_exception():
+    calls = []
+
+    @click.utils._safecall
+    def fail():
+        calls.append(True)
+        raise ValueError("boom")
+
+    assert fail() is None
+    assert calls == [True]
+
+
+def test_safecall_does_not_swallow_base_exception():
+    @click.utils._safecall
+    def interrupt():
+        raise KeyboardInterrupt
+
+    with pytest.raises(KeyboardInterrupt):
+        interrupt()
+
