+def test_echo_object_and_color(monkeypatch):
+    out = io.StringIO()
+    click.echo(123, file=out)
+    click.echo(click.style("red", fg="red"), file=out)
+    click.echo(click.style("kept", fg="red"), file=out, color=True)
+    assert out.getvalue() == f"123\nred\n{click.style('kept', fg='red')}\n"
