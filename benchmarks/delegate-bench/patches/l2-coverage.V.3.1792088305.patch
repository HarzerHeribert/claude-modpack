+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_text_stream(monkeypatch, name):
+    sentinel = io.StringIO()
+    seen = []
+
+    def opener(encoding, errors):
+        seen.append((encoding, errors))
+        return sentinel
+
+    monkeypatch.setitem(click.utils.text_streams, name, opener)
+    assert click.utils._get_text_stream(name, "utf-8", "replace") is sentinel
+    assert click.utils._get_text_stream(name) is sentinel
+    assert seen == [("utf-8", "replace"), (None, "strict")]
+
