+def test_keepopenfile_proxies_and_stays_open():
+    buf = io.StringIO("line1\nline2\n")
+    kf = click.utils._KeepOpenFile(buf)
+
+    assert repr(kf) == repr(buf)
+    assert kf.readline() == "line1\n"
+
+    with kf as f:
+        assert f is kf
+        assert list(f) == ["line2\n"]
+
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
