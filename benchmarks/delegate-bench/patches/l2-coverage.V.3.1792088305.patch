+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "b.txt").touch()
+    pattern = os.path.join(str(tmp_path), "**", "*.txt")
+
+    recursive = sorted(click.utils._expand_args([pattern]))
+    assert recursive == sorted(
+        [str(tmp_path / "a.txt"), str(tmp_path / "sub" / "b.txt")]
+    )
+
+    flat = click.utils._expand_args([pattern], glob_recursive=False)
+    assert flat == [str(tmp_path / "sub" / "b.txt")]
+
+
+def test_expand_args_re_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad", "other"]) == ["[bad", "other"]
