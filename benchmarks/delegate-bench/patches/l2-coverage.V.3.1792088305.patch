+def test_echo_bytes_without_binary_writer(monkeypatch):
+    class Recorder:
+        def __init__(self):
+            self.written = []
+            self.flushes = 0
+
+        def write(self, data):
+            self.written.append(data)
+
+        def flush(self):
+            self.flushes += 1
+
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    out = Recorder()
+    click.echo(b"bytes", file=out)
+    assert out.written == [b"bytes\n"]
+    assert out.flushes == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out)
+    click.echo(b"def", file=out, nl=False)
+    assert out.getvalue() == b"abc\ndef"
+
+
+def test_echo_empty_message_only_flushes():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
