+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_is_idempotent(tmp_path):
+    path = tmp_path / "out.txt"
+    with _LazyFile(path, "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+
+    assert f.closed
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "out.txt").exists()
+
+
+def test_lazy_file_stdout_not_closed(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = _LazyFile("-", "wb")
+    assert lf.should_close is False
+    assert lf._f is fake_stdout.buffer
+    assert repr(lf) == repr(fake_stdout.buffer)
+
+    with lf as f:
+        f.write(b"hello")
+
+    assert not fake_stdout.buffer.closed
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("data")
+    kof = _KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+
+    with kof as inner:
+        assert inner is kof
+        assert inner.read() == "data"
+
+    assert not f.closed
+    kof.close()
+    assert f.closed
+
