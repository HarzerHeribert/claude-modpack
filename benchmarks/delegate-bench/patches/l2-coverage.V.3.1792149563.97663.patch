+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    args = ["~", "$CLICK_TEST_VAR"]
+    assert _expand_args(args, user=False, env=False) == args
+
+
+def test_expand_args_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    out = _expand_args(["~/does-not-exist", "$CLICK_TEST_VAR-x"])
+    assert out == [os.path.expanduser("~/does-not-exist"), "value-x"]
+
+
+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "c.txt").touch()
+
+    out = _expand_args([str(tmp_path / "*.txt")])
+    assert sorted(out) == [str(tmp_path / "a.txt"), str(tmp_path / "b.txt")]
+
+    out = _expand_args([str(tmp_path / "**" / "*.txt")])
+    assert str(tmp_path / "sub" / "c.txt") in out
+
+    out = _expand_args([str(tmp_path / "**" / "*.txt")], glob_recursive=False)
+    assert out == [str(tmp_path / "sub" / "c.txt")]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
