+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_lazy_read_checks_early(tmp_path):
+    with pytest.raises(OSError):
+        open_file(tmp_path / "missing.txt", "r", lazy=True)
+
+
+def test_open_file_stdout_kept_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    f = open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+
+    with f as out:
+        out.write("hi")
+        out.flush()
+
+    assert not fake_stdout.closed
+    assert fake_stdout.buffer.getvalue() == b"hi"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with open_file(path, "w") as f:
+        assert not isinstance(f, _KeepOpenFile)
+        f.write("plain")
+
+    assert path.read_text() == "plain"
