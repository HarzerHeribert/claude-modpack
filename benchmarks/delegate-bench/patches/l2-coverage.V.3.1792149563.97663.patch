+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    assert _get_binary_stream("stdout") is fake_stdout.buffer
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = _get_text_stream("stdout")
+    stream.write("héllo")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == "héllo".encode()
