+def _patch_stdout(monkeypatch):
+    """Replace ``sys.stdout`` with a text wrapper around an in-memory
+    binary buffer, so standard stream helpers have a real binary layer.
+
+    This must be called from the test body, pytest's output capturing
+    replaces ``sys.stdout`` again between fixture setup and the test call.
+    """
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
