+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"caf\xc3\xa9", "café"),
+        (b"bad\xff", "bad�"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(value, expected):
+    assert make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # The exact length is reached before the last word, truncate.
+        ("abc def ghi", 7, "abc..."),
+        # The first word alone is already too long.
+        ("abcdefghij", 5, "..."),
+        # Fits exactly at the last word, no truncation.
+        ("abc def", 7, "abc def"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
