+def test_echo_bytes_without_binary_writer(monkeypatch):
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    out = io.BytesIO()
+    echo(b"hello", file=out)
+    assert out.getvalue() == b"hello\n"
+
+
+def test_echo_bytearray_no_newline():
+    out = io.BytesIO()
+    echo(bytearray(b"hi"), file=out, nl=False)
+    assert out.getvalue() == b"hi"
+
+
+def test_echo_no_message_no_newline_flushes():
+    class Recorder(io.StringIO):
+        flushed = False
+
+        def flush(self):
+            self.flushed = True
+            super().flush()
+
+    out = Recorder()
+    echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+    assert out.flushed
+
+
+def test_echo_no_standard_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    # Nothing to write to, so this silently does nothing.
+    echo("hello")
+    echo("hello", err=True)
+
