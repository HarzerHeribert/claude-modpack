+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click import utils
+
+
+def _patch_stdout(monkeypatch):
+    # Patch inside the test body, pytest's capture would replace
+    # sys.stdout again after fixture setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("Foo Bar", "foo-bar"), ("  My   App ", "my-app"), ("app", "app")],
+)
+def test_posixify(value, expected):
+    assert utils._posixify(value) == expected
+
+
+def test_safecall_returns_value():
+    def add(a, b=1):
+        """Add numbers."""
+        return a + b
+
+    wrapped = utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add numbers."
+
+
+def test_safecall_swallows_exception():
+    calls = []
+
+    def fail():
+        calls.append(True)
+        raise ValueError("boom")
+
+    assert utils._safecall(fail)() is None
+    assert calls == [True]
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert utils.make_str(b"caf\xc3\xa9") == "café"
+
+
+def test_make_str_bytes_invalid(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert utils.make_str(b"caf\xff") == "caf\ufffd"
+
+
+def test_make_str_other():
+    assert utils.make_str(42) == "42"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # The second word ends exactly at max_length but more words follow.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The very first word is already too long.
+        ("abcdefghijkl more", 5, "..."),
+        # The first word fills max_length exactly, more words follow.
+        ("abcde fgh", 5, "..."),
+    ],
+)
+def test_make_default_short_help_truncation(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with utils._LazyFile(path, "w") as lf:
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_dash_is_not_closed(monkeypatch):
+    text_stdout = _patch_stdout(monkeypatch)
+    lf = utils._LazyFile("-", "w")
+    assert lf._f is text_stdout
+    assert lf.should_close is False
+    assert repr(lf) == repr(text_stdout)
+
+    with lf as f:
+        f.write("hi")
+
+    assert not text_stdout.closed
+    text_stdout.flush()
+    assert text_stdout.buffer.getvalue() == b"hi"
+
+
+def test_keep_open_file_repr(tmp_path):
+    path = tmp_path / "data.txt"
+    path.write_text("x")
+
+    with open(path) as f:
+        kf = utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as k:
+            assert k is kf
+
+        assert not f.closed
+
+
+def test_echo_bytes_without_binary_writer():
+    out = io.StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=out)
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    text_stdout = _patch_stdout(monkeypatch)
+    assert utils._get_text_stream("stdout") is text_stdout
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
