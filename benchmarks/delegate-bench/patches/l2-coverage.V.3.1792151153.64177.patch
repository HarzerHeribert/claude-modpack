+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.written = []
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+    def write(self, value):
+        self.written.append(value)
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRaises()
+    wrapper = utils._PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapped = _FlushRaises()
+    wrapper = utils._PacifyFlushWrapper(wrapped)
+    wrapper.write("hello")
+    assert wrapped.written == ["hello"]
+    assert wrapper.exc is None
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/example.py", "--flag"])
+    assert utils._detect_program_name() == "example.py"
+
+
+def test_detect_program_name_default_module(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/example/cli.py"])
+    assert utils._detect_program_name() == "python -m example.cli"
+
