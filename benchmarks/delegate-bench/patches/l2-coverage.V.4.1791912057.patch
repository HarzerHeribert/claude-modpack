+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_not_recursive(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b").mkdir()
+    (tmp_path / "a" / "b" / "c.txt").write_text("")
+    assert click.utils._expand_args(["**/c.txt"]) == [os.path.join("a", "b", "c.txt")]
+    assert click.utils._expand_args(["**/c.txt"], glob_recursive=False) == [
+        "**/c.txt"
+    ]
+
+
+def test_expand_args_re_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
