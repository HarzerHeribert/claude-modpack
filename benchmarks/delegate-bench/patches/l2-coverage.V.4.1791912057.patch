+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.utils.format_filename(path)}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils._LazyFile(path, "w") as lf:
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_open_twice_returns_same(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils._LazyFile(path, "w") as lf:
+        assert lf.open() is lf.open()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_stdout(runner):
+    with runner.isolation() as (out, _, _):
+        lf = click.utils._LazyFile("-", "w")
+        assert lf._f is not None
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+
+        with lf:
+            lf.write("hello")
+
+        # The standard stream was not closed by close_intelligently.
+        assert not lf._f.closed
+        lf.flush()
+        assert out.getvalue() == b"hello"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_atomic(tmp_path):
+    path = tmp_path / "out.txt"
+    path.write_text("old")
+
+    with click.utils.open_file(path, "w", atomic=True) as f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_keep_open_file_repr_and_iter(runner):
+    with runner.isolation(input="a\nb\n"):
+        f = click.utils.open_file("-")
+        assert isinstance(f, click.utils._KeepOpenFile)
+        assert repr(f) == repr(f._file)
+
+        with f:
+            assert list(f) == ["a\n", "b\n"]
+
+        assert not f.closed
+
