+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_ok():
+    wrapped = _FlushRaises()
+    w = click.utils._PacifyFlushWrapper(wrapped)
+    w.flush()
+    assert wrapped.flushed == 1
+    # Other attributes are proxied.
+    assert w.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_epipe():
+    wrapped = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
