+        ("text", "text"),
+        (42, "42"),
+        (b"bytes", "bytes"),
+        (b"\xff\xfe", "��"),
+    ],
+)
+def test_make_str(value, expect):
+    assert click.utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expect"),
+    [
+        # Exactly hits the limit before the last word, truncate with "...".
+        ("ab cd ef", 5, "ab..."),
+        # The first word exactly hits the limit, nothing fits with "...".
+        ("abcde fgh", 5, "..."),
+        # The first word alone is too long.
+        ("abcdefgh", 5, "..."),
+        # Exactly hits the limit on the last word, no truncation.
+        ("ab cd", 5, "ab cd"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expect):
+    assert click.utils._make_default_short_help(help, max_length) == expect
+
