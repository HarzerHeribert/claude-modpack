+class _BytesOnlyWhenNonEmpty:
+    """A stream that isn't detected as a binary or text writer, because it
+    rejects empty writes, and has no ``buffer``.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_no_binary_writer():
+    f = _BytesOnlyWhenNonEmpty()
+    click.utils.echo(b"abc", file=f)
+    assert f.data == [b"abc\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file(tmp_path):
+    path = tmp_path / "out.bin"
+
+    with open(path, "wb") as f:
+        click.utils.echo(bytearray(b"abc"), file=f, nl=False)
+
+    assert path.read_bytes() == b"abc"
+
+
+def test_echo_no_default_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.utils.echo("nowhere")
+    click.utils.echo("nowhere", err=True)
+
+
+def test_echo_empty_flushes():
+    f = _BytesOnlyWhenNonEmpty()
+    click.utils.echo("", file=f, nl=False)
+    click.utils.echo(None, file=f, nl=False)
+    assert f.data == []
+    assert f.flushed == 2
+
+
+@pytest.mark.parametrize("color", [True, False])
+def test_echo_color(color):
+    from io import StringIO
+
+    f = StringIO()
+    click.utils.echo("\x1b[31mx\x1b[39m", file=f, color=color)
+
+    if color:
+        assert f.getvalue() == "\x1b[31mx\x1b[39m\n"
+    else:
+        assert f.getvalue() == "x\n"
+
+
+@pytest.mark.parametrize(
+    "func", [click.utils._get_binary_stream, click.utils._get_text_stream]
+)
+def test_get_stream_unknown(func):
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        func("nope")
+
