+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+from click.exceptions import FileError
+
+
+def _patch_stdout(monkeypatch):
+    # Patch in the test body, pytest's capture replaces sys.stdout again
+    # between fixture setup and the test call.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+def test_make_str():
+    assert click.utils.make_str(b"hello") == "hello"
+    assert click.utils.make_str(42) == "42"
+    assert click.utils.make_str("text") == "text"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"caf\xc3\xa9\xff") == "café�"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hits max length before the last word, truncate with "...".
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # A single first word longer than the limit.
+        ("abcdefghijk more", 5, "..."),
+        ("abcdefghijk", 5, "..."),
+        ("", 45, ""),
+        ("\b\nshort text", 45, "short text"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert not lf.should_close
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    # Not owned by the lazy file, so it must stay open.
+    lf.close_intelligently()
+    with lf:
+        pass
+    assert not lf._f.closed
+    lf._f.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(str(path))}' w>"
+    assert lf._f is None
+    # Closing an unopened file is a no-op.
+    lf.close()
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("data")
+    lf.close_intelligently()
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_read_missing_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    path = tmp_path / "missing" / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename == click.format_filename(str(path))
+
+
+def test_keep_open_file(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kof = click.utils._KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+
+        with kof as entered:
+            assert entered is kof
+            assert entered.readline() == "a\n"
+
+        assert not f.closed
+        assert list(kof) == ["b\n"]
+
+
+def test_echo_bytes_to_text_only_stream():
+    # No binary buffer can be found, so the bytes are passed to the text
+    # stream's write as-is, which rejects them.
+    out = io.StringIO()
+
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=out)
+
+    assert out.getvalue() == ""
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_empty_message_flushes():
+    out = io.StringIO()
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_strip_ansi():
+    class Obj:
+        def __str__(self):
+            return "\033[31mred\033[0m"
+
+    out = io.StringIO()
+    click.echo(Obj(), file=out, color=False)
+    assert out.getvalue() == "red\n"
+
+
+def test_get_binary_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = click.utils._get_binary_stream("stdout")
+    assert stream is fake_stdout.buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("text")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == b"text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+
+    with click.utils.open_file(path, "w") as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        f.write("plain")
+
+    assert path.read_text() == "plain"
+
+
+def test_open_file_stdout_kept_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    with click.utils.open_file("-", "w") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        f.write("out")
+        f.flush()
+
+    assert not fake_stdout.closed
+    assert fake_stdout.buffer.getvalue() == b"out"
+
