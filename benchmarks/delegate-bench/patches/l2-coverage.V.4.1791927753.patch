+@pytest.mark.parametrize(
+    ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+)
+def test_get_app_dir_windows(monkeypatch, roaming, key):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv(key, os.path.join("C:", "AppData"))
+    assert click.get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+        "C:", "AppData", "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_force_posix(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    assert click.get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser(
+        "~/.foo-bar"
+    )
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_xdg(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", os.path.join("xdg", "config"))
+    assert click.get_app_dir("Foo Bar") == os.path.join("xdg", "config", "foo-bar")
+
+
+def test_get_app_dir_xdg_default(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert click.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/.config"), "foo-bar"
+    )
+
+
+class _FlushRaises:
+    def __init__(self, error):
+        self.error = error
+        self.name = "wrapped"
+
+    def flush(self):
+        raise self.error
+
+
+def test_pacify_flush_wrapper_success():
+    out = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(out)
+    wrapper.write("hi")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hi"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("bin", "my-app")])
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    assert click.utils._detect_program_name() == "my-app"
+
+
+def test_expand_args_disabled(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_attributes(name):
+    with pytest.warns(DeprecationWarning, match=f"'click.utils.{name}'"):
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
+
+
+def test_unknown_attribute():
+    with pytest.raises(AttributeError, match="does_not_exist"):
+        click.utils.does_not_exist  # noqa: B018
