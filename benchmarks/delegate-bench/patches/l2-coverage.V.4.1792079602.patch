+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_binary_stream(capfd, name):
+    stream = click.utils._get_binary_stream(name)
+    stream.write(b"binary")
+    stream.flush()
+    captured = capfd.readouterr()
+    assert getattr(captured, name[3:]) == "binary"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(capfd, name):
