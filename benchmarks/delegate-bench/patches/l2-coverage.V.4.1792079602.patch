+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # A word ends exactly at the limit, but more words follow.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghij", 5, "..."),
+        # The first word fills the limit exactly with more words after.
+        ("abcde fgh", 5, "..."),
+    ],
+)
+def test_make_default_short_help_truncation(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
