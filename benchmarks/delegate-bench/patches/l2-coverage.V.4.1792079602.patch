+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.delenv("LOCALAPPDATA", raising=False)
+    result = click.utils.get_app_dir("Foo Bar")
+    assert result == os.path.join(os.path.expanduser("~"), "Foo Bar")
+
+
