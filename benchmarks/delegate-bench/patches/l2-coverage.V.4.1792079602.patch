+class _FlushRaises:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        raise self.err
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.write("hello")
+    wrapper.flush()
+    assert wrapper.getvalue() == "hello"
+    assert wrapper.wrapped is inner
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
