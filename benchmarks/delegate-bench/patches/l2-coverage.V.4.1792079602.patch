+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    result = click.utils._expand_args(
+        ["~", "$CLICK_TEST"], user=False, env=False
+    )
+    assert result == ["~", "$CLICK_TEST"]
+
+
+def test_expand_args_glob_matches(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    deep = tmp_path / "sub" / "deep"
+    deep.mkdir(parents=True)
+    (deep / "c.txt").touch()
+    nested = os.path.join("sub", "deep", "c.txt")
+
+    assert sorted(click.utils._expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+    assert nested in click.utils._expand_args(["**/*.txt"])
+    # Without recursion, "**" only matches a single directory level.
+    assert nested not in click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
