+def test_lazy_file_dash_uses_stdout(capsys):
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Closing intelligently must not close the borrowed standard stream.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+
+def test_lazy_file_open_and_close(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with click.utils._LazyFile(path, "w") as lf:
+        lf.write("data")
+        assert lf.open() is lf._f
+        assert repr(lf) == repr(lf._f)
+
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("content")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as entered:
+        assert entered is kf
+        assert entered.read() == "content"
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
+
+def test_echo_bytes_to_text_only_stream_fails():
+    # A text stream with no binary buffer cannot receive bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(b"data", file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_bytearray_without_newline():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_empty_flushes_only():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object_is_stringified():
+    out = io.StringIO()
+    click.echo(42, file=out)
+    assert out.getvalue() == "42\n"
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.echo("nowhere")
+    click.echo("nowhere", err=True)
+
+
+def test_echo_strips_ansi_for_non_tty():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out)
+    assert out.getvalue() == "red\n"
+
+
+def test_echo_keeps_ansi_with_color():
+    out = io.StringIO()
+    click.echo("\x1b[31mred\x1b[0m", file=out, color=True)
+    assert out.getvalue() == "\x1b[31mred\x1b[0m\n"
