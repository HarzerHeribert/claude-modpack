+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    calls = []
+
+    def fail():
+        calls.append(True)
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+    assert calls == [True]
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        pytest.param("text", "text", id="str"),
+        pytest.param(42, "42", id="int"),
+        pytest.param(b"caf\xc3\xa9", "café", id="valid bytes"),
+        pytest.param(b"bad\xff", "bad�", id="invalid bytes"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("1234 678 x", 8, "1234...", id="exact length, more words"),
+        pytest.param("123456789 x", 5, "...", id="first word too long"),
+        pytest.param("12345 789", 5, "...", id="first word exact length"),
+        pytest.param("\b", 10, "", id="only no-wrap marker"),
+    ],
+)
+def test_make_default_short_help_edges(value, max_length, expect):
+    assert _make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_dash_uses_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Should not close stdout.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_read_mode_missing_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "no-such-dir" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with _LazyFile(path, "w") as lf:
+        pass
+
+    lf.close()
+    assert lf._f is None
+    assert not path.exists()
+
+
+def test_keep_open_file_proxies_and_stays_open():
+    inner = io.StringIO("line1\nline2\n")
+
+    with _KeepOpenFile(inner) as f:
+        assert repr(f) == repr(inner)
+        assert f.read() == "line1\nline2\n"
+
+    assert not inner.closed
+    f.close()
+    assert inner.closed
+
+
+def test_echo_bytes_to_text_only_stream():
+    # No binary writer can be found, so the bytes are passed through to the
+    # text stream's write, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_empty_bytes_no_newline():
+    out = io.BytesIO()
+    click.echo(b"", file=out, nl=False)
+    assert out.getvalue() == b""
+
+
+def test_echo_object_to_stderr(capsys):
+    click.echo(123, err=True)
+    captured = capsys.readouterr()
+    assert captured.err == "123\n"
+    assert captured.out == ""
+
+
+def test_echo_color_strip_and_keep():
+    styled = click.style("hi", fg="red")
+    out = io.StringIO()
+    click.echo(styled, file=out, color=False)
+    assert out.getvalue() == "hi\n"
+
+    out = io.StringIO()
+    click.echo(styled, file=out, color=True)
+    assert out.getvalue() == f"{styled}\n"
+
+
+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(name):
+    stream = _get_binary_stream(name)
+    assert stream is not None
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        _get_binary_stream("bad")
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(name):
+    stream = _get_text_stream(name)
+    assert stream is not None
+    assert hasattr(stream, "write")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bad'"):
+        _get_text_stream("bad")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy content")
+
+    assert path.read_text() == "lazy content"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "regular.txt"
+    path.write_text("content")
+
+    with click.open_file(path) as f:
+        assert not isinstance(f, _KeepOpenFile)
+        assert f.read() == "content"
+
+
+def test_open_file_dash_keeps_open(capsys):
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("to stdout")
+
+    assert not f.closed
+    f.flush()
+    assert capsys.readouterr().out == "to stdout"
+
