+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/app.py", "--flag"])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_package_main(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/example/__main__.py"])
+    assert _detect_program_name() == "python -m example"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    result = _expand_args(["~", "$CLICK_TEST"], user=False, env=False)
+    assert result == ["~", "$CLICK_TEST"]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    import glob
+
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"], user=False, env=False) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    recursive = _expand_args(["**/*.txt"])
+    non_recursive = _expand_args(["**/*.txt"], glob_recursive=False)
+    assert sorted(recursive) == sorted(["b.txt", os.path.join("sub", "a.txt")])
+    assert non_recursive == [os.path.join("sub", "a.txt")]
+
+
