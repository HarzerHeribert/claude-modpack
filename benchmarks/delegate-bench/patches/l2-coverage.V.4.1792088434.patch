+class _FlushStream:
+    def __init__(self, error=None):
+        self.error = error
+        self.flushed = 0
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.error is not None:
+            raise self.error
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushStream()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.extra == "proxied"
+    assert wrapper.wrapped is inner
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    inner = _FlushStream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushStream(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
