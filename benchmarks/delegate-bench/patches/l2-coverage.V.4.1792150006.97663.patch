+def _fake_stdio(monkeypatch):
+    """Replace the standard streams with in-memory binary-backed streams.
+
+    This must be called from the test body, not a fixture, because pytest's
+    output capturing resets ``sys.stdout`` between setup and the test call.
+    """
+    stdin = io.TextIOWrapper(io.BytesIO(b"from stdin\n"), encoding="utf-8")
+    stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    stderr = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdin", stdin)
+    monkeypatch.setattr(sys, "stdout", stdout)
+    monkeypatch.setattr(sys, "stderr", stderr)
+    return stdin, stdout, stderr
+
