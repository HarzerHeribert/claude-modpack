+class _TextOnlyRecorder:
+    """A file-like object that rejects empty bytes, so it is not detected
+    as a binary writer, and has no ``buffer``, but records everything else.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("not binary")
+
+        if value:
+            self.written.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyRecorder()
+    click.echo(b"raw", file=f)
+    assert f.written == [b"raw\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    f = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=f, nl=False)
+    assert f.getvalue() == b"abc"
+
+
+def test_echo_empty_flushes_only():
+    f = _TextOnlyRecorder()
+    click.echo("", file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
