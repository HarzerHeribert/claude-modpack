+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.value = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.wrapped is inner
+    assert wrapper.value == "proxied"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    inner = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_missing_attribute():
+    with pytest.raises(AttributeError):
+        _PacifyFlushWrapper(_FlushRaises()).does_not_exist  # noqa: B018
+
