+def test_echo_object_and_color():
+    f = io.StringIO()
+    click.echo(123, file=f)
+    click.echo("\x1b[31mred\x1b[0m", file=f, color=True)
+    click.echo("\x1b[31mred\x1b[0m", file=f, color=False)
+    assert f.getvalue() == "123\n\x1b[31mred\x1b[0m\nred\n"
