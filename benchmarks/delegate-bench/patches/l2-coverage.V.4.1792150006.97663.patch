+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_MORE", "expanded")
+    assert _expand_args(["~", "$CLICK_TEST_MORE"], user=False, env=False) == [
+        "~",
