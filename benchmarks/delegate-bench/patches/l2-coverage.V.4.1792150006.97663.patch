+def test_keep_open_file_proxies(tmp_path):
+    path = tmp_path / "keep.txt"
+    path.write_text("one\ntwo\n")
+
+    with open(path) as f:
+        kof = _KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+        assert kof.name == f.name
+
+        with kof as inner:
+            assert inner is kof
+            assert inner.readline() == "one\n"
+
+        assert not f.closed
+        assert list(kof) == ["two\n"]
+
+        kof.close()
+        assert f.closed
