+@pytest.mark.parametrize(
+    ("help", "max_length", "expect"),
+    [
+        # Ends exactly at max_length but more words follow.
+        ("aaa bbb ccc", 7, "aaa..."),
+        # First word alone is longer than max_length.
+        ("abcdefghij klm", 5, "..."),
+        # Exactly fills max_length with the last word.
+        ("aaa bbb", 7, "aaa bbb"),
+        # Second paragraph is ignored.
+        ("First part\n\nSecond part.", 45, "First part"),
+        # No-rewrap marker is dropped.
+        ("\b\nShort help", 45, "Short help"),
+        # Only whitespace.
+        ("   \n\t ", 45, ""),
+        # Sentence end before the limit.
+        ("Done. More text here", 45, "Done."),
+    ],
+)
