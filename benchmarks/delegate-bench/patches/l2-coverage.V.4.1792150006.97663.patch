+def test_lazy_file_stdout(monkeypatch):
+    _, stdout, _ = _fake_stdio(monkeypatch)
+
+    with _LazyFile("-", "w") as lf:
+        lf.write("hello")
+        lf.flush()
+
+    assert not stdout.closed
+    assert stdout.buffer.getvalue() == b"hello"
+
