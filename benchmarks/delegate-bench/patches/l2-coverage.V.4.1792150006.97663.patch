+def test_lazy_file_stdin(monkeypatch):
+    _fake_stdio(monkeypatch)
+    lf = _LazyFile("-")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+
+    with lf as f:
+        assert f.read() == "from stdin\n"
+
+    # Leaving the block must not close the borrowed stream.
+    assert not sys.stdin.closed
+
