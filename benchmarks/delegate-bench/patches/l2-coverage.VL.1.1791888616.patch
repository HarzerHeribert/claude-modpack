+def test_lazy_file_dash_uses_stdin(runner):
+    with runner.isolation(input="hello\n"):
+        lf = _LazyFile("-")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        assert lf.read() == "hello\n"
+        # A standard stream is never closed by the lazy file.
+        lf.close_intelligently()
+        assert not lf._f.closed
+
+
+def test_lazy_file_write_is_deferred(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    # Nothing was opened yet, so closing is a no-op and creates no file.
+    lf.close_intelligently()
+    assert not path.exists()
+
+    with _LazyFile(path, "w") as lf:
+        lf.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer cannot accept bytes.
+    with pytest.raises(TypeError):
+        echo(b"data", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation() as (_, err, _):
+        # A compatible stream is returned as-is.
+        assert _get_text_stream("stdout") is sys.stdout
+        assert _get_text_stream("stderr", errors="backslashreplace") is sys.stderr
+
+        # The isolated stderr uses "backslashreplace", so asking for "strict"
+        # wraps its binary buffer in a new text stream.
+        stream = _get_text_stream("stderr")
+        assert stream is not sys.stderr
+        stream.write("hello")
+        stream.flush()
+        assert err.getvalue() == b"hello"
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
