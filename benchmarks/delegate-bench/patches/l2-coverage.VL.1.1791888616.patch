+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.written = []
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+    def write(self, text):
+        self.written.append(text)
+
+
+def test_pacify_flush_wrapper_flushes():
+    wrapped = _FlushRaises()
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EBADF, "bad")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapped = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(wrapped)
+    wrapper.write("x")
+    assert wrapped.written == ["x"]
+    assert wrapper.wrapped is wrapped
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~"], user=False) == ["~"]
+    assert _expand_args(["$CLICK_TEST"], env=False) == ["$CLICK_TEST"]
+
+
+def test_expand_args_glob_recursive(tmp_path):
+    nested = tmp_path / "a" / "b"
+    nested.mkdir(parents=True)
+    (nested / "c.txt").write_text("")
+    pattern = os.path.join(str(tmp_path), "**", "c.txt")
+
+    assert _expand_args([pattern]) == [str(nested / "c.txt")]
+    # Without recursion "**" matches a single level, so nothing is found.
+    assert _expand_args([pattern], glob_recursive=False) == [pattern]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
