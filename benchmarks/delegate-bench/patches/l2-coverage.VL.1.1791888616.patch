+def test_safecall_returns_result():
+    def add(a, b):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def boom():
+        raise ValueError("nope")
+
+    assert _safecall(boom)() is None
+
+
+def test_make_str_decodes_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"hello") == "hello"
+    assert make_str(42) == "42"
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    # The filesystem encoding cannot decode the bytes, so UTF-8 is used.
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    # Undecodable bytes are replaced instead of raising.
+    assert make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("12345 789 x", 9, "12345...", id="exact length, more words"),
+        pytest.param("abcdefghijkl more", 5, "...", id="first word too long"),
+        pytest.param("ab cdefghijkl more", 5, "ab...", id="second word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert _make_default_short_help(value, max_length) == expect
+
