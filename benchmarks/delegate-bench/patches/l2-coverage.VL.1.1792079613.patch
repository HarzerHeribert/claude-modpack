+import errno
+import glob
+import io
+import os
+import re
+import sys
+
+import pytest
+
+import click
+from click import utils
+
+
+def test_safecall_returns_value():
+    assert utils._safecall(lambda x: x * 2)(21) == 42
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        pytest.param(b"hello", "hello", id="bytes"),
+        pytest.param(b"\xff", "�", id="invalid bytes"),
+        pytest.param(42, "42", id="non-string"),
+    ],
+)
+def test_make_str(value, expect):
+    assert utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("123 567 90 abc", 10, "123 567...", id="exact length mid text"),
+        pytest.param("1234567890 x", 10, "...", id="first word fills length"),
+        pytest.param("12345678901 x", 10, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help(value, max_length, expect):
+    assert utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazyfile_dash_uses_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stream)
+    lf = utils._LazyFile("-", "w")
+    assert not lf.should_close
+    assert repr(lf) == repr(stream)
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not stream.closed
+    assert stream.getvalue() == "hello"
+
+
+def test_lazyfile_repr_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(path)}' w>"
+    assert not path.exists()
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("data")
+    lf.close_intelligently()
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    lf = utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keepopenfile_repr_and_context():
+    stream = io.StringIO()
+    f = utils._KeepOpenFile(stream)
+    assert repr(f) == repr(stream)
+
+    with f as entered:
+        assert entered is f
+        entered.write("x")
+
+    assert not stream.closed
+    assert stream.getvalue() == "x"
+
+
+class _NoEmptyWrites:
+    """Accepts any non-empty write, so it is neither detected as a binary
+    nor as a text stream by the probing done in ``echo``.
+    """
+
+    def __init__(self):
+        self.data = []
+
+    def write(self, value):
+        if not value:
+            raise TypeError("empty writes are not supported")
+
+        self.data.append(value)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _NoEmptyWrites()
+    click.echo(b"hello", file=stream)  # type: ignore[arg-type]
+    assert stream.data == [b"hello\n"]
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_binary_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream(monkeypatch):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    assert utils._get_text_stream("stdout") is stream
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        utils._get_text_stream("nope")  # type: ignore[arg-type]
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
