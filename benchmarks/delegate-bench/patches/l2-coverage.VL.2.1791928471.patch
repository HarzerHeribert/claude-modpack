+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+
+
+def test_safecall_returns_result():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exceptions():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+def test_make_str_decodes_bytes_with_filesystem_encoding(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "latin-1")
+    assert click.utils.make_str(b"caf\xe9") == "café"
+
+
+def test_make_str_replaces_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"caf\xc3\xa9\xff") == "café�"
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("12345 7890 abc", 10, "12345...", id="reaches max before end"),
+        pytest.param("a" * 50, 45, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_dash_uses_stdin_without_closing(monkeypatch):
+    stdin = io.TextIOWrapper(io.BytesIO(b"line\n"), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdin", stdin)
+
+    with click.utils._LazyFile("-") as lf:
+        assert lf.should_close is False
+        assert repr(lf) == repr(stdin)
+        assert lf.read() == "line\n"
+
+    assert not stdin.closed
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+
+def test_keep_open_file_repr():
+    stream = io.StringIO()
+    assert repr(click.utils._KeepOpenFile(stream)) == repr(stream)
+
+
+class _RejectsEmptyWrites:
+    """A stream that rejects the empty probe writes echo uses to detect a
+    binary stream, and has no ``buffer`` to fall back on.
+    """
+
+    def __init__(self):
+        self.chunks = []
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.chunks.append(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_stream_writes_to_file():
+    out = _RejectsEmptyWrites()
+    click.echo(b"data", file=out)
+    assert out.chunks == [b"data\n"]
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
+
+def test_get_text_stream_rewraps_with_requested_encoding(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+
+    stream = click.utils._get_text_stream("stdout", encoding="latin-1")
+    stream.write("é")
+    stream.flush()
+
+    assert buffer.getvalue() == b"\xe9"
+
+
+def test_open_file_lazy_defers_creation(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
