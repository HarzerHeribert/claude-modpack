+def _make_main(package):
+    main = types.ModuleType("__main__")
+    main.__package__ = package
+    return main
+
+
+def test_detect_program_name_uses_argv_and_main_module(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _make_main(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "tool.py")])
+    assert _detect_program_name() == "tool.py"
+
+
+def test_detect_program_name_module_from_main_module(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _make_main("example"))
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "__main__.py")])
+    assert _detect_program_name() == "python -m example"
+
+
+def test_expand_args_without_user_and_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_globs(monkeypatch, tmp_path):
+    (tmp_path / "sub" / "deep").mkdir(parents=True)
+    (tmp_path / "sub" / "deep" / "a.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert _expand_args(["**/a.txt"]) == [os.path.join("sub", "deep", "a.txt")]
+    assert _expand_args(["**/a.txt"], glob_recursive=False) == ["**/a.txt"]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def raise_re_error(pattern, recursive):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", raise_re_error)
+    assert _expand_args(["[bad"]) == ["[bad"]
