+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular_is_closable(tmp_path):
+    path = tmp_path / "file.txt"
+
+    with open_file(path, "w") as f:
+        assert not isinstance(f, _KeepOpenFile)
+        f.write("text")
+
+    assert f.closed
+    assert path.read_text() == "text"
+
+
+def test_open_file_dash_keeps_stream_open(monkeypatch):
+    stdout = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert not stdout.closed
+    assert stdout.getvalue() == "out"
+
