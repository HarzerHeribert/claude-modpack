+def test_lazy_file_dash_uses_standard_stream(monkeypatch):
+    stdout = io.StringIO()
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    lf = _LazyFile("-", "w")
+    assert lf._f is stdout
+    assert not lf.should_close
+    assert repr(lf) == repr(stdout)
+
+    lf.write("hello")
+    lf.close_intelligently()
+    assert not stdout.closed
+    assert stdout.getvalue() == "hello"
+
+
+def test_lazy_file_repr_unopened_then_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    path = tmp_path / "never.txt"
+    lf = _LazyFile(path, "w")
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_open_failure_raises_file_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.filename == lf.name
+
+
+def test_lazy_file_read_mode_checks_file_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_keep_open_file_proxies(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("content")
+
+    with path.open() as f:
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as entered:
+            assert entered is kf
+            assert entered.read() == "content"
+
+        assert not f.closed
+
+
+def test_echo_bytes_to_text_only_stream_raises():
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_buffer():
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    click.echo(b"\xffraw", file=stream, nl=False)
+    assert buffer.getvalue() == b"\xffraw"
+
+
+def test_echo_empty_message_without_newline_only_flushes():
+    stream = io.StringIO()
+    click.echo("", file=stream, nl=False)
+    assert stream.getvalue() == ""
+
+
+def test_echo_without_standard_streams(monkeypatch):
+    monkeypatch.setattr(sys, "stdout", None)
+    monkeypatch.setattr(sys, "stderr", None)
+    click.echo("lost")
+    click.echo("lost", err=True)
+
+
+def _patch_stdout(monkeypatch):
+    # Patched in the test body: pytest's capture resets sys.stdout after
+    # fixture setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_get_binary_stream(monkeypatch):
+    stdout = _patch_stdout(monkeypatch)
+    assert _get_binary_stream("stdout") is stdout.buffer
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream(monkeypatch):
+    stdout = _patch_stdout(monkeypatch)
+    assert _get_text_stream("stdout") is stdout
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
