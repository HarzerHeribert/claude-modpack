+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("123 567890 abc", 10, "123...", id="exact length, not last"),
+        pytest.param("1234567890 abc", 10, "...", id="first word fills limit"),
+        pytest.param("12345678901 abc", 10, "...", id="first word too long"),
+    ],
+)
+def test_make_default_short_help_truncation(value, max_length, expect):
+    assert _make_default_short_help(value, max_length) == expect
+
