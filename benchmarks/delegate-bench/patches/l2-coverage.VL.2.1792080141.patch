+class _FlushStream:
+    def __init__(self, error=None):
+        self.error = error
+        self.flushed = False
+        self.name = "<fake>"
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_passes_through():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.name == "<fake>"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
