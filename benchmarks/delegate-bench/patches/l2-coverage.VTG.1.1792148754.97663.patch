+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _safecall
+from click.utils import get_app_dir
+from click.utils import make_str
+from click.utils import open_file
+
+
+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (b"bytes", "bytes"),
+        (b"\xff\xfe", "��"),
+    ],
+)
+def test_make_str(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Length hits the limit exactly before the last word.
+        ("ab cd ef", 5, "ab..."),
+        # The first word alone is already too long.
+        ("abcdefghij klm", 5, "..."),
+        # Removing words walks back to the first one.
+        ("a bbbbbb cccccc", 6, "a..."),
+    ],
+)
+def test_make_default_short_help_truncation(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_stdout_dash(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # close_intelligently must not close the borrowed stream.
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    try:
+        assert repr(lf) == repr(lf._f)
+        assert lf.open() is lf._f
+    finally:
+        lf.close()
+
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_echo_bytes_to_text_only_stream_raises():
+    # No binary writer can be found for a StringIO, so the bytes are
+    # passed through to the text stream, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+@pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+def test_get_binary_stream(name):
+    assert _get_binary_stream(name) is not None
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(name):
+    stream = _get_text_stream(name)
+    assert hasattr(stream, "write")
+
+
+@pytest.mark.parametrize("func", [_get_binary_stream, _get_text_stream])
+def test_get_stream_unknown_name(func):
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        func("nope")
+
+
+def test_get_app_dir_force_posix(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    assert get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser(
+        "~/.foo-bar"
+    )
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_linux_xdg(monkeypatch, tmp_path):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", os.fspath(tmp_path))
+    assert get_app_dir("Foo Bar") == os.path.join(os.fspath(tmp_path), "foo-bar")
+
+
+def test_get_app_dir_linux_default(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/.config"), "foo-bar"
+    )
+
+
+@pytest.mark.parametrize(
+    ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+)
+def test_get_app_dir_windows(monkeypatch, tmp_path, roaming, key):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv(key, os.fspath(tmp_path))
+    assert get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+        os.fspath(tmp_path), "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    assert get_app_dir("Foo Bar") == os.path.join(os.path.expanduser("~"), "Foo Bar")
+
+
+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    inner = _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/example.py", "--flag"])
+    assert _detect_program_name() == "example.py"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
