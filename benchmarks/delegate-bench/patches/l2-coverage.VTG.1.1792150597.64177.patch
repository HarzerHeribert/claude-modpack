+def test_safecall_returns_value():
+    @_safecall
+    def add(a, b):
+        return a + b
+
+    assert add(1, 2) == 3
+    assert add.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    @_safecall
+    def fail():
+        raise ValueError("boom")
+
+    assert fail() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"caf\xc3\xa9", "café"),
+        (b"bad \xff byte", "bad � byte"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(value, expected):
+    assert make_str(value) == expected
+
+
+def test_make_str_falls_back_to_utf8_replace(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"caf\xc3\xa9") == "café"
+    assert make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly max_length reached before the last word.
+        ("abcde fgh", 5, "..."),
+        # The first word alone exceeds the max length.
+        ("abcdefghij", 5, "..."),
+        # Removing words walks all the way back to the first word.
+        ("abcd efghij", 5, "..."),
+        # Removing one word is enough.
+        ("ab cdefgh", 5, "ab..."),
+        # Exactly max_length on the last word, no truncation.
+        ("ab cd", 5, "ab cd"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash_uses_stream(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Must not close the standard stream.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    with lf as f:
+        f.write("data")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_returns_same_file(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+    lf = _LazyFile(path, "r")
+    f = lf.open()
+    assert lf.open() is f
+    assert list(lf) == ["a\n", "b\n"]
+    lf.close()
+
+
+def test_keep_open_file_repr_and_context():
+    buf = io.StringIO()
+    kof = _KeepOpenFile(buf)
+    assert repr(kof) == repr(buf)
+
+    with kof as f:
+        assert f is kof
+        f.write("x")
+
+    assert not buf.closed
+    assert buf.getvalue() == "x"
+    kof.close()
+    assert buf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_stdout_open(capsys):
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert not f.closed
+    assert capsys.readouterr().out == "out"
+
