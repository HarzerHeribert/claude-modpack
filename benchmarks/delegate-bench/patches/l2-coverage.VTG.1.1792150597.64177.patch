+def test_echo_bytes_to_text_only_stream_fails():
+    # StringIO has no binary buffer, so bytes are passed through to write().
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_empty_bytes_no_newline_flushes():
+    out = io.BytesIO()
+    click.echo(b"", file=out, nl=False)
+    assert out.getvalue() == b""
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out)
+    assert out.getvalue() == b"abc\n"
+
