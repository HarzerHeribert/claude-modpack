+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    inner = _FlushRaiser()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.wrapped is inner
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaiser(OSError(errno.EPIPE, "broken")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaiser(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_default_path(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "cli.py")])
+    assert _detect_program_name() == "python -m example.cli"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
