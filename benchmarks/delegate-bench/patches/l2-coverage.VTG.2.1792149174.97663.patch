+def _fake_stdout():
+    return io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+
+
+@pytest.mark.parametrize(
+    ("name", "expect"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo \t  Bar\nBaz  ", "foo-bar-baz"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(name, expect):
+    assert _posixify(name) == expect
+
+
+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__wrapped__ is add
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_safecall_does_not_swallow_base_exception():
+    def interrupt():
+        raise KeyboardInterrupt
+
+    with pytest.raises(KeyboardInterrupt):
+        _safecall(interrupt)()
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"hello", "hello"),
+        ("caf\xe9".encode(), "caf\xe9"),
+        (b"bad \xff byte", "bad � byte"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expect"),
+    [
+        # Exactly fills the limit before the last word, truncate with "...".
+        ("aaaa bbbbb cc", 10, "aaaa..."),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghijklmnop", 5, "..."),
+        # Removing words walks all the way back to the first word.
+        ("aaaa bbbbbbbbbb", 5, "..."),
+        # Removing the overflowing word is enough.
+        ("a bbbbbbbbbbbb", 5, "a..."),
+        # Exactly fills the limit with the last word, no truncation.
+        ("aaaa bbbbb", 10, "aaaa bbbbb"),
+    ],
+)
+def test_make_default_short_help_truncation(help, max_length, expect):
+    assert _make_default_short_help(help, max_length) == expect
+
+
+def test_lazy_file_dash_write(monkeypatch):
+    fake = _fake_stdout()
+    monkeypatch.setattr(sys, "stdout", fake)
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert not lf.should_close
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+
+    with lf:
+        pass
+
+    # stdout is not closed by close_intelligently
+    assert not fake.closed
+    fake.flush()
+    assert fake.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    assert lf.open() is lf.open()
+    assert repr(lf) == repr(lf._f)
+    lf.write("data")
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_keep_open_file_repr_and_proxy():
+    sio = io.StringIO("a\nb\n")
+    f = _KeepOpenFile(sio)
+    assert repr(f) == repr(sio)
+    assert list(f) == ["a\n", "b\n"]
+
+    with f as inner:
+        assert inner is f
+
+    assert not sio.closed
+    f.close()
+    assert sio.closed
+
+
+def test_echo_bytes_without_binary_writer_falls_through():
+    # A text-only stream has no binary buffer, so the bytes are passed to
+    # the stream's write directly, which rejects them.
+    with pytest.raises(TypeError):
+        echo(b"hello", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_binary_stream("bogus")
+
+
+def test_get_text_stream_unknown_name():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        _get_text_stream("bogus")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    fake = _fake_stdout()
+    monkeypatch.setattr(sys, "stdout", fake)
+    stream = _get_text_stream("stdout")
+    stream.write("hi")
+    stream.flush()
+    assert fake.buffer.getvalue() == b"hi"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_lazy_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    f = open_file(path, "w", lazy=True, atomic=True)
+
+    with f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
