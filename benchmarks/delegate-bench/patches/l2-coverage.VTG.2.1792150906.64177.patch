+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    result = click.utils._expand_args(
+        ["~", "$CLICK_TEST", "*.not-found"], user=False, env=False
+    )
+    assert result == ["~", "$CLICK_TEST", "*.not-found"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    result = click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    assert result == [os.path.join("sub", "a.txt")]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def raise_re_error(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", raise_re_error)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
