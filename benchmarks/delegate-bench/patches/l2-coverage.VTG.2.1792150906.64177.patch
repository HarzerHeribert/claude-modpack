+import errno
+import glob
+import io
+import os
+import re
+import sys
+
+import pytest
+
+import click
+import click.utils
+from click.exceptions import FileError
+
+
+def _patch_stdout(monkeypatch):
+    # Patch inside the test body, pytest's capture plugin resets sys.stdout
+    # between fixture setup and the test call.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_result():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+def test_make_str_str_and_other():
+    assert click.utils.make_str("abc") == "abc"
+    assert click.utils.make_str(42) == "42"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str("é".encode()) == "é"
+
+
+def test_make_str_bytes_undecodable(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"a\xffb") == "a�b"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches exactly max_length before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word is already too long.
+        ("abcdefghij", 5, "..."),
+        # Exactly max_length on the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert not lf.should_close
+    assert lf.open() is lf._f
+    lf.write("hello")
+    # Leaving the context does not close a standard stream.
+    with lf:
+        pass
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    f = lf.open()
+    try:
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close()
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "out.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(click.utils._KeepOpenFile(f)) == repr(f)
+
+
+def test_echo_bytes_without_binary_writer():
+    # A text-only stream with no binary buffer falls through to write.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_binary_stream(monkeypatch, name):
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, name, stream)
+    assert click.utils._get_binary_stream(name) is stream.buffer
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("hi")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == b"hi"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    ("name", "args"),
+    [("get_binary_stream", ("stdout",)), ("get_text_stream", ("stdout",))],
+)
+def test_deprecated_stream_getters(monkeypatch, name, args):
+    _patch_stdout(monkeypatch)
+    with pytest.warns(DeprecationWarning, match=name):
+        func = getattr(click.utils, name)
+
+    assert func(*args) is not None
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_dash_keeps_stdout_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    with click.utils.open_file("-", "w") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        f.write("x")
+
+    assert not fake_stdout.closed
+
