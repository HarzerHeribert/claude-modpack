+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_default_argv(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "__main__.py")])
+    assert _detect_program_name(_main=_MockMain("pkg")) == "python -m pkg"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b.txt").write_text("")
+    (tmp_path / "c.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert sorted(_expand_args(["**/*.txt"], glob_recursive=True)) == [
+        os.path.join("a", "b.txt"),
+        "c.txt",
+    ]
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("a", "b.txt")
+    ]
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_names(name):
+    with pytest.warns(DeprecationWarning, match=f"click.utils.{name}"):
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
+
+
+def test_unknown_attribute():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
