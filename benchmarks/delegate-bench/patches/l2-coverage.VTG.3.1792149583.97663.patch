+class _EmptyRejectingWriter:
+    """Accepts writes, except empty ones, and has no binary buffer. This makes
+    ``_find_binary_writer`` give up, so ``echo`` writes bytes to it directly.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        if not data:
+            raise TypeError("empty write")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _EmptyRejectingWriter()
+    echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushes == 1
+
+
+def test_echo_bytearray_binary_file():
+    f = io.BytesIO()
+    echo(bytearray(b"data"), file=f, nl=False)
+    assert f.getvalue() == b"data"
+
+
+def test_echo_empty_flushes_only():
+    f = _EmptyRejectingWriter()
+    echo("", file=f, nl=False)
+    assert f.written == []
+    assert f.flushes == 1
+
+
+def test_echo_object_and_color():
+    f = io.StringIO()
+    echo(123, file=f)
+    echo("\x1b[31mred\x1b[0m", file=f, color=True)
+    echo("\x1b[31mred\x1b[0m", file=f, color=False)
+    assert f.getvalue() == "123\n\x1b[31mred\x1b[0m\nred\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_binary_stream("foo")
+
+
+def test_get_text_stream(monkeypatch):
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    out = _get_text_stream("stdout")
+    out.write("hello")
+    out.flush()
+    assert buffer.getvalue() == b"hello"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_text_stream("foo")
+
