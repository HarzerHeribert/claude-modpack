+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRaiser()
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    # Suppressed.
+    _PacifyFlushWrapper(wrapped).flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = _FlushRaiser(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    wrapper = _PacifyFlushWrapper(_FlushRaiser())
+    assert wrapper.name == "wrapped"
+
+    with pytest.raises(AttributeError):
+        wrapper.missing  # noqa: B018
+
