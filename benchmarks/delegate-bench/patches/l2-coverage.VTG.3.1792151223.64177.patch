+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.written = []
+
+    def flush(self):
+        raise self.exc
+
+    def write(self, data):
+        self.written.append(data)
+
+
+def test_pacify_flush_wrapper_flushes():
+    out = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(out)
+    assert wrapper.wrapped is out
+    wrapper.write("abc")
+    wrapper.flush()
+    assert out.getvalue() == "abc"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    inner = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    wrapper.write("x")
+    assert inner.written == ["x"]
+
+
+def test_pacify_flush_wrapper_other_os_error():
+    inner = _FlushRaises(OSError(errno.EBADF, "Bad file descriptor"))
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_pacify_flush_wrapper_missing_attribute():
+    wrapper = click.utils._PacifyFlushWrapper(io.StringIO())
+
+    with pytest.raises(AttributeError):
+        wrapper.does_not_exist  # noqa: B018
+
