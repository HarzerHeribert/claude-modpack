+def test_lazy_file_stdout(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+
+    # Leaving the block must not close a standard stream.
+    assert not lf._f.closed
+    lf.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close()
+    assert f.closed
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_read_errors_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing-dir" / "out.txt", "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.filename == os.fspath(tmp_path / "missing-dir" / "out.txt")
+    assert lf._f is None
+
+
+def test_lazy_file_iter(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+
+    with click.utils._LazyFile(path) as lf:
+        assert [line for line in lf] == ["a\n", "b\n"]
+
+    assert lf._f.closed
+
+
+def test_keep_open_file(tmp_path):
+    path = tmp_path / "data.txt"
+    path.write_text("abc")
+
+    with open(path) as raw:
+        kof = click.utils._KeepOpenFile(raw)
+        assert repr(kof) == repr(raw)
+
+        with kof as f:
+            assert f is kof
+            assert f.read() == "abc"
+
+        assert not raw.closed
+        # An explicit close passes through to the wrapped file.
+        kof.close()
+        assert raw.closed
+
