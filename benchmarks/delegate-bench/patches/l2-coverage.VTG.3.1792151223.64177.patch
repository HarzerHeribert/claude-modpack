+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+
+
+def _fake_stdout(monkeypatch):
+    # Patch inside the test body, pytest's capture replaces sys.stdout
+    # again between the setup and call phases.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo   Bar  Baz ", "foo-bar-baz"),
+        ("foo", "foo"),
+    ],
+)
+def test_posixify(value, expect):
+    assert click.utils._posixify(value) == expect
+
+
+def test_safecall_returns_value():
+    def add(a, b=1):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__wrapped__ is add
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+def test_safecall_does_not_swallow_base_exception():
+    def interrupt():
+        raise KeyboardInterrupt
+
+    with pytest.raises(KeyboardInterrupt):
+        click.utils._safecall(interrupt)()
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"hello", "hello"),
+        (b"\xff\xfe", "��"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expect):
+    assert click.utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        # Reaches max_length exactly before the last word, truncate.
+        pytest.param("12345 7890 abc", 10, "12345...", id="exact length mid"),
+        # The first word alone doesn't fit with the suffix.
+        pytest.param("12345678 abc", 10, "...", id="first word too long"),
+        pytest.param("\b", 10, "", id="only no-wrap mark"),
+        pytest.param("one two", 45, "one two", id="short"),
+    ],
+)
+def test_make_default_short_help_more(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
