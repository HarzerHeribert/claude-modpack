+def test_get_text_stream_stdout(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("hi")
+    stream.flush()
+    assert fake_stdout.buffer.getvalue() == b"hi"
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    stream = click.utils._get_binary_stream("stdout")
+    assert stream is fake_stdout.buffer
+
