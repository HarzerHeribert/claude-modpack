+def _main_module(package):
+    main = types.ModuleType("__main__")
+    main.__package__ = package
+    return main
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _main_module(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+    assert click.utils._detect_program_name("") == "app.py"
+
+
+def test_detect_program_name_module_from_argv(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("pkg", "cli.py")])
+    main = _main_module("pkg")
+    assert click.utils._detect_program_name(_main=main) == "python -m pkg.cli"
+
+
+def test_detect_program_name_dunder_main(monkeypatch):
+    main = _main_module("pkg")
+    path = os.path.join("pkg", "__main__.py")
+    assert click.utils._detect_program_name(path, _main=main) == "python -m pkg"
+
+
+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "a.txt").write_text("")
+    (tmp_path / "b.txt").write_text("")
+    sub = tmp_path / "sub"
+    sub.mkdir()
+    (sub / "c.txt").write_text("")
+
+    assert sorted(click.utils._expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+    assert sorted(click.utils._expand_args(["**/*.txt"])) == [
+        "a.txt",
+        "b.txt",
+        os.path.join("sub", "c.txt"),
+    ]
+    assert sorted(
+        click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    ) == [os.path.join("sub", "c.txt")]
+    assert click.utils._expand_args([]) == []
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad", "other"]) == ["[bad", "other"]
+
