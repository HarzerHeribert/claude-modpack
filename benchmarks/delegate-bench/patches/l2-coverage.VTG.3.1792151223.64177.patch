+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer can't accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_object_and_no_newline():
+    out = io.StringIO()
+    click.echo(123, file=out, nl=False)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == "123"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
