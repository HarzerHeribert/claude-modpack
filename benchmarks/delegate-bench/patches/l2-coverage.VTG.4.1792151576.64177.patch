+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+def test_make_str_falls_back_to_utf8(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str("é".encode()) == "é"
+    assert click.utils.make_str(b"\xff") == "�"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Word exactly fills the limit but more words follow.
+        ("abcde fgh", 5, "..."),
+        ("ab cd efg", 5, "ab..."),
+        # A single word longer than the limit.
+        ("abcdefghij", 5, "..."),
+        # Exactly at the limit with nothing following.
+        ("ab cd", 5, "ab cd"),
+        # Whitespace only.
+        ("   \n\t ", 45, ""),
+        # No-rewrap marker is dropped.
+        ("\b\nfirst line", 45, "first line"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash_uses_stdout():
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+
+    with lf as f:
+        assert f is lf
+
+    # Leaving the block must not close the standard stream.
+    assert not lf._f.closed
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_keep_open_file_proxies():
+    buf = io.StringIO("line1\nline2\n")
+    kf = click.utils._KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    assert list(kf) == ["line1\n", "line2\n"]
+
+    with kf as f:
+        assert f is kf
+
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
+
+def test_open_file_dash_keeps_stream_open():
+    f = click.utils.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+
+    with f:
+        pass
+
+    assert not f.closed
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("content")
+
+    with click.utils.open_file(path) as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        assert f.read() == "content"
+
