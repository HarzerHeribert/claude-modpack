+@pytest.mark.parametrize(
+    ("value", "shorten", "expected"),
+    [
+        ("/a/b/c.txt", False, "/a/b/c.txt"),
+        ("/a/b/c.txt", True, "c.txt"),
+        (b"/a/b/c.txt", True, "c.txt"),
+        (b"bad\xffname", False, "bad�name"),
+        ("bad\udcffname", False, "bad�name"),
+    ],
+)
+def test_format_filename(value, shorten, expected):
+    assert click.utils.format_filename(value, shorten=shorten) == expected
