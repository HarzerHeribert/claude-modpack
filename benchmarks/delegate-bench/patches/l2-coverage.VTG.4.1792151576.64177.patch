+class _RecordingStream:
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer(monkeypatch):
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda stream: None)
+    stream = _RecordingStream()
+    click.utils.echo(b"hi", file=stream)
+    assert stream.written == [b"hi\n"]
+    assert stream.flushes == 1
+
+
+def test_echo_empty_message_only_flushes():
+    stream = _RecordingStream()
+    click.utils.echo(None, file=stream, nl=False)
+    assert stream.written == []
+    assert stream.flushes == 1
+
+
+def test_echo_no_standard_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.utils.echo("lost")
+    click.utils.echo("lost", err=True)
+
+
+def test_echo_object_and_bytearray():
+    out = io.StringIO()
+    click.utils.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
+    bout = io.BytesIO()
+    click.utils.echo(bytearray(b"ab"), file=bout)
+    assert bout.getvalue() == b"ab\n"
+
+
+def test_get_text_stream():
+    stream = click.utils._get_text_stream("stdout")
+    assert hasattr(stream, "write")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
