+class TestGetAppDir:
+    @pytest.fixture(autouse=True)
+    def _clean_env(self, monkeypatch):
+        for key in ("APPDATA", "LOCALAPPDATA", "XDG_CONFIG_HOME"):
+            monkeypatch.delenv(key, raising=False)
+
+    def test_windows_roaming(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv("APPDATA", "roaming-dir")
+        monkeypatch.setenv("LOCALAPPDATA", "local-dir")
+        assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+            "roaming-dir", "Foo Bar"
+        )
+
+    def test_windows_local(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        monkeypatch.setenv("APPDATA", "roaming-dir")
+        monkeypatch.setenv("LOCALAPPDATA", "local-dir")
+        assert click.utils.get_app_dir("Foo Bar", roaming=False) == os.path.join(
+            "local-dir", "Foo Bar"
+        )
+
+    def test_windows_no_env_uses_home(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", True)
+        assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~"), "Foo Bar"
+        )
+
+    def test_force_posix(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        assert click.utils.get_app_dir(
+            "Foo Bar", force_posix=True
+        ) == os.path.expanduser("~/.foo-bar")
+
+    def test_darwin(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "darwin")
+        assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+        )
+
+    def test_linux_default(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        assert click.utils.get_app_dir("Foo Bar") == os.path.join(
+            os.path.expanduser("~/.config"), "foo-bar"
+        )
+
+    def test_linux_xdg(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "WIN", False)
+        monkeypatch.setattr(sys, "platform", "linux")
+        monkeypatch.setenv("XDG_CONFIG_HOME", "xdg-home")
+        assert click.utils.get_app_dir("Foo  Bar\tBaz") == os.path.join(
+            "xdg-home", "foo-bar-baz"
+        )
+
