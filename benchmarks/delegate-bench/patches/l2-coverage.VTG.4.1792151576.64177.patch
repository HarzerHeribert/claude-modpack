+class _FlushStub:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "stub"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    stub = _FlushStub()
+    wrapper = click.utils._PacifyFlushWrapper(stub)
+    wrapper.flush()
+    assert stub.flushed
+    assert wrapper.name == "stub"
+    assert wrapper.wrapped is stub
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    stub = _FlushStub(OSError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(stub).flush()
+    assert stub.flushed
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    stub = _FlushStub(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(stub).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
