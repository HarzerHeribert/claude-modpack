+# make_str
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+        ("café".encode(sys.getfilesystemencoding()), "café"),
+    ],
+)
+def test_make_str(value, expected):
+    assert utils.make_str(value) == expected
+
+
+def test_make_str_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert utils.make_str(b"caf\xc3\xa9") == "café"
+    assert utils.make_str(b"bad\xff") == "bad�"
+
+
+# _make_default_short_help
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hits the limit before the last word, truncate with "...".
+        ("aa bb cc", 5, "aa..."),
+        # The first word alone fills the limit, nothing but the suffix fits.
+        ("abc def", 3, "..."),
+        # Exactly hits the limit on the last word, no truncation needed.
+        ("aa bb", 5, "aa bb"),
+        # Only a no-rewrap marker.
+        ("\b\n", 45, ""),
+        # Whitespace only.
+        ("   \n\t ", 45, ""),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
