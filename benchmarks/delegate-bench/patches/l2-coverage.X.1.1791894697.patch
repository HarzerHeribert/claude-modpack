+# _expand_args
+
+
+def test_expand_args_disable_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "expanded")
+    result = utils._expand_args(["~", "$CLICK_TEST_VAR"], user=False, env=False)
+    assert result == ["~", "$CLICK_TEST_VAR"]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert utils._expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b.txt").write_text("")
+    (tmp_path / "top.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    recursive = utils._expand_args(["**/*.txt"])
+    flat = utils._expand_args(["**/*.txt"], glob_recursive=False)
+    assert sorted(recursive) == sorted(["top.txt", os.path.join("a", "b.txt")])
+    assert flat == [os.path.join("a", "b.txt")]
+
