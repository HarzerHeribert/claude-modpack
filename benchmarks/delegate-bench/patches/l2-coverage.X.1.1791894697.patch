+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/local/bin/my-tool", "--flag"])
+    assert utils._detect_program_name() == "my-tool"
+
+
+def test_detect_program_name_module_default_main(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "pkg"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/src/pkg/cli.py"])
+    assert utils._detect_program_name() == "python -m pkg.cli"
