+# _KeepOpenFile / open_file
+
+
+def test_keepopenfile_proxies_and_stays_open():
+    buf = io.StringIO("a\nb\n")
+    kf = utils._KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    assert list(kf) == ["a\n", "b\n"]
+
+    with kf as f:
+        assert f is kf
+
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
+
+
+def test_open_file_dash_returns_keep_open(capsys):
+    f = utils.open_file("-", "w")
+    assert isinstance(f, utils._KeepOpenFile)
+    assert repr(f) == repr(f._file)
+
+    with f:
+        f.write("hi")
+        f.flush()
+
+    assert not f._file.closed
+    assert "hi" in capsys.readouterr().out
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("content")
+
+    with utils.open_file(path) as f:
+        assert not isinstance(f, utils._KeepOpenFile)
+        assert f.read() == "content"
+
+    assert f.closed
