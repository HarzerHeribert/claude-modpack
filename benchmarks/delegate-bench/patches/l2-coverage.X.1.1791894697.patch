+# Module __getattr__
+
+
+def test_module_getattr_unknown():
+    with pytest.raises(AttributeError):
+        utils.does_not_exist  # noqa: B018
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_module_getattr_deprecated(name):
+    with pytest.warns(DeprecationWarning, match=f"click.utils.{name}"):
+        value = getattr(utils, name)
+
+    assert value is getattr(utils, f"_{name}")
