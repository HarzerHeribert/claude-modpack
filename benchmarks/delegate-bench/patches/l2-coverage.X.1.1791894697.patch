+# _PacifyFlushWrapper
+
+
+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_proxies():
+    inner = _FlushRaiser()
+    wrapper = utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.name == "wrapped"
+    assert wrapper.wrapped is inner
+
+
+def test_pacify_flush_wrapper_suppresses_broken_pipe():
+    inner = _FlushRaiser(OSError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaiser(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as excinfo:
+        utils._PacifyFlushWrapper(inner).flush()
+
+    assert excinfo.value.errno == errno.EIO
+
