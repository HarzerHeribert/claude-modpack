+# _LazyFile
+
+
+def test_lazyfile_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    lf = utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_read_missing_file_errors_early(tmp_path):
+    with pytest.raises(OSError):
+        utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazyfile_open_error_raises_file_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "no-such-dir" / "file.txt", "w")
+
+    with pytest.raises(FileError) as excinfo:
+        lf.open()
+
+    assert excinfo.value.ui_filename.endswith("file.txt")
+    assert isinstance(excinfo.value.__cause__, OSError)
+
+
+def test_lazyfile_open_returns_same_file(tmp_path):
+    with utils._LazyFile(tmp_path / "f.txt", "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+    assert f.closed
+
+
+def test_lazyfile_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    with utils._LazyFile(path, "w", atomic=True) as lf:
+        lf.write("new")
+        assert path.read_text() == "old"
+    assert path.read_text() == "new"
+
+
+def test_lazyfile_stdout_is_not_closed(capsys):
+    lf = utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf:
+        lf.write("to stdout")
+        lf.flush()
+
+    # Leaving the block does not close the borrowed stream.
+    assert not lf._f.closed
+    assert "to stdout" in capsys.readouterr().out
+
