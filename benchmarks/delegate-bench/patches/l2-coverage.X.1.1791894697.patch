+# echo
+
+
+class _OpaqueWriter:
+    """A stream that isn't detected as binary (it rejects empty probes)
+    but accepts whatever non-empty data it is given."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+        self.data.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _OpaqueWriter()
+    click.echo(b"raw", file=out)
+    assert out.data == [b"raw\n"]
+    assert out.flushed >= 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out)
+    assert out.getvalue() == b"abc\n"
+
+
+def test_echo_empty_flushes_only():
+    out = _OpaqueWriter()
+    click.echo("", file=out, nl=False)
+    assert out.data == []
+    assert out.flushed == 1
+
+
+def test_echo_object_converted_to_str():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    click.echo(None, file=out)
+    assert out.getvalue() == "123\n\n"
+
+
+def test_echo_no_stream_available(monkeypatch):
+    monkeypatch.setattr(utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(utils, "_default_text_stderr", lambda: None)
+    # Nothing to write to, so this must return silently.
+    assert click.echo("lost") is None
+    assert click.echo("lost", err=True) is None
+
