+# _PacifyFlushWrapper
+
+
+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed += 1
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = _FlushRaiser()
+    wrapper = utils._PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed == 1
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    inner = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _FlushRaiser(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        utils._PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
