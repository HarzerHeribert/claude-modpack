+# _KeepOpenFile
+
+
+def test_keep_open_file_repr_and_exit():
+    buf = io.StringIO()
+    kof = utils._KeepOpenFile(buf)
+    assert repr(kof) == repr(buf)
+
+    with kof as f:
+        assert f is kof
+        f.write("x")
+
+    assert not buf.closed
+    assert buf.getvalue() == "x"
+
