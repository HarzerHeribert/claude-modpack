+# _posixify / make_str
+
+
+@pytest.mark.parametrize(
+    ("name", "expect"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Spaced   Out\tApp ", "spaced-out-app"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(name, expect):
+    assert utils._posixify(name) == expect
+
+
+def test_make_str_from_str_and_object():
+    assert utils.make_str("abc") == "abc"
+    assert utils.make_str(42) == "42"
+
+
+def test_make_str_from_valid_bytes():
+    assert utils.make_str("héllo".encode(sys.getfilesystemencoding())) == "héllo"
+
+
+def test_make_str_from_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert utils.make_str(b"a\xffb") == "a�b"
+
