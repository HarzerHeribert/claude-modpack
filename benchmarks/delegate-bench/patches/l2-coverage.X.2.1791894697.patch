+# Deprecated module attributes
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_aliases(name):
+    with pytest.warns(DeprecationWarning, match=name):
+        value = getattr(utils, name)
+
+    assert value is getattr(utils, f"_{name}")
+
+
+def test_unknown_module_attribute():
+    with pytest.raises(AttributeError):
+        utils.does_not_exist  # noqa: B018
