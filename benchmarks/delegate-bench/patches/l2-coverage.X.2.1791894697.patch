+# echo
+
+
+def test_echo_bytes_to_text_only_stream_fails():
+    # StringIO has no binary buffer, so the bytes go to the text write,
+    # which rejects them.
+    with pytest.raises(TypeError):
+        utils.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_stream_without_binary_buffer():
+    class AnyWriter:
+        def __init__(self):
+            self.written = []
+            self.flushed = 0
+
+        def write(self, value):
+            # Reject the empty bytes probe so it is not treated as binary.
+            if value == b"":
+                raise TypeError("probe")
+
+            if value:
+                self.written.append(value)
+
+        def flush(self):
+            self.flushed += 1
+
+    out = AnyWriter()
+    utils.echo(b"data", file=out)
+    assert out.written == [b"data\n"]
+    assert out.flushed == 1
+
