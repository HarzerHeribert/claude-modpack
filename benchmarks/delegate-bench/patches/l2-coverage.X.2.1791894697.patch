+@pytest.mark.parametrize("roaming", [True, False])
+def test_get_app_dir_windows_env(monkeypatch, tmp_path, roaming):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", str(tmp_path / "roam"))
+    monkeypatch.setenv("LOCALAPPDATA", str(tmp_path / "local"))
+    expected_base = tmp_path / ("roam" if roaming else "local")
+    assert utils.get_app_dir("Foo Bar", roaming=roaming) == os.path.join(
+        expected_base, "Foo Bar"
+    )
+
+
+def test_get_app_dir_windows_no_env(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_force_posix(monkeypatch, tmp_path):
+    monkeypatch.setattr(utils, "WIN", False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    assert utils.get_app_dir("Foo Bar", force_posix=True) == os.path.join(
+        str(tmp_path), ".foo-bar"
+    )
+
+
