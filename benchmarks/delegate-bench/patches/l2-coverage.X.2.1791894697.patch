+# _expand_args
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    args = ["~/nothing-here-xyz", "$CLICK_TEST_VAR"]
+    assert utils._expand_args(args, user=False, env=False) == args
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def raise_re_error(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", raise_re_error)
+    assert utils._expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_glob_matches(tmp_path, monkeypatch):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    monkeypatch.chdir(tmp_path)
+    assert sorted(utils._expand_args(["*.txt"])) == ["a.txt", "b.txt"]
+
