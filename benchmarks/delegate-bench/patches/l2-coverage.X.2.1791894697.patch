+# _LazyFile
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+
+    try:
+        assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+        f = lf.open()
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close()
+
+
+def test_lazy_file_stdout_not_closed():
+    lf = utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        assert f is lf
+
+    assert not lf._f.closed
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_getattr_and_context_manager(tmp_path):
+    path = tmp_path / "data.txt"
+
+    with utils._LazyFile(path, "w") as lf:
+        lf.write("hello")
+
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_iter(tmp_path):
+    path = tmp_path / "lines.txt"
+    path.write_text("a\nb\n")
+
+    with utils._LazyFile(path, "r") as lf:
+        assert list(lf) == ["a\n", "b\n"]
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = utils._LazyFile(tmp_path / "missing" / "x.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
