+# _make_default_short_help
+
+
+def test_short_help_exact_length_not_last_word():
+    # "90" makes the length exactly 10, but more words follow.
+    assert utils._make_default_short_help("123 567 90 abc", 10) == "123 567..."
+
+
+def test_short_help_first_word_too_long():
+    assert utils._make_default_short_help("12345678901234 abc", 10) == "..."
+
+
+def test_short_help_removes_all_words():
+    assert utils._make_default_short_help("abcdefgh abcdefgh", 10) == "..."
+
