+def test_get_text_stream_stdout(monkeypatch):
+    raw = io.BytesIO()
+    monkeypatch.setattr(
+        sys, "stdout", io.TextIOWrapper(raw, encoding="utf-8", write_through=True)
+    )
+    stream = utils._get_text_stream("stdout", encoding="utf-8")
+    stream.write("hi")
+    stream.flush()
+    assert raw.getvalue() == b"hi"
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    raw = io.BytesIO()
+    monkeypatch.setattr(
+        sys, "stdout", io.TextIOWrapper(raw, encoding="utf-8", write_through=True)
+    )
+    stream = utils._get_binary_stream("stdout")
+    assert stream is raw
+
