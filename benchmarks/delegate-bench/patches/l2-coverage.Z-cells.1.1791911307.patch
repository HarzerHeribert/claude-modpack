+def test_echo_object_and_err(runner):
+    with runner.isolation() as (out, err, _):
+        click.echo(123)
+        click.echo(["x"], err=True)
+        assert out.getvalue() == b"123\n"
+        assert err.getvalue() == b"['x']\n"
