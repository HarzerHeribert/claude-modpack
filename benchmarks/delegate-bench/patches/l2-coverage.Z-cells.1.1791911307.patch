+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hits max_length before the last word, truncate with "...".
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # Exactly hits max_length on the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # First word alone is too long.
+        ("abcdefghij klm", 5, "..."),
+        # Rewrap marker is ignored.
+        ("\b\nhello world", 45, "hello world"),
+        # Only the first paragraph is considered.
+        ("First line\n\nSecond paragraph.", 45, "First line"),
+        ("Short sentence. More text", 45, "Short sentence."),
+        ("   ", 45, ""),
+    ],
+)
