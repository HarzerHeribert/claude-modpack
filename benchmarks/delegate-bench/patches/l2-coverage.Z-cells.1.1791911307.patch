+def test_open_file_stdout_kept_open(runner):
+    with runner.isolation() as (out, _, _):
+        with open_file("-", "w") as f:
+            assert isinstance(f, _KeepOpenFile)
+            f.write("hi")
+            f.flush()
+
+        assert not f.closed
+        assert out.getvalue() == b"hi"
