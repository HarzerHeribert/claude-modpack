+def test_keep_open_file(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as entered:
+            assert entered is kf
+            assert kf.readline() == "a\n"
+
+        assert not f.closed
+        assert list(kf) == ["b\n"]
+        kf.close()
+        assert f.closed
