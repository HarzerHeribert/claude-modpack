+class BytesOnlyNonEmpty:
+    """A file that rejects empty bytes but accepts text and other bytes, so
+    ``_find_binary_writer`` can't find a binary writer."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("no empty bytes")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = BytesOnlyNonEmpty()
+    click.echo(b"hi", file=f)
+    assert f.data == ["", b"hi\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytes_no_newline_to_binary(runner):
+    with runner.isolation() as (out, _, _):
+        click.echo(bytearray(b"raw"), nl=False)
+        assert out.getvalue() == b"raw"
+
