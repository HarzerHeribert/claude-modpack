+class FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = FlushRaises()
+    wrapper = _PacifyFlushWrapper(wrapped)
+    wrapper.flush()
+    assert wrapped.flushed
+    # Other attributes are proxied.
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapped = FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
