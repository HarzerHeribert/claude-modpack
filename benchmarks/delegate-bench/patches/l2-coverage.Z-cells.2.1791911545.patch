+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "out.txt"
+
+    with open_file(path, "w") as f:
+        assert not isinstance(f, _KeepOpenFile)
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_stdout_keeps_open(capsys):
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert not f.closed
+    f.flush()
+    assert capsys.readouterr().out == "out"
+
