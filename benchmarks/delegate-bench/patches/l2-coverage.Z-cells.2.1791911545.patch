+def test_lazy_file_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Closing intelligently must not close the borrowed stream.
+    with lf:
+        pass
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert lf._f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_returns_cached(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+    assert f.closed
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename == os.fspath(tmp_path / "missing" / "out.txt")
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(OSError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
