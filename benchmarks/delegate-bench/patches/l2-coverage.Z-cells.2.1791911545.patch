+class _TextOnlyProbe:
+    """Rejects the empty bytes probe used to detect binary streams, but
+    accepts anything written afterwards, and has no ``buffer``.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if data == b"":
+            raise TypeError("not binary")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _TextOnlyProbe()
+    echo(b"hi", file=f)
+    assert f.written == ["", b"hi\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    f = io.BytesIO()
+    echo(bytearray(b"hi"), file=f, nl=False)
+    assert f.getvalue() == b"hi"
+
+
+def test_echo_empty_flushes_only():
+    f = _TextOnlyProbe()
+    echo(None, file=f, nl=False)
+    assert f.written == []
+    assert f.flushed == 1
+
+
+def test_echo_object():
+    f = io.StringIO()
+    echo(123, file=f)
+    assert f.getvalue() == "123\n"
+
