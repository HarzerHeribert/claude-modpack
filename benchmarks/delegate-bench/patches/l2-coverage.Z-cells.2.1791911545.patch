+def test_keep_open_file_repr_and_context():
+    buf = io.StringIO()
+    f = _KeepOpenFile(buf)
+    assert repr(f) == repr(buf)
+
+    with f as inner:
+        assert inner is f
+        inner.write("x")
+
+    assert not buf.closed
+    assert buf.getvalue() == "x"
+
