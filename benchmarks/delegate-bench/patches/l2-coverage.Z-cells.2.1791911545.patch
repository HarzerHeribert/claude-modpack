+def test_make_default_short_help_exact_length_not_last_word():
+    # The first word fills the limit exactly but more words follow, so it is
+    # truncated. The single word can't be removed, leaving only the suffix.
+    assert _make_default_short_help("1234567890 abc", 10) == "..."
+
+
+def test_make_default_short_help_first_word_too_long():
+    assert _make_default_short_help("12345678901 abc", 10) == "..."
+
