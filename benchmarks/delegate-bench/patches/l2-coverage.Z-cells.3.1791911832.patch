+class _PickyWriter:
+    """A stream that is neither detected as text nor binary, but accepts
+    non-empty bytes writes.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _PickyWriter()
+    click.echo(b"data", file=f)
+    assert f.data == [b"data\n"]
+    assert f.flushed == 1
+
