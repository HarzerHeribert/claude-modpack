+def test_open_file_dash_keeps_open(runner):
+    with runner.isolation() as (out, _, _):
+        with click.utils.open_file("-", "w") as f:
+            assert isinstance(f, click.utils._KeepOpenFile)
+            f.write("dash")
+
+        assert not f.closed
+        f.flush()
+        assert out.getvalue() == b"dash"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("plain")
+
+    with click.utils.open_file(path) as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        assert f.read() == "plain"
+
