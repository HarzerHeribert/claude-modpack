+class _FlushRaises:
+    def __init__(self, err):
+        self.err = err
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.err is not None:
+            raise OSError(self.err, os.strerror(self.err))
+
+
+def test_pacify_flush_wrapper_ok():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(None))
+    wrapper.flush()
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(errno.EPIPE))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(errno.EIO))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
