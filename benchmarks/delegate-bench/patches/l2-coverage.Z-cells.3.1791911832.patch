+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "x.txt").write_text("")
+    (tmp_path / "y.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    recursive = click.utils._expand_args(["**/*.txt"])
+    flat = click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    assert sorted(recursive) == sorted([os.path.join("a", "x.txt"), "y.txt"])
+    assert flat == [os.path.join("a", "x.txt")]
+
