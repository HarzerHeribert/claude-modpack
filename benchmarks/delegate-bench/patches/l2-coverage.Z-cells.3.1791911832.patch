+def test_safecall_swallows_exception():
+    def fail(value):
+        raise ValueError(value)
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped.__name__ == "fail"
+    assert wrapped("x") is None
+
+
+def test_safecall_returns_value():
+    assert click.utils._safecall(lambda a, b=1: a + b)(1, b=2) == 3
+
