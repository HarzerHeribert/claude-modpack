+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click.utils
+from click.exceptions import FileError
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _posixify
+from click.utils import _safecall
+from click.utils import echo
+from click.utils import get_app_dir
+from click.utils import make_str
+from click.utils import open_file
+
+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        """Add numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, 2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add numbers."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_make_str_bytes():
+    assert make_str("abc".encode(sys.getfilesystemencoding())) == "abc"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+def test_make_str_other():
+    assert make_str(42) == "42"
+    assert make_str("x") == "x"
+
+
+def test_short_help_exact_length_not_last_word():
+    assert _make_default_short_help("aaaa bbbb cc", max_length=9) == "aaaa..."
+
+
+def test_short_help_first_word_too_long():
+    assert _make_default_short_help("a" * 50, max_length=45) == "..."
+
+
+def test_lazy_file_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    with lf:
+        lf.write("hello\n")
+    # stdout must not have been closed
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello\n"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    p = tmp_path / "out.txt"
+    lf = _LazyFile(p, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(p)}' w>"
+    lf.close()  # nothing opened yet, no-op
+    assert not p.exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_open_twice(tmp_path):
+    p = tmp_path / "out.txt"
+    with _LazyFile(p, "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+        lf.write("data")
+    assert p.read_text() == "data"
+
+
+def test_keep_open_file():
+    buf = io.StringIO("a\nb\n")
+    kf = _KeepOpenFile(buf)
+    assert repr(kf) == repr(buf)
+    assert list(kf) == ["a\n", "b\n"]
+    with kf as f:
+        assert f is kf
+    assert not buf.closed
+    kf.close()
+    assert buf.closed
+
+
+class _RejectEmptyWrites:
+    """A stream that is neither detected as binary nor text, but still
+    accepts non-empty bytes writes."""
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_no_binary_writer():
+    stream = _RejectEmptyWrites()
+    echo(b"hello", file=stream)
+    assert stream.written == [b"hello\n"]
+    assert stream.flushed >= 1
+
+
+def test_echo_bytes_to_binary_buffer():
+    buf = io.BytesIO()
+    echo(b"hi", file=buf, nl=False)
+    assert buf.getvalue() == b"hi"
+
+
+def test_echo_bytearray():
+    buf = io.BytesIO()
+    echo(bytearray(b"hi"), file=buf)
+    assert buf.getvalue() == b"hi\n"
+
+
+def test_echo_empty_flushes():
+    stream = _RejectEmptyWrites()
+    echo("", file=stream, nl=False)
+    assert stream.written == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_and_strip_ansi():
+    buf = io.StringIO()
+    echo(123, file=buf)
+    echo("\x1b[31mred\x1b[0m", file=buf, color=False)
+    assert buf.getvalue() == "123\nred\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_text_stream("nope")
+
+
+def test_get_binary_stream_known():
+    assert _get_binary_stream("stdout") is not None
+
+
+def test_get_text_stream_known():
+    assert _get_text_stream("stderr") is not None
+
+
+def test_open_file_lazy(tmp_path):
+    p = tmp_path / "lazy.txt"
+    f = open_file(p, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not p.exists()
+    with f:
+        f.write("x")
+    assert p.read_text() == "x"
+
+
+def test_open_file_dash_keeps_open():
+    f = open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+
+
+def test_open_file_regular(tmp_path):
+    p = tmp_path / "plain.txt"
+    p.write_text("content")
+    with open_file(p) as f:
+        assert not isinstance(f, _KeepOpenFile)
+        assert f.read() == "content"
+
