+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click.utils
+from click.exceptions import FileError
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff", "�"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly hitting the limit before the last word truncates with "...".
+        ("aaa bbb ccc", 7, "aaa..."),
+        # Exactly hitting the limit on the last word needs no truncation.
+        ("aaa bbb", 7, "aaa bbb"),
+        # A single word longer than the limit leaves only the suffix.
+        ("abcdefghij", 5, "..."),
+        # Several words must be dropped to make room for the suffix.
+        ("aa bb cc dd ee ff", 10, "aa bb..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_stdout(capsys):
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    lf.write("hello")
+    lf.flush()
+    # The standard stream is never closed by the lazy file.
+    lf.close_intelligently()
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    f = lf.open()
+    try:
+        assert lf.open() is f
+        assert repr(lf) == repr(f)
+    finally:
+        lf.close_intelligently()
+
+    assert f.closed
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    kof = click.utils._KeepOpenFile(f)
+    assert repr(kof) == repr(f)
+
+    with kof as inner:
+        inner.write("x")
+
+    assert not f.closed
+    assert f.getvalue() == "x"
+
+
+def test_echo_bytes_without_binary_writer(monkeypatch):
+    class Recorder:
+        def __init__(self):
+            self.data = []
+            self.flushed = 0
+
+        def write(self, value):
+            self.data.append(value)
+
+        def flush(self):
+            self.flushed += 1
+
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    out = Recorder()
+    click.utils.echo(b"data", file=out)
+    assert out.data == [b"data\n"]
+    assert out.flushed == 1
+
+
+def test_echo_no_standard_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    # Nothing to write to, so nothing happens.
+    click.utils.echo("hello")
+    click.utils.echo("hello", err=True)
+
+
+def test_get_binary_stream():
+    stream = click.utils._get_binary_stream("stdout")
+    assert isinstance(stream.write(b""), int)
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        click.utils._get_binary_stream("foo")
+
+
+def test_get_text_stream(capsys):
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("text")
+    stream.flush()
+    assert capsys.readouterr().out == "text"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        click.utils._get_text_stream("foo")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
