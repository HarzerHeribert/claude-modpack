+class _FlushRaiser:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    inner = _FlushRaiser()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.wrapped is inner
+    # Other attributes are proxied to the wrapped object.
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    inner = _FlushRaiser(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(inner).flush()
+    assert inner.flushed
+
+
+def test_pacify_flush_wrapper_other_error():
+    inner = _FlushRaiser(OSError(errno.EBADF, "Bad file descriptor"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EBADF
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("path", "to", "app.py")])
+    assert click.utils._detect_program_name() == "app.py"
+
