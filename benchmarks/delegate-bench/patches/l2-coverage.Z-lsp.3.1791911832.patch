+def test_lazy_file_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Not opened by the wrapper, so it must not be closed.
+    lf.close_intelligently()
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    f = lf.open()
+    # Opening again returns the same file.
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+
+    with lf:
+        lf.write("data")
+
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
