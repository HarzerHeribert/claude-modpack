+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/example.py", "--help"])
+    assert _detect_program_name() == "example.py"
+    assert _detect_program_name("") == "example.py"
+
+
+def test_detect_program_name_submodule():
+    main = types.ModuleType("__main__")
+    main.__package__ = "pkg"
+    assert _detect_program_name("/pkg/cli.py", _main=main) == "python -m pkg.cli"
+    assert _detect_program_name("/pkg/__main__.py", _main=main) == "python -m pkg"
+
