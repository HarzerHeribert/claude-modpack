+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "c.txt").touch()
+    pattern = os.path.join(os.fspath(tmp_path), "**", "*.txt")
+
+    recursive = sorted(_expand_args([pattern]))
+    assert recursive == sorted(
+        [
+            os.path.join(tmp_path, "a.txt"),
+            os.path.join(tmp_path, "b.txt"),
+            os.path.join(tmp_path, "sub", "c.txt"),
+        ]
+    )
+
+    flat = sorted(_expand_args([pattern], glob_recursive=False))
+    assert flat == [os.path.join(tmp_path, "sub", "c.txt")]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
