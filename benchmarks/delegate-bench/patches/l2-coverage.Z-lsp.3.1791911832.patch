+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.wrapped is stream
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(BrokenPipeError(errno.EPIPE, "pipe")))
+    # EPIPE is suppressed.
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
