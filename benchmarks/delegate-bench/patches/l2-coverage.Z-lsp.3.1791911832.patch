+def test_echo_bytes_without_binary_writer(monkeypatch):
+    written = []
+
+    class Collector:
+        def write(self, data):
+            written.append(data)
+
+        def flush(self):
+            written.append("flush")
+
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    click.echo(b"data", file=Collector())
+    assert written == [b"data\n", "flush"]
+
