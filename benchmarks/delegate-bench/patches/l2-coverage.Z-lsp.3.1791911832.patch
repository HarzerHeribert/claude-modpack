+def test_keep_open_file_proxy():
+    stream = io.StringIO("a\nb\n")
+    f = _KeepOpenFile(stream)
+    assert repr(f) == repr(stream)
+    assert f.getvalue() == "a\nb\n"
+
+    with f as inner:
+        assert inner is f
+        assert list(inner) == ["a\n", "b\n"]
+
+    assert not stream.closed
+    f.close()
+    assert stream.closed
+
