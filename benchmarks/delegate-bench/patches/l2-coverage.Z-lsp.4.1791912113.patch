+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly fills max length but more words follow.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # First word alone is longer than the limit.
+        ("abcdefghijklmnop qrs", 5, "..."),
+        # Exactly fills max length at the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # No-rewrap marker is dropped.
+        ("\b\nfoo bar", 45, "foo bar"),
+        ("", 45, ""),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
