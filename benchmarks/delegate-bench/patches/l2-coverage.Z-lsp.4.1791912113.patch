+class _Flushable:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.value = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+class TestPacifyFlushWrapper:
+    def test_flush(self):
+        click.utils._PacifyFlushWrapper(_Flushable()).flush()
+
+    def test_flush_broken_pipe_suppressed(self):
+        exc = BrokenPipeError(errno.EPIPE, "Broken pipe")
+        click.utils._PacifyFlushWrapper(_Flushable(exc)).flush()
+
+    def test_flush_other_error_raised(self):
+        exc = OSError(errno.EIO, "I/O error")
+
+        with pytest.raises(OSError) as exc_info:
+            click.utils._PacifyFlushWrapper(_Flushable(exc)).flush()
+
+        assert exc_info.value is exc
+
+    def test_getattr_proxied(self):
+        assert click.utils._PacifyFlushWrapper(_Flushable()).value == "proxied"
+
