+class _BytesOnlyNonEmpty:
+    """Rejects empty writes, so it isn't detected as text or binary."""
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise TypeError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+class TestEcho:
+    def test_no_standard_stream(self, monkeypatch):
+        monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+        monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+        click.utils.echo("hello")
+        click.utils.echo("hello", err=True)
+
+    def test_err_uses_stderr(self, capsys):
+        click.utils.echo("to stderr", err=True)
+        captured = capsys.readouterr()
+        assert captured.out == ""
+        assert captured.err == "to stderr\n"
+
+    def test_empty_message_only_flushes(self):
+        f = _BytesOnlyNonEmpty()
+        click.utils.echo(None, file=f, nl=False)
+        assert f.written == []
+        assert f.flushed == 1
+
+    def test_bytes_without_binary_writer(self):
+        f = _BytesOnlyNonEmpty()
+        click.utils.echo(b"data", file=f)
+        assert f.written == [b"data\n"]
+
+    def test_bytearray_to_binary(self):
+        f = io.BytesIO()
+        click.utils.echo(bytearray(b"abc"), file=f)
+        assert f.getvalue() == b"abc\n"
+
+    def test_object_converted_to_str(self):
+        f = io.StringIO()
+        click.utils.echo(123, file=f, nl=False)
+        assert f.getvalue() == "123"
+
+    @pytest.mark.parametrize(
+        ("color", "expected"),
+        [(True, "\x1b[31mred\x1b[0m\n"), (False, "red\n"), (None, "red\n")],
+    )
+    def test_color(self, color, expected):
+        f = io.StringIO()
+        click.utils.echo("\x1b[31mred\x1b[0m", file=f, color=color)
+        assert f.getvalue() == expected
+
