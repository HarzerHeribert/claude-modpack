+class TestOpenFile:
+    def test_lazy(self, tmp_path):
+        path = tmp_path / "lazy.txt"
+        f = click.utils.open_file(path, "w", lazy=True)
+        assert isinstance(f, click.utils._LazyFile)
+        assert not path.exists()
+
+        with f:
+            f.write("lazy")
+
+        assert path.read_text() == "lazy"
+
+    def test_lazy_atomic(self, tmp_path):
+        path = tmp_path / "atomic.txt"
+        path.write_text("old")
+        f = click.utils.open_file(path, "w", lazy=True, atomic=True)
+
+        with f:
+            f.write("new")
+            assert path.read_text() == "old"
+
+        assert path.read_text() == "new"
+
+    def test_regular_file(self, tmp_path):
+        path = tmp_path / "plain.txt"
+        path.write_text("content")
+
+        with click.utils.open_file(path) as f:
+            assert not isinstance(f, click.utils._KeepOpenFile)
+            assert f.read() == "content"
+
+    def test_dash_keeps_open(self, monkeypatch):
+        _, buffer = _binary_stdout(monkeypatch)
+
+        with click.utils.open_file("-", "w") as f:
+            assert isinstance(f, click.utils._KeepOpenFile)
+            f.write("out")
+
+        assert not f.closed
+        f.flush()
+        assert buffer.getvalue() == b"out"
+
