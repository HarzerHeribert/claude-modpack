+class TestStdStreams:
+    def test_binary_stream(self, monkeypatch):
+        _, buffer = _binary_stdout(monkeypatch)
+        assert click.utils._get_binary_stream("stdout") is buffer
+
+    def test_binary_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+            click.utils._get_binary_stream("nope")
+
+    def test_text_stream(self, monkeypatch):
+        _, buffer = _binary_stdout(monkeypatch)
+        out = click.utils._get_text_stream("stdout")
+        out.write("hi")
+        out.flush()
+        assert buffer.getvalue() == b"hi"
+
+    def test_text_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+            click.utils._get_text_stream("nope")
+
