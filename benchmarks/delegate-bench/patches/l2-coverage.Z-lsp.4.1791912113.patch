+class TestExpandArgs:
+    def test_no_user_no_env(self, monkeypatch):
+        monkeypatch.setenv("CLICK_TEST_VAR", "value")
+        assert click.utils._expand_args(
+            ["~", "$CLICK_TEST_VAR"], user=False, env=False
+        ) == ["~", "$CLICK_TEST_VAR"]
+
+    def test_glob_re_error(self, monkeypatch):
+        def bad_glob(pattern, recursive=False):
+            raise re.error("bad pattern")
+
+        monkeypatch.setattr(glob, "glob", bad_glob)
+        assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
+    def test_glob_non_recursive(self, tmp_path, monkeypatch):
+        (tmp_path / "sub").mkdir()
+        (tmp_path / "sub" / "a.txt").touch()
+        (tmp_path / "b.txt").touch()
+        monkeypatch.chdir(tmp_path)
+        assert click.utils._expand_args(["**/*.txt"], glob_recursive=False) == [
+            os.path.join("sub", "a.txt")
+        ]
+        assert sorted(click.utils._expand_args(["**/*.txt"])) == sorted(
+            ["b.txt", os.path.join("sub", "a.txt")]
+        )
+
