+def _binary_stdout(monkeypatch):
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream, buffer
+
+
+class TestLazyFile:
+    def test_stdout_dash(self, monkeypatch):
+        _, buffer = _binary_stdout(monkeypatch)
+        lf = click.utils._LazyFile("-", "w")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        lf.write("hello")
+        lf.flush()
+        assert buffer.getvalue() == b"hello"
+
+        # Exiting doesn't close a stream it didn't open.
+        with lf:
+            pass
+
+        assert not lf.closed
+
+    def test_repr_unopened_then_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = click.utils._LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{path}' w>"
+        assert not path.exists()
+
+        with lf as f:
+            f.write("data")
+            assert repr(lf) == repr(lf._f)
+            # Opening again returns the same object.
+            assert lf.open() is lf._f
+
+        assert lf.closed
+        assert path.read_text() == "data"
+
+    def test_close_unopened(self, tmp_path):
+        lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+        lf.close()
+        assert lf._f is None
+
+    def test_read_checks_early(self, tmp_path):
+        with pytest.raises(OSError):
+            click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error(self, tmp_path):
+        lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+        with pytest.raises(FileError) as exc_info:
+            lf.open()
+
+        assert exc_info.value.ui_filename == os.fspath(
+            tmp_path / "missing" / "out.txt"
+        )
+
