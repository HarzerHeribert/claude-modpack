+class TestKeepOpenFile:
+    def test_proxies_and_keeps_open(self):
+        f = io.StringIO("line1\nline2\n")
+        kof = click.utils._KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+
+        with kof as k:
+            assert k is kof
+            assert k.readline() == "line1\n"
+
+        assert not f.closed
+        assert list(kof) == ["line2\n"]
+        kof.close()
+        assert f.closed
+
