+class TestDetectProgramName:
+    def test_default_main(self, monkeypatch):
+        main = types.ModuleType("__main__")
+        main.__package__ = None
+        monkeypatch.setitem(sys.modules, "__main__", main)
+        assert click.utils._detect_program_name("/path/app.py") == "app.py"
+
+    def test_default_path(self, monkeypatch):
+        monkeypatch.setattr(sys, "argv", ["/path/to/tool.py", "--flag"])
+        main = types.ModuleType("__main__")
+        main.__package__ = ""
+        assert click.utils._detect_program_name(_main=main) == "tool.py"
+
+    def test_module_with_leading_dot(self):
+        main = types.ModuleType("__main__")
+        main.__package__ = ".pkg"
+        assert (
+            click.utils._detect_program_name("pkg/__main__.py", _main=main)
+            == "python -m pkg"
+        )
+
