+class _FailingFlush:
+    def __init__(self, err):
+        self.err = err
+        self.name = "failing"
+
+    def flush(self):
+        raise self.err
+
+
+def test_pacify_flush_wrapper_ok():
+    f = io.StringIO()
+    w = _PacifyFlushWrapper(f)
+    w.write("x")
+    w.flush()
+    assert w.getvalue() == "x"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    f = _FailingFlush(OSError(errno.EPIPE, "broken pipe"))
+    w = _PacifyFlushWrapper(f)  # type: ignore[arg-type]
+    w.flush()
+    assert w.name == "failing"
+
+
+def test_pacify_flush_wrapper_other_error():
+    f = _FailingFlush(OSError(errno.EIO, "io error"))
+    w = _PacifyFlushWrapper(f)  # type: ignore[arg-type]
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", [os.path.join("some", "dir", "app.py")])
+    assert _detect_program_name() == "app.py"
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def bad_glob(*args, **kwargs):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
