+class _PickyWriter:
+    """Accepts any non-empty data but rejects empty writes, so it is not
+    detected as either a binary or a text stream.
+    """
+
+    def __init__(self):
+        self.data = []
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.data.append(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _PickyWriter()
+    click.echo(b"hello", file=f)  # type: ignore[arg-type]
+    assert f.data == [b"hello\n"]
+
+
+def test_echo_bytearray_to_binary_stream():
+    f = io.BytesIO()
+    click.echo(bytearray(b"hi"), file=f, nl=False)
+    assert f.getvalue() == b"hi"
+
+
+def test_echo_no_message_no_newline_only_flushes():
+    f = io.StringIO()
+    click.echo(file=f, nl=False)
+    assert f.getvalue() == ""
+
+
+def test_get_binary_stream():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_binary_stream("foo")  # type: ignore[arg-type]
+
+    assert _get_binary_stream("stdin") is not None
+
+
+def test_get_text_stream():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_text_stream("foo")  # type: ignore[arg-type]
+
+    assert _get_text_stream("stderr", errors="replace") is not None
+
