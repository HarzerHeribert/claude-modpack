+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    assert _safecall(lambda a, b=1: a + b)(1, b=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = _safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__wrapped__ is fail
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"abc") == "abc"
+    assert make_str("abc") == "abc"
+    assert make_str(42) == "42"
+
+
+def test_make_str_bytes_invalid(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly max_length but more words follow, truncate with "...".
+        ("aaaaa bbbb cc", 10, "aaaaa..."),
+        # First word alone is too long.
+        ("a" * 50, 45, "..."),
+        ("", 45, ""),
+        ("\b\nshort help", 45, "short help"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # Leaving the block must not close stdout.
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+
+
+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO()
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as k:
+        k.write("x")
+
+    assert not f.closed
+    assert f.getvalue() == "x"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_stdout_keep_open(capsys):
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+
+    assert capsys.readouterr().out == "out"
+
