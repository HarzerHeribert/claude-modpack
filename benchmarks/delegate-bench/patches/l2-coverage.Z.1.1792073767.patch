+def test_detect_program_name_defaults_to_sys(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/example/cli.py"])
+    assert click.utils._detect_program_name() == "python -m example.cli"
+
+
+def test_detect_program_name_file(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/app.py"])
+    assert click.utils._detect_program_name(_main=main) == "app.py"
+
+
+def test_detect_program_name_package_main():
+    main = types.ModuleType("__main__")
+    main.__package__ = "pkg"
+    assert (
+        click.utils._detect_program_name("/x/pkg/__main__.py", _main=main)
+        == "python -m pkg"
+    )
+
