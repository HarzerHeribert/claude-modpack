+class _Flushable:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_passes_through():
+    inner = _Flushable()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    inner = _Flushable(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(inner).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _Flushable(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
