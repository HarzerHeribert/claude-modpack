+def test_echo_bytes_without_binary_writer():
+    class TextOnly:
+        """Rejects the empty probe writes so no binary writer is found,
+        but accepts real data."""
+
+        def __init__(self):
+            self.data = []
+            self.flushed = 0
+
+        def write(self, value):
+            if not value:
+                raise TypeError("empty write")
+            self.data.append(value)
+
+        def flush(self):
+            self.flushed += 1
+
+    f = TextOnly()
+    click.utils.echo(b"raw", file=f)
+    assert f.data == [b"raw\n"]
+    assert f.flushed == 1
+
+
+def test_echo_empty_message_flushes():
+    f = StringIO()
+    click.utils.echo(None, file=f, nl=False)
+    assert f.getvalue() == ""
+
+    click.utils.echo(b"", file=f, nl=False)
+    assert f.getvalue() == ""
+
+
+def test_echo_err(runner):
+    with runner.isolation() as (out, err, _):
+        click.utils.echo("to stderr", err=True)
+        assert err.getvalue().replace(b"\r\n", b"\n") == b"to stderr\n"
+        assert out.getvalue() == b""
+
+
+def test_echo_object_and_color():
+    f = StringIO()
+    click.utils.echo(["a"], file=f, color=False)
+    click.utils.echo("\x1b[31mred\x1b[0m", file=f, color=True)
+    assert f.getvalue() == "['a']\n\x1b[31mred\x1b[0m\n"
+
+
+def test_get_binary_stream(runner):
+    with runner.isolation():
+        stream = click.utils._get_binary_stream("stdout")
+        stream.write(b"")
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation() as (out, _, _):
+        stream = click.utils._get_text_stream("stdout")
+        stream.write("hi")
+        stream.flush()
+        assert out.getvalue() == b"hi"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
