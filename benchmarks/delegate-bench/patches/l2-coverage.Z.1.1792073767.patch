+def test_format_filename():
+    assert click.utils.format_filename("/a/b/c.txt", shorten=True) == "c.txt"
+    assert click.utils.format_filename(b"/a/b/c.txt") == "/a/b/c.txt"
+    assert click.utils.format_filename("bad\udcff") == "bad\ufffd"
+
