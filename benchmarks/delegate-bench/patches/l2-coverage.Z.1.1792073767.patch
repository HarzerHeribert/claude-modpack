+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert click.utils._expand_args(
+        ["~", "$CLICK_TEST"], user=False, env=False
+    ) == ["~", "$CLICK_TEST"]
+
+
+def test_expand_args_glob_not_recursive(tmp_path, monkeypatch):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "x.txt").write_text("")
+    (tmp_path / "y.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert click.utils._expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("sub", "x.txt")
+    ]
+    assert sorted(click.utils._expand_args(["**/*.txt"])) == sorted(
+        [os.path.join("sub", "x.txt"), "y.txt"]
+    )
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
