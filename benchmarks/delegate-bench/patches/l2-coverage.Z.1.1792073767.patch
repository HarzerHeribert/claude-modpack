+import errno
+import glob
+import os
+import re
+import sys
+import types
+from io import StringIO
+
+import pytest
+
+import click.utils
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff\xfe", "\ufffd\ufffd"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+def test_make_str_decode_error(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    # Not valid ASCII, so it falls back to UTF-8 with replacement.
+    assert click.utils.make_str(b"caf\xc3\xa9\xff") == "caf\u00e9\ufffd"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # First word exactly fills the limit but more words follow, so
+        # every word is removed and only the suffix remains.
+        ("abcde f", 5, "..."),
+        # Exact fit before the last word, shorten to make room for "...".
+        ("ab cd efgh", 5, "ab..."),
+        # Exact fit on the last word needs no truncation.
+        ("ab cd", 5, "ab cd"),
+        ("", 45, ""),
+        ("\b\nshort text", 45, "short text"),
+        ("First paragraph.\n\nSecond paragraph.", 45, "First paragraph."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
