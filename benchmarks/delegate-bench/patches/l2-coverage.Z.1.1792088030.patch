+def test_echo_bytes_to_text_only_stream():
+    # StringIO has no binary buffer, so the bytes fall through to write().
+    with pytest.raises(TypeError):
+        click.echo(b"bytes", file=io.StringIO())
+
+
+def test_echo_bytearray_to_binary_stream():
+    f = io.BytesIO()
+    click.echo(bytearray(b"data"), file=f)
+    assert f.getvalue() == b"data\n"
+
+
+def test_echo_empty_no_newline_flushes():
+    class Recorder(io.StringIO):
+        flushed = 0
+
+        def flush(self):
+            self.flushed += 1
+            super().flush()
+
+    f = Recorder()
+    click.echo("", file=f, nl=False)
+    assert f.getvalue() == ""
+    assert f.flushed == 1
+
+
+def test_echo_object_converted_to_str():
+    f = io.StringIO()
+    click.echo(123, file=f)
+    click.echo(None, file=f)
+    assert f.getvalue() == "123\n\n"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_binary_stream("foo")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'foo'"):
+        _get_text_stream("foo")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation(input="input line\n") as (out, err, _):
+        stdin = _get_text_stream("stdin")
+        assert stdin.readline() == "input line\n"
+        stdout = _get_text_stream("stdout")
+        stdout.write("out text")
+        stdout.flush()
+        stderr = _get_text_stream("stderr", errors="replace")
+        stderr.write("err text")
+        stderr.flush()
+        assert out.getvalue() == b"out text"
+        assert err.getvalue() == b"err text"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+    with f:
+        f.write("lazy content")
+    assert path.read_text() == "lazy content"
+
+
+def test_open_file_dash_keeps_stream_open(runner):
+    with runner.isolation() as (out, _, _):
+        f = click.open_file("-", "w")
+        assert isinstance(f, _KeepOpenFile)
+        with f:
+            f.write("hello")
+        f.flush()
+        assert not f.closed
+        assert out.getvalue() == b"hello"
+
