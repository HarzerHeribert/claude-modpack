+def test_lazy_file_unopened_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_opened_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close_intelligently()
+    assert f.closed
+
+
+def test_lazy_file_write_on_attribute_access(tmp_path):
+    path = tmp_path / "out.txt"
+    with _LazyFile(path, "w", encoding="utf-8") as lf:
+        lf.write("hello")
+    assert path.read_text(encoding="utf-8") == "hello"
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazy_file_dash(runner):
+    with runner.isolation() as (out, _, _):
+        lf = _LazyFile("-", "w")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        with lf:
+            lf.write("to stdout")
+            lf.flush()
+        # The standard stream is not closed when leaving the block.
+        assert not lf._f.closed
+        assert out.getvalue() == b"to stdout"
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO("data")
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+
+def test_keep_open_file_context_and_close():
+    f = io.StringIO("data")
+    kf = _KeepOpenFile(f)
+    with kf as entered:
+        assert entered is kf
+        assert entered.read() == "data"
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
