+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = 0
+        self.name = "wrapped-stream"
+
+    def flush(self):
+        self.flushed += 1
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passes_through():
+    wrapped = _FlushRaises()
+    pacified = _PacifyFlushWrapper(wrapped)
+    pacified.flush()
+    assert wrapped.flushed == 1
+    assert pacified.name == "wrapped-stream"
+    assert pacified.wrapped is wrapped
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapped = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    _PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed == 1
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapped = _FlushRaises(OSError(errno.EIO, "I/O error"))
+    with pytest.raises(OSError) as exc_info:
+        _PacifyFlushWrapper(wrapped).flush()
+    assert exc_info.value.errno == errno.EIO
+
