+import errno
+import glob
+import os
+import re
+import sys
+from types import ModuleType
+
+import pytest
+
+import click.utils
+from click.exceptions import FileError
+from click.testing import CliRunner
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff", "�"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(value, expected):
+    assert click.utils.make_str(value) == expected
+
+
+def test_make_default_short_help_exact_length_not_last_word():
+    # The first word fills the limit exactly but more words follow, so the
+    # text is truncated with "..." and no earlier words to fall back on.
+    assert click.utils._make_default_short_help("abcde fgh", max_length=5) == "..."
+
+
+def test_lazy_file_dash_reads_stdin():
+    runner = CliRunner()
+
+    with runner.isolation(input="hello\n"):
+        lf = click.utils._LazyFile("-")
+        assert lf.should_close is False
+        assert lf._f is not None
+        assert repr(lf) == repr(lf._f)
+        assert lf.read() == "hello\n"
+        # Not opened by the wrapper, so it must not be closed.
+        lf.close_intelligently()
+        assert not lf._f.closed
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.close()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "file.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_exit():
+    runner = CliRunner()
+
+    with runner.isolation():
+        f = click.utils.open_file("-", "w")
+        assert isinstance(f, click.utils._KeepOpenFile)
+        assert repr(f) == repr(sys.stdout)
+
+        with f as inner:
+            assert inner is f
+
+        assert not sys.stdout.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+    path.write_text("content")
+
+    with click.utils.open_file(path) as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        assert f.read() == "content"
+
