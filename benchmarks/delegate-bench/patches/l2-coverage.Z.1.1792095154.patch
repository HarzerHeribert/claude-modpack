+def test_expand_args_without_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    assert click.utils._expand_args(
+        ["~", "$CLICK_TEST_VAR"], user=False, env=False
+    ) == ["~", "$CLICK_TEST_VAR"]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def broken_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", broken_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
