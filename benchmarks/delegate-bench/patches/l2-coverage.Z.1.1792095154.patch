+class _RejectsEmptyBytes:
+    """A text-like stream without a binary buffer that still accepts bytes
+    once the empty-bytes probe has failed.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("probe rejected")
+
+        if value:
+            self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _RejectsEmptyBytes()
+    click.utils.echo(b"hi", file=stream)
+    assert stream.data == [b"hi\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytearray_without_newline():
+    stream = _RejectsEmptyBytes()
+    click.utils.echo(bytearray(b"raw"), file=stream, nl=False)
+    assert stream.data == [bytearray(b"raw")]
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_get_text_stream_stdout():
+    runner = CliRunner()
+
+    with runner.isolation() as (out, _, _):
+        stream = click.utils._get_text_stream("stdout")
+        stream.write("text stream")
+        stream.flush()
+        assert out.getvalue() == b"text stream"
+
