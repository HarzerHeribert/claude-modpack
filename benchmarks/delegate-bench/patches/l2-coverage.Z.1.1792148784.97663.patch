+import errno
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils as utils
+
+
+def test_posixify():
+    assert utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    wrapped = utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    calls = []
+
+    def fail():
+        calls.append(True)
+        raise ValueError("boom")
+
+    assert utils._safecall(fail)() is None
+    assert calls == [True]
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff", "�"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(value, expected):
+    assert utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly max_length before the last word, then remove words to fit "...".
+        ("aaa bbb ccc ddd", 11, "aaa bbb..."),
+        # Removing words reaches the first word without fitting.
+        ("a b c", 3, "..."),
+    ],
+)
+def test_make_default_short_help_exact_length(help, max_length, expected):
+    assert utils._make_default_short_help(help, max_length) == expected
+
