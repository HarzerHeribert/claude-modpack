+class _EmptyRejectingWriter:
+    """A stream that isn't detected as binary or text, but accepts
+    non-empty writes of any type.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _EmptyRejectingWriter()
+    utils.echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_without_binary_writer():
+    f = _EmptyRejectingWriter()
+    utils.echo(bytearray(b"hi"), file=f, nl=False)
+    assert f.written == [bytearray(b"hi")]
+
