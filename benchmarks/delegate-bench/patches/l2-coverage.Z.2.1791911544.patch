+def test_echo_bytes_without_binary_writer():
+    class OddStream:
+        """Rejects empty writes of both types so it is not detected as
+        a binary writer, and has no ``buffer`` attribute."""
+
+        def __init__(self):
+            self.data = []
+            self.flushed = 0
+
+        def write(self, data):
+            if not data:
+                raise ValueError("empty")
+            self.data.append(data)
+
+        def flush(self):
+            self.flushed += 1
+
+    stream = OddStream()
+    click.utils.echo(b"hello", file=stream)
+    assert stream.data == [b"hello\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_empty_no_newline_flushes():
+    class Stream(io.StringIO):
+        flushed = False
+
+        def flush(self):
+            self.flushed = True
+            super().flush()
+
+    s = Stream()
+    click.utils.echo(None, file=s, nl=False)
+    assert s.getvalue() == ""
+    assert s.flushed
+
+
+def test_echo_bytearray_to_binary():
+    b = io.BytesIO()
+    click.utils.echo(bytearray(b"abc"), file=b)
+    assert b.getvalue() == b"abc\n"
+
