+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("content")
+
+    assert path.read_text() == "content"
+
+
+def test_open_file_lazy_read(tmp_path):
+    path = tmp_path / "lazy.txt"
+    path.write_text("a\nb\n")
+
+    with click.utils.open_file(path, lazy=True) as f:
+        assert list(f) == ["a\n", "b\n"]
+
+
+def test_open_file_stdout_keep_open(monkeypatch):
+    out = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", out)
+    f = click.utils.open_file("-", "w", encoding="utf-8")
+    assert isinstance(f, click.utils._KeepOpenFile)
+
+    with f:
+        f.write("x")
+
+    f.flush()
+    assert out.buffer.getvalue() == b"x"
+
