+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("data")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as inner:
+        assert inner is kf
+        assert inner.read() == "data"
+
+    assert not f.closed
+
