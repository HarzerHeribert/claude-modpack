+class TestPacifyFlushWrapper:
+    class Stream:
+        def __init__(self, exc=None):
+            self.exc = exc
+            self.flushed = False
+            self.name = "stream"
+
+        def flush(self):
+            if self.exc is not None:
+                raise self.exc
+            self.flushed = True
+
+    def test_flush(self):
+        s = self.Stream()
+        w = click.utils._PacifyFlushWrapper(s)
+        w.flush()
+        assert s.flushed
+
+    def test_flush_broken_pipe_suppressed(self):
+        s = self.Stream(OSError(errno.EPIPE, "Broken pipe"))
+        click.utils._PacifyFlushWrapper(s).flush()
+
+    def test_flush_other_error_raised(self):
+        s = self.Stream(OSError(errno.EBADF, "Bad file descriptor"))
+
+        with pytest.raises(OSError) as exc_info:
+            click.utils._PacifyFlushWrapper(s).flush()
+
+        assert exc_info.value.errno == errno.EBADF
+
+    def test_getattr_proxied(self):
+        s = self.Stream()
+        assert click.utils._PacifyFlushWrapper(s).name == "stream"
+
