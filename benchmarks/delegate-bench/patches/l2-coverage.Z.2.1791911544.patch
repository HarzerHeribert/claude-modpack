+        ("abcde fgh", 5, "..."),
+        # Exactly reaching max_length mid-sentence, then words are removed.
+        ("ab cd efgh ij", 10, "ab cd..."),
+    ],
+)
+def test_make_default_short_help_exact_length(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
