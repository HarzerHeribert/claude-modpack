+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRaises()
+    w = utils._PacifyFlushWrapper(wrapped)
+    w.flush()
+    assert wrapped.flushed
+    assert w.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    w = utils._PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "pipe")))
+    # A broken pipe is suppressed.
+    w.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    w = utils._PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
