+class _BytesOnlyWhenNonEmpty:
+    """A stream that rejects empty writes, so it is detected as neither
+    a binary nor a text writer, but accepts any non-empty data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.data.append(data)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _BytesOnlyWhenNonEmpty()
+    click.echo(b"hello", file=f)
+    assert f.data == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    f = io.BytesIO()
+    click.echo(bytearray(b"hi"), file=f, nl=False)
+    assert f.getvalue() == b"hi"
+
+
+def test_echo_object_and_strip_ansi():
+    f = io.StringIO()
+    click.echo(click.style(42, fg="red"), file=f, color=False)
+    click.echo(["x"], file=f, color=True)
+    assert f.getvalue() == "42\n['x']\n"
+
+
+def test_echo_empty_flushes():
+    f = _BytesOnlyWhenNonEmpty()
+    click.echo(None, file=f, nl=False)
+    assert f.data == []
+    assert f.flushed == 1
+
