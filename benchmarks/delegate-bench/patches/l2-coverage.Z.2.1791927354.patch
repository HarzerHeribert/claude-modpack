+def test_open_file_stdout_keep_open(monkeypatch):
+    text_stdout = _patch_stdout(monkeypatch)
+    f = utils.open_file("-", "w")
+    assert isinstance(f, utils._KeepOpenFile)
+
+    with f:
+        f.write("out")
+        f.flush()
+
+    assert not text_stdout.closed
+    assert text_stdout.buffer.getvalue() == b"out"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("content")
+
+    with utils.open_file(path) as f:
+        assert not isinstance(f, utils._KeepOpenFile)
+        assert f.read() == "content"
