+def test_lazyfile_stdout(monkeypatch):
+    text_stdout = _patch_stdout(monkeypatch)
+    lf = utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+        f.flush()
+
+    # Leaving the block doesn't close a standard stream.
+    assert not lf._f.closed
+    assert text_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_open_returns_existing(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = utils._LazyFile(path, "w")
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+
+
+def test_lazyfile_close_unopened(tmp_path):
+    lf = utils._LazyFile(tmp_path / "out.txt", "w")
+    # Closing a file that was never opened does nothing.
+    lf.close()
+    assert lf._f is None
+
