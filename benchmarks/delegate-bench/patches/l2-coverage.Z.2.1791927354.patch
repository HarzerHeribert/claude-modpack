+def _patch_stdout(monkeypatch):
+    """Replace stdout with a UTF-8 text wrapper around a byte buffer.
+
+    This must be called in the test body, since pytest's output capturing
+    replaces ``sys.stdout`` again after fixtures are set up.
+    """
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo   Bar\tBaz ", "foo-bar-baz"),
+        ("single", "single"),
+    ],
+)
+def test_posixify(name, expected):
+    assert utils._posixify(name) == expected
+
