+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain("example"))
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "cli.py")])
+    assert utils._detect_program_name() == "python -m example.cli"
+
+
+def test_detect_program_name_file_default_main(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    assert utils._detect_program_name(os.path.join("a", "app.py")) == "app.py"
+
+
+def test_detect_program_name_relative_package():
+    path = os.path.join("example", "__main__.py")
+    main = _MockMain(".example")
+    assert utils._detect_program_name(path, _main=main) == "python -m example"
+
