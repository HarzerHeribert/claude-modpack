+class _FlushStream:
+    def __init__(self, error=None):
+        self.error = error
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.error is not None:
+            raise self.error
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flushes():
+    inner = _FlushStream()
+    wrapper = _PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
