+def test_lazyfile_dash(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+
+    # Exiting did not close the borrowed stream.
+    assert not lf._f.closed
+    lf._f.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_unopened_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("data")
+    assert lf.open() is lf._f
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazyfile_read_checks_early(tmp_path):
+    with pytest.raises(OSError):
+        _LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "no" / "such" / "dir.txt", "w")
+
+    with pytest.raises(FileError):
+        lf.open()
