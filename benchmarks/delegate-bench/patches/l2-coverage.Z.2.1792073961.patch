+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("abcde fgh", 5, "...", id="first word fills, no words kept"),
+        pytest.param("ab cd efgh", 5, "ab...", id="exact length mid text"),
+        pytest.param("ab cd", 5, "ab cd", id="exact length at end"),
+    ],
+)
+def test_make_default_short_help_exact_length(value, max_length, expect):
+    assert _make_default_short_help(value, max_length) == expect
