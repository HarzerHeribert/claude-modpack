+def test_keepopenfile_proxies():
+    inner = io.StringIO("a\nb\n")
+    f = _KeepOpenFile(inner)
+    assert repr(f) == repr(inner)
+    assert list(f) == ["a\n", "b\n"]
+
+    with f as g:
+        assert g is f
+
+    assert not inner.closed
+    assert f.getvalue() == "a\nb\n"
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_open(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    f = open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+    assert repr(f) == repr(f._file)
+
+    with f:
+        f.write("x")
+
+    f.flush()
+    assert not f.closed
+    assert fake_stdout.buffer.getvalue() == b"x"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+
+    with open_file(path, "w") as f:
+        assert not isinstance(f, _KeepOpenFile)
+        f.write("plain")
+
+    assert path.read_text() == "plain"
