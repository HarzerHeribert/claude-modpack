+class _PickyStream:
+    """A stream that rejects empty writes, so it is detected as neither a
+    text nor a binary writer, but accepts any non-empty data.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _PickyStream()
+    echo(b"hi", file=stream)
+    assert stream.data == [b"hi\n"]
+    assert stream.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    stream = io.BytesIO()
+    echo(bytearray(b"ab"), file=stream, nl=False)
+    assert stream.getvalue() == b"ab"
+
+
+def test_echo_empty_only_flushes():
+    stream = _PickyStream()
+    echo(None, file=stream, nl=False)
+    assert stream.data == []
+    assert stream.flushed == 1
+
+
+def test_echo_object_strips_ansi():
+    class Obj:
+        def __str__(self):
+            return "\x1b[31mred\x1b[0m"
+
+    stream = io.StringIO()
+    echo(Obj(), file=stream, color=False)
+    assert stream.getvalue() == "red\n"
+
