+def test_echo_bytes_without_binary_writer():
+    class TextOnly:
+        def __init__(self):
+            self.written = []
+            self.flushed = 0
+
+        def write(self, x):
+            if x == b"":
+                raise TypeError("text only")
+            self.written.append(x)
+
+        def flush(self):
+            self.flushed += 1
+
+    out = TextOnly()
+    click.echo(b"hi", file=out)
+    assert out.written[-1] == b"hi\n"
+    assert out.flushed >= 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out)
+    assert out.getvalue() == b"abc\n"
+
+
+def test_echo_object_to_stringio():
+    out = io.StringIO()
+    click.echo(123, file=out, nl=False)
+    assert out.getvalue() == "123"
+
