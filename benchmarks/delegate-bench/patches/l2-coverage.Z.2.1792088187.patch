+class _Flushable:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_proxies():
+    inner = _Flushable()
+    wrapper = click.utils._PacifyFlushWrapper(inner)
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_swallows_epipe():
+    inner = _Flushable(OSError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(inner).flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    inner = _Flushable(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(inner).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
