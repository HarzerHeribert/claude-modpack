+def test_format_filename_bytes_and_shorten(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.format_filename(b"/a/b/c\xff.txt", shorten=True) == (
+        "c�.txt"
+    )
+    assert click.utils.format_filename("/a/b/c.txt", shorten=True) == "c.txt"
