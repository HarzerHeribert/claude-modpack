+import errno
+import io
+import os
+import re
+import sys
+
+import pytest
+
+import click
+import click.utils
+
+
+class MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def _fake_stdout(monkeypatch):
+    # Patch inside the test body; pytest's capture resets sys.stdout after
+    # fixture setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    def add(a, b):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (b"hello", "hello"),
+        (b"\xff\xfe", "��"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(monkeypatch, value, expect):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        # Reaches exactly max_length before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is already too long.
+        ("abcdefghij klm", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edge_cases(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_dash(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+
+    # Leaving the context must not close the borrowed stream.
+    with lf as f:
+        f.write("hello")
+
+    assert not fake_stdout.closed
+    fake_stdout.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_unopened_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert lf._f is None
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    # Closing an unopened file is a no-op.
+    lf.close()
+    assert lf._f is None
+    assert not path.exists()
+
+
+def test_lazy_file_read_and_iter(tmp_path):
+    path = tmp_path / "in.txt"
+    path.write_text("a\nb\n")
+    lf = click.utils._LazyFile(path, "r")
+    assert lf._f is None
+
+    with lf:
+        assert list(lf) == ["a\n", "b\n"]
+        # __getattr__ proxies to the opened file.
+        assert lf.name == os.fspath(path)
+        assert not lf.closed
+
+    assert lf._f.closed
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_close():
+    f = io.StringIO("data")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as k:
+        assert k.read() == "data"
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
