+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+from click.exceptions import FileError
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    @click.utils._safecall
+    def add(a, b):
+        """Add two numbers."""
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+    assert add.__doc__ == "Add two numbers."
+
+
+def test_safecall_swallows_exception():
+    @click.utils._safecall
+    def fail():
+        raise ValueError("boom")
+
+    assert fail() is None
+
+
+def test_make_str_str_and_objects():
+    assert click.utils.make_str("abc") == "abc"
+    assert click.utils.make_str(42) == "42"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str("äb".encode()) == "äb"
+
+
+def test_make_str_bytes_decode_error(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"a\xffb") == "a�b"
+
+
+@pytest.mark.parametrize(
+    ("value", "max_length", "expect"),
+    [
+        pytest.param("aaaa bbbb cccc", 9, "aaaa...", id="exact length, more words"),
+        pytest.param("abcdefghij", 5, "...", id="first word too long"),
+        pytest.param("abc defghijklmn", 5, "...", id="shrink to nothing"),
+        pytest.param("\b", 10, "", id="only no-wrap marker"),
+    ],
+)
+def test_make_default_short_help_edge_cases(value, max_length, expect):
+    assert click.utils._make_default_short_help(value, max_length) == expect
+
+
+def test_lazy_file_repr_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert lf.should_close
+    assert not path.exists()
+
+    with lf:
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+        # A second open returns the already opened file.
+        assert lf.open() is lf._f
+
+    assert lf._f.closed
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_read_checks_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename == str(tmp_path / "missing" / "out.txt")
+
+
+def test_lazy_file_dash_does_not_close(monkeypatch):
+    stdout = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", stdout)
+    lf = click.utils._LazyFile("-", "wb")
+    assert lf._f is stdout
+    assert not lf.should_close
+    assert repr(lf) == repr(stdout)
+
+    with lf as f:
+        f.write(b"data")
+
+    assert not stdout.closed
+    assert stdout.getvalue() == b"data"
+
+
+def test_keep_open_file_repr_and_close():
+    f = io.StringIO("line1\nline2\n")
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+    assert list(kf) == ["line1\n", "line2\n"]
+
+    with kf as inner:
+        assert inner is kf
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer cannot accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out)
+    assert out.getvalue() == b"data\n"
+
+
+def test_echo_no_message_no_newline():
+    out = io.StringIO()
+    click.echo(None, file=out, nl=False)
+    click.echo(b"", file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_get_binary_stream(monkeypatch):
+    stdout = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", stdout)
+    assert click.utils._get_binary_stream("stdout") is stdout
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    buffer = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buffer, encoding="utf-8"))
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("hällo")
+    stream.flush()
+    assert buffer.getvalue() == "hällo".encode()
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        click.utils._get_text_stream("nope")
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+
+    with click.utils.open_file(path, "w", atomic=True) as f:
+        f.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_open_file_dash_keeps_stdout_open(monkeypatch):
+    stdout = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    with click.utils.open_file("-", "wb") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        f.write(b"x")
+
+    assert not stdout.closed
+    assert stdout.getvalue() == b"x"
+
+
+def test_format_filename_shorten_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.format_filename(b"/a/b/c\xff.txt", shorten=True) == "c�.txt"
+
