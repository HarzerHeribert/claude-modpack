+def test_echo_bytes_to_text_only_stream():
+    # StringIO has no binary buffer to write bytes to, so the bytes are
+    # passed to the text stream's write, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
