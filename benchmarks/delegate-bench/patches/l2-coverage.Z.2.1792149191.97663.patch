+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly reaching max_length mid-text truncates with "...".
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # A first word that is already too long leaves only "...".
+        ("abcdefghij", 5, "..."),
+        ("", 45, ""),
+        ("\b\nshort text", 45, "short text"),
+        ("First sentence. Second sentence.", 45, "First sentence."),
+    ],
+)
+def test_make_default_short_help(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_dash_write(runner):
+    with runner.isolation() as (out, _, _):
+        lf = _LazyFile("-", "w")
+        assert lf._f is not None
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+
+        with lf as f:
+            f.write("to stdout")
+            f.flush()
+
+        # Exiting the block must not close the standard stream.
+        assert not lf._f.closed
+        lf.close_intelligently()
+        assert not lf._f.closed
+        assert out.getvalue() == b"to stdout"
+
+
+def test_lazy_file_dash_read(runner):
+    with runner.isolation(input="line1\nline2\n"):
+        lf = _LazyFile("-")
+        assert list(lf) == ["line1\n", "line2\n"]
+
+
+def test_keep_open_file_repr():
+    f = io.StringIO()
+    assert repr(_KeepOpenFile(f)) == repr(f)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_open_file_lazy_read_checks_early(tmp_path):
+    with pytest.raises(OSError):
+        open_file(tmp_path / "missing.txt", "r", lazy=True)
+
