+def test_safecall_returns_value():
+    def add(a, b=0):
+        """Add numbers."""
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+    assert wrapped.__doc__ == "Add numbers."
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_make_str_str_and_other():
+    assert make_str("abc") == "abc"
+    assert make_str(42) == "42"
+
+
+def test_make_str_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str("ä".encode()) == "ä"
+
+
+def test_make_str_invalid_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert make_str(b"a\xffb") == "a�b"
+
