+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+def test_get_text_stream(runner):
+    with runner.isolation(input="input text") as (out, err, _):
+        assert _get_text_stream("stdin").read() == "input text"
+
+        stdout = _get_text_stream("stdout")
+        stdout.write("out text")
+        stdout.flush()
+
+        stderr = _get_text_stream("stderr", errors="replace")
+        stderr.write("err text")
+        stderr.flush()
+
+        assert out.getvalue() == b"out text"
+        assert err.getvalue() == b"err text"
+
