+def test_echo_bytes_without_binary_writer(monkeypatch):
+    class Recorder:
+        def __init__(self):
+            self.written = []
+            self.flushes = 0
+
+        def write(self, data):
+            self.written.append(data)
+
+        def flush(self):
+            self.flushes += 1
+
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    rec = Recorder()
+    click.echo(b"raw", file=rec)
+    assert rec.written == [b"raw\n"]
+    assert rec.flushes == 1
+
+
+def test_echo_bytes_to_binary_writer():
+    buf = io.BytesIO()
+    click.echo(b"raw", file=buf, nl=False)
+    assert buf.getvalue() == b"raw"
+
+
+def test_echo_empty_flushes_only():
+    s = io.StringIO()
+    click.echo("", file=s, nl=False)
+    assert s.getvalue() == ""
+
+
+def test_echo_object_and_none():
+    s = io.StringIO()
+    click.echo(123, file=s)
+    click.echo(None, file=s)
+    click.echo(bytearray(b"ba"), file=io.BytesIO())
+    assert s.getvalue() == "123\n\n"
+
