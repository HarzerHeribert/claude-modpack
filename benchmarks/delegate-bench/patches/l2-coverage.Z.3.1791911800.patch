+class _FlushStub:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.extra = "proxied"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    stub = _FlushStub()
+    wrapper = click.utils._PacifyFlushWrapper(stub)
+    wrapper.flush()
+    assert stub.flushed
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    stub = _FlushStub(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    wrapper = click.utils._PacifyFlushWrapper(stub)
+    wrapper.flush()
+    assert stub.flushed
+
+
+def test_pacify_flush_wrapper_other_oserror():
+    stub = _FlushStub(OSError(errno.EIO, "I/O error"))
+    wrapper = click.utils._PacifyFlushWrapper(stub)
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
