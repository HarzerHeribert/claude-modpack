+def test_get_text_stream_known():
+    with CliRunner().isolation() as (out, err, _):
+        stdout = click.utils._get_text_stream("stdout")
+        stdout.write("to out")
+        stdout.flush()
+        stderr = click.utils._get_text_stream("stderr", errors="replace")
+        stderr.write("to err")
+        stderr.flush()
+        assert out.getvalue() == b"to out"
+        assert err.getvalue() == b"to err"
+
+
+def test_get_binary_stream_known():
+    with CliRunner().isolation() as (out, _err, _):
+        stdout = click.utils._get_binary_stream("stdout")
+        stdout.write(b"bytes")
+        stdout.flush()
+        assert out.getvalue() == b"bytes"
+
