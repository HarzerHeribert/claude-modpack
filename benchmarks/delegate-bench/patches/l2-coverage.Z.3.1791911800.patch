+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    sub = tmp_path / "sub"
+    sub.mkdir()
+    (sub / "c.txt").touch()
+    pattern = os.path.join(str(tmp_path), "**", "*.txt")
+    recursive = sorted(click.utils._expand_args([pattern]))
+    assert recursive == sorted(
+        [
+            str(tmp_path / "a.txt"),
+            str(tmp_path / "b.txt"),
+            str(sub / "c.txt"),
+        ]
+    )
+    flat = sorted(click.utils._expand_args([pattern], glob_recursive=False))
+    assert flat == [str(sub / "c.txt")]
+
+
+def test_expand_args_invalid_pattern(monkeypatch):
+    import glob
+
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[invalid"]) == ["[invalid"]
