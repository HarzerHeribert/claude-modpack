+def test_lazy_file_context_manager(tmp_path):
+    path = tmp_path / "ctx.txt"
+    with click.utils._LazyFile(path, "w") as lf:
+        lf.write("x")
+    assert lf._f.closed
+    assert path.read_text() == "x"
+
+
+def test_keep_open_file_proxy(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("a\nb\n")
+    with open(path) as f:
+        kof = click.utils._KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+        assert kof.name == f.name
+        with kof as inner:
+            assert inner is kof
+            assert list(inner) == ["a\n", "b\n"]
+        assert not f.closed
+
