+def test_make_str():
+    assert click.utils.make_str("text") == "text"
+    assert click.utils.make_str(42) == "42"
+    assert click.utils.make_str(b"bytes") == "bytes"
+
+
+def test_make_str_undecodable_bytes(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert click.utils.make_str(b"caf\xc3\xa9") == "caf\xe9"
+    assert click.utils.make_str(b"caf\xff") == "caf�"
+
