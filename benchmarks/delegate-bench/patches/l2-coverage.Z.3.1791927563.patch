+def test_lazy_file_repr(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.open()
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.close_intelligently()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_open_is_cached(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+    f = lf.open()
+    assert lf.open() is f
+    lf.close()
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.ui_filename.endswith("out.txt")
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_stdout_not_closed(monkeypatch):
+    text_stdout = _replace_stdout(monkeypatch)
+    with click.utils._LazyFile("-", "w") as lf:
+        assert lf.should_close is False
+        assert lf._f is not None
+        lf.write("hello")
+        lf.flush()
+
+    assert not text_stdout.closed
+    assert text_stdout.buffer.getvalue() == b"hello"
+
+
+def test_keep_open_file(tmp_path):
+    path = tmp_path / "data.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kof = click.utils._KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+        with kof as entered:
+            assert entered is kof
+            assert list(kof) == ["a\n", "b\n"]
+        assert not f.closed
+        assert kof.name == f.name
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+    with f:
+        f.write("content")
+    assert path.read_text() == "content"
+
+
+def test_open_file_stdout_keep_open(monkeypatch):
+    text_stdout = _replace_stdout(monkeypatch)
+    f = click.utils.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+    with f:
+        f.write("x")
+    assert not text_stdout.closed
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "regular.txt"
+    path.write_text("abc")
+    with click.utils.open_file(path) as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        assert f.read() == "abc"
