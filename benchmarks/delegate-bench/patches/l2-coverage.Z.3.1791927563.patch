+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_binary_stream("bogus")
+
+
+def test_get_binary_stream_stdout(monkeypatch):
+    text_stdout = _replace_stdout(monkeypatch)
+    assert click.utils._get_binary_stream("stdout") is text_stdout.buffer
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+        click.utils._get_text_stream("bogus")
+
+
+def test_get_text_stream_stdout(monkeypatch):
+    text_stdout = _replace_stdout(monkeypatch)
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("hi")
+    stream.flush()
+    assert text_stdout.buffer.getvalue() == b"hi"
