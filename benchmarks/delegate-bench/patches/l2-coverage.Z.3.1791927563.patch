+def _replace_stdout(monkeypatch):
+    # Done in the test body: pytest's capture resets sys.stdout after setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [("Foo Bar", "foo-bar"), ("  Spaced\tOut  App ", "spaced-out-app"), ("x", "x")],
+)
+def test_posixify(name, expected):
+    assert click.utils._posixify(name) == expected
+
+
+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = click.utils._safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert click.utils._safecall(fail)() is None
+
