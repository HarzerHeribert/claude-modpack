+class _AnyWriter:
+    """Accepts any written data but is not detected as a binary writer."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if isinstance(value, bytes) and not value:
+            raise TypeError("not binary")
+        if value:
+            self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _AnyWriter()
+    click.utils.echo(b"raw", file=out)
+    assert out.data == [b"raw\n"]
+    assert out.flushed == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.utils.echo(bytearray(b"abc"), file=out, nl=False)
+    assert out.getvalue() == b"abc"
+
+
+def test_echo_object_and_empty():
+    out = io.StringIO()
+    click.utils.echo(123, file=out)
+    click.utils.echo(None, file=out, nl=False)
+    assert out.getvalue() == "123\n"
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.utils.echo("nothing")
+    click.utils.echo("nothing", err=True)
+
+
+def test_echo_strips_ansi_and_keeps_with_color():
+    out = io.StringIO()
+    styled = "\x1b[31mred\x1b[0m"
+    click.utils.echo(styled, file=out, nl=False)
+    assert out.getvalue() == "red"
+
+    out = io.StringIO()
+    click.utils.echo(styled, file=out, nl=False, color=True)
+    assert out.getvalue() == styled
+
