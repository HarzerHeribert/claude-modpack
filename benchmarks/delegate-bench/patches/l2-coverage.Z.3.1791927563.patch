+class _FlushRaises:
+    def __init__(self, err):
+        self.err = err
+        self.extra = "proxied"
+
+    def flush(self):
+        raise self.err
+
+
+def test_pacify_flush_wrapper_passes_through():
+    stream = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(stream)
+    wrapper.flush()
+    wrapper.write("text")
+    assert stream.getvalue() == "text"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+    assert wrapper.extra == "proxied"
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
