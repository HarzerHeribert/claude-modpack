+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _posixify
+from click.utils import _safecall
+from click.utils import make_str
+
+
+def test_posixify():
+    assert _posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    @_safecall
+    def add(a, b):
+        return a + b
+
+    assert add(1, b=2) == 3
+    assert add.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    @_safecall
+    def fail():
+        raise ValueError("boom")
+
+    assert fail() is None
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"bad \xff byte", "bad � byte"),
+        ("text", "text"),
+        (42, "42"),
+    ],
+)
+def test_make_str(value, expected):
+    assert make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches exactly max_length before the last word.
+        ("aaaa bbbb ccc", 9, "aaaa..."),
+        # First word alone is already too long.
+        ("aaaaaaaaaaaa bb", 5, "..."),
+        # Fits exactly with the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_dash_wraps_stream(capsys):
+    lf = _LazyFile("-", "w")
+    assert not lf.should_close
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf as f:
+        f.write("hello")
+
+    # The standard stream was not closed.
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_opens_on_attribute_access(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    lf.write("data")
+    # Opening twice returns the same file.
+    assert lf.open() is lf._f
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file():
+    f = io.StringIO("a\nb\n")
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+    assert list(kf) == ["a\n", "b\n"]
+
+    with kf as inner:
+        assert inner is kf
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_dash_keeps_open(capsys):
+    f = click.open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+
+    with f:
+        f.write("out")
+
+    assert capsys.readouterr().out == "out"
+
