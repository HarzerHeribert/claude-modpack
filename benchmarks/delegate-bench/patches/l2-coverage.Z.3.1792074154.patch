+def test_echo_bytes_without_binary_writer():
+    # StringIO has no binary buffer, so the bytes are written directly
+    # to the text stream, which rejects them.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytearray_to_binary():
+    out = io.BytesIO()
+    click.echo(bytearray(b"data"), file=out, nl=False)
+    assert out.getvalue() == b"data"
+
+
+def test_echo_empty_no_newline():
+    out = io.StringIO()
+    click.echo("", file=out, nl=False)
+    assert out.getvalue() == ""
+
+
+def test_echo_object():
+    out = io.StringIO()
+    click.echo(123, file=out)
+    assert out.getvalue() == "123\n"
+
+
+def test_echo_no_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.echo("nowhere")
+    click.echo("nowhere", err=True)
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_binary_stream(capsysbinary, name):
+    stream = _get_binary_stream(name)
+    stream.write(b"bin")
+    stream.flush()
+    captured = capsysbinary.readouterr()
+    assert getattr(captured, name[3:]) == b"bin"
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_binary_stream("bogus")
+
+
+@pytest.mark.parametrize("name", ["stdout", "stderr"])
+def test_get_text_stream(capsys, name):
+    stream = _get_text_stream(name)
+    stream.write("txt")
+    stream.flush()
+    captured = capsys.readouterr()
+    assert getattr(captured, name[3:]) == "txt"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        _get_text_stream("bogus")
+
