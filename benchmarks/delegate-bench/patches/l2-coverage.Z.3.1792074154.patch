+class _FlushStream:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.value = "proxied"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush():
+    stream = _FlushStream()
+    wrapper = _PacifyFlushWrapper(stream)
+    wrapper.flush()
+    assert stream.flushed
+    assert wrapper.value == "proxied"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapper = _PacifyFlushWrapper(
+        _FlushStream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_other_error():
+    wrapper = _PacifyFlushWrapper(_FlushStream(OSError(errno.EIO, "I/O error")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_detect_program_name_default_main(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    assert _detect_program_name("/path/example/cli.py") == "python -m example.cli"
+
+
+def test_detect_program_name_default_path(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setattr(sys, "argv", ["/usr/bin/myapp.py", "--flag"])
+    assert _detect_program_name(_main=main) == "myapp.py"
+
+
+def test_detect_program_name_package_main():
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    assert (
+        _detect_program_name("/path/example/__main__.py", _main=main)
+        == "python -m example"
+    )
+
+
+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    assert _expand_args(["~", "$CLICK_TEST_VAR"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST_VAR",
+    ]
+
+
+def test_expand_args_user_and_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    assert _expand_args(["~", "$CLICK_TEST_VAR"]) == [
+        os.path.expanduser("~"),
+        "value",
+    ]
+
+
+def test_expand_args_glob(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    result = _expand_args([str(tmp_path / "*.txt")])
+    assert sorted(result) == [str(tmp_path / "a.txt"), str(tmp_path / "b.txt")]
+
+
+def test_expand_args_invalid_glob(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "LazyFile",
+        "KeepOpenFile",
+        "make_default_short_help",
+        "PacifyFlushWrapper",
+        "safecall",
+        "get_text_stream",
+        "get_binary_stream",
+    ],
+)
+def test_deprecated_aliases(name):
+    with pytest.deprecated_call():
+        value = getattr(click.utils, name)
+
+    assert value is getattr(click.utils, f"_{name}")
+
+
+def test_unknown_attribute():
+    with pytest.raises(AttributeError):
+        click.utils.does_not_exist  # noqa: B018
