+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    result = click.utils._expand_args(
+        ["~/does-not-exist", "$CLICK_TEST-not-found"], user=False, env=False
+    )
