+def test_lazyfile_stdout(monkeypatch):
+    fake_stdout = _fake_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+
+    with lf:
+        lf.write("hello")
+
+    # Leaving the block does not close the borrowed stream.
+    assert not lf._f.closed
+    lf.flush()
+    assert fake_stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_and_open(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert lf._f is None
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    assert not path.exists()
+
+    # Closing an unopened file is a no-op.
+    lf.close()
+    assert lf._f is None
+
+    f = lf.open()
+    assert lf.open() is f
+    assert repr(lf) == repr(f)
+    lf.write("data")
+    lf.close_intelligently()
+    assert f.closed
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_read_missing_file(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazyfile_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.filename == lf.name
+
+
+def test_lazyfile_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+
+    with click.utils._LazyFile(path, "w", atomic=True) as lf:
+        lf.write("new")
+        assert path.read_text() == "old"
+
+    assert path.read_text() == "new"
+
+
+def test_keepopenfile(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("content")
+
+    with path.open() as f:
+        kf = click.utils._KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as entered:
+            assert entered is kf
+            assert kf.read() == "content"
+
+        assert not f.closed
+        kf.close()
+        assert f.closed
+
