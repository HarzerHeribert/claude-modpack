+def test_echo_bytes_to_text_only_stream():
+    # A text stream with no binary buffer can't receive bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"data", file=io.StringIO())
+
+
+def test_echo_bytes_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(b"data", file=out)
+    click.echo(bytearray(b"more"), file=out, nl=False)
+    assert out.getvalue() == b"data\nmore"
+
+
+def test_echo_object_and_none():
+    out = io.StringIO()
+    click.echo(42, file=out)
+    click.echo(file=out)
+    click.echo(None, file=out, nl=False)
+    assert out.getvalue() == "42\n\n"
+
+
+def test_echo_strip_and_keep_ansi():
+    out = io.StringIO()
+    click.echo("\033[31mred\033[0m", file=out)
+    click.echo("\033[31mred\033[0m", file=out, color=True)
+    assert out.getvalue() == "red\n\033[31mred\033[0m\n"
+
