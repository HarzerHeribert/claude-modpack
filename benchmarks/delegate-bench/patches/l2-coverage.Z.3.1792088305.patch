+def _fake_stdout(monkeypatch):
+    # Patched in the test body, pytest's capture replaces sys.stdout
+    # again after fixture setup.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_swallows_exceptions():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+def test_safecall_returns_value():
+    assert click.utils._safecall(lambda x: x * 2)(3) == 6
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"caf\xc3\xa9", "café"),
+        (b"bad\xff", "bad�"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly reaching the limit before the last word truncates.
+        ("aa bb cc", 5, "aa..."),
+        # Exactly reaching the limit on the last word does not truncate.
+        ("aa bb", 5, "aa bb"),
+        # The first word alone is too long.
+        ("abcdefghij more", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    result = click.utils._make_default_short_help(help, max_length)
+    assert result == expected
+
