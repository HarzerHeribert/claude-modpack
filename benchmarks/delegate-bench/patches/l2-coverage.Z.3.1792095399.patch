+import errno
+import io
+import os
+import re
+import sys
+
+import pytest
+
+import click
+from click.utils import _detect_program_name
+from click.utils import _expand_args
+from click.utils import _get_binary_stream
+from click.utils import _get_text_stream
+from click.utils import _KeepOpenFile
+from click.utils import _LazyFile
+from click.utils import _make_default_short_help
+from click.utils import _PacifyFlushWrapper
+from click.utils import _posixify
+from click.utils import _safecall
+from click.utils import make_str
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("Foo Bar", "foo-bar"),
+        ("  Foo   Bar\tBaz ", "foo-bar-baz"),
+        ("app", "app"),
+    ],
+)
+def test_posixify(value, expected):
+    assert _posixify(value) == expected
+
+
+def test_safecall_returns_value():
+    def add(a, b=0):
+        return a + b
+
+    wrapped = _safecall(add)
+    assert wrapped(1, b=2) == 3
+    assert wrapped.__name__ == "add"
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    assert _safecall(fail)() is None
+
+
+def test_make_str_str_and_object():
+    assert make_str("abc") == "abc"
+    assert make_str(42) == "42"
+
+
+def test_make_str_bytes():
+    assert make_str("ä".encode(sys.getfilesystemencoding())) == "ä"
+
+
+def test_make_str_bytes_invalid(monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "ascii")
+    assert make_str(b"a\xffb") == "a�b"
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Word ends exactly at the limit but more words follow.
+        ("ab cd ef", 5, "ab..."),
+        # The very first word is too long.
+        ("abcdefghij", 5, "..."),
+        # The first word fits exactly but more words follow.
+        ("abcde fgh", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edge_cases(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    lf.close()
+    assert not path.exists()
+
+
+def test_lazy_file_repr_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    with _LazyFile(path, "w") as lf:
+        lf.write("hello")
+        assert repr(lf) == repr(lf._f)
+
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_dash_does_not_close(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf._f is not None
+    assert lf.should_close is False
+
+    with lf:
+        lf.write("hello")
+        lf.flush()
+
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_open_error(tmp_path):
+    path = tmp_path / "missing" / "out.txt"
+    lf = _LazyFile(path, "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_exit():
+    f = io.StringIO("a\nb\n")
+    kf = _KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+    with kf as entered:
+        assert entered is kf
+        assert list(kf) == ["a\n", "b\n"]
+
+    assert not f.closed
+    kf.close()
+    assert f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("hello")
+
+    assert path.read_text() == "hello"
+
+
+def test_open_file_dash_keeps_open(capsys):
+    f = click.open_file("-", "w")
+    assert isinstance(f, _KeepOpenFile)
+
+    with f:
+        f.write("hello")
+        f.flush()
+
+    assert not f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_echo_bytes_to_text_only_stream():
+    # A text stream without a binary buffer cannot accept bytes.
+    with pytest.raises(TypeError):
+        click.echo(b"hello", file=io.StringIO())
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream(capsys):
+    stream = _get_text_stream("stdout")
+    stream.write("hello")
+    stream.flush()
+    assert capsys.readouterr().out == "hello"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+@pytest.mark.parametrize(
+    ("roaming", "key"), [(True, "APPDATA"), (False, "LOCALAPPDATA")]
+)
+def test_get_app_dir_windows(monkeypatch, tmp_path, roaming, key):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv(key, str(tmp_path))
+    result = click.get_app_dir("Foo Bar", roaming=roaming)
+    assert result == os.path.join(str(tmp_path), "Foo Bar")
+
+
+def test_get_app_dir_windows_no_env(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    result = click.get_app_dir("Foo Bar")
+    assert result == os.path.join(os.path.expanduser("~"), "Foo Bar")
+
+
+def test_get_app_dir_force_posix(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    result = click.get_app_dir("Foo Bar", force_posix=True)
+    assert result == os.path.expanduser("~/.foo-bar")
+
+
+def test_get_app_dir_darwin(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "darwin")
+    result = click.get_app_dir("Foo Bar")
+    assert result == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_get_app_dir_xdg(monkeypatch, tmp_path):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path))
+    result = click.get_app_dir("Foo Bar")
+    assert result == os.path.join(str(tmp_path), "foo-bar")
+
+
+def test_get_app_dir_xdg_default(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", False)
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    result = click.get_app_dir("Foo Bar")
+    assert result == os.path.join(os.path.expanduser("~/.config"), "foo-bar")
+
+
+class _FlushRaises:
+    def __init__(self, error):
+        self.error = error
+        self.value = "proxied"
+
+    def flush(self):
+        raise self.error
+
+
+def test_pacify_flush_wrapper_proxies_and_flushes():
+    f = io.StringIO()
+    wrapper = _PacifyFlushWrapper(f)
+    assert wrapper.wrapped is f
+    wrapper.write("hello")
+    wrapper.flush()
+    assert f.getvalue() == "hello"
+
+
+def test_pacify_flush_wrapper_ignores_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "broken")))
+    wrapper.flush()
+    assert wrapper.value == "proxied"
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "io")))
+
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+class _MockMain:
+    __slots__ = "__package__"
+
+    def __init__(self, package_name):
+        self.__package__ = package_name
+
+
+def test_detect_program_name_defaults(monkeypatch):
+    monkeypatch.setitem(sys.modules, "__main__", _MockMain(None))
+    monkeypatch.setattr(sys, "argv", [os.path.join("foo", "prog.py")])
+    assert _detect_program_name() == "prog.py"
+
+
+def test_detect_program_name_module_from_argv(monkeypatch):
+    monkeypatch.setattr(sys, "argv", [os.path.join("example", "cli.py")])
+    assert _detect_program_name("", _main=_MockMain("example")) == (
+        "python -m example.cli"
+    )
+
+
+def test_expand_args_no_user_no_env(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("CLICK_TEST", "hello")
+    assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+        "~",
+        "$CLICK_TEST",
+    ]
+
+
+def test_expand_args_non_recursive(monkeypatch, tmp_path):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "b.txt").write_text("")
+    (tmp_path / "c.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    assert _expand_args(["**/*.txt"], glob_recursive=False) == [
+        os.path.join("a", "b.txt")
+    ]
+    assert sorted(_expand_args(["**/*.txt"])) == sorted(
+        ["c.txt", os.path.join("a", "b.txt")]
+    )
+
+
+def test_expand_args_glob_re_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr("glob.glob", bad_glob)
+    assert _expand_args(["[bad"]) == ["[bad"]
