+def test_echo_strips_ansi_unless_color():
+    out = io.StringIO()
+    styled = click.style("x", fg="red")
+    click.echo(styled, file=out, nl=False)
+    assert out.getvalue() == "x"
+
+    out = io.StringIO()
+    click.echo(styled, file=out, nl=False, color=True)
+    assert out.getvalue() == styled
