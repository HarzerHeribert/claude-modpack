+def test_lazyfile_write_is_lazy(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert lf.name == str(path)
+    assert lf.mode == "w"
+    assert lf.should_close is True
+    assert not path.exists()
+    assert repr(lf) == f"<unopened file '{path}' w>"
+
+    lf.write("hello")
+    assert path.exists()
+    assert repr(lf) == repr(lf._f)
+    assert lf.open() is lf._f
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    path = tmp_path / "never.txt"
+    lf = click.utils._LazyFile(path, "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not path.exists()
+
+
+def test_lazyfile_context_manager_closes(tmp_path):
+    path = tmp_path / "ctx.txt"
+    with click.utils._LazyFile(path, "w", encoding="utf-8") as lf:
+        lf.write("data")
+        f = lf._f
+    assert f.closed
+    assert path.read_text(encoding="utf-8") == "data"
+
+
+def test_lazyfile_read_missing_raises_early(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
