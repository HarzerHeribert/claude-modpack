+def test_echo_bytes_without_binary_writer():
+    class TextOnly:
+        def __init__(self):
+            self.data = []
+
+        def write(self, value):
+            if value == b"":
+                raise TypeError("text only")
+            self.data.append(value)
+
+        def flush(self):
+            pass
+
+    out = TextOnly()
+    click.echo(b"bytes", file=out)
+    # The binary writer probe writes an empty text string first.
+    assert [d for d in out.data if d] == [b"bytes\n"]
+
+
+def test_echo_bytes_to_stringio_fails():
