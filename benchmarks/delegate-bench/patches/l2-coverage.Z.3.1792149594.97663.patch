+class _FlushRaises:
+    def __init__(self, exc):
+        self.exc = exc
+        self.name = "wrapped-stream"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush_ok():
+    wrapper = click.utils._PacifyFlushWrapper(_FlushRaises(None))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_suppresses_epipe():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    )
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    wrapper = click.utils._PacifyFlushWrapper(
+        _FlushRaises(OSError(errno.EIO, "I/O error"))
+    )
+    with pytest.raises(OSError) as exc_info:
+        wrapper.flush()
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_proxies_attributes():
+    buf = io.StringIO()
+    wrapper = click.utils._PacifyFlushWrapper(buf)
+    assert wrapper.wrapped is buf
+    wrapper.write("proxied")
+    assert wrapper.getvalue() == "proxied"
+
