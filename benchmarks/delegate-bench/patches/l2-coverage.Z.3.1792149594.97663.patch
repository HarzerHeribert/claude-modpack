+def test_keepopenfile_proxies_and_stays_open():
+    buf = io.StringIO()
+    f = click.utils._KeepOpenFile(buf)
+    assert repr(f) == repr(buf)
+
+    with f as entered:
+        assert entered is f
+        f.write("text")
+
+    assert not buf.closed
+    assert buf.getvalue() == "text"
+    f.close()
+    assert buf.closed
+
