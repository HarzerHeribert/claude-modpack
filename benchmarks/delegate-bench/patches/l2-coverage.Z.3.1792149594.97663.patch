+
+def test_lazyfile_open_error_raises_file_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "no-dir" / "f.txt", "w")
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_lazyfile_atomic(tmp_path):
+    path = tmp_path / "atomic.txt"
+    path.write_text("old")
+    with click.utils._LazyFile(path, "w", atomic=True) as lf:
+        lf.write("new")
+        assert path.read_text() == "old"
+    assert path.read_text() == "new"
+
