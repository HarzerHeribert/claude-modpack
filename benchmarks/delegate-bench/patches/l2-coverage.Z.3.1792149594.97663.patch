+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    stdout = _utf8_stdout()
+    monkeypatch.setattr(sys, "stdout", stdout)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+
+    with lf:
+        lf.write("hi")
+        lf.flush()
+
+    # The standard stream is not closed when leaving the block.
+    assert not lf._f.closed
+    assert not stdout.closed
+    assert stdout.buffer.getvalue() == b"hi"
+
+
+def test_lazyfile_dash_binary_uses_stdout_buffer(monkeypatch):
+    stdout = _utf8_stdout()
+    monkeypatch.setattr(sys, "stdout", stdout)
+    lf = click.utils._LazyFile("-", "wb")
+    lf.close_intelligently()
+    lf.write(b"raw")
+    assert stdout.buffer.getvalue() == b"raw"
+
