+def test_expand_args_matches(tmp_path):
+    (tmp_path / "a.txt").touch()
+    (tmp_path / "b.txt").touch()
+    out = click.utils._expand_args([os.path.join(str(tmp_path), "*.txt")])
+    assert sorted(out) == [
+        os.path.join(str(tmp_path), "a.txt"),
+        os.path.join(str(tmp_path), "b.txt"),
+    ]
+
