+class _NoEmptyWrites:
+    """Neither a binary nor a text writer according to Click's probing,
+    since it rejects the empty probe writes, but accepts real data.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _NoEmptyWrites()
+    click.echo(b"hello", file=f)
+    assert f.written == [b"hello\n"]
+    assert f.flushes == 1
+
