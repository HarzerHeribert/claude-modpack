+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        self.flushed = True
+
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_passthrough():
+    wrapped = _FlushRaises()
+    w = click.utils._PacifyFlushWrapper(wrapped)
+    w.flush()
+    assert wrapped.flushed
+    assert w.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_broken_pipe():
+    wrapped = _FlushRaises(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+    click.utils._PacifyFlushWrapper(wrapped).flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_other_oserror():
+    wrapped = _FlushRaises(OSError(errno.EIO, "I/O error"))
+
+    with pytest.raises(OSError) as exc_info:
+        click.utils._PacifyFlushWrapper(wrapped).flush()
+
+    assert exc_info.value.errno == errno.EIO
+
