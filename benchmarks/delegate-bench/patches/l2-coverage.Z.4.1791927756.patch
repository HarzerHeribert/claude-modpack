+def test_detect_program_name_defaults(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = None
+    monkeypatch.setitem(sys.modules, "__main__", main)
+    monkeypatch.setattr(sys, "argv", ["/path/to/app.py", "--flag"])
+    assert click.utils._detect_program_name() == "app.py"
+
+
+def test_detect_program_name_module_default_path(monkeypatch):
+    main = types.ModuleType("__main__")
+    main.__package__ = "example"
+    monkeypatch.setattr(sys, "argv", ["/path/to/example/cli.py"])
+    assert click.utils._detect_program_name(_main=main) == "python -m example.cli"
+
