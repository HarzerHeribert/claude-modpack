+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is already too long.
+        ("a" * 50, 45, "..."),
+        # Fits exactly on the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+        # Only the first paragraph is considered.
+        ("First line.\n\nSecond paragraph.", 45, "First line."),
+        # A leading no-rewrap marker is skipped.
+        ("\b\nsome words here", 45, "some words here"),
+        ("   \n\t ", 45, ""),
+    ],
+)
+def test_make_default_short_help(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
