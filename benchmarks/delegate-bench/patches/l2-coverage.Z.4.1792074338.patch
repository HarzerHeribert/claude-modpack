+class TestPacifyFlushWrapper:
+    class _Stream:
+        def __init__(self, error=None):
+            self.error = error
+            self.flushed = False
+            self.name = "stream"
+
+        def flush(self):
+            if self.error is not None:
+                raise self.error
+
+            self.flushed = True
+
+    def test_flush(self):
+        stream = self._Stream()
+        _PacifyFlushWrapper(stream).flush()
+        assert stream.flushed
+
+    def test_flush_broken_pipe_suppressed(self):
+        stream = self._Stream(BrokenPipeError(errno.EPIPE, "Broken pipe"))
+        _PacifyFlushWrapper(stream).flush()
+
+    def test_flush_other_error_raised(self):
+        stream = self._Stream(OSError(errno.EIO, "I/O error"))
+
+        with pytest.raises(OSError) as exc_info:
+            _PacifyFlushWrapper(stream).flush()
+
+        assert exc_info.value.errno == errno.EIO
+
+    def test_getattr_proxied(self):
+        stream = self._Stream()
+        assert _PacifyFlushWrapper(stream).name == "stream"
+
