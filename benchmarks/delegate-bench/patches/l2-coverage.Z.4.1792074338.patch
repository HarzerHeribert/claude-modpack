+class TestGetStreams:
+    @pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+    def test_binary_stream(self, fake_stdio, name):
+        streams = fake_stdio()
+        assert _get_binary_stream(name) is streams[name].buffer
