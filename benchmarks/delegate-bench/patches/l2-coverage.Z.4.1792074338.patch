+@pytest.fixture
+def fake_stdio(monkeypatch):
+    """Return a function that replaces the standard streams with in-memory
+    binary-backed text streams. This must be called from the test body, since
+    pytest's output capturing resets the streams after fixture setup.
+    """
+
+    def install():
+        streams = {}
+
+        for name in ("stdin", "stdout", "stderr"):
+            stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+            monkeypatch.setattr(sys, name, stream)
+            streams[name] = stream
+
+        return streams
+
+    return install
+
