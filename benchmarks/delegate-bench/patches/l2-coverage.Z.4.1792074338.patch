+class TestLazyFile:
+    def test_repr_unopened(self, tmp_path):
+        path = tmp_path / "out.txt"
+        lf = _LazyFile(path, "w")
+        assert repr(lf) == f"<unopened file '{path}' w>"
+        assert not path.exists()
+
+    def test_repr_opened(self, tmp_path):
+        path = tmp_path / "out.txt"
+
+        with _LazyFile(path, "w") as lf:
+            f = lf.open()
+            assert lf.open() is f
+            assert repr(lf) == repr(f)
+            lf.write("hello")
+
+        assert f.closed
+        assert path.read_text() == "hello"
+
+    def test_close_unopened_is_noop(self, tmp_path):
+        lf = _LazyFile(tmp_path / "out.txt", "w")
+        lf.close()
+        lf.close_intelligently()
+        assert not (tmp_path / "out.txt").exists()
+
+    def test_read_mode_checks_early(self, tmp_path):
+        with pytest.raises(OSError):
+            _LazyFile(tmp_path / "missing.txt", "r")
+
+    def test_open_error_raises_file_error(self, tmp_path):
+        lf = _LazyFile(tmp_path / "missing-dir" / "out.txt", "w")
+
+        with pytest.raises(FileError) as exc_info:
+            lf.open()
+
+        assert exc_info.value.ui_filename.endswith("out.txt")
+
+    def test_getattr_opens_file(self, tmp_path):
+        path = tmp_path / "data.txt"
+        path.write_text("line1\nline2\n")
+        lf = _LazyFile(path)
+
+        try:
+            assert lf.readline() == "line1\n"
+            assert lf._f is not None
+        finally:
+            lf.close()
+
+    def test_atomic_write(self, tmp_path):
+        path = tmp_path / "atomic.txt"
+        path.write_text("old")
+
+        with _LazyFile(path, "w", atomic=True) as lf:
+            lf.write("new")
+            assert path.read_text() == "old"
+
+        assert path.read_text() == "new"
+
+    def test_stdout(self, fake_stdio):
+        streams = fake_stdio()
+        lf = _LazyFile("-", "w")
+        assert lf._f is not None
+        assert lf.should_close is False
+        assert repr(lf) == repr(lf._f)
+
+        with lf:
+            lf.write("hello")
+
+        # The standard stream is not closed when leaving the block.
+        assert not streams["stdout"].closed
+        streams["stdout"].flush()
+        assert streams["stdout"].buffer.getvalue() == b"hello"
+
