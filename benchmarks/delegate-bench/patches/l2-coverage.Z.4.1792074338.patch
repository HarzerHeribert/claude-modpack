+    def test_binary_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+            _get_binary_stream("bogus")
+
+    @pytest.mark.parametrize("name", ["stdin", "stdout", "stderr"])
+    def test_text_stream(self, fake_stdio, name):
+        streams = fake_stdio()
+        assert _get_text_stream(name) is streams[name]
+
+    def test_text_stream_unknown(self):
+        with pytest.raises(TypeError, match="Unknown standard stream 'bogus'"):
+            _get_text_stream("bogus")
+
+    @pytest.mark.parametrize("name", ["get_binary_stream", "get_text_stream"])
+    def test_deprecated_aliases(self, name):
+        with pytest.warns(DeprecationWarning, match=name):
+            func = getattr(click.utils, name)
+
+        assert func is getattr(click.utils, f"_{name}")
