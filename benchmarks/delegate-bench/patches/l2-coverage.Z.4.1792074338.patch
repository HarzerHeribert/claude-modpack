+class TestKeepOpenFile:
+    def test_repr_and_proxy(self):
+        inner = io.StringIO("data")
+        f = _KeepOpenFile(inner)
+        assert repr(f) == repr(inner)
+        assert f.read() == "data"
+
+    def test_context_manager_keeps_open(self):
+        inner = io.StringIO()
+
+        with _KeepOpenFile(inner) as f:
+            f.write("x")
+
+        assert not inner.closed
+        assert inner.getvalue() == "x"
+
+        f.close()
+        assert inner.closed
+
