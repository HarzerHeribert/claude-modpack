+class TestEcho:
+    def test_bytes_to_text_only_stream(self):
+        # A stream without a binary buffer can't receive bytes.
+        with pytest.raises(TypeError):
+            click.echo(b"data", file=io.StringIO())
+
+    def test_bytes_to_binary_stream(self):
+        out = io.BytesIO()
+        click.echo(bytearray(b"data"), file=out)
+        assert out.getvalue() == b"data\n"
+
+    def test_empty_no_newline_flushes(self):
+        out = io.StringIO()
+        click.echo("", file=out, nl=False)
+        click.echo(None, file=out, nl=False)
+        assert out.getvalue() == ""
+
+    def test_object_converted_to_str(self):
+        out = io.StringIO()
+        click.echo(123, file=out)
+        assert out.getvalue() == "123\n"
+
+    def test_strip_ansi_for_non_tty(self):
+        out = io.StringIO()
+        click.echo(click.style("hi", fg="red"), file=out)
+        assert out.getvalue() == "hi\n"
+
+    def test_keep_ansi_with_color(self):
+        out = io.StringIO()
+        styled = click.style("hi", fg="red")
+        click.echo(styled, file=out, color=True)
+        assert out.getvalue() == f"{styled}\n"
+
+    def test_default_streams(self, fake_stdio):
+        streams = fake_stdio()
+        click.echo("out")
+        click.echo("err", err=True)
+        assert streams["stdout"].buffer.getvalue() == b"out\n"
+        assert streams["stderr"].buffer.getvalue() == b"err\n"
+
+    def test_no_stream(self, monkeypatch):
+        monkeypatch.setattr(sys, "stdout", None)
+        monkeypatch.setattr(sys, "stderr", None)
+        click.echo("nothing")
+        click.echo("nothing", err=True)
+
