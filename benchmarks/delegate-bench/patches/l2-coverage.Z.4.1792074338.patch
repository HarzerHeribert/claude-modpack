+class TestExpandArgs:
+    def test_no_user_no_env(self, monkeypatch):
+        monkeypatch.setenv("CLICK_TEST", "hello")
+        assert _expand_args(["~", "$CLICK_TEST"], user=False, env=False) == [
+            "~",
+            "$CLICK_TEST",
+        ]
+
+    def test_glob_regex_error(self, monkeypatch):
+        def bad_glob(pattern, recursive=False):
+            raise re.error("bad pattern")
+
+        monkeypatch.setattr(glob, "glob", bad_glob)
+        assert _expand_args(["[bad"]) == ["[bad"]
+
+    def test_glob_non_recursive(self, tmp_path, monkeypatch):
+        (tmp_path / "sub").mkdir()
+        (tmp_path / "sub" / "a.txt").touch()
+        (tmp_path / "b.txt").touch()
+        monkeypatch.chdir(tmp_path)
+        assert sorted(_expand_args(["**/*.txt"], glob_recursive=False)) == [
+            os.path.join("sub", "a.txt")
+        ]
+        assert sorted(_expand_args(["**/*.txt"])) == [
+            "b.txt",
+            os.path.join("sub", "a.txt"),
+        ]
+
