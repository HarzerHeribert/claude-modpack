+class _RecordingWriter:
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer(monkeypatch):
+    monkeypatch.setattr(click.utils, "_find_binary_writer", lambda f: None)
+    out = _RecordingWriter()
+    click.echo(b"raw", file=out)
+    assert out.written == [b"raw\n"]
+    assert out.flushes == 1
+
+
+def test_echo_bytearray_to_binary_file():
+    out = io.BytesIO()
+    click.echo(bytearray(b"abc"), file=out)
+    assert out.getvalue() == b"abc\n"
+
+
+def test_echo_empty_no_newline_only_flushes():
+    out = _RecordingWriter()
+    click.echo("", file=out, nl=False)
+    assert out.written == []
+    assert out.flushes == 1
+
+
+def test_echo_object_strips_ansi():
+    out = io.StringIO()
+    click.echo(click.style("hi", fg="red"), file=out, color=False)
+    click.echo(123, file=out)
+    assert out.getvalue() == "hi\n123\n"
+
+
+def test_echo_no_default_stream(monkeypatch):
+    monkeypatch.setattr(click.utils, "_default_text_stdout", lambda: None)
+    monkeypatch.setattr(click.utils, "_default_text_stderr", lambda: None)
+    click.echo("nowhere")
+    click.echo("nowhere", err=True)
