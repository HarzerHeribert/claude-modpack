+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{os.fspath(path)}' w>"
+    lf.write("hello")
+    assert repr(lf) == repr(lf._f)
+    lf.close()
+    assert path.read_text() == "hello"
+
+
+def test_lazy_file_open_returns_cached(tmp_path):
+    path = tmp_path / "out.txt"
+    with click.utils._LazyFile(path, "w") as lf:
+        f = lf.open()
+        assert lf.open() is f
+    assert f.closed
+
+
+def test_lazy_file_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(FileError) as exc_info:
+        lf.open()
+
+    assert exc_info.value.filename == os.fspath(tmp_path / "missing" / "out.txt")
+
+
+def test_lazy_file_read_missing_raises_early(tmp_path):
+    with pytest.raises(OSError):
+        click.utils._LazyFile(tmp_path / "missing.txt", "r")
+
+
+def test_lazy_file_dash_does_not_close_stdout(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    with click.utils._LazyFile("-", "w") as lf:
+        assert lf._f is not None
+        assert lf.should_close is False
+        lf.write("hi")
+        lf.flush()
+
+    assert not lf._f.closed
+    assert fake_stdout.getvalue() == b"hi"
+
+
+def test_keep_open_file_repr_and_exit(tmp_path):
+    with open(tmp_path / "f.txt", "w") as f:
+        kof = click.utils._KeepOpenFile(f)
+        assert repr(kof) == repr(f)
+
+        with kof as inner:
+            assert inner is kof
+            inner.write("data")
+
+        assert not f.closed
+        assert kof.name == f.name
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.utils.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+    f.write("x")
+    f.close()
+    assert path.read_text() == "x"
+
+
+def test_open_file_dash_keeps_open(monkeypatch):
+    fake_stdout = _patch_stdout(monkeypatch)
+    f = click.utils.open_file("-", "w")
+    assert isinstance(f, click.utils._KeepOpenFile)
+
+    with f:
+        f.write("out")
+        f.flush()
+
+    assert fake_stdout.getvalue() == b"out"
+
+
+def test_open_file_regular(tmp_path):
+    path = tmp_path / "plain.txt"
+
+    with click.utils.open_file(path, "w") as f:
+        assert not isinstance(f, click.utils._KeepOpenFile)
+        f.write("plain")
+
+    assert path.read_text() == "plain"
+
