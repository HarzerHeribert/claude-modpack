+class _NoCloseBytesIO(io.BytesIO):
+    """Click wraps the stream in temporary text wrappers which close the
+    underlying buffer when collected. Keep it readable for assertions.
+    """
+
+    def close(self):
+        pass
+
+
+def _patch_stdout(monkeypatch):
+    # Must be called in the test body: pytest's capture replaces sys.stdout
+    # again between fixture setup and the test call.
+    buffer = _NoCloseBytesIO()
+    stream = io.TextIOWrapper(buffer, encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return buffer
+
+
+def test_posixify():
+    assert click.utils._posixify("Foo  Bar\tBaz") == "foo-bar-baz"
+
+
+def test_safecall_returns_value():
+    wrapped = click.utils._safecall(lambda a, b=1: a + b)
+    assert wrapped(1, b=2) == 3
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        """Docstring."""
+        raise ValueError("boom")
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+    assert wrapped.__doc__ == "Docstring."
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"caf\xc3\xa9", "café"),
+        (b"\xff\xfe", "��"),
+        ("text", "text"),
+        (42, "42"),
+        (None, "None"),
+    ],
+)
+def test_make_str(value, expected, monkeypatch):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word.
+        ("aaaa bbbb cccc", 9, "aaaa..."),
+        # The first word alone is too long.
+        ("abcdefghijklmnop", 5, "..."),
+        # Exactly max_length on the last word, no truncation.
+        ("aaaa bbbb", 9, "aaaa bbbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
