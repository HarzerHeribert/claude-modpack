+def test_expand_args_no_user_no_env(monkeypatch):
+    monkeypatch.setenv("CLICK_TEST_VAR", "value")
+    result = click.utils._expand_args(
+        ["~/nothing-here", "$CLICK_TEST_VAR"], user=False, env=False
+    )
+    assert result == ["~/nothing-here", "$CLICK_TEST_VAR"]
+
+
+def test_expand_args_glob_error(monkeypatch):
+    def bad_glob(pattern, recursive=False):
+        raise re.error("bad pattern")
+
+    monkeypatch.setattr(glob, "glob", bad_glob)
+    assert click.utils._expand_args(["[bad"]) == ["[bad"]
+
+
+def test_expand_args_non_recursive(tmp_path, monkeypatch):
+    (tmp_path / "a").mkdir()
+    (tmp_path / "a" / "x.txt").write_text("")
+    (tmp_path / "y.txt").write_text("")
+    monkeypatch.chdir(tmp_path)
+    recursive = click.utils._expand_args(["**/*.txt"])
+    flat = click.utils._expand_args(["**/*.txt"], glob_recursive=False)
+    assert sorted(recursive) == sorted([os.path.join("a", "x.txt"), "y.txt"])
+    assert flat == [os.path.join("a", "x.txt")]
+
+
