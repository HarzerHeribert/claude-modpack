+def test_lazy_file_stdout(capsys):
+    lf = _LazyFile("-", "w")
+    assert lf.should_close is False
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.flush()
+    # Closing intelligently must not close the borrowed stream.
+    with lf:
+        pass
+    assert not lf._f.closed
+    assert capsys.readouterr().out == "hello"
+
+
+def test_lazy_file_repr_unopened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{path}' w>"
+    assert not path.exists()
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazy_file_close_unopened(tmp_path):
+    lf = _LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    assert lf._f is None
+
+
+def test_lazy_file_open_error(tmp_path):
+    lf = _LazyFile(tmp_path / "missing" / "file.txt", "w")
+    with pytest.raises(FileError):
+        lf.open()
+
+
+def test_keep_open_file_repr_and_iter(tmp_path):
+    path = tmp_path / "f.txt"
+    path.write_text("a\nb\n")
+
+    with open(path) as f:
+        kf = _KeepOpenFile(f)
+        assert repr(kf) == repr(f)
+
+        with kf as inner:
+            assert inner is kf
+            assert list(kf) == ["a\n", "b\n"]
+
+        assert not kf.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
+
+def test_open_file_stdout_keep_open(capsys):
+    with open_file("-", "w") as f:
+        assert isinstance(f, _KeepOpenFile)
+        f.write("out")
+        f.flush()
+
+    assert not f.closed
+    assert capsys.readouterr().out == "out"
