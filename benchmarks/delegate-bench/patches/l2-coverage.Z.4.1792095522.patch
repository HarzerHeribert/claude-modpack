+class _NoEmptyWriter:
+    """Accepts any non-empty write but rejects empty probes, so it is
+    detected as neither a binary nor a text writer.
+    """
+
+    def __init__(self):
+        self.written = []
+        self.flushes = 0
+
+    def write(self, data):
+        if not data:
+            raise ValueError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        self.flushes += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _NoEmptyWriter()
+    click.utils.echo(b"data", file=f)
+    assert f.written == [b"data\n"]
+    assert f.flushes == 1
+
+
+def test_echo_no_message_flushes_only():
+    f = _NoEmptyWriter()
+    click.utils.echo(file=f, nl=False)
+    assert f.written == []
+    assert f.flushes == 1
+
