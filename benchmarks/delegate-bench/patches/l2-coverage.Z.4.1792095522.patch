+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # The exact limit is reached before the last word.
+        ("aaa bbb ccc", 7, "aaa..."),
+        # The first word is already too long, nothing can be kept.
+        ("abcdefghij", 5, "..."),
+        # The exact limit is reached on the last word, no truncation.
+        ("aaa bbb", 7, "aaa bbb"),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
