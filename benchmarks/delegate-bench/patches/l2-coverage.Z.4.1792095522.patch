+def test_get_app_dir_windows_roaming(monkeypatch):
+    monkeypatch.setattr(click.utils, "WIN", True)
+    monkeypatch.setenv("APPDATA", os.path.join("roaming", "dir"))
+    assert get_app_dir("Foo Bar") == os.path.join("roaming", "dir", "Foo Bar")
