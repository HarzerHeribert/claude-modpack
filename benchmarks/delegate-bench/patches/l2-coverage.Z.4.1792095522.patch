+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.name = "wrapped"
+
+    def flush(self):
+        if self.exc is not None:
+            raise self.exc
+
+        self.flushed = True
+
+
+def test_pacify_flush_wrapper_flush_and_proxy():
+    inner = _FlushRaises()
+    wrapper = _PacifyFlushWrapper(inner)
+    assert wrapper.wrapped is inner
+    wrapper.flush()
+    assert inner.flushed
+    assert wrapper.name == "wrapped"
+
+
+def test_pacify_flush_wrapper_swallows_broken_pipe():
+    wrapper = _PacifyFlushWrapper(_FlushRaises(BrokenPipeError(errno.EPIPE, "pipe")))
+    wrapper.flush()
+
+
+def test_pacify_flush_wrapper_reraises_other_errors():
+    exc = OSError(errno.EIO, "io error")
+    wrapper = _PacifyFlushWrapper(_FlushRaises(exc))
+
+    with pytest.raises(OSError) as info:
+        wrapper.flush()
+
+    assert info.value is exc
+
