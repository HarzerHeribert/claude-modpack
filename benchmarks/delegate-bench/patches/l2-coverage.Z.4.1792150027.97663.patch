+def test_lazy_file_dash_does_not_close(monkeypatch):
+    stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+
+    with lf:
+        lf.write("hello")
+
+    # close_intelligently must leave a borrowed stream open.
+    assert not stdout.closed
+    assert not lf._f.closed
+    lf._f.flush()
+    assert stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazy_file_close_when_unopened(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "never.txt", "w")
+    lf.close()
+    lf.close_intelligently()
+    assert not (tmp_path / "never.txt").exists()
+
+
+def test_keep_open_file_repr_and_proxy():
+    raw = io.StringIO("a\nb\n")
+    f = click.utils._KeepOpenFile(raw)
+    assert repr(f) == repr(raw)
+    assert f.readline() == "a\n"
+
+    with f as inner:
+        assert inner is f
+
+    assert not raw.closed
+    assert list(f) == ["b\n"]
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
