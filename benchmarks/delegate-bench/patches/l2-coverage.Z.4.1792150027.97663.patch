+class _NonBinaryNonTextWriter:
+    """Rejects empty writes so it is detected as neither binary nor text."""
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _NonBinaryNonTextWriter()
+    click.echo(b"hello", file=out)
+    assert out.data == [b"hello\n"]
+    assert out.flushed == 1
+
+
+def test_echo_bytearray_to_binary_stream():
+    out = io.BytesIO()
+    click.echo(bytearray(b"hi"), file=out, nl=False)
+    assert out.getvalue() == b"hi"
+
+
+def test_echo_empty_only_flushes():
+    out = _NonBinaryNonTextWriter()
+    click.echo("", file=out, nl=False)
+    assert out.data == []
+    assert out.flushed == 1
+
