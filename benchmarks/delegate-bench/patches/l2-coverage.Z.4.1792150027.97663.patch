+def test_open_file_dash_wraps_stream(monkeypatch):
+    stdout = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stdout)
+
+    with click.open_file("-", "w") as f:
+        assert isinstance(f, click.utils._KeepOpenFile)
+        f.write("x")
+        f.flush()
+
+    assert stdout.buffer.getvalue() == b"x"
