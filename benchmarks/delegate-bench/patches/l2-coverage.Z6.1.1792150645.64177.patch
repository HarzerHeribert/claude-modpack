+def test_lazy_file_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = _LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(str(path))}' w>"
+    f = lf.open()
+    assert repr(lf) == repr(f)
+    lf.close()
+    assert f.closed
+
+
+def test_lazy_file_dash_does_not_close(runner):
+    with runner.isolation(input="hello\n"):
+        lf = _LazyFile("-", "r")
+        assert lf._f is not None
+        assert not lf.should_close
+        assert repr(lf) == repr(lf._f)
+
+        with lf as f:
+            assert f.read() == "hello\n"
+
+        assert not lf._f.closed
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, _LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("data")
+
+    assert path.read_text() == "data"
+
+
+def test_keep_open_file_repr():
+    inner = io.StringIO()
+    assert repr(_KeepOpenFile(inner)) == repr(inner)
+
