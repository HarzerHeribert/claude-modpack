+class _TextOnlyAcceptsNonEmptyBytes:
+    """A stream that is not detected as binary (rejects ``b""``) and has
+    no ``buffer``, but still records whatever is written to it.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if value == b"":
+            raise TypeError("empty bytes")
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    stream = _TextOnlyAcceptsNonEmptyBytes()
+    click.echo(b"raw", file=stream)  # type: ignore[arg-type]
+    assert stream.data == ["", b"raw\n"]
+    assert stream.flushed == 1
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")  # type: ignore[arg-type]
+
+
+def test_get_text_stream_passes_arguments(monkeypatch):
+    calls = []
+
+    def opener(encoding, errors):
+        calls.append((encoding, errors))
+        return "stream"
+
+    monkeypatch.setitem(click.utils.text_streams, "stdout", opener)
+    assert _get_text_stream("stdout", encoding="latin-1", errors="replace") == (
+        "stream"
+    )
+    assert calls == [("latin-1", "replace")]
+
+
+def test_get_text_stream_real(runner):
+    with runner.isolation() as (out, _, _):
+        stream = _get_text_stream("stdout")
+        stream.write("hi")
+        stream.flush()
+        assert out.getvalue() == b"hi"
+
