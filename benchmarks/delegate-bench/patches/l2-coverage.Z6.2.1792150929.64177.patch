+import errno
+import glob
+import io
+import os
+import re
+import sys
+import types
+
+import pytest
+
+import click
+import click.utils
+
+
+def test_safecall_returns_value():
+    wrapped = click.utils._safecall(lambda x: x * 2)
+    assert wrapped(3) == 6
+
+
+def test_safecall_swallows_exception():
+    def fail():
+        raise ValueError("boom")
+
+    wrapped = click.utils._safecall(fail)
+    assert wrapped() is None
+    assert wrapped.__name__ == "fail"
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (b"hello", "hello"),
+        (b"\xff", "�"),
+        (42, "42"),
+        ("text", "text"),
+    ],
+)
+def test_make_str(monkeypatch, value, expected):
+    monkeypatch.setattr(sys, "getfilesystemencoding", lambda: "utf-8")
+    assert click.utils.make_str(value) == expected
+
+
+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Reaches max_length exactly before the last word.
+        ("aaa bbb ccc", 7, "aaa..."),
+        # Reaches max_length exactly on the last word.
+        ("aaa bbb", 7, "aaa bbb"),
+        # First word alone is too long.
+        ("abcdefghij", 5, "..."),
+    ],
+)
+def test_make_default_short_help_edges(help, max_length, expected):
+    assert click.utils._make_default_short_help(help, max_length) == expected
+
+
+def _fake_stdout(monkeypatch):
+    # Patched in the test body, pytest's capture replaces sys.stdout between
+    # fixture setup and the test call.
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr(sys, "stdout", stream)
+    return stream
+
+
+def test_lazyfile_dash_uses_stdout(monkeypatch):
+    stdout = _fake_stdout(monkeypatch)
+    lf = click.utils._LazyFile("-", "w")
+    assert lf.should_close is False
+    assert lf._f is not None
+    assert repr(lf) == repr(lf._f)
+    lf.write("hello")
+    lf.close_intelligently()
+    # Standard streams are borrowed and must not be closed.
+    assert not lf._f.closed
+    lf._f.flush()
+    assert stdout.buffer.getvalue() == b"hello"
+
+
+def test_lazyfile_repr_unopened_and_opened(tmp_path):
+    path = tmp_path / "out.txt"
+    lf = click.utils._LazyFile(path, "w")
+    assert repr(lf) == f"<unopened file '{click.format_filename(str(path))}' w>"
+    lf.write("data")
+    assert repr(lf) == repr(lf._f)
+    lf.close_intelligently()
+    assert path.read_text() == "data"
+
+
+def test_lazyfile_open_error_raises_file_error(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "missing" / "out.txt", "w")
+
+    with pytest.raises(click.FileError):
+        lf.open()
+
+
+def test_lazyfile_close_unopened_is_noop(tmp_path):
+    lf = click.utils._LazyFile(tmp_path / "out.txt", "w")
+    lf.close()
+    assert lf._f is None
+    assert not (tmp_path / "out.txt").exists()
+
+
+def test_keepopenfile_repr():
+    f = io.StringIO()
+    kf = click.utils._KeepOpenFile(f)
+    assert repr(kf) == repr(f)
+
+
+def test_open_file_lazy(tmp_path):
+    path = tmp_path / "lazy.txt"
+    f = click.open_file(path, "w", lazy=True)
+    assert isinstance(f, click.utils._LazyFile)
+    assert not path.exists()
+
+    with f:
+        f.write("lazy")
+
+    assert path.read_text() == "lazy"
+
