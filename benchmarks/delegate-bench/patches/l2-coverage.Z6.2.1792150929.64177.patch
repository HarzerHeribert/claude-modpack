+class _BytesOnlyNonEmptyWriter:
+    """Accepts non-empty bytes but rejects the empty probes used to detect a
+    binary writer, so no binary writer is found.
+    """
+
+    def __init__(self):
+        self.written = []
+
+    def write(self, data):
+        if not data:
+            raise TypeError("empty write")
+
+        self.written.append(data)
+
+    def flush(self):
+        pass
+
+
+def test_echo_bytes_without_binary_writer():
+    out = _BytesOnlyNonEmptyWriter()
+    click.echo(b"hi", file=out)
+    assert out.written == [b"hi\n"]
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        click.utils._get_binary_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    stdout = _fake_stdout(monkeypatch)
+    stream = click.utils._get_text_stream("stdout")
+    stream.write("x")
+    stream.flush()
+    assert stdout.buffer.getvalue() == b"x"
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream"):
+        click.utils._get_text_stream("nope")
+
