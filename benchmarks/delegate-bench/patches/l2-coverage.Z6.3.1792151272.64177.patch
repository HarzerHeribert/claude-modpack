+@pytest.mark.parametrize(
+    ("help", "max_length", "expected"),
+    [
+        # Exactly at max length, but more words follow; first word fills it.
+        ("abcde fgh", 5, "..."),
+        # Exactly at max length after second word, more words follow.
+        ("abc defgh ijk", 9, "abc..."),
+    ],
+)
+def test_make_default_short_help_exact_length(help, max_length, expected):
+    assert _make_default_short_help(help, max_length) == expected
+
