+class _FlushRaises:
+    def __init__(self, exc=None):
+        self.exc = exc
+        self.flushed = False
+        self.attr = "proxied"
+
+    def flush(self):
+        self.flushed = True
+        if self.exc is not None:
+            raise self.exc
+
+
+def test_pacify_flush_wrapper_flush():
+    wrapped = _FlushRaises()
+    w = _PacifyFlushWrapper(wrapped)
+    assert w.wrapped is wrapped
+    w.flush()
+    assert wrapped.flushed
+
+
+def test_pacify_flush_wrapper_epipe_suppressed():
+    w = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EPIPE, "Broken pipe")))
+    w.flush()
+
+
+def test_pacify_flush_wrapper_other_error_raised():
+    w = _PacifyFlushWrapper(_FlushRaises(OSError(errno.EIO, "I/O error")))
+
+    with pytest.raises(OSError) as exc_info:
+        w.flush()
+
+    assert exc_info.value.errno == errno.EIO
+
+
+def test_pacify_flush_wrapper_getattr():
+    w = _PacifyFlushWrapper(_FlushRaises())
+    assert w.attr == "proxied"
+
