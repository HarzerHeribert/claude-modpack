+class _NoBinaryWriter:
+    """A stream that is neither detected as binary nor text, but accepts
+    non-empty bytes.
+    """
+
+    def __init__(self):
+        self.data = []
+        self.flushed = 0
+
+    def write(self, value):
+        if not value:
+            raise ValueError("empty write")
+        self.data.append(value)
+
+    def flush(self):
+        self.flushed += 1
+
+
+def test_echo_bytes_without_binary_writer():
+    f = _NoBinaryWriter()
+    echo(b"hello", file=f)
+    assert f.data == [b"hello\n"]
+    assert f.flushed == 1
+
+
+def test_get_binary_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_binary_stream("nope")
+
+
+def test_get_text_stream_unknown():
+    with pytest.raises(TypeError, match="Unknown standard stream 'nope'"):
+        _get_text_stream("nope")
+
+
+def test_get_text_stream(monkeypatch):
+    buf = io.BytesIO()
+    monkeypatch.setattr(sys, "stdout", io.TextIOWrapper(buf, encoding="utf-8"))
+    stream = _get_text_stream("stdout", encoding="utf-8")
+    stream.write("hi")
+    stream.flush()
+    assert buf.getvalue() == b"hi"
+
