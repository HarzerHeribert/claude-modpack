+def format_filesize(num_bytes: int) -> str:
+    """Format a size in bytes as a human-readable string for display.
+
+    Sizes below 1024 are shown as a whole number of bytes, such as
+    ``"1023 B"``. Larger sizes use the largest binary unit (``KiB``,
+    ``MiB``, ``GiB``, ``TiB``) in which the value is at least 1, rounded
+    half up to one decimal place, such as ``"1.5 KiB"``. A value that
+    rounds up to 1024 of a unit is shown as 1 of the next unit instead.
+    Sizes of 1024 TiB and above are still shown in ``TiB``.
+
+    .. versionadded:: 8.5.1
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exponent = 1
+
+    while exponent < len(units) and num_bytes >= 1024 ** (exponent + 1):
+        exponent += 1
+
+    # Round half up to tenths with integer math to avoid float errors.
+    divisor = 1024**exponent
+    tenths = (num_bytes * 20 + divisor) // (divisor * 2)
+
+    # Rounding up to 1024.0 means the value is 1.0 in the next unit.
+    if tenths == 10240 and exponent < len(units):
+        exponent += 1
+        tenths = 10
+
+    return f"{tenths // 10}.{tenths % 10} {units[exponent - 1]}"
+
+
