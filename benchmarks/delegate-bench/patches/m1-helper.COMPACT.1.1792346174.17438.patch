@@ -0,0 +1,27 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in binary units such as KiB and MiB.",
+)
+def cli(sizes, human):
+    """Print each of the SIZES given in bytes, one per line.
+
+    \b
+    Print the sizes as they are:
+        filesize 512 1536
+
+    \b
+    Print the sizes in human-readable form:
+        filesize --human 512 1536
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
