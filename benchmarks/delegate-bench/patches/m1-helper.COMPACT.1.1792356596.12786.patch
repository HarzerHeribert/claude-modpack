+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Format sizes in binary units, such as 1.5 KiB.",
+)
+def cli(sizes, human):
+    """Print each of SIZES, a number of bytes, on its own line.
+
+    \b
+    Print sizes as given:
+        filesize 512 1536
+
+    \b
+    Print sizes in binary units:
+        filesize --human 512 1536
+    \f
+
+    .. versionadded:: 8.5.1
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
