+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a string for display, using binary units
+    that are powers of 1024.
+
+    Values under 1024 are shown as whole bytes, such as ``"1023 B"``.
+    Larger values use the largest unit up to ``TiB`` in which the value is at
+    least 1, rounded half up to one decimal, such as ``"1.5 KiB"``. A value
+    that rounds up to 1024 of a unit is shown in the next unit instead, so
+    1048575 bytes is ``"1.0 MiB"``. Values above 1024 TiB stay in ``TiB``.
+
+    :param num_bytes: The non-negative number of bytes to format.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exponent = 1
+
+    while True:
+        divisor = 1024**exponent
+        # Integer arithmetic, since float rounding is not reliably half up.
+        tenths = (num_bytes * 10 + divisor // 2) // divisor
+
+        if tenths < 10240 or exponent == len(units):
+            break
+
+        exponent += 1
+
+    return f"{tenths // 10}.{tenths % 10} {units[exponent - 1]}"
+
+
