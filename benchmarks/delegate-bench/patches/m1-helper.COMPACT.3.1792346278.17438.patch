+_FILESIZE_UNITS = ("B", "KiB", "MiB", "GiB", "TiB")
+
+
+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size using binary units
+    (powers of 1024): ``B``, ``KiB``, ``MiB``, ``GiB``, and ``TiB``.
+
+    Sizes under 1024 bytes are shown as an integer, like ``"1023 B"``.
+    Larger sizes use the largest unit in which the value is at least 1,
+    rounded half up to one decimal, like ``"1.5 KiB"``. If rounding
+    reaches 1024 of a unit, the next unit is used instead, so 1048575
+    bytes is ``"1.0 MiB"``. Sizes of 1024 TiB and above stay in TiB.
+
+    .. code-block:: python
+
+        click.echo(click.format_filesize(1536))  # 1.5 KiB
+
+    :param num_bytes: The number of bytes, must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    last = len(_FILESIZE_UNITS) - 1
+    exp = 1
+
+    while exp < last and num_bytes >= 1024 ** (exp + 1):
+        exp += 1
+
+    # Round half up to tenths with integer math to avoid float error.
+    divisor = 1024**exp
+    tenths = (num_bytes * 10 + divisor // 2) // divisor
+
+    if tenths >= 10240 and exp < last:
+        exp += 1
+        divisor = 1024**exp
+        tenths = (num_bytes * 10 + divisor // 2) // divisor
+
+    return f"{tenths // 10}.{tenths % 10} {_FILESIZE_UNITS[exp]}"
+
+
