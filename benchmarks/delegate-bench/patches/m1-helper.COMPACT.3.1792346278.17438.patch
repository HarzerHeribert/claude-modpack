@@ -0,0 +1,28 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    default=False,
+    show_default=True,
+    help="Show sizes in human-readable binary units.",
+)
+def cli(sizes, human):
+    """Print each size in bytes, one per line.
+
+    \b
+    Print sizes as bytes:
+        filesize 512 1536
+
+    \b
+    Print sizes in human-readable units:
+        filesize --human 512 1536
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
