@@ -0,0 +1,27 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in human-readable units such as KiB and MiB.",
+)
+def cli(sizes, human):
+    """Print each of the given SIZES, one per line, in bytes.
+
+    \b
+    Print sizes in bytes:
+        filesize 512 1536
+
+    \b
+    Print sizes in human-readable units:
+        filesize --human 512 1536
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
