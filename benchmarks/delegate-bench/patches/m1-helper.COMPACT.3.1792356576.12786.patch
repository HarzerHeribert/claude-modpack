+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size for display.
+
+    Sizes below 1024 bytes are shown as an integer with the unit ``B``, such
+    as ``1023 B``. Larger sizes use the largest binary unit, from ``KiB`` up
+    to ``TiB``, in which the value is at least 1. The value is rounded half
+    up to one decimal place, such as ``1.5 KiB``. Sizes of 1024 TiB and more
+    are still shown in ``TiB``.
+
+    .. code-block:: python
+
+        click.format_filesize(1536)  # "1.5 KiB"
+        click.format_filesize(1048575)  # "1.0 MiB"
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exp = 1
+
+    while exp < len(units) and num_bytes >= 1024 ** (exp + 1):
+        exp += 1
+
+    while True:
+        unit_size = 1024**exp
+        # Round half up to tenths with integer math to avoid float errors.
+        tenths = (20 * num_bytes + unit_size) // (2 * unit_size)
+
+        # Rounding can reach 1024.0, which belongs to the next unit.
+        if tenths < 10240 or exp == len(units):
+            break
+
+        exp += 1
+
+    return f"{tenths // 10}.{tenths % 10} {units[exp - 1]}"
+
+
