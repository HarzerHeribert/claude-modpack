+def format_filesize(num_bytes: int) -> str:
+    """Format a size in bytes for display, using binary units that are
+    powers of 1024.
+
+    A size under 1024 is shown as the integer with ``B``. Larger sizes use
+    the largest of ``KiB``, ``MiB``, ``GiB``, and ``TiB`` in which the
+    value is at least 1, rounded half up to one decimal. If rounding makes
+    the value 1024.0 in a unit below ``TiB``, the next unit is used instead.
+    Sizes of 1024 TiB and above are still shown in ``TiB``.
+
+    .. code-block:: python
+
+        format_filesize(1023)  # "1023 B"
+        format_filesize(1536)  # "1.5 KiB"
+        format_filesize(1048575)  # "1.0 MiB"
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exp = 1
+
+    while True:
+        base = 1024**exp
+        # Round half up to one decimal with integer math to avoid float error.
+        tenths = (num_bytes * 20 + base) // (base * 2)
+
+        # Move up while the value is, or rounds to, 1024.0, but stop at TiB.
+        if tenths < 10240 or exp == len(units):
+            return f"{tenths // 10}.{tenths % 10} {units[exp - 1]}"
+
+        exp += 1
+
+
