+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in binary units such as KiB and MiB.",
+)
+def cli(sizes, human):
+    """Print each of the given SIZES in bytes, one per line.
+
+    \b
+    Print sizes in binary units:
+        filesize --human 1023 1536 1048575
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
