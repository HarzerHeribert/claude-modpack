@@ -0,0 +1,18 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in human readable units such as KiB and MiB.",
+)
+def cli(sizes, human):
+    """Prints each of the given SIZES in bytes, one per line."""
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
