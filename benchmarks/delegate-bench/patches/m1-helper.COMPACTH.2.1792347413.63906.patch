+def format_filesize(num_bytes: int) -> str:
+    """Format a size in bytes as a human readable string for display.
+
+    Sizes below 1024 are shown as a whole number of bytes, such as
+    ``"1023 B"``. Larger sizes are shown in the largest binary unit
+    (``KiB``, ``MiB``, ``GiB``, or ``TiB``) in which the value is at least
+    1, rounded half up to one decimal, such as ``"1.5 KiB"``. If rounding
+    reaches 1024.0, the next unit is used instead. Sizes of 1024 TiB and
+    above stay in ``TiB``.
+
+    .. versionadded:: 8.5.1
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exp = 1
+
+    while exp < len(units) and num_bytes >= 1024 ** (exp + 1):
+        exp += 1
+
+    # Round half up to tenths with integer math to avoid float errors.
+    tenths = (num_bytes * 20 + 1024**exp) // (2 * 1024**exp)
+
+    # Rounding up to 1024.0 is shown as 1.0 in the next unit instead.
+    if tenths >= 10240 and exp < len(units):
+        exp += 1
+        tenths = (num_bytes * 20 + 1024**exp) // (2 * 1024**exp)
+
+    return f"{tenths // 10}.{tenths % 10} {units[exp - 1]}"
+
+
