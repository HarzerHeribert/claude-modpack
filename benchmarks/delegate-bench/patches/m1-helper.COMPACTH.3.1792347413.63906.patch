+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size for display.
+
+    Sizes under 1024 bytes are shown as an integer with the unit ``B``.
+    Larger sizes use binary units (powers of 1024), up to ``TiB``. The
+    largest unit in which the value is at least 1 is used, and the value
+    is rounded half up to one decimal place. If rounding would show
+    ``1024.0`` of a unit below ``TiB``, the next unit is used instead.
+
+    .. code-block:: python
+
+        format_filesize(1023)  # "1023 B"
+        format_filesize(1536)  # "1.5 KiB"
+        format_filesize(1048575)  # "1.0 MiB"
+
+    :param num_bytes: The number of bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("B", "KiB", "MiB", "GiB", "TiB")
+    exponent = 1
+
+    while exponent < len(units) - 1 and num_bytes >= 1024 ** (exponent + 1):
+        exponent += 1
+
+    while True:
+        divisor = 1024**exponent
+        # Tenths of the unit, rounded half up with exact integer math.
+        tenths = (num_bytes * 20 + divisor) // (2 * divisor)
+
+        if tenths < 10240 or exponent == len(units) - 1:
+            break
+
+        exponent += 1
+
+    return f"{tenths // 10}.{tenths % 10} {units[exponent]}"
+
+
