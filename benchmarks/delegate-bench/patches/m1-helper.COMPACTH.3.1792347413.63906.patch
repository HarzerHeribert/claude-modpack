+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human",
+    is_flag=True,
+    default=False,
+    show_default=True,
+    help="Show sizes in human-readable units.",
+)
+def cli(sizes, human):
+    """Print each size in bytes, or as a human-readable size with
+    ``--human``.
+
+    \b
+    Print sizes as given:
+        filesize 512 1536
+
+    \b
+    Print human-readable sizes:
+        filesize --human 512 1536
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
