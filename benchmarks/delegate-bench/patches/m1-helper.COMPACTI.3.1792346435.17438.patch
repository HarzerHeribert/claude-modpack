@@ -0,0 +1,20 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", type=int, nargs=-1)
+@click.option(
+    "--human", is_flag=True, show_default=True, help="Show human readable sizes."
+)
+def cli(sizes, human):
+    """Print each of the given SIZES in bytes, one per line, or as a human
+    readable size with --human.
+
+    \f
+    .. versionadded:: 8.5.1
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
