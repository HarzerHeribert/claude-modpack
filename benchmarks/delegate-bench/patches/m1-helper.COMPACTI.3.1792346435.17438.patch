+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human readable size for display, using
+    binary units that are powers of 1024.
+
+    Values below 1024 are shown as an integer number of bytes, such as
+    ``"1023 B"``. Larger values are shown in the largest unit, up to
+    ``TiB``, in which the value is at least 1, rounded half up to one
+    decimal, such as ``"1.5 KiB"``. If rounding reaches 1024.0, the next
+    unit is used instead, so ``1048575`` is ``"1.0 MiB"``. Values of 1024
+    TiB and more stay in ``TiB``.
+
+    .. versionadded:: 8.5.1
+
+    :param num_bytes: The non-negative number of bytes to format.
+    :raises ValueError: If ``num_bytes`` is negative.
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exp = 1
+
+    while exp < len(units) and num_bytes >= 1024 ** (exp + 1):
+        exp += 1
+
+    while True:
+        divisor = 1024**exp
+        # Integer math rounds half up exactly, without float error.
+        tenths = (num_bytes * 20 + divisor) // (divisor * 2)
+
+        if tenths < 10240 or exp == len(units):
+            break
+
+        exp += 1
+
+    return f"{tenths // 10}.{tenths % 10} {units[exp - 1]}"
+
+
