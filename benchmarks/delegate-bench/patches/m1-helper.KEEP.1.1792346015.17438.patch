+_FILESIZE_UNITS = ("B", "KiB", "MiB", "GiB", "TiB")
+
+
+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size in binary units,
+    where each unit is 1024 times the previous one.
+
+    Sizes under 1024 bytes are shown as a whole number of bytes, like
+    ``"1023 B"``. Larger sizes use the largest unit up to ``TiB`` in which
+    the value is at least 1, rounded half up to one decimal place, like
+    ``"1.5 KiB"``. Sizes of 1024 TiB and above are still shown in ``TiB``.
+
+    .. code-block:: python
+
+        format_filesize(1536)  # "1.5 KiB"
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raise ValueError: ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    max_exponent = len(_FILESIZE_UNITS) - 1
+    exponent = 1
+
+    while exponent < max_exponent and num_bytes >= 1024 ** (exponent + 1):
+        exponent += 1
+
+    # Round half up to tenths with integer arithmetic. round() rounds half
+    # to even, and floats can't represent most tenths exactly.
+    unit = 1024**exponent
+    tenths = (num_bytes * 20 + unit) // (unit * 2)
+
+    # Rounding can carry up to 1024.0, like 1048575 bytes in KiB. Show that
+    # in the next unit instead.
+    if tenths >= 10240 and exponent < max_exponent:
+        exponent += 1
+        unit *= 1024
+        tenths = (num_bytes * 20 + unit) // (unit * 2)
+
+    return f"{tenths // 10}.{tenths % 10} {_FILESIZE_UNITS[exponent]}"
+
+
