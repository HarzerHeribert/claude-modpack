+import click
+
+
+@click.command()
+@click.argument("sizes", nargs=-1, type=int)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in binary units, like 1.5 KiB.",
+)
+def cli(sizes, human):
+    """Filesize.
+
+    This example prints each of the given SIZES in bytes, or formatted
+    with click.format_filesize when --human is passed.
+
+    \f
+    .. versionadded:: 8.5.1
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
