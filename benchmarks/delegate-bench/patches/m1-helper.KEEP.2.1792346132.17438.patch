+_FILESIZE_UNITS = ("B", "KiB", "MiB", "GiB", "TiB")
+
+
+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size in binary units,
+    where each unit is 1024 times the previous one.
+
+    Sizes under 1024 bytes are shown as a whole number of bytes, like
+    ``"1023 B"``. Larger sizes use the largest unit, up to ``TiB``, in
+    which the value is at least 1. The value is rounded half up to one
+    decimal place, like ``"1.5 KiB"``. If rounding reaches ``1024.0``,
+    the next unit is used instead, so ``1048575`` is ``"1.0 MiB"``.
+
+    :param num_bytes: The size in bytes.
+    :raise ValueError: ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    last = len(_FILESIZE_UNITS) - 1
+    exponent = 1
+
+    # Use the largest unit, up to TiB, in which the value is at least 1.
+    while exponent < last and num_bytes >= 1024 ** (exponent + 1):
+        exponent += 1
+
+    while True:
+        divisor = 1024**exponent
+        # Tenths of the unit, rounded half up. Integer math avoids float
+        # rounding error.
+        tenths = (num_bytes * 20 + divisor) // (2 * divisor)
+
+        # Rounding up to 1024.0 means the value belongs to the next unit.
+        if tenths < 10240 or exponent == last:
+            break
+
+        exponent += 1
+
+    return f"{tenths // 10}.{tenths % 10} {_FILESIZE_UNITS[exponent]}"
+
+
