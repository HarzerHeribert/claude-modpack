@@ -0,0 +1,30 @@
+import click
+
+
+@click.command()
+@click.argument("sizes", nargs=-1, type=int)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show sizes in binary units, like 1.5 KiB.",
+)
+def cli(sizes, human):
+    """Print each of the given SIZES in bytes, one per line.
+
+    \b
+    Print sizes as given:
+        filesize 512 1536
+
+    \b
+    Print sizes in binary units:
+        filesize --human 512 1536
+
+    \f
+    .. versionadded:: 8.5.1
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
