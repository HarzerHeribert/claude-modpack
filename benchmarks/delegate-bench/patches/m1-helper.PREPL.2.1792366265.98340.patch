+def format_filesize(num_bytes: int) -> str:
+    """Format a number of bytes as a human-readable size for display, using
+    binary units that are powers of 1024: ``B``, ``KiB``, ``MiB``,
+    ``GiB``, and ``TiB``.
+
+    Sizes under 1024 bytes are shown as an integer, such as ``"1023 B"``.
+    Larger sizes use the largest unit in which the value is at least 1,
+    rounded half up to one decimal, such as ``"1.5 KiB"``. If rounding
+    reaches 1024 of a unit, the next unit is used instead, so 1048575 bytes
+    is ``"1.0 MiB"``. Sizes above 1024 TiB are still shown in TiB.
+
+    :param num_bytes: The number of bytes, which must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    units = ("KiB", "MiB", "GiB", "TiB")
+    exponent = 1
+
+    while exponent < len(units) and num_bytes >= 1024 ** (exponent + 1):
+        exponent += 1
+
+    def to_tenths(exponent: int) -> int:
+        # Round half up to tenths with integer math to avoid float error.
+        divisor: int = 1024**exponent
+        return (num_bytes * 20 + divisor) // (divisor * 2)
+
+    tenths = to_tenths(exponent)
+
+    if tenths >= 10240 and exponent < len(units):
+        exponent += 1
+        tenths = to_tenths(exponent)
+
+    return f"{tenths // 10}.{tenths % 10} {units[exponent - 1]}"
+
+
