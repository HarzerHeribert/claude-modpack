+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("num_bytes", "expect"),
+    [
+        (0, "0 B"),
+        (1, "1 B"),
+        (1023, "1023 B"),
+        (1024, "1.0 KiB"),
+        (1536, "1.5 KiB"),
+        # 1.25 KiB rounds half up.
+        (1280, "1.3 KiB"),
+        # 1.2 KiB plus a bit less than half a tenth rounds down.
+        (1280 - 1, "1.2 KiB"),
+        (1023 * 1024, "1023.0 KiB"),
+        # Rounds to 1024.0 KiB, shown in the next unit.
+        (1048575, "1.0 MiB"),
+        (1024**2, "1.0 MiB"),
+        (1024**3 - 1, "1.0 GiB"),
+        (1024**3, "1.0 GiB"),
+        (int(2.5 * 1024**3), "2.5 GiB"),
+        (1024**4 - 1, "1.0 TiB"),
+        (1024**4, "1.0 TiB"),
+        # TiB is the largest unit.
+        (1024**5, "1024.0 TiB"),
+        (2048 * 1024**4, "2048.0 TiB"),
+    ],
+)
+def test_format_filesize(num_bytes, expect):
+    assert click.format_filesize(num_bytes) == expect
+
+
+def test_format_filesize_negative():
+    with pytest.raises(ValueError, match="num_bytes must not be negative"):
+        click.format_filesize(-1)
