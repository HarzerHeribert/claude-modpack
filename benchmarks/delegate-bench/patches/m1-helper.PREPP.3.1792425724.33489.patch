+_FILESIZE_UNITS = ("KiB", "MiB", "GiB", "TiB")
+
+
+def format_filesize(num_bytes: int) -> str:
+    """Format a size in bytes as a human readable string, using binary
+    units that are powers of 1024.
+
+    A size below 1024 is shown as a whole number of bytes. A larger size is
+    shown in the largest unit, up to ``TiB``, in which its value is at
+    least 1, rounded half up to one decimal place. If rounding makes the
+    value ``1024.0``, the next unit is used instead.
+
+    .. code-block:: python
+
+        format_filesize(1023)  # "1023 B"
+        format_filesize(1536)  # "1.5 KiB"
+        format_filesize(1048575)  # "1.0 MiB"
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :raises ValueError: If ``num_bytes`` is negative.
+
+    .. versionadded:: 8.5.1
+    """
+    if num_bytes < 0:
+        raise ValueError("num_bytes must not be negative")
+
+    if num_bytes < 1024:
+        return f"{num_bytes} B"
+
+    exponent = 1
+
+    while True:
+        divisor = 1024**exponent
+        # Tenths of the unit, rounded half up. Integer math avoids float
+        # rounding errors.
+        tenths = (20 * num_bytes + divisor) // (2 * divisor)
+
+        # A value that rounds to 1024.0 moves to the next unit, unless the
+        # unit is already the largest one.
+        if tenths < 10240 or exponent == len(_FILESIZE_UNITS):
+            return f"{tenths // 10}.{tenths % 10} {_FILESIZE_UNITS[exponent - 1]}"
+
+        exponent += 1
+
+
