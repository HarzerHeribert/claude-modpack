+import click
+
+
+@click.command()
+@click.argument("sizes", nargs=-1, type=int)
+@click.option(
+    "--human",
+    is_flag=True,
+    show_default=True,
+    help="Show the sizes in units such as KiB and MiB.",
+)
+def cli(sizes, human):
+    """This script prints each of the given SIZES in bytes, one per line.
+
+    \b
+    Print sizes in bytes:
+        filesize 512 1536
+
+    \b
+    Print sizes in human readable units:
+        filesize --human 512 1536
+
+    \f
+    .. versionadded:: 8.5.1
+    """
+    for size in sizes:
+        if human:
+            click.echo(click.format_filesize(size))
+        else:
+            click.echo(size)
