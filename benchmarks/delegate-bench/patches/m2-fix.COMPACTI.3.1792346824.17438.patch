+def test_int_range_clamp_max_open_option(runner):
+    @click.command()
+    @click.option(
+        "--n",
+        type=click.IntRange(max=5, max_open=True, clamp=True),
+        show_default=True,
+    )
+    def cli(n):
+        click.echo(n)
+
+    result = runner.invoke(cli, ["--n", "9"])
+    assert result.exit_code == 0
+    assert result.output == "4\n"
