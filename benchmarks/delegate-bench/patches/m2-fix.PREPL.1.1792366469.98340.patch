+@pytest.mark.parametrize(("value", "expect"), [("3", 3), ("5", 4), ("9", 4)])
+def test_int_range_clamp_max_open_option(runner, value, expect):
+    """An open max bound clamps to the largest value inside the range."""
+
+    @click.command()
+    @click.option(
+        "--n",
+        type=click.IntRange(max=5, max_open=True, clamp=True),
+        show_default=True,
+    )
+    def cli(n):
+        click.echo(n)
+
+    result = runner.invoke(cli, ["--n", value])
+    assert result.exit_code == 0
+    assert result.output == f"{expect}\n"
+
+
