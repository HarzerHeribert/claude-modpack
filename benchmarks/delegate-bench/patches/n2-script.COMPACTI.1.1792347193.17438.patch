+"""Print the line count of every ``.py`` file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``<lines>`` is the number
+of newline characters in the file, as ``wc -l`` counts them, and
+``<path>`` is relative to the repository root with forward slashes.
+Files are sorted by line count, largest first, then by path.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def count_lines(path: Path) -> int:
+    """Return the number of newline characters in ``path``, the same
+    count ``wc -l`` reports.
+
+    .. versionadded:: 8.5.1
+    """
+    return path.read_bytes().count(b"\n")
+
+
+def main() -> None:
+    """Print ``<lines> <path>`` for every ``.py`` file under
+    ``src/click``, largest first, files with the same count ordered by
+    path.
+
+    .. versionadded:: 8.5.1
+    """
+    rows = [
+        (count_lines(file), file.relative_to(ROOT).as_posix())
+        for file in (ROOT / "src" / "click").rglob("*.py")
+        if file.is_file()
+    ]
+    rows.sort(key=lambda row: (-row[0], row[1]))
+
+    for lines, path in rows:
+        print(lines, path)
+
+
+if __name__ == "__main__":
+    main()
