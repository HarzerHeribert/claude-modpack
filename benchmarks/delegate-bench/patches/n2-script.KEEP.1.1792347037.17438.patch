+"""Print the line count of every Python file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``<lines>`` counts newline
+characters the way ``wc -l`` does and ``<path>`` is relative to the
+repository root. Files are sorted by line count, largest first, then by
+path.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def main() -> int:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    .. versionadded:: 8.5.1
+    """
+    rows = []
+
+    for path in (ROOT / "src" / "click").rglob("*.py"):
+        if not path.is_file():
+            continue
+
+        lines = path.read_bytes().count(b"\n")
+        rows.append((lines, path.relative_to(ROOT).as_posix()))
+
+    rows.sort(key=lambda row: (-row[0], row[1]))
+
+    for lines, name in rows:
+        print(f"{lines} {name}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
