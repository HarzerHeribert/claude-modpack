+"""Print the line count of every Python file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``lines`` is the number of
+newline characters (as counted by ``wc -l``) and ``path`` is relative to
+the repository root with forward slashes. Files are sorted by line count,
+largest first, then by path.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def count_lines() -> list[tuple[int, str]]:
+    """Return ``(lines, path)`` pairs for every ``.py`` file under
+    ``src/click``, sorted by line count descending, then by path.
+
+    .. versionadded:: 8.5.1
+    """
+    rows = []
+
+    for file in (ROOT / "src" / "click").rglob("*.py"):
+        if not file.is_file():
+            continue
+
+        lines = file.read_bytes().count(b"\n")
+        rows.append((lines, file.relative_to(ROOT).as_posix()))
+
+    rows.sort(key=lambda row: (-row[0], row[1]))
+    return rows
+
+
+def main() -> None:
+    """Print each ``<lines> <path>`` pair from :func:`count_lines`.
+
+    .. versionadded:: 8.5.1
+    """
+    for lines, path in count_lines():
+        print(f"{lines} {path}")
+
+
+if __name__ == "__main__":
+    main()
