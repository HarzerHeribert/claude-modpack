+"""Print the line count of every Python file under src/click.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``. ``<lines>`` counts newline
+characters, as ``wc -l`` does, and ``<path>`` is relative to the repository
+root. Files are sorted by line count, largest first, then by path.
+"""
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+PACKAGE = ROOT / "src" / "click"
+
+
+def main() -> int:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    .. versionadded:: 8.5.1
+    """
+    counts = []
+
+    for path in PACKAGE.rglob("*.py"):
+        if not path.is_file():
+            continue
+
+        lines = path.read_bytes().count(b"\n")
+        counts.append((lines, path.relative_to(ROOT).as_posix()))
+
+    counts.sort(key=lambda item: (-item[0], item[1]))
+    sys.stdout.write("".join(f"{lines} {name}\n" for lines, name in counts))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
