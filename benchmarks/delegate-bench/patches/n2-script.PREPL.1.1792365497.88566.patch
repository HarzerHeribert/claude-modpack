+"""Print the line count of every ``.py`` file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+
+def main() -> int:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    Lines are counted as ``wc -l`` counts them, the number of newline
+    characters. Paths are relative to the repository root and use forward
+    slashes. Files are sorted by line count, largest first, then by path.
+
+    .. versionadded:: 8.5.1
+    """
+    root = Path(__file__).resolve().parent.parent
+    counts = []
+
+    for path in (root / "src" / "click").rglob("*.py"):
+        if path.is_file():
+            lines = path.read_bytes().count(b"\n")
+            counts.append((lines, path.relative_to(root).as_posix()))
+
+    counts.sort(key=lambda item: (-item[0], item[1]))
+
+    for lines, name in counts:
+        print(f"{lines} {name}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
