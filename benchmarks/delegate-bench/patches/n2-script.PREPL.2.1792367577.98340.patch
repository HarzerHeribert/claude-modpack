+"""Print the line count of every Python file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``<lines>`` is the number
+of newline characters in the file (as ``wc -l`` counts them) and
+``<path>`` is relative to the repository root with forward slashes.
+Files are sorted by line count, largest first, then by path.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+SRC = ROOT / "src" / "click"
+
+
+def count_lines() -> list[tuple[int, str]]:
+    """Return ``(lines, path)`` for every ``.py`` file under ``src/click``,
+    sorted by line count descending, then by path ascending.
+
+    .. versionadded:: 8.5.1
+    """
+    counts = []
+
+    for path in SRC.rglob("*.py"):
+        if not path.is_file():
+            continue
+
+        lines = path.read_bytes().count(b"\n")
+        counts.append((lines, path.relative_to(ROOT).as_posix()))
+
+    counts.sort(key=lambda item: (-item[0], item[1]))
+    return counts
+
+
+def main() -> None:
+    """Print each file's line count and path, one file per line.
+
+    .. versionadded:: 8.5.1
+    """
+    for lines, path in count_lines():
+        print(f"{lines} {path}")
+
+
+if __name__ == "__main__":
+    main()
