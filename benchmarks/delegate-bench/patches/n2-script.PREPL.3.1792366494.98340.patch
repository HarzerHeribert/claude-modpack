+"""Print the line count of every ``.py`` file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, sorted by line count, largest
+first, then by path.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+SRC = ROOT / "src" / "click"
+
+
+def count_lines(path: Path) -> int:
+    """Count newline characters in a file, the same way ``wc -l`` does.
+
+    .. versionadded:: 8.5.1
+    """
+    return path.read_bytes().count(b"\n")
+
+
+def main() -> None:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    .. versionadded:: 8.5.1
+    """
+    rows = [
+        (count_lines(path), path.relative_to(ROOT).as_posix())
+        for path in SRC.rglob("*.py")
+        if path.is_file()
+    ]
+    rows.sort(key=lambda row: (-row[0], row[1]))
+
+    for lines, name in rows:
+        print(f"{lines} {name}")
+
+
+if __name__ == "__main__":
+    main()
