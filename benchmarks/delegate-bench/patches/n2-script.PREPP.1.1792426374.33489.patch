+"""Print the line count of every ``.py`` file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``<lines>`` counts newline
+characters as ``wc -l`` does and ``<path>`` is relative to the repository
+root. Files are sorted by line count, largest first, then by path.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def count_lines(path: Path) -> int:
+    """Return the number of newline characters in ``path``, like ``wc -l``.
+
+    .. versionadded:: 8.5.1
+    """
+    return path.read_bytes().count(b"\n")
+
+
+def main() -> None:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    .. versionadded:: 8.5.1
+    """
+    counts = [
+        (count_lines(path), path.relative_to(ROOT).as_posix())
+        for path in (ROOT / "src" / "click").rglob("*.py")
+        if path.is_file()
+    ]
+    counts.sort(key=lambda item: (-item[0], item[1]))
+
+    for lines, name in counts:
+        print(f"{lines} {name}")
+
+
+if __name__ == "__main__":
+    main()
