+"""Print the line count of every ``.py`` file under ``src/click``.
+
+Run from the repository root::
+
+    python3 scripts/count_lines.py
+
+Each output line is ``<lines> <path>``, where ``lines`` counts newline
+characters as ``wc -l`` does and ``path`` is relative to the repository
+root with forward slashes. Files are sorted by line count, largest first,
+then by path.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def count_lines(path: Path) -> int:
+    """Return the number of newline characters in the file, like ``wc -l``.
+
+    .. versionadded:: 8.5.1
+    """
+    with open(path, "rb") as f:
+        return sum(chunk.count(b"\n") for chunk in iter(lambda: f.read(65536), b""))
+
+
+def main() -> int:
+    """Print ``<lines> <path>`` for each ``.py`` file under ``src/click``.
+
+    .. versionadded:: 8.5.1
+    """
+    results = []
+
+    for dirpath, _, filenames in os.walk(ROOT / "src" / "click"):
+        for name in filenames:
+            if name.endswith(".py"):
+                path = Path(dirpath, name)
+                rel = path.relative_to(ROOT).as_posix()
+                results.append((count_lines(path), rel))
+
+    results.sort(key=lambda item: (-item[0], item[1]))
+
+    for lines, rel in results:
+        sys.stdout.write(f"{lines} {rel}\n")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
