+def parse_date(text, formats):
+    """The date in whichever of the formats it is written in, as YYYY-MM-DD. Fails if the formats disagree about it."""
+    dates = set()
+    for fmt in formats:
+        try:
+            dates.add(datetime.strptime(text.strip(), fmt).date())
+        except ValueError:
+            pass
+    if not dates:
+        raise ValueError(f"date {text!r} matches none of the formats {formats}")
+    if len(dates) > 1:
+        raise ValueError(f"date {text!r} is ambiguous in the formats {formats}")
+    return dates.pop().isoformat()
+
+
