+def parse_date(text, date_formats):
+    """The date as YYYY-MM-DD; the formats are tried in order. Raises ValueError if none matches."""
+    for fmt in date_formats:
+        try:
+            return datetime.strptime(text, fmt).date().isoformat()
+        except ValueError:
+            pass
+    raise ValueError(f"date {text!r} matches none of the formats {list(date_formats)}")
+
