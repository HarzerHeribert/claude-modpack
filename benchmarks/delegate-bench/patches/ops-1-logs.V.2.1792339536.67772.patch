     def test_amount(self):
         self.assertEqual(importer.parse_amount("19.99"), 1999)
 
+    def test_date_formats(self):
+        formats = ["%Y-%m-%d", "%d.%m.%Y"]
+        self.assertEqual(importer.parse_date("2026-09-30", formats), "2026-09-30")
+        self.assertEqual(importer.parse_date("01.10.2026", formats), "2026-10-01")
+        with self.assertRaises(ValueError):
+            importer.parse_date("10/01/2026", formats)
+
+    def test_mixed_date_formats_in_one_file(self):
+        with tempfile.TemporaryDirectory() as t:
+            csv_path = Path(t) / "mixed.csv"
+            csv_path.write_text("invoice_id,customer,date,amount\n1,acme,2026-09-30,1.00\n2,acme,01.10.2026,2.00\n")
+            path = Path(t) / "t.db"
+            db.init(path)
+            conn = db.connect(path)
+            n = importer.import_file(conn, csv_path, ["%Y-%m-%d", "%d.%m.%Y"])
+            self.assertEqual(n, 2)
+            rows = conn.execute("SELECT id, issued_on FROM invoices ORDER BY id").fetchall()
