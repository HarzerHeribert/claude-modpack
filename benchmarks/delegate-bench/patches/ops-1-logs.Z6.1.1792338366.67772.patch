+def parse_date(text, formats):
+    """The ISO date of text, which must match one of formats (a format or a list of them, tried in order)."""
+    if isinstance(formats, str):
+        formats = [formats]
+    for fmt in formats:
+        try:
+            return datetime.strptime(text.strip(), fmt).date().isoformat()
+        except ValueError:
+            pass
+    raise ValueError(f"date {text!r} matches none of the formats {formats}")
+
