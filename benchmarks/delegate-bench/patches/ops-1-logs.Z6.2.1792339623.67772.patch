-def import_file(conn, path, date_format):
+def parse_date(text, formats):
+    """The ISO date of text, which may be in any of formats (a list, or a single format)."""
+    if isinstance(formats, str):
+        formats = [formats]
+    for fmt in formats:
+        try:
+            return datetime.strptime(text.strip(), fmt).date().isoformat()
+        except ValueError:
+            pass
+    raise ValueError(f"date {text!r} matches none of the formats {list(formats)}")
+
+
+def import_file(conn, path, date_formats):
     """Inserts the rows of one file; returns their number. A bad row is logged with file name and line, then raised."""
