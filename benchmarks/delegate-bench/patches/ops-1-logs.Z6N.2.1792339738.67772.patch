+def parse_date(text, date_formats):
+    """The date as YYYY-MM-DD. date_formats is one strptime format or a list of them, tried in order."""
+    if isinstance(date_formats, str):
+        date_formats = [date_formats]
+    for fmt in date_formats:
+        try:
+            return datetime.strptime(text.strip(), fmt).date().isoformat()
+        except ValueError:
+            pass
+    raise ValueError(f"date {text!r} matches none of the formats {date_formats}")
+
+
+def import_file(conn, path, date_formats):
     """Inserts the rows of one file; returns their number. A bad row is logged with file name and line, then raised."""
     path = Path(path)
     log.info("%s: start", path.name)
