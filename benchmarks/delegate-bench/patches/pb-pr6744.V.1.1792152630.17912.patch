+func TestFileSystemCreateThumbWebp(t *testing.T) {
+	dir := createTestDir(t)
+	defer os.RemoveAll(dir)
+
+	fsys, err := filesystem.NewLocal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer fsys.Close()
+
+	// tiny 4x3 lossless webp
+	webp := []byte{
+		0x52, 0x49, 0x46, 0x46, 0x1c, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
+		0x56, 0x50, 0x38, 0x4c, 0x0f, 0x00, 0x00, 0x00, 0x2f, 0x03, 0x80, 0x00,
+		0x00, 0x07, 0x10, 0xfd, 0x8f, 0xfe, 0x07, 0x22, 0xa2, 0xff, 0x01, 0x00,
+	}
+	if err := fsys.Upload(webp, "image.webp"); err != nil {
+		t.Fatal(err)
+	}
+
+	thumbKey := "thumbs_image.webp/100x50_image.webp"
+
+	if err := fsys.CreateThumb("image.webp", thumbKey, "100x50"); err != nil {
+		t.Fatalf("Expected nil error, got %v", err)
+	}
+
+	// webp thumbs are encoded as png
+	attrs, err := fsys.Attributes(thumbKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if attrs.ContentType != "image/png" {
+		t.Fatalf("Expected thumb content type %q, got %q", "image/png", attrs.ContentType)
+	}
+
+	r, err := fsys.GetFile(thumbKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+
+	cfg, err := png.DecodeConfig(r)
+	if err != nil {
+		t.Fatalf("Expected the thumb to be a valid png, got %v", err)
+	}
+	if cfg.Width != 100 || cfg.Height != 50 {
+		t.Fatalf("Expected 100x50 thumb, got %dx%d", cfg.Width, cfg.Height)
+	}
+}
