+func TestFileDownloadWebpThumb(t *testing.T) {
+	t.Parallel()
+
+	// tiny 4x3 lossless webp
+	webp := []byte{
+		0x52, 0x49, 0x46, 0x46, 0x1c, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
+		0x56, 0x50, 0x38, 0x4c, 0x0f, 0x00, 0x00, 0x00, 0x2f, 0x03, 0x80, 0x00,
+		0x00, 0x07, 0x10, 0xfd, 0x8f, 0xfe, 0x07, 0x22, 0xa2, 0xff, 0x01, 0x00,
+	}
+
+	createWebpRecord := func(t testing.TB, app *tests.TestApp, e *core.ServeEvent) {
+		collection, err := app.FindCollectionByNameOrId("demo1")
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		f, err := filesystem.NewFileFromBytes(webp, "test.webp")
+		if err != nil {
+			t.Fatal(err)
+		}
+		f.Name = "test.webp" // static name to be able to reference it in the url
+
+		record := core.NewRecord(collection)
+		record.Id = "webpthumbtest01"
+		record.Set("file_many", []any{f})
+		if err := app.Save(record); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	scenarios := []tests.ApiScenario{
+		{
+			Name:            "webp image - without thumb",
+			Method:          http.MethodGet,
+			URL:             "/api/files/demo1/webpthumbtest01/test.webp",
+			BeforeTestFunc:  createWebpRecord,
+			ExpectedStatus:  200,
+			ExpectedContent: []string{string(webp)},
+			ExpectedEvents: map[string]int{
+				"*":                     0,
+				"OnFileDownloadRequest": 1,
+			},
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if ct := res.Header.Get("Content-Type"); ct != "image/webp" {
+					t.Fatalf("Expected Content-Type %q, got %q", "image/webp", ct)
+				}
+			},
+		},
+		{
+			Name:            "webp image - with thumb (should be generated as png)",
+			Method:          http.MethodGet,
+			URL:             "/api/files/demo1/webpthumbtest01/test.webp?thumb=100x100",
+			BeforeTestFunc:  createWebpRecord,
+			ExpectedStatus:  200,
+			ExpectedContent: []string{"PNG"},
+			ExpectedEvents: map[string]int{
+				"*":                     0,
+				"OnFileDownloadRequest": 1,
+			},
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if ct := res.Header.Get("Content-Type"); ct != "image/png" {
+					t.Fatalf("Expected Content-Type %q, got %q", "image/png", ct)
+				}
+
+				cfg, err := png.DecodeConfig(res.Body)
+				if err != nil {
+					t.Fatalf("Expected the thumb to be a valid png, got %v", err)
+				}
+				if cfg.Width != 100 || cfg.Height != 100 {
+					t.Fatalf("Expected 100x100 thumb, got %dx%d", cfg.Width, cfg.Height)
+				}
+
+				fsys, err := app.NewFilesystem()
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer fsys.Close()
+
+				thumbKey := "wsmn24bux7wo113/webpthumbtest01/thumbs_test.webp/100x100_test.webp"
+				if exists, _ := fsys.Exists(thumbKey); !exists {
+					t.Fatalf("Missing thumb %q", thumbKey)
+				}
+			},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		scenario.Test(t)
+	}
+}
