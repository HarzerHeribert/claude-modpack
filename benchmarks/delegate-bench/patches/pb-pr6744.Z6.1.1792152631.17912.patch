+func TestFileSystemCreateThumbWebp(t *testing.T) {
+	dir := createTestDir(t)
+	defer os.RemoveAll(dir)
+
+	fsys, err := filesystem.NewLocal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer fsys.Close()
+
+	// tiny 4x2 lossless webp
+	webpData, err := base64.StdEncoding.DecodeString("UklGRiAAAABXRUJQVlA4TBMAAAAvA0AAAA8Q87//8x8OfvAQ0f8IAA==")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := fsys.Upload(webpData, "image.webp"); err != nil {
+		t.Fatal(err)
+	}
+
+	thumbKey := "thumbs_image.webp/100x50_image.webp"
+
+	if err := fsys.CreateThumb("image.webp", thumbKey, "100x50"); err != nil {
+		t.Fatalf("Failed to create webp thumb: %v", err)
+	}
+
+	// webp thumbs are encoded as png
+	attrs, err := fsys.Attributes(thumbKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if attrs.ContentType != "image/png" {
+		t.Fatalf("Expected thumb content type %q, got %q", "image/png", attrs.ContentType)
+	}
+
+	r, err := fsys.GetFile(thumbKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+
+	config, format, err := image.DecodeConfig(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if format != "png" {
+		t.Fatalf("Expected thumb format %q, got %q", "png", format)
+	}
+	if config.Width != 100 || config.Height != 50 {
+		t.Fatalf("Expected thumb size 100x50, got %dx%d", config.Width, config.Height)
+	}
+}
