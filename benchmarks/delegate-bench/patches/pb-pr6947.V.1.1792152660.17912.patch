+func TestRandomStringByRegexCharsDistribution(t *testing.T) {
+	scenarios := []struct {
+		pattern  string
+		alphabet string
+	}{
+		{`[A-Za-z0-9\-_]{1000}`, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"},
+		{`[a-z0-9]{1000}`, "abcdefghijklmnopqrstuvwxyz0123456789"},
+		{`.{1000}`, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"},
+	}
+
+	// 20k samples per scenario so that the ±50% bounds below are
+	// several standard deviations away from the expected count
+	const iterations = 20
+
+	for _, s := range scenarios {
+		t.Run(s.pattern, func(t *testing.T) {
+			counts := map[rune]int{}
+
+			for i := 0; i < iterations; i++ {
+				str, err := security.RandomStringByRegex(s.pattern)
+				if err != nil {
+					t.Fatal(err)
+				}
+
+				for _, c := range str {
+					counts[c]++
+				}
+			}
+
+			alphabet := []rune(s.alphabet)
+			expected := float64(iterations*1000) / float64(len(alphabet))
+
+			if len(counts) != len(alphabet) {
+				t.Fatalf("Expected %d distinct chars, got %d: %v", len(alphabet), len(counts), counts)
+			}
+
+			for _, c := range alphabet {
+				count := float64(counts[c])
+				if count < expected*0.5 || count > expected*1.5 {
+					t.Errorf("Expected %q to be generated ~%.0f times, got %.0f", c, expected, count)
+				}
+			}
+		})
+	}
+}
