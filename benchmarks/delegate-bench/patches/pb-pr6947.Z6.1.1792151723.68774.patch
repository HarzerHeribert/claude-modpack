+// rangeSize returns the number of valid runes in the inclusive [lo, hi] range.
+func rangeSize(lo rune, hi rune) int {
+	size := int(hi - lo + 1)
+
+	if lo <= surrogateMax && hi >= surrogateMin {
+		size -= int(min(hi, surrogateMax) - max(lo, surrogateMin) + 1)
+	}
+
+	return size
+}
+
+// nthRuneInRange returns the n-th (0-based) valid rune of a range starting at lo.
+func nthRuneInRange(lo rune, n int) rune {
+	if lo >= surrogateMin && lo <= surrogateMax {
+		lo = surrogateMax + 1
+	}
+
+	r := lo + rune(n)
+
+	if lo < surrogateMin && r >= surrogateMin {
+		r += surrogateMax - surrogateMin + 1
 	}
 
-	return min + rune(offset), nil
+	return r
