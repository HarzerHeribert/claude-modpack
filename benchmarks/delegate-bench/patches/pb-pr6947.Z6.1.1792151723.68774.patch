+func TestRandomStringByRegexCharClassDistribution(t *testing.T) {
+	const samplesPerChar = 1000
+
+	scenarios := []struct {
+		pattern string
+		chars   string
+	}{
+		{`[A-Za-z0-9\-_]`, "-_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"},
+		{`[a-z0-9]`, "0123456789abcdefghijklmnopqrstuvwxyz"},
+		{`.`, "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"},
+	}
+
+	for _, s := range scenarios {
+		t.Run(s.pattern, func(t *testing.T) {
+			counts := map[rune]int{}
+
+			// the max allowed repeat count is 1000
+			for range len(s.chars) {
+				str, err := security.RandomStringByRegex(s.pattern + "{" + strconv.Itoa(samplesPerChar) + "}")
+				if err != nil {
+					t.Fatal(err)
+				}
+
+				for _, c := range str {
+					counts[c]++
+				}
+			}
+
+			if len(counts) != len(s.chars) {
+				t.Fatalf("Expected %d distinct chars, got %d: %v", len(s.chars), len(counts), counts)
+			}
+
+			// the tolerance is ~10 standard deviations so that the test doesn't flake
+			for _, c := range s.chars {
+				if counts[c] < samplesPerChar*7/10 || counts[c] > samplesPerChar*13/10 {
+					t.Errorf("Expected %q to be generated ~%d times, got %d", c, samplesPerChar, counts[c])
+				}
+			}
+		})
+	}
+}
+
+func TestRandomStringByRegexSkipSurrogates(t *testing.T) {
+	// the only valid runes in the range are U+D7FF and U+E000
+	str, err := security.RandomStringByRegex(`[\x{D7FF}-\x{E000}]{100}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	counts := map[rune]int{}
+	for _, c := range str {
+		counts[c]++
+	}
+
+	if len(counts) != 2 || counts['\uD7FF'] == 0 || counts['\uE000'] == 0 {
+		t.Fatalf("Expected only U+D7FF and U+E000 runes, got %v", counts)
+	}
+}
