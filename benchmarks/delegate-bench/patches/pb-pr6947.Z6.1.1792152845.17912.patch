+func TestRandomStringByRegexDistribution(t *testing.T) {
+	scenarios := []struct {
+		class string
+		chars string
+	}{
+		{`[a-z0-9]`, "abcdefghijklmnopqrstuvwxyz0123456789"},
+		{`[A-Za-z0-9\-_]`, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"},
+		{`[a-z_]`, "abcdefghijklmnopqrstuvwxyz_"},
+	}
+
+	// with ~200 draws per character the allowed ±50% deviation is ~7 standard
+	// deviations so the test shouldn't be flaky, while the old per-range
+	// selection (e.g. "_" in [a-z_] being picked 50% of the time) fails it
+	const expectedPerChar = 200
+	const strLength = 100
+
+	for _, s := range scenarios {
+		t.Run(s.class, func(t *testing.T) {
+			pattern := fmt.Sprintf("%s{%d}", s.class, strLength)
+
+			counts := make(map[rune]int, len(s.chars))
+			for _, c := range s.chars {
+				counts[c] = 0
+			}
+
+			total := expectedPerChar * len(counts)
+			for i := 0; i < total/strLength; i++ {
+				str, err := security.RandomStringByRegex(pattern)
+				if err != nil {
+					t.Fatal(err)
+				}
+
+				for _, c := range str {
+					if _, ok := counts[c]; !ok {
+						t.Fatalf("Unexpected character %q", c)
+					}
+					counts[c]++
+				}
+			}
+
+			for c, count := range counts {
+				if count < expectedPerChar/2 || count > expectedPerChar*3/2 {
+					t.Errorf("Expected %q to be generated ~%d times, got %d", c, expectedPerChar, count)
+				}
+			}
+		})
+	}
+}
