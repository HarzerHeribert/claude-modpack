index 0000000..dbb9efb
--- /dev/null
+++ b/tests/test_utils/test_display_filename.py
@@ -0,0 +1,9 @@
+import click
+
+
+def test_filename_formatting():
+    assert click.display_filename(b"foo.txt") == "foo.txt"
+    assert click.display_filename(b"/x/foo.txt") == "/x/foo.txt"
+    assert click.display_filename("/x/foo.txt") == "/x/foo.txt"
+    assert click.display_filename("/x/foo.txt", shorten=True) == "foo.txt"
+    assert click.display_filename("/x/\ufffd.txt", shorten=True) == "�.txt"
