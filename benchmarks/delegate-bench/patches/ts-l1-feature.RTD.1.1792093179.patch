@@ -0,0 +1,72 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (week-numbering year, week and optional weekday 1-7 = Monday-Sunday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+    Without a weekday, the date is the Monday of that week.
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Don't fall back to a shorter week date when more digits follow
+    "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th
+        const date = createUTCDate(year, 0, 4);
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - (jan4IsoWeekday - 1) + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
+
+function getISOWeeksInYear(year: number): number {
+    // A year has 53 ISO weeks when it starts or ends on a Thursday
+    const startsOnThursday = createUTCDate(year, 0, 1).getUTCDay() === 4;
+    const endsOnThursday = createUTCDate(year, 11, 31).getUTCDay() === 4;
+    return startsOnThursday || endsOnThursday ? 53 : 52;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..9e030bd
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,207 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www) is the Monday of the week", () => {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", () => {
+    testSingleCase(chrono, "2026W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W424", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", () => {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Compact week date with lowercase w", () => {
+    testSingleCase(chrono, "2026w424", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026w424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date with weekday 7 is Sunday", () => {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week date within a sentence", () => {
+    testSingleCase(chrono, "The sprint starts on 2026-W43-1 as planned", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W43-1");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+    });
+});
+
+test("Test - Compact week date within a sentence", () => {
+    testSingleCase(chrono, "Release planned for 2026W45.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2026W45");
+        expect(result.start).toBeDate(new Date(2026, 11 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date in casual mode", () => {
+    testSingleCase(chrono.casual, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", () => {
+    testSingleCase(chrono, "2026-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W01-1");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 53 of a year starting on Thursday", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 of a leap year starting on Wednesday, ending in the next calendar year", () => {
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week date followed by a time", () => {
+    testSingleCase(chrono, "2026-W42-4 at 10am", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4 at 10am");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10));
+    });
+});
+
+test("Test - Week 00 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Week above 53 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Week 53 of a year with 52 weeks is not a week date", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Week 53 of a non-leap year starting on Wednesday is not a week date", () => {
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Compact week 53 of a year with 52 weeks is not a week date", () => {
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Weekday 0 is not a week date, not even without the weekday", () => {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Weekday 8 is not a week date, not even without the weekday", () => {
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Weekday 9 is not a week date, not even without the weekday", () => {
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Compact weekday 0 is not a week date, not even without the weekday", () => {
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Compact weekday 8 is not a week date, not even without the weekday", () => {
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Invalid weekday within a sentence is not a week date", () => {
+    testUnexpectedResult(chrono, "Due on 2026-W42-8 at the latest", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Extended week with more than one weekday digit is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W42-45", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Mixed extended week and compact weekday is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W424", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Mixed compact week and extended weekday is not a week date", () => {
+    testUnexpectedResult(chrono, "2026W42-4", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Single-digit week is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 10 - 1, 15));
+});
