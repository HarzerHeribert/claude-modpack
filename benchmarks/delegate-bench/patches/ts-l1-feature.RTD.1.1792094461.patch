diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..93b8c70
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,63 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week dates
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// The week and weekday digits are captured loosely; invalid values are rejected in innerExtract,
+// so that a shorter prefix (e.g. "2026-W01" in "2026-W01-8") is never matched.
+const PATTERN = new RegExp(
+    `([0-9]{4})(?:-[Ww]([0-9]{2})(?:-([0-9]))?|[Ww]([0-9]{2})([0-9])?)` + `(?![0-9A-Za-z]|-[0-9])`
+);
+
+const YEAR_GROUP = 1;
+const EXTENDED_WEEK_GROUP = 2;
+const EXTENDED_WEEKDAY_GROUP = 3;
+const COMPACT_WEEK_GROUP = 4;
+const COMPACT_WEEKDAY_GROUP = 5;
+
+function isoWeekdayOfJan1(year: number): number {
+    // 1 = Monday ... 7 = Sunday
+    return new Date(Date.UTC(year, 0, 1)).getUTCDay() || 7;
+}
+
+function weeksInYear(year: number): number {
+    const jan1 = isoWeekdayOfJan1(year);
+    const isLeap = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+    return jan1 === 4 || (isLeap && jan1 === 3) ? 53 : 52;
+}
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_GROUP] ?? match[COMPACT_WEEK_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_GROUP] ?? match[COMPACT_WEEKDAY_GROUP];
+        const isoWeekday = weekdayText === undefined ? 1 : parseInt(weekdayText);
+
+        if (week < 1 || week > weeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th.
+        const jan4 = Date.UTC(year, 0, 4);
+        const jan4Weekday = new Date(Date.UTC(year, 0, 4)).getUTCDay() || 7;
+        const dayOffset = (week - 1) * 7 + (isoWeekday - 1) - (jan4Weekday - 1);
+        const date = new Date(jan4 + dayOffset * 24 * 60 * 60 * 1000);
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": isoWeekday % 7,
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
