diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..b32a018
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,57 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// Dashed: YYYY-Www or YYYY-Www-D. Compact: YYYYWww or YYYYWwwD.
+const PATTERN = new RegExp("(\\d{4})(?:-w(\\d{2})(?:-(\\d))?|w(\\d{2})(\\d)?)(?!\\w|-\\d)", "i");
+
+const YEAR_GROUP = 1;
+const DASHED_WEEK_GROUP = 2;
+const DASHED_WEEKDAY_GROUP = 3;
+const COMPACT_WEEK_GROUP = 4;
+const COMPACT_WEEKDAY_GROUP = 5;
+
+/**
+ * Parser for ISO 8601 week dates.
+ * - 2020-W10-3
+ * - 2020-W10
+ * - 2020W103
+ * - 2020W10
+ */
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const isoYear = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[DASHED_WEEK_GROUP] ?? match[COMPACT_WEEK_GROUP]);
+        const weekdayText = match[DASHED_WEEKDAY_GROUP] ?? match[COMPACT_WEEKDAY_GROUP];
+        const isoWeekday = weekdayText === undefined ? 1 : parseInt(weekdayText);
+
+        if (week < 1 || week > weeksInIsoYear(isoYear) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Monday of ISO week 1 is the Monday on or before Jan 4th.
+        const jan4 = new Date(Date.UTC(isoYear, 0, 4));
+        const jan4Weekday = jan4.getUTCDay() || 7;
+        const date = new Date(Date.UTC(isoYear, 0, 4 - (jan4Weekday - 1) + (week - 1) * 7 + (isoWeekday - 1)));
+
+        const result = context.createParsingResult(match.index, match.index + match[0].length);
+        result.start.assign("year", date.getUTCFullYear());
+        result.start.assign("month", date.getUTCMonth() + 1);
+        result.start.assign("day", date.getUTCDate());
+        result.start.assign("weekday", date.getUTCDay());
+        result.start.addTag("parser/ENISOWeekDateParser");
+        return result;
+    }
+}
+
+function weeksInIsoYear(year: number): number {
+    // Dec 28th always falls in the last ISO week of its year.
+    const dec28 = new Date(Date.UTC(year, 11, 28));
+    const jan4 = new Date(Date.UTC(year, 0, 4));
+    const jan4Weekday = jan4.getUTCDay() || 7;
+    const week1Monday = Date.UTC(year, 0, 4 - (jan4Weekday - 1));
+    return Math.floor((dec28.getTime() - week1Monday) / (7 * 24 * 3600 * 1000)) + 1;
+}
