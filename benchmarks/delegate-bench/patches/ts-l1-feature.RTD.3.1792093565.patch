--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,76 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week date
+// https://en.wikipedia.org/wiki/ISO_week_date
+// - YYYY-Www   (e.g. 2024-W10, the Monday of the week)
+// - YYYY-Www-D (e.g. 2024-W10-3, 1 = Monday ... 7 = Sunday)
+// - YYYYWww    (compact form)
+// - YYYYWwwD   (compact form)
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([1-7]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([1-7])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Reject instead of matching a shorter week date (e.g. "2024-W10-8", "2024W108", "2024-W10-12")
+    "(?!\\w|-\\d)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const isoWeekday = parseInt(match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP] ?? "1");
+        if (week < 1 || week > getISOWeeksInYear(year)) {
+            return null;
+        }
+
+        const date = getISOWeekOneMonday(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday of the ISO week 1 (the week containing January 4th) as a UTC date.
+ */
+function getISOWeekOneMonday(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(4 - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+/**
+ * Returns 53 if the ISO week-numbering year has 53 weeks (it starts or ends on a Thursday), otherwise 52.
+ */
+function getISOWeeksInYear(year: number): number {
+    const firstDay = new Date(0);
+    firstDay.setUTCFullYear(year, 0, 1);
+    const lastDay = new Date(0);
+    lastDay.setUTCFullYear(year, 11, 31);
+    return firstDay.getUTCDay() === 4 || lastDay.getUTCDay() === 4 ? 53 : 52;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..88f9db1
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,181 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - ISO week date (YYYY-Www)", () => {
+    testSingleCase(chrono, "2024-W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W10");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2024-w10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-w10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2024-W10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W10-3");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(6);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2024-W10-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-1");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2024-W10-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+});
+
+test("Test - ISO week date in compact form (YYYYWww and YYYYWwwD)", () => {
+    testSingleCase(chrono, "2024W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2024W103", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2024w107", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024w107");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+});
+
+test("Test - ISO week date within text", () => {
+    testSingleCase(chrono, "The release is planned for 2024-W10-3.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W10-3");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review (2024W10), see notes", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2024W10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date crossing the calendar year", () => {
+    testSingleCase(chrono, "2026-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2026-W01-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W01-7");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week 53 in years with 53 weeks", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week date in strict and casual mode", () => {
+    testSingleCase(chrono.strict, "2024-W10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024-W10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - ISO week date with time", () => {
+    testSingleCase(chrono, "2024-W10-3 at 10am", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-3 at 10am");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 10));
+    });
+});
+
+test("Test - Invalid ISO week number", () => {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W99-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W5", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W100", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Invalid ISO weekday is not matched as a shorter week date", () => {
+    testUnexpectedResult(chrono, "2024-W10-0", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W10-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W10-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024W100", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024W108", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024W109", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024-W10-12", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "The release is planned for 2024-W10-8.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Mixed extended and compact ISO week date", () => {
+    testUnexpectedResult(chrono, "2024-W103", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2024W10-3", new Date(2026, 10 - 1, 15));
+});
