index 0000000..acbd975
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,67 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week dates
+// - YYYY-Www, YYYY-Www-D
+// - YYYYWww, YYYYWwwD
+// The trailing lookahead prevents falling back to a shorter match (e.g. "2020-W10-8" must not yield "2020-W10").
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" +
+        "|" +
+        "W([0-9]{2})([0-9])?" +
+    ")(?![0-9]|-[0-9])",
+    "i"
+);
+
+const YEAR_GROUP = 1;
+const DASHED_WEEK_GROUP = 2;
+const DASHED_WEEKDAY_GROUP = 3;
+const COMPACT_WEEK_GROUP = 4;
+const COMPACT_WEEKDAY_GROUP = 5;
+
+function isoWeekdayOfJan1(year: number): number {
+    return new Date(Date.UTC(year, 0, 1)).getUTCDay();
+}
+
+function isLeapYear(year: number): boolean {
+    return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+}
+
+function weeksInYear(year: number): number {
+    const jan1 = isoWeekdayOfJan1(year);
+    return jan1 === 4 || (isLeapYear(year) && jan1 === 3) ? 53 : 52;
+}
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[DASHED_WEEK_GROUP] ?? match[COMPACT_WEEK_GROUP]);
+        const weekdayText = match[DASHED_WEEKDAY_GROUP] ?? match[COMPACT_WEEKDAY_GROUP];
+        const isoWeekday = weekdayText != null ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > weeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Monday of ISO week 1 is the Monday of the week containing Jan 4th.
+        const jan4 = new Date(Date.UTC(year, 0, 4));
+        const jan4IsoWeekday = jan4.getUTCDay() || 7;
+        const dayOffset = 1 - jan4IsoWeekday + (week - 1) * 7 + (isoWeekday - 1);
+        const date = new Date(Date.UTC(year, 0, 4 + dayOffset));
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
