diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..6e37148
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,79 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, with an optional weekday (1 = Monday ... 7 = Sunday).
+    Without the weekday, it refers to the Monday of the week.
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?" +
+        // Do not fall back to a shorter match (e.g. "2020-W01" in "2020-W01-89")
+        "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        let isoWeekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // Either the extended (YYYY-Www-D) or the basic (YYYYWwwD) format, not a mix of both
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            isoWeekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+        }
+
+        if (week < 1 || week > 53 || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        const monday = getMondayOfFirstISOWeek(year);
+        monday.setUTCDate(monday.getUTCDate() + (week - 1) * 7);
+
+        // A week belongs to the year containing its Thursday, so the week 53 only exists in some years
+        const thursday = new Date(monday);
+        thursday.setUTCDate(monday.getUTCDate() + 3);
+        if (thursday.getUTCFullYear() !== year) {
+            return null;
+        }
+
+        const date = new Date(monday);
+        date.setUTCDate(monday.getUTCDate() + isoWeekday - 1);
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday of the first ISO week of the year (the week containing January 4th) as a UTC date.
+ */
+function getMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(Date.UTC(year, 0, 4));
+    date.setUTCFullYear(year);
+    const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+    date.setUTCDate(date.getUTCDate() - daysSinceMonday);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..5630c92
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,182 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - ISO week date without weekday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - ISO week date in compact form (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026W424", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase week designator", function () {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026w42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date within a sentence", function () {
+    testSingleCase(chrono, "The sprint starts in 2026-W43 as planned", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W43");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+    });
+
+    testSingleCase(chrono, "Deliver it on 2026-W43-5.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(14);
+        expect(result.text).toBe("2026-W43-5");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 23, 12));
+    });
+
+    testSingleCase(chrono, "(2026W435)", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(1);
+        expect(result.text).toBe("2026W435");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 23, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date falling in the previous calendar year", function () {
+    testSingleCase(chrono, "2020-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W01-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2015W537", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2026, 10 - 1, 15));
+
+    testSingleCase(chrono, "2021-W52-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 1 - 1, 2, 12));
+    });
+});
+
+test("Test - ISO week date with an invalid week", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W99", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date with an invalid weekday", function () {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2026-W42-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "Deliver it on 2026-W42-8.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date with trailing digits or mixed separators", function () {
+    testUnexpectedResult(chrono, "2026-W42-45", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W4245", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W424", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W42-4", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2026, 10 - 1, 15));
+});
