index 0000000..c01e6e7
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,50 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week dates:
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(`([0-9]{4})(?<sep>-?)[Ww]([0-9]{2})(?:\\k<sep>([0-9]))?(?![0-9]|-[0-9])`);
+
+const YEAR_GROUP = 1;
+const WEEK_GROUP = 3;
+const WEEKDAY_GROUP = 4;
+
+function weeksInIsoYear(year: number): number {
+    const jan1 = new Date(Date.UTC(year, 0, 1)).getUTCDay();
+    const isLeap = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+    return jan1 === 4 || (isLeap && jan1 === 3) ? 53 : 52;
+}
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[WEEK_GROUP]);
+        const isoWeekday = match[WEEKDAY_GROUP] === undefined ? 1 : parseInt(match[WEEKDAY_GROUP]);
+
+        if (week < 1 || week > weeksInIsoYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Monday of week 1 is the Monday of the week containing Jan 4th.
+        const jan4 = new Date(Date.UTC(year, 0, 4));
+        const jan4IsoWeekday = jan4.getUTCDay() || 7;
+        const offsetDays = 4 - jan4IsoWeekday + 1 + (week - 1) * 7 + (isoWeekday - 1);
+        const date = new Date(Date.UTC(year, 0, offsetDays));
+
+        const components = context.createParsingComponents();
+        components.assign("year", date.getUTCFullYear());
+        components.assign("month", date.getUTCMonth() + 1);
+        components.assign("day", date.getUTCDate());
+        components.assign("weekday", isoWeekday % 7);
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
