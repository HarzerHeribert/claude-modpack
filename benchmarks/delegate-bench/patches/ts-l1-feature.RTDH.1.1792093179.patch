@@ -0,0 +1,70 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]+))?" + // YYYY-Www[-D]
+        "|" +
+        "W([0-9]{2})([0-9]+)?" + // YYYYWww[D]
+    ")" +
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        if (week < 1 || week > 53) {
+            return null;
+        }
+
+        // The weekday pattern takes all following digits, so e.g. "2024-W01-12" is rejected instead of being
+        // read as "2024-W01".
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP] ?? "1";
+        if (!weekdayText.match(/^[1-7]$/)) {
+            return null;
+        }
+        const weekday = parseInt(weekdayText);
+
+        // January 4th is always in the first week of the ISO week-numbering year
+        const january4th = new Date(Date.UTC(year, 0, 4));
+        const firstMondayDay = 4 - ((january4th.getUTCDay() + 6) % 7);
+        const mondayDay = firstMondayDay + (week - 1) * 7;
+
+        // A week belongs to the year that contains its Thursday (e.g. this rejects week 53 of a 52-week year)
+        const thursday = new Date(Date.UTC(year, 0, mondayDay + 3));
+        if (thursday.getUTCFullYear() !== year) {
+            return null;
+        }
+
+        const date = new Date(Date.UTC(year, 0, mondayDay + weekday - 1));
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..133bde3
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,221 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W42");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date with Sunday (YYYY-Www-7)", function () {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W42", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W424", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Compact week date with lowercase w", function () {
+    testSingleCase(chrono, "2026w424", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026w424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W43-5, if nothing goes wrong.",
+        new Date(2026, 9, 15),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W43-5");
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 23, 12));
+        }
+    );
+});
+
+test("Test - Compact week date within a sentence", function () {
+    testSingleCase(chrono, "Sprint review (2026W43) in room 4", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2026W43");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "Due 2026-W42-4", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date in casual mode", function () {
+    testSingleCase(chrono.casual, "Due 2026-W42-4", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono, "2025-W01-1", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2025-W01-1");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2024, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 1 starting after January 1st", function () {
+    testSingleCase(chrono, "2027-W01", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2027-W01");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53 of a year with 53 weeks", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year", function () {
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 of a leap year starting on Wednesday", function () {
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Negative week date: week 00", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: week 00 with weekday", function () {
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: week above 53", function () {
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: week 53 with weekday of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 9, 15));
+});
+
+test("Test - Negative compact week date: week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025W53", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: weekday 0", function () {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: weekday 8", function () {
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: weekday 9", function () {
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: weekday 8 within a sentence", function () {
+    testUnexpectedResult(chrono, "Due 2026-W42-8, please.", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: two weekday digits", function () {
+    testUnexpectedResult(chrono, "2026-W42-12", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: weekday with a leading zero", function () {
+    testUnexpectedResult(chrono, "2026-W42-07", new Date(2026, 9, 15));
+});
+
+test("Test - Negative compact week date: weekday with leading zeros", function () {
+    testUnexpectedResult(chrono, "2026W42007", new Date(2026, 9, 15));
+});
+
+test("Test - Negative compact week date: weekday 0", function () {
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 9, 15));
+});
+
+test("Test - Negative compact week date: weekday 8", function () {
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date in strict mode: weekday 8", function () {
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2026, 9, 15));
+});
+
+test("Test - Negative week date: single digit week", function () {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 9, 15));
+});
