index 0000000..5301f79
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,76 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week date
+// - YYYY-Www
+// - YYYY-Www-D
+// - YYYYWww
+// - YYYYWwwD
+// The weekday digit is captured broadly and validated in innerExtract,
+// so that invalid weekday digits do not fall back to the shorter YYYY-Www form.
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "(\\d{4})(-?)W(\\d{2})" +
+    "(?:(-)?(\\d+))?" +
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const hasHyphen = match[SEPARATOR_GROUP] === "-";
+        const weekdayText = match[WEEKDAY_NUMBER_GROUP];
+        const weekdaySeparator = match[WEEKDAY_SEPARATOR_GROUP];
+
+        // Separators must be consistent: either all hyphens or none.
+        if (hasHyphen && weekdayText != null && weekdaySeparator == null) return null;
+        if (!hasHyphen && weekdaySeparator != null) return null;
+
+        // ISO weekday (1 = Monday ... 7 = Sunday), defaults to Monday.
+        let isoWeekday = 1;
+        if (weekdayText != null) {
+            if (!/^[1-7]$/.test(weekdayText)) return null;
+            isoWeekday = parseInt(weekdayText);
+        }
+
+        if (week < 1 || week > 53 || (week === 53 && !hasIso53Weeks(year))) {
+            return null;
+        }
+
+        // Monday of ISO week 1 is the Monday of the week containing Jan 4.
+        const jan4 = new Date(Date.UTC(year, 0, 4));
+        const jan4IsoWeekday = jan4.getUTCDay() || 7;
+        const week1Monday = Date.UTC(year, 0, 4 - (jan4IsoWeekday - 1));
+        const target = new Date(week1Monday + ((week - 1) * 7 + (isoWeekday - 1)) * 24 * 60 * 60 * 1000);
+
+        const components = context.createParsingComponents({
+            "year": target.getUTCFullYear(),
+            "month": target.getUTCMonth() + 1,
+            "day": target.getUTCDate(),
+            "weekday": target.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks iff Jan 1 is a Thursday, or it is a leap year and Jan 1 is a Wednesday.
+ */
+function hasIso53Weeks(year: number): boolean {
+    const jan1Weekday = new Date(Date.UTC(year, 0, 1)).getUTCDay();
+    const isLeapYear = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+    return jan1Weekday === 4 || (isLeapYear && jan1Weekday === 3);
+}
