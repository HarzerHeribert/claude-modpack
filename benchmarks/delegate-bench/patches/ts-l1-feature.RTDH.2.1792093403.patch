diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..609d2e4
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,76 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www   (e.g. 2024-W05)
+    - YYYY-Www-D (e.g. 2024-W05-3)
+    - YYYYWww    (e.g. 2024W05)
+    - YYYYWwwD   (e.g. 2024W053)
+
+    The week digits and weekday digit are captured loosely and validated in innerExtract(), and the pattern
+    refuses to stop before a trailing digit, so an invalid week date (e.g. 2024-W01-8) is rejected as a whole
+    instead of matching a shorter week date (e.g. 2024-W01).
+*/
+const PATTERN = new RegExp(`([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?(?!\\w|-\\d)`, "i");
+
+const YEAR_NUMBER_GROUP = 1;
+const YEAR_WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEK_WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const weekday = match[WEEKDAY_NUMBER_GROUP] ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+
+        // The weekday must use the same (extended or basic) format as the week, e.g. not 2024-W053 or 2024W05-3
+        if (match[WEEKDAY_NUMBER_GROUP] && match[YEAR_WEEK_SEPARATOR_GROUP] !== match[WEEK_WEEKDAY_SEPARATOR_GROUP]) {
+            return null;
+        }
+        if (week < 1 || week > getISOWeeksInYear(year) || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = getStartOfISOWeekYear(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    // Unlike Date.UTC(), setUTCFullYear() does not map the years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, month - 1, day);
+    return date;
+}
+
+// The Monday of the ISO week 1, which is the week containing January 4th
+function getStartOfISOWeekYear(year: number): Date {
+    const date = createUTCDate(year, 1, 4);
+    date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+// A year has 53 ISO weeks if it starts or ends on a Thursday, otherwise 52
+function getISOWeeksInYear(year: number): number {
+    const thursday = 4;
+    if (createUTCDate(year, 1, 1).getUTCDay() === thursday || createUTCDate(year, 12, 31).getUTCDay() === thursday) {
+        return 53;
+    }
+    return 52;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..630275a
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,201 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W05", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2024-W05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", function () {
+    testSingleCase(chrono, "2024W05", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2024W053", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024W053");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2024-w05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024-w05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2024w053", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024w053");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Week date with Sunday weekday", function () {
+    testSingleCase(chrono, "2024-W05-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 2 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date in a different calendar year", function () {
+    testSingleCase(chrono, "2025-W01-1", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2025-W01-1");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2024, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2009-W53-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2015W537", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2024-W05-3, see you then", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review (2024W05)", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2024W05");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date with time", function () {
+    testSingleCase(chrono, "2024-W05-3 at 10am", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3 at 10am");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 10));
+    });
+});
+
+test("Test - Week date in strict and casual mode", function () {
+    testSingleCase(chrono.strict, "2024-W05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024-W05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W00-1", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W00", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W54", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W541", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W99", new Date(2026, 9, 15));
+});
+
+test("Test - Week 53 in a year with 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W53", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W537", new Date(2026, 9, 15));
+});
+
+test("Test - Invalid weekday number", function () {
+    testUnexpectedResult(chrono, "2024-W05-0", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W05-8", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W05-9", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W050", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W058", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W059", new Date(2026, 9, 15));
+});
+
+test("Test - Invalid weekday number within a sentence", function () {
+    testUnexpectedResult(chrono, "The release is planned for 2024-W05-8, see you then", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "Sprint review (2024W050)", new Date(2026, 9, 15));
+});
+
+test("Test - Malformed week dates", function () {
+    testUnexpectedResult(chrono, "2024-W5", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W05-12", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W0512", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024-W053", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2024W05-3", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "12024-W05", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "X2024-W05", new Date(2026, 9, 15));
+});
