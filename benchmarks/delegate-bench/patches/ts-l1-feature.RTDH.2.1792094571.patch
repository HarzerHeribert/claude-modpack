+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+const REF_DATE = new Date(2026, 9, 15, 12);
+
+test("Test - Single Expression (YYYY-Www)", function () {
+    testSingleCase(chrono.strict, "2024-W15", REF_DATE, (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W15");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(8);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags().has("parser/ENISOWeekDateParser")).toBe(true);
+    });
+});
+
+test("Test - Single Expression (YYYY-Www-D)", function () {
+    testSingleCase(chrono.strict, "2024-W15-3", REF_DATE, (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W15-3");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(10);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags().has("parser/ENISOWeekDateParser")).toBe(true);
+    });
+});
+
+test("Test - Single Expression (YYYYWww compact)", function () {
+    testSingleCase(chrono.strict, "2020W01", REF_DATE, (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2020W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags().has("parser/ENISOWeekDateParser")).toBe(true);
+    });
+});
+
+test("Test - Single Expression (YYYYWwwD compact)", function () {
+    testSingleCase(chrono.strict, "2024W153", REF_DATE, (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024W153");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(10);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags().has("parser/ENISOWeekDateParser")).toBe(true);
+    });
+});
+
+test("Test - Single Expression (lowercase w)", function () {
+    testSingleCase(chrono.strict, "2020-w01-1", REF_DATE, (result) => {
+        expect(result.text).toBe("2020-w01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+    });
+});
+
+test("Test - Single Expression (lowercase w compact)", function () {
+    testSingleCase(chrono.strict, "2020w01", REF_DATE, (result) => {
+        expect(result.text).toBe("2020w01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+    });
+});
+
+test("Test - Single Expression (year boundary 2026-W01-1 into 2025)", function () {
+    testSingleCase(chrono.strict, "2026-W01-1", REF_DATE, (result) => {
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+    });
+});
+
+test("Test - Single Expression (year boundary 2020-W53-5 into 2021)", function () {
