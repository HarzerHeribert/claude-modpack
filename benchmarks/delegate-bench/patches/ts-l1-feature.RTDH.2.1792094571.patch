+});
+
+test("Test - Single Expression (year boundary 2004-W53-7 into 2005)", function () {
+    testSingleCase(chrono.strict, "2004-W53-7", REF_DATE, (result) => {
+        expect(result.start.get("year")).toBe(2005);
+        expect(result.start.get("month")).toBe(1);
