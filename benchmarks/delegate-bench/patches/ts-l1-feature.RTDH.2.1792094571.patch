@@ -0,0 +1,79 @@
+import { ParsingContext } from "../../../chrono";
+import { ParsingComponents } from "../../../results";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date:
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+    (D = weekday, 1 = Monday ... 7 = Sunday)
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-[Ww]([0-9]{2})(?:-([1-7]))?" + // YYYY-Www[-D]
+        "|" +
+        "[Ww]([0-9]{2})([1-7])?" + // YYYYWww[D]
+    ")" +
+    "(?![0-9A-Za-z]|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const DASH_WEEK_NUMBER_GROUP = 2;
+const DASH_WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function isLeapYear(year: number): boolean {
+    return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+}
+
+function utcDate(year: number, month: number, day: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
+
+/** An ISO year has 53 weeks iff Jan 1 is a Thursday, or it is a leap year and Jan 1 is a Wednesday. */
+function hasWeek53(year: number): boolean {
+    const jan1Day = utcDate(year, 0, 1).getUTCDay();
+    return jan1Day === 4 || (isLeapYear(year) && jan1Day === 3);
+}
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray): ParsingComponents | null {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const isDashForm = match[DASH_WEEK_NUMBER_GROUP] != null;
+        const week = parseInt(isDashForm ? match[DASH_WEEK_NUMBER_GROUP] : match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayText = isDashForm ? match[DASH_WEEKDAY_NUMBER_GROUP] : match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > 53 || (week === 53 && !hasWeek53(year))) {
+            return null;
+        }
+
+        // The Monday of ISO week 1 is the Monday of the week containing Jan 4.
+        const jan4 = utcDate(year, 0, 4);
+        const jan4Monday = (jan4.getUTCDay() + 6) % 7;
+        const week1Monday = jan4.getTime() - jan4Monday * DAY_MS;
+        const target = new Date(week1Monday + ((week - 1) * 7 + (isoWeekday - 1)) * DAY_MS);
+
+        const components = context.createParsingComponents({
+            year: target.getUTCFullYear(),
+            month: target.getUTCMonth() + 1,
+            day: target.getUTCDate(),
+        });
+        components.assign("weekday", target.getUTCDay());
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
