+    });
+});
+
+test("Test - Single Expression (2015-W53 valid 53-week year)", function () {
+    testSingleCase(chrono.strict, "2015-W53", REF_DATE, (result) => {
+        expect(result.text).toBe("2015-W53");
+        expect(result.start.get("year")).toBe(2015);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(28);
+        expect(result.start.get("weekday")).toBe(1);
+    });
+});
+
+test("Test - Single Expression (2020-W53 valid leap year with Jan 1 Wednesday)", function () {
+    testSingleCase(chrono.strict, "2020-W53", REF_DATE, (result) => {
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(28);
+    });
+});
+
+test("Test - Single Expression (2021-W52 last week of 52-week year)", function () {
+    testSingleCase(chrono.strict, "2021-W52-7", REF_DATE, (result) => {
+        expect(result.start.get("year")).toBe(2022);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(0);
+    });
+});
+
+test("Test - Single Expression (embedded in sentence)", function () {
+    testSingleCase(chrono.strict, "The release is planned for 2024-W15-3 at the latest", REF_DATE, (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W15-3");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(10);
+    });
+});
+
+test("Test - Single Expression (casual parser)", function () {
+    testSingleCase(chrono.casual, "The release is planned for 2024-W15-3 at the latest", REF_DATE, (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W15-3");
+        expect(result.start.get("day")).toBe(10);
+        expect(result.tags().has("parser/ENISOWeekDateParser")).toBe(true);
+    });
+});
+
+test("Test - Single Expression (casual parser, compact)", function () {
+    testSingleCase(chrono.casual, "2024W15", REF_DATE, (result) => {
+        expect(result.text).toBe("2024W15");
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(8);
+    });
+});
+
+test("Test - Unexpected Result (week 00)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W00", REF_DATE);
+});
+
+test("Test - Unexpected Result (week 54)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W54", REF_DATE);
+});
+
+test("Test - Unexpected Result (week 53 in 52-week year)", function () {
+    testUnexpectedResult(chrono.strict, "2021-W53", REF_DATE);
+});
+
+test("Test - Unexpected Result (week 53 in 52-week year, with weekday)", function () {
+    testUnexpectedResult(chrono.strict, "2021-W53-1", REF_DATE);
+});
+
+test("Test - Unexpected Result (weekday 0)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W01-0", REF_DATE);
+});
+
+test("Test - Unexpected Result (weekday 8)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W01-8", REF_DATE);
+});
+
+test("Test - Unexpected Result (weekday 9)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W01-9", REF_DATE);
+});
+
+test("Test - Unexpected Result (compact weekday 8, no shorter match)", function () {
+    testUnexpectedResult(chrono.strict, "2020W018", REF_DATE);
+});
+
+test("Test - Unexpected Result (trailing digits after weekday)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W01-12", REF_DATE);
+});
+
+test("Test - Unexpected Result (trailing digits compact)", function () {
+    testUnexpectedResult(chrono.strict, "2020W0123", REF_DATE);
+});
+
+test("Test - Unexpected Result (mixed form, separator then compact digit)", function () {
+    testUnexpectedResult(chrono.strict, "2020-W011", REF_DATE);
+});
+
