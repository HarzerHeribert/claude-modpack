@@ -0,0 +1,69 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (week-numbering year, week number, and optional weekday, 1 = Monday ... 7 = Sunday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Also reject a following "-<digit>" so that e.g. "2020-W01-10" doesn't fall back to "2020-W01"
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP] ?? "1");
+        if (week < 1 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th. Find the day-of-January of the requested week's Monday.
+        const jan4Weekday = createUTCDate(year, 4).getUTCDay() || 7;
+        const monday = 4 - (jan4Weekday - 1) + (week - 1) * 7;
+
+        // A week belongs to the year of its Thursday (this rejects e.g. week 53 of a year with 52 weeks)
+        if (createUTCDate(year, monday + 3).getUTCFullYear() !== year) {
+            return null;
+        }
+
+        const date = createUTCDate(year, monday + weekday - 1);
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function createUTCDate(year: number, dayOfJanuary: number): Date {
+    // Unlike Date.UTC(), setUTCFullYear() doesn't map the years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, dayOfJanuary);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..5373564
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,234 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+
+    testSingleCase(chrono, "2009-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result.start.get("year")).toBe(2008);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2004-W53-6", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2004-W53-6");
+        expect(result.start.get("year")).toBe(2005);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(6);
+        expect(result.start).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date without weekday (YYYY-Www) is the Monday of the week", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2020-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2021-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2021-W01");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026W424", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2009W537", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009W537");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Lowercase week designator", function () {
+    testSingleCase(chrono, "2026-w42-4", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026w42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2026W535", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W535");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2015W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2015W53");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Date is certain, time is implied", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2012, 7, 10), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+
+    testSingleCase(chrono, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date in sentence", function () {
+    testSingleCase(chrono, "The sprint starts on 2026-W42-4.", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "Ship it by 2020W537, please", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2020W537");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "Planning (2026-W42) is done", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(10);
+        expect(result.text).toBe("2026-W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date followed by time", function () {
+    testSingleCase(chrono, "2026-W42-4 at 10:30", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-4 at 10:30");
+        expect(result.start.get("hour")).toBe(10);
+        expect(result.start.get("minute")).toBe(30);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10, 30));
+    });
+});
+
+test("Test - Strict and casual mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W42-4", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2026-W54", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021W531", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2025-W53-7", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday is not shortened to a week", function () {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W420", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W428", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W429", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "The sprint starts on 2026-W42-8.", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2012, 7, 10));
+});
+
+test("Test - Malformed week dates", function () {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W424", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W42-4", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W42-10", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W42x", new Date(2012, 7, 10));
+});
