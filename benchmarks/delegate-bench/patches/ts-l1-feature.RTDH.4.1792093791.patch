index 0000000..06a9340
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,69 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([1-7]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([1-7])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Reject, rather than shorten, a week date followed by more digits (e.g. "2020-W01-8" or "2020W018")
+    "(?!-[0-9])(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP] ?? "1");
+
+        const firstMonday = getMondayOfFirstISOWeek(year);
+        const nextYearFirstMonday = getMondayOfFirstISOWeek(year + 1);
+        const weeksInYear = Math.round((nextYearFirstMonday.getTime() - firstMonday.getTime()) / (7 * 24 * 3600000));
+        if (week < 1 || week > weeksInYear) {
+            return null;
+        }
+
+        const date = firstMonday;
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday (as a UTC date) of the week 1 of the ISO week-numbering `year`,
+ * which is the week containing the January 4th.
+ */
+function getMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(Date.UTC(2000, 0, 4));
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(4 - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..b1949fb
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,188 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2024-W10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W10-3");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(6);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W42-4 at the latest",
+        new Date(2026, 10 - 1, 1),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W42-4");
+
+            expect(result.start.get("weekday")).toBe(4);
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+        }
+    );
+
+    testSingleCase(chrono, "2024-W10-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+});
+
+test("Test - ISO week date without weekday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10");
+
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "Sprint planning: 2026-W42.", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(17);
+        expect(result.text).toBe("2026-W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date in compact form (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2024W103", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2024W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "Shipped in 2026W424 as planned", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026W424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w", function () {
+    testSingleCase(chrono, "2024-w10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-w10-3");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2024w10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024w10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date outside its calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2015W534", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2015W534");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2024-W10-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date followed by a time", function () {
+    testSingleCase(chrono, "2024-W10-3 at 10:30", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W10-3 at 10:30");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 10, 30));
+    });
+});
+
+test("Test - Invalid ISO week number", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W99", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2020-W00-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2020-W54-1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week 53 in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2025W537", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "Due by 2021-W53 at the latest", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Invalid ISO weekday is not shortened to the week", function () {
+    testUnexpectedResult(chrono, "2020-W01-0", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W01-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W01-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W010", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W018", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W019", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2020-W01-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "2020W018", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "Due by 2020-W01-8 at the latest", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Malformed ISO week date", function () {
+    testUnexpectedResult(chrono, "2020-W1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W123", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W01-12", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W0112", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W011", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020W01-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "12020-W01", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "X2020-W01", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2020-W01X", new Date(2026, 10 - 1, 15));
+});
