diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..adb2df0
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,81 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (https://en.wikipedia.org/wiki/ISO_week_date)
+    - YYYY-Www   (e.g. 2020-W01, the Monday of the week)
+    - YYYY-Www-D (e.g. 2020-W01-3, D = 1 (Monday) ... 7 (Sunday))
+    - YYYYWww    (e.g. 2020W01)
+    - YYYYWwwD   (e.g. 2020W013)
+
+    The weekday position is captured as any digit (and `-<digit>` must not follow) so that an
+    invalid weekday (e.g. "2020-W01-8") rejects the whole expression instead of matching a shorter
+    week date (e.g. "2020-W01").
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+    "(?:(-?)([0-9]))?" +
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        let isoWeekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // The basic (YYYYWwwD) and extended (YYYY-Www-D) formats must not be mixed
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            isoWeekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+            if (isoWeekday < 1 || isoWeekday > 7) {
+                return null;
+            }
+        }
+
+        const firstWeekMonday = getMondayOfFirstISOWeek(year);
+        const weeksInYear = Math.round(
+            (getMondayOfFirstISOWeek(year + 1).getTime() - firstWeekMonday.getTime()) / (7 * 24 * 60 * 60 * 1000)
+        );
+        if (week < 1 || week > weeksInYear) {
+            return null;
+        }
+
+        const date = new Date(firstWeekMonday.getTime());
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday (as a UTC date) of the first ISO week of the ISO week-numbering year,
+ * which is the week containing January 4th.
+ */
+function getMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+    date.setUTCDate(date.getUTCDate() - daysSinceMonday);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..49fc33b
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,230 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Extended week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2020-W01-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2020-W01-3");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W42-5, see you there",
+        new Date(2026, 10 - 1, 1),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W42-5");
+
+            expect(result.start.get("weekday")).toBe(5);
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+        }
+    );
+});
+
+test("Test - Extended week date without weekday is the Monday of the week (YYYY-Www)", function () {
+    testSingleCase(chrono, "2020-W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2020-W01");
+
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review in 2026-W42.", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(17);
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2020W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020W01");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020W013", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020W013");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "Deadline: 2026W427 (end of week)", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(10);
+        expect(result.text).toBe("2026W427");
+
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Lowercase week designator", function () {
+    testSingleCase(chrono, "2020-w01-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-w01-3");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2020w013", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020w013");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week dates crossing the calendar year boundary", function () {
+    testSingleCase(chrono, "2009-W01-1", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2009-W53-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2024-W52-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2024-W52-7");
+        expect(result.start).toBeDate(new Date(2024, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2025-W01-1", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2025-W01-1");
+        expect(result.start).toBeDate(new Date(2024, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    // 2020 is a leap year starting on Wednesday
+    testSingleCase(chrono, "2020-W53", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    // 2015 is a common year starting on Thursday
+    testSingleCase(chrono, "2015W53", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2015W53");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+
+    // 2026 is a common year starting on Thursday
+    testSingleCase(chrono, "2026-W53-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W53-5");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Strict and casual configurations", function () {
+    testSingleCase(chrono.strict, "2020-W01-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono.strict, "2020W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020W01");
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-W01-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020W01");
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week date followed by time", function () {
+    testSingleCase(chrono, "2026-W42-5 at 3pm", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5 at 3pm");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 15));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W00-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W00", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W54", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W99-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W54", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2020-W00", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2020-W54", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 53 in years with only 52 ISO weeks", function () {
+    // 2021 is a common year starting on Friday
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 16));
+
+    // 2025 is a common year starting on Wednesday
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 10 - 1, 16));
+
+    // 2024 is a leap year starting on Monday
+    testUnexpectedResult(chrono, "2024-W53-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2024W531", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Invalid weekday does not fall back to the week", function () {
+    testUnexpectedResult(chrono, "2020-W01-0", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W01-8", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W01-9", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W010", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W018", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W019", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020-W01-12", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2020-W01-8", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2020W018", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "Due on 2020-W01-8 at the latest", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Mixed extended and compact forms", function () {
+    testUnexpectedResult(chrono, "2020-W013", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2020W01-3", new Date(2026, 10 - 1, 16));
+});
