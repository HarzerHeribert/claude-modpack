--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,69 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, with or without the weekday (the week's Monday when omitted).
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // Extended: YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // Basic (compact): YYYYWww or YYYYWwwD
+    ")" +
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        const firstMonday = getFirstMondayOfISOWeekYear(year);
+        const weeksInYear = (getFirstMondayOfISOWeekYear(year + 1) - firstMonday) / (7 * DAY_IN_MILLISECONDS);
+        if (week < 1 || week > weeksInYear || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        const date = new Date(firstMonday + ((week - 1) * 7 + (isoWeekday - 1)) * DAY_IN_MILLISECONDS);
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the UTC timestamp of the Monday that starts week 1 of the ISO week-numbering year
+ * (i.e. the Monday of the week containing January 4th).
+ */
+function getFirstMondayOfISOWeekYear(year: number): number {
+    const jan4 = new Date(0);
+    jan4.setUTCFullYear(year, 0, 4);
+    const daysSinceMonday = (jan4.getUTCDay() + 6) % 7;
+    return jan4.getTime() - daysSinceMonday * DAY_IN_MILLISECONDS;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..a5d5086
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,254 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Extended week date without weekday (YYYY-Www) is the week's Monday", () => {
+    testSingleCase(chrono.casual, "2026-W42", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W42");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Extended week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono.casual, "2026-W42-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Basic week date without weekday (YYYYWww)", () => {
+    testSingleCase(chrono.casual, "2026W42", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Basic week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono.casual, "2026W425", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Lowercase 'w' in extended format", () => {
+    testSingleCase(chrono.casual, "2020-w10-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-w10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Lowercase 'w' in basic format", () => {
+    testSingleCase(chrono.casual, "2020w103", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020w103");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Weekday 7 is Sunday", () => {
+    testSingleCase(chrono.casual, "2026-W42-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", () => {
+    testSingleCase(chrono.casual, "2020-W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 1 day 1 in the previous calendar year (2009-W01-1)", () => {
+    testSingleCase(chrono.casual, "2009-W01-1", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year (2009-W53-7)", () => {
+    testSingleCase(chrono.casual, "2009-W53-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in a year starting on Thursday (2015-W53-5)", () => {
+    testSingleCase(chrono.casual, "2015-W53-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week 53 in a leap year starting on Wednesday (2020-W53)", () => {
+    testSingleCase(chrono.casual, "2020-W53", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 in basic format (2004W536)", () => {
+    testSingleCase(chrono.casual, "2004W536", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.start).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Date components are certain and time is implied", () => {
+    testSingleCase(chrono.casual, "2026-W42-5", new Date(2026, 10 - 1, 16, 8, 30), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.start.isCertain("second")).toBe(false);
+        expect(result.start.get("hour")).toBe(12);
+        expect(result.end).toBeNull();
+    });
+});
+
+test("Test - Result is tagged with the parser", () => {
+    testSingleCase(chrono.casual, "2026-W42-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2026-W42-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Basic week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Extended week date embedded in a sentence", () => {
+    testSingleCase(
+        chrono.casual,
+        "The sprint starts on 2026-W43-1 and ends later",
+        new Date(2026, 10 - 1, 16),
+        (result) => {
+            expect(result.index).toBe(21);
+            expect(result.text).toBe("2026-W43-1");
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+        }
+    );
+});
+
+test("Test - Basic week date embedded in a sentence", () => {
+    testSingleCase(chrono.casual, "Release planned for 2026W44 at the latest", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2026W44");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 26, 12));
+    });
+});
+
+test("Test - Week date followed by punctuation", () => {
+    testSingleCase(chrono.casual, "Deadline: 2020-W53-5.", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(10);
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date in parentheses", () => {
+    testSingleCase(chrono.casual, "Kickoff (2026-W45)", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(9);
+        expect(result.text).toBe("2026-W45");
+        expect(result.start).toBeDate(new Date(2026, 11 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020-W00", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 00 in basic format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020W00", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week above 53 is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020-W54", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 99 in basic format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020W99", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 53 of a year with 52 weeks is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2021-W53", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 53 with weekday of a year with 52 weeks is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2021-W53-1", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 53 in basic format of a year with 52 weeks is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2021W53", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 0 is not a week date (not even without the weekday)", () => {
+    testUnexpectedResult(chrono.casual, "2020-W01-0", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 8 is not a week date (not even without the weekday)", () => {
+    testUnexpectedResult(chrono.casual, "2020-W01-8", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 9 is not a week date (not even without the weekday)", () => {
+    testUnexpectedResult(chrono.casual, "2020-W01-9", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 0 in basic format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020W010", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 8 in basic format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020W018", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Weekday 9 in basic format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020W019", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Invalid weekday embedded in a sentence is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "Due 2020-W01-8 sharp", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Invalid week in strict mode is not a week date", () => {
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Invalid weekday in strict mode is not a week date", () => {
+    testUnexpectedResult(chrono.strict, "2020W018", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Single-digit week is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020-W1", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Mixed basic and extended format is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020-W011", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Year with more than four digits is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "12020-W01", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week date attached to a word is not a week date", () => {
+    testUnexpectedResult(chrono.casual, "ID2020-W01", new Date(2026, 10 - 1, 16));
+});
