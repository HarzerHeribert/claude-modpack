@@ -0,0 +1,81 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (https://en.wikipedia.org/wiki/ISO_week_date)
+    - YYYY-Www   (e.g. 2020-W01, the Monday of the week)
+    - YYYY-Www-D (e.g. 2020-W01-3, D = 1 (Monday) ... 7 (Sunday))
+    - YYYYWww    (e.g. 2020W01)
+    - YYYYWwwD   (e.g. 2020W013)
+
+    The week date must not be followed by a word character or by "-" and a digit, so that an invalid
+    weekday (e.g. 2020-W01-8, 2020W018) does not get extracted as a shorter week date (2020-W01, 2020W01).
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // Extended: YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // Compact: YYYYWww or YYYYWwwD
+    ")" +
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > getISOWeeksInYear(year)) {
+            return null;
+        }
+        if (isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th (the week with the year's first Thursday)
+        const date = createUTCDate(year, 0, 4);
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - (jan4IsoWeekday - 1) + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the number of ISO weeks (52 or 53) in the ISO week-numbering year.
+ * A year has 53 weeks when it starts or ends on a Thursday.
+ */
+function getISOWeeksInYear(year: number): number {
+    const firstDayWeekday = createUTCDate(year, 0, 1).getUTCDay();
+    const lastDayWeekday = createUTCDate(year, 11, 31).getUTCDay();
+    return firstDayWeekday === 4 || lastDayWeekday === 4 ? 53 : 52;
+}
+
+function createUTCDate(year: number, monthIndex: number, day: number): Date {
+    // Use setUTCFullYear() to avoid Date.UTC() mapping years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, monthIndex, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..59fae01
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,245 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date without weekday (YYYY-Www)", () => {
+    testSingleCase(chrono, "2024-W10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "The sprint starts on 2024-W10 as planned", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W10");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2024-W10-2", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10-2");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(5);
+        expect(result.start.get("weekday")).toBe(2);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+
+    testSingleCase(chrono, "2008-W39-6", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2008-W39-6");
+        expect(result.start.get("weekday")).toBe(6);
+        expect(result).toBeDate(new Date(2008, 9 - 1, 27, 12));
+    });
+
+    testSingleCase(chrono, "2024-W10-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+
+    testSingleCase(chrono, "The meeting is on 2024-W10-3, see you there", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(18);
+        expect(result.text).toBe("2024-W10-3");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", () => {
+    testSingleCase(chrono, "2024W10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "Due in 2024W10.", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2024W10");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2024W107", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W107");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(10);
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+
+    testSingleCase(chrono, "Release planned for 2024W105 (tentative)", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2024W105");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Lowercase week designator", () => {
+    testSingleCase(chrono, "2024-w10-2", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-w10-2");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+
+    testSingleCase(chrono, "2024w10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024w10");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2024w102", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024w102");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+});
+
+test("Test - Week date crossing calendar year boundary", () => {
+    testSingleCase(chrono, "2020-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W01-3", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2009-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2007-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2007-W01-1");
+        expect(result).toBeDate(new Date(2007, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2009-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2004W536", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2004W536");
+        expect(result).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2026W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W53");
+        expect(result).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2024-W10-2", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10-2");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date in casual mode", () => {
+    testSingleCase(chrono.casual, "2024-W10-2", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10-2");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024W107", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W107");
+        expect(result).toBeDate(new Date(2024, 3 - 1, 10, 12));
+    });
+});
+
+test("Test - Invalid week number", () => {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W00-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W99", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2020-W54-1", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W537", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday is not extracted as a shorter week date", () => {
+    testUnexpectedResult(chrono, "2024-W10-0", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W10-8", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W10-9", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W100", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W108", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W109", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "The date 2024-W10-8 is invalid", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "The date 2024W109 is invalid", new Date(2012, 7, 10));
+});
+
+test("Test - Malformed week dates", () => {
+    testUnexpectedResult(chrono, "2024-W1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W101", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024-W10-12", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2024W1012", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "12024-W10", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "X2024W10", new Date(2012, 7, 10));
+});
