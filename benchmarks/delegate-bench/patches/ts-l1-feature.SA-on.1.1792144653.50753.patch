@@ -0,0 +1,76 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week dates
+// - YYYY-Www   / YYYYWww   (Monday of the week)
+// - YYYY-Www-D / YYYYWwwD  (D = 1 for Monday ... 7 for Sunday)
+//
+// The separator must be used consistently (extended or basic format). A trailing digit or "-digit"
+// that does not form a valid week date rejects the whole match, instead of falling back to a
+// shorter week date (e.g. "2020-W10-8" is not read as "2020-W10").
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+    "(?:(-?)([0-9]))?" +
+    "(?!-?[0-9])" +
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_GROUP = 5;
+
+const MILLISECONDS_IN_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        if (match[WEEKDAY_GROUP] && match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+            return null;
+        }
+
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[WEEK_GROUP]);
+        const isoWeekday = match[WEEKDAY_GROUP] ? parseInt(match[WEEKDAY_GROUP]) : 1;
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        const date = getStartOfISOWeekYear(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday of ISO week 1 (the week containing January 4th) of the ISO week-numbering year (as a UTC date).
+ */
+function getStartOfISOWeekYear(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+/**
+ * Returns the number of ISO weeks (52 or 53) in the ISO week-numbering year.
+ */
+function getISOWeeksInYear(year: number): number {
+    const start = getStartOfISOWeekYear(year).getTime();
+    const nextStart = getStartOfISOWeekYear(year + 1).getTime();
+    return Math.round((nextStart - start) / MILLISECONDS_IN_WEEK);
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..0b19a64
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,233 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+const refDate = new Date(2024, 5, 15, 12);
+
+test("Test - Week date without weekday (YYYY-Www) is the Monday of that week", function () {
+    testSingleCase(chrono, "2020-W10", refDate, (result) => {
+        expect(result.text).toBe("2020-W10");
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2020-W10-3", refDate, (result) => {
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date with weekday 7 is Sunday", function () {
+    testSingleCase(chrono, "2020-W10-7", refDate, (result) => {
+        expect(result.text).toBe("2020-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", function () {
+    testSingleCase(chrono, "2020W10", refDate, (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2020W103", refDate, (result) => {
+        expect(result.text).toBe("2020W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Lowercase w in week date", function () {
+    testSingleCase(chrono, "2020-w10-3", refDate, (result) => {
+        expect(result.text).toBe("2020-w10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Lowercase w in compact week date", function () {
+    testSingleCase(chrono, "2020w107", refDate, (result) => {
+        expect(result.text).toBe("2020w107");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Week 1 can start in the previous calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", refDate, (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 1 starting in the same calendar year", function () {
+    testSingleCase(chrono, "2021-W01", refDate, (result) => {
+        expect(result.text).toBe("2021-W01");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Last week of a 52-week year can end in the next calendar year", function () {
+    testSingleCase(chrono, "2021-W52-7", refDate, (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 1 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 53 in a 53-week leap year", function () {
+    testSingleCase(chrono, "2020-W53-5", refDate, (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week 53 in a 53-week common year", function () {
+    testSingleCase(chrono, "2015-W53-7", refDate, (result) => {
+        expect(result.text).toBe("2015-W53-7");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 without weekday", function () {
+    testSingleCase(chrono, "2026W53", refDate, (result) => {
+        expect(result.text).toBe("2026W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date embedded in a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2020-W10-3.", refDate, (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date embedded in a sentence", function () {
+    testSingleCase(chrono, "Sprint ends 2020W107, then we ship", refDate, (result) => {
+        expect(result.index).toBe(12);
+        expect(result.text).toBe("2020W107");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Week date components are certain and time is implied", function () {
+    testSingleCase(chrono, "2020-W10-3", refDate, (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.end).toBeNull();
+    });
+});
+
+test("Test - Week date result is tagged with the parser", function () {
+    testSingleCase(chrono, "2020-W10-3", refDate, (result) => {
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2020-W10-3", refDate, (result) => {
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date in casual mode", function () {
+    testSingleCase(chrono.casual, "2020W10", refDate, (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W00", refDate);
+});
+
+test("Test - Week 00 with weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W00-1", refDate);
+});
+
+test("Test - Week above 53 is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W54", refDate);
+});
+
+test("Test - Compact week above 53 is not a week date", function () {
+    testUnexpectedResult(chrono, "2020W99", refDate);
+});
+
+test("Test - Week 53 in a 52-week year is not a week date", function () {
+    testUnexpectedResult(chrono, "2021-W53", refDate);
+});
+
+test("Test - Week 53 with weekday in a 52-week year is not a week date", function () {
+    testUnexpectedResult(chrono, "2021-W53-1", refDate);
+});
+
+test("Test - Compact week 53 in a 52-week year is not a week date", function () {
+    testUnexpectedResult(chrono, "2021W53", refDate);
+});
+
+test("Test - Weekday 0 is not a week date (not even the shorter week)", function () {
+    testUnexpectedResult(chrono, "2020-W10-0", refDate);
+});
+
+test("Test - Weekday 8 is not a week date (not even the shorter week)", function () {
+    testUnexpectedResult(chrono, "2020-W10-8", refDate);
+});
+
+test("Test - Weekday 9 is not a week date (not even the shorter week)", function () {
+    testUnexpectedResult(chrono, "2020-W10-9", refDate);
+});
+
+test("Test - Compact weekday 0 is not a week date (not even the shorter week)", function () {
+    testUnexpectedResult(chrono, "2020W100", refDate);
+});
+
+test("Test - Compact weekday 8 is not a week date (not even the shorter week)", function () {
+    testUnexpectedResult(chrono, "2020W108", refDate);
+});
+
+test("Test - Two digits in the weekday position is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W10-12", refDate);
+});
+
+test("Test - Invalid weekday embedded in a sentence is not a week date", function () {
+    testUnexpectedResult(chrono, "Planned for 2020-W10-8.", refDate);
+});
+
+test("Test - Single-digit week is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W1", refDate);
+});
+
+test("Test - Week date followed by letters is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W10abc", refDate);
+});
+
+test("Test - Extended week with compact weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W103", refDate);
+});
+
+test("Test - Compact week with extended weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2020W10-3", refDate);
+});
