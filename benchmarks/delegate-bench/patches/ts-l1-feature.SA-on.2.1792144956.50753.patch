+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+});
+
+test("Test - Compact week date embedded in a sentence", () => {
+    testSingleCase(chrono, "Release planned for 2024W12.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2024W12");
