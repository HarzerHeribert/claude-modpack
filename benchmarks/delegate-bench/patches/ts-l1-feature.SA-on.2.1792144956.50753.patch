+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week without weekday (YYYY-Www) is the Monday of that week", () => {
+    testSingleCase(chrono, "2024-W05", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+});
+
+test("Test - Year, month, day and weekday are certain and time is implied", () => {
+    testSingleCase(chrono, "2024-W05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.start.get("hour")).toBe(12);
+        expect(result.end).toBeNull();
+    });
+});
+
+test("Test - Result is tagged by the parser", () => {
+    testSingleCase(chrono, "2024-W05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2024-W05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+});
+
+test("Test - Weekday 7 is Sunday", () => {
+    testSingleCase(chrono, "2024-W05-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-7");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(2);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 1, 4, 12));
+    });
+});
+
+test("Test - Compact week (YYYYWww)", () => {
+    testSingleCase(chrono, "2024W05", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W05");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+});
+
+test("Test - Compact week with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2024W053", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W053");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+});
+
+test("Test - Lowercase w (YYYY-www-D)", () => {
+    testSingleCase(chrono, "2024-w05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-w05-3");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+});
+
+test("Test - Lowercase w compact (YYYYwwwD)", () => {
+    testSingleCase(chrono, "2024w053", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024w053");
