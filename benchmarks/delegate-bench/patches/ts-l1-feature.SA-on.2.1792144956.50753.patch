+});
+
+test("Test - Week 53 of a year starting on Thursday", () => {
+    testSingleCase(chrono, "2015-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2015-W53");
+        expect(result.start.get("year")).toBe(2015);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(28);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2015, 11, 28, 12));
+    });
+});
+
+test("Test - Week 53 of 2009 ending in 2010", () => {
+    testSingleCase(chrono, "2009W537", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2009W537");
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2010, 0, 3, 12));
+    });
+});
+
+test("Test - Week 53 of 2026", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start.get("year")).toBe(2026);
