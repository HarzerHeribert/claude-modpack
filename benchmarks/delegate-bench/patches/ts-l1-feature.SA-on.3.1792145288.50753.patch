@@ -0,0 +1,85 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week dates
+// - YYYY-Www   (e.g. 2020-W01, the Monday of the week)
+// - YYYY-Www-D (e.g. 2020-W01-3)
+// - YYYYWww    (e.g. 2020W01, the Monday of the week)
+// - YYYYWwwD   (e.g. 2020W013)
+// The weekday D is 1 (Monday) to 7 (Sunday).
+//
+// The weekday is captured as any digit (and validated later), and the pattern must not be followed by
+// another digit (or "-" and a digit), so that an invalid week date (e.g. "2020-W01-8") is rejected
+// entirely instead of being matched as a shorter week date (e.g. "2020-W01").
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // Extended format
+        "|" +
+        "W([0-9]{2})([0-9])?" + // Basic (compact) format
+    ")" +
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_GROUP = 1;
+const EXTENDED_WEEK_GROUP = 2;
+const EXTENDED_WEEKDAY_GROUP = 3;
+const BASIC_WEEK_GROUP = 4;
+const BASIC_WEEKDAY_GROUP = 5;
+
+const MILLISECONDS_IN_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_GROUP] ?? match[BASIC_WEEK_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_GROUP] ?? match[BASIC_WEEKDAY_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > countISOWeeksInYear(year)) {
+            return null;
+        }
+        if (isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        const date = findMondayOfFirstISOWeek(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+        });
+        components.assign("weekday", date.getUTCDay());
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * The first ISO week of a year is the week (starting on Monday) that contains January 4th.
+ * @return the Monday of that week as a UTC date
+ */
+function findMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+    date.setUTCDate(date.getUTCDate() - daysSinceMonday);
+    return date;
+}
+
+/**
+ * @return the number of ISO weeks in the ISO week-numbering year (52 or 53)
+ */
+function countISOWeeksInYear(year: number): number {
+    const start = findMondayOfFirstISOWeek(year);
+    const end = findMondayOfFirstISOWeek(year + 1);
+    return Math.round((end.getTime() - start.getTime()) / MILLISECONDS_IN_WEEK);
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..509e2be
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,203 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - ISO week date (YYYY-Www) is the Monday of the week", () => {
+    testSingleCase(chrono, "2020-W01", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2020-W01-3", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week date compact form (YYYYWww)", () => {
+    testSingleCase(chrono, "2020W01", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020W01");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - ISO week date compact form with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2020W013", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020W013");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w", () => {
+    testSingleCase(chrono, "2020-w10-5", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-w10-5");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - ISO week date compact form with lowercase w", () => {
+    testSingleCase(chrono, "2020w105", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020w105");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - ISO week date with Sunday (weekday 7)", () => {
+    testSingleCase(chrono, "2025W017", new Date(2025, 5, 1), (result) => {
+        expect(result.text).toBe("2025W017");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2025, 1 - 1, 5, 12));
+    });
+});
+
+test("Test - ISO week date falling in the previous calendar year", () => {
+    testSingleCase(chrono, "2026-W01-1", new Date(2026, 5, 1), (result) => {
+        expect(result.text).toBe("2026-W01-1");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week 53 falling in the next calendar year", () => {
+    testSingleCase(chrono, "2020-W53-5", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week 53 compact form in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2015W537", new Date(2015, 5, 1), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 of 2026", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 5, 1), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week date within a sentence", () => {
+    testSingleCase(chrono, "The sprint starts on 2024-W15-2 and ends later", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W15-2");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 9, 12));
+    });
+});
+
+test("Test - ISO week date compact form within a sentence", () => {
+    testSingleCase(chrono, "Deadline: 2025W017.", new Date(2025, 0, 1), (result) => {
+        expect(result.index).toBe(10);
+        expect(result.text).toBe("2025W017");
+        expect(result.start).toBeDate(new Date(2025, 1 - 1, 5, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2024-W01", new Date(2024, 5, 1), (result) => {
+        expect(result.text).toBe("2024-W01");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week date compact form in strict mode", () => {
+    testSingleCase(chrono.strict, "2024W152", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024W152");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 9, 12));
+    });
+});
+
+test("Test - Invalid ISO week date: week 00", () => {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: week 00 compact form", () => {
+    testUnexpectedResult(chrono, "2020W00", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: week above 53", () => {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: week 53 in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2021, 5, 1));
+});
+
+test("Test - Invalid ISO week date: week 53 with weekday in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2021W531", new Date(2021, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 0", () => {
+    testUnexpectedResult(chrono, "2020-W01-0", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 8", () => {
+    testUnexpectedResult(chrono, "2020-W01-8", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 9", () => {
+    testUnexpectedResult(chrono, "2020-W01-9", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 0 compact form", () => {
+    testUnexpectedResult(chrono, "2020W010", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 8 compact form", () => {
+    testUnexpectedResult(chrono, "2020W018", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date: weekday 8 within a sentence", () => {
+    testUnexpectedResult(chrono, "The sprint starts on 2020-W01-8 and ends later", new Date(2020, 5, 1));
+});
+
+test("Test - Invalid ISO week date in strict mode", () => {
+    testUnexpectedResult(chrono.strict, "2020-W01-9", new Date(2020, 5, 1));
+});
