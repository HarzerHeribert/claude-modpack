@@ -0,0 +1,67 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www (e.g. "2020-W05"), the Monday of the week
+    - YYYY-Www-D (e.g. "2020-W05-3"), D is the weekday from 1 (Monday) to 7 (Sunday)
+    - YYYYWww and YYYYWwwD, the compact forms (e.g. "2020W05", "2020W053")
+*/
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?" +
+        // Do not fall back to a shorter week date when followed by more digits (e.g. "2020-W05-12")
+        "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        // The basic (e.g. "2020W053") and extended (e.g. "2020-W05-3") forms cannot be mixed
+        if (match[WEEKDAY_GROUP] && match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+            return null;
+        }
+
+        const year = parseInt(match[YEAR_GROUP]);
+        const week = parseInt(match[WEEK_GROUP]);
+        const isoWeekday = match[WEEKDAY_GROUP] ? parseInt(match[WEEKDAY_GROUP]) : 1;
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week with the year's first Thursday, i.e. the week containing January 4th
+        const date = new Date(0);
+        date.setUTCFullYear(year, 0, 4);
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - jan4IsoWeekday + 1 + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks if it starts on a Thursday, or if it is a leap year starting on a Wednesday.
+ */
+function getISOWeeksInYear(year: number): number {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 1);
+    const jan1Weekday = date.getUTCDay();
+    const isLeapYear = (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+    return jan1Weekday === 4 || (isLeapYear && jan1Weekday === 3) ? 53 : 52;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..2ca18cf
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,219 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date without weekday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2020-W05", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.end).toBeNull();
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(27);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 27, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2020-W05-3", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", function () {
+    testSingleCase(chrono, "2020W05", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020W05");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 27, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2020W053", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020W053");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2020-w05-3", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-w05-3");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Compact week date with lowercase w", function () {
+    testSingleCase(chrono, "2020w053", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020w053");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date embedded in a sentence", function () {
+    testSingleCase(chrono, "The sprint starts on 2020-W05-3 as planned", new Date(2020, 0, 1), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2020-W05-3");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Compact week date embedded in a sentence", function () {
+    testSingleCase(chrono, "Release (2020W05) is ready", new Date(2020, 0, 1), (result) => {
+        expect(result.index).toBe(9);
+        expect(result.text).toBe("2020W05");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 27, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2020-W05-3", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date with Sunday (weekday 7)", function () {
+    testSingleCase(chrono, "2020-W05-7", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 2 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 1 starting in the same calendar year", function () {
+    testSingleCase(chrono, "2021-W01-1", new Date(2021, 0, 1), (result) => {
+        expect(result.text).toBe("2021-W01-1");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53 in a year starting on Thursday", function () {
+    testSingleCase(chrono, "2015-W53-7", new Date(2015, 0, 1), (result) => {
+        expect(result.text).toBe("2015-W53-7");
+        expect(result.start.get("year")).toBe(2016);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in a leap year starting on Wednesday", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date followed by a time", function () {
+    testSingleCase(chrono, "2020-W05-3 at 10am", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W05-3 at 10am");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 29, 10));
+    });
+});
+
+test("Test - Invalid week 00", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid week 00 with weekday", function () {
+    testUnexpectedResult(chrono, "2020-W00-1", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid compact week 00", function () {
+    testUnexpectedResult(chrono, "2020W00", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid week above 53", function () {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid compact week above 53", function () {
+    testUnexpectedResult(chrono, "2020W541", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid week 53 in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2021, 0, 1));
+});
+
+test("Test - Invalid week 53 with weekday in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2016-W53-1", new Date(2016, 0, 1));
+});
+
+test("Test - Invalid week 53 embedded in a sentence", function () {
+    testUnexpectedResult(chrono, "Due by 2021-W53 at the latest", new Date(2021, 0, 1));
+});
+
+test("Test - Invalid weekday 0", function () {
+    testUnexpectedResult(chrono, "2020-W05-0", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid weekday 8", function () {
+    testUnexpectedResult(chrono, "2020-W05-8", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid weekday 9", function () {
+    testUnexpectedResult(chrono, "2020-W12-9", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid compact weekday 8", function () {
+    testUnexpectedResult(chrono, "2020W058", new Date(2020, 0, 1));
+});
+
+test("Test - Invalid compact weekday 0", function () {
+    testUnexpectedResult(chrono, "2020W050", new Date(2020, 0, 1));
+});
+
+test("Test - No shorter week date before extra digits", function () {
+    testUnexpectedResult(chrono, "2020-W05-12", new Date(2020, 0, 1));
+});
+
+test("Test - No shorter compact week date before extra digits", function () {
+    testUnexpectedResult(chrono, "2020W0512", new Date(2020, 0, 1));
+});
+
+test("Test - No week date when mixing extended week with compact weekday", function () {
+    testUnexpectedResult(chrono, "2020-W051", new Date(2020, 0, 1));
+});
+
+test("Test - No week date when mixing compact week with extended weekday", function () {
+    testUnexpectedResult(chrono, "2020W05-1", new Date(2020, 0, 1));
+});
+
+test("Test - No week date with a single-digit week", function () {
+    testUnexpectedResult(chrono, "2020-W5", new Date(2020, 0, 1));
+});
