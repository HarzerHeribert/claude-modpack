diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..1d8fd1c
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,62 @@
+import { ParsingContext } from "../../../chrono";
+import { ParsingComponents } from "../../../results";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, defaults to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    `([0-9]{4})` +
+        `(?:-W([0-9]{2})(?:-([0-9]))?|W([0-9]{2})([0-9])?)` +
+        // Don't fall back to a shorter week date when the weekday is malformed (e.g. "2024-W01-12")
+        "(?!-[0-9])" +
+        "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray): ParsingComponents | null {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+        if (week < 1 || week > 53 || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // The first ISO week of the year is the week (starting on Monday) that contains January 4th.
+        const date = new Date(0);
+        date.setUTCFullYear(year, 0, 4);
+        const firstMonday = 4 - ((date.getUTCDay() + 6) % 7);
+
+        // A week belongs to the year that contains its Thursday, so only some years have the week 53.
+        date.setUTCFullYear(year, 0, firstMonday + (week - 1) * 7 + 3);
+        if (date.getUTCFullYear() !== year) {
+            return null;
+        }
+
+        date.setUTCFullYear(year, 0, firstMonday + (week - 1) * 7 + (isoWeekday - 1));
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..96d031e
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,195 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date without weekday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W42");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(14);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 14, 12));
+    });
+
+    testSingleCase(chrono, "The release is planned for 2026-W05.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W05");
+
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+
+    testSingleCase(chrono, "2024-w42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-w42");
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 14, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2024-W42-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W42-3");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "We meet on 2026-W10-2, as agreed", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026-W10-2");
+
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2024-W42-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 20, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2024W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 14, 12));
+    });
+
+    testSingleCase(chrono, "2024W423", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W423");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "2024w423", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024w423");
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "Shipped in 2026W104 to everyone", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026W104");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 5, 12));
+    });
+});
+
+test("Test - Week date across the calendar year boundary", function () {
+    testSingleCase(chrono, "2008-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.get("year")).toBe(2007);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2026-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2021W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2020W535", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2024-W42-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W42-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024W42");
+        expect(result.start).toBeDate(new Date(2024, 10 - 1, 14, 12));
+    });
+});
+
+test("Test - Week date with time", function () {
+    testSingleCase(chrono, "2026-W10-2 at 10:30", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W10-2 at 10:30");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 3, 10, 30));
+    });
+});
+
+test("Test - Week date range", function () {
+    testSingleCase(chrono, "from 2026-W01 to 2026-W03", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(5);
+        expect(result.text).toBe("2026-W01 to 2026-W03");
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+        expect(result.end).toBeDate(new Date(2026, 1 - 1, 12, 12));
+    });
+});
+
+test("Test - Invalid week", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2025W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2025W537", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "The deadline is 2025-W53.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Invalid weekday", function () {
+    testUnexpectedResult(chrono, "2026-W01-0", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W01-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W01-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W010", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W018", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W019", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W01-12", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono.strict, "The deadline is 2026-W01-8.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Malformed week date", function () {
+    testUnexpectedResult(chrono, "2026-W1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W011", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W01-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W0112", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "12026-W01", new Date(2026, 10 - 1, 15));
+});
