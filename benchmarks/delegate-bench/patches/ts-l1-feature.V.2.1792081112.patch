diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..52e0a78
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,60 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www (e.g. 2026-W42, the Monday of the week)
+    - YYYY-Www-D (e.g. 2026-W42-4, where 1 = Monday ... 7 = Sunday)
+    - YYYYWww, YYYYWwwD (compact forms)
+*/
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?" +
+        // Don't fall back to a shorter match when followed by a malformed weekday (e.g. "2026-W42-10")
+        "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const YEAR_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const weekday = match[WEEKDAY_NUMBER_GROUP] ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+
+        // The compact and extended forms can't be mixed (e.g. "2026-W424")
+        if (match[WEEKDAY_NUMBER_GROUP] && match[WEEKDAY_SEPARATOR_GROUP] !== match[YEAR_SEPARATOR_GROUP]) {
+            return null;
+        }
+        if (week < 1 || week > 53 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week with January 4th, and a week belongs to the year of its Thursday
+        const date = new Date(0);
+        date.setUTCFullYear(year, 0, 4);
+        date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7) + (week - 1) * 7 + 3);
+        if (date.getUTCFullYear() !== year) {
+            // Week 53 of a year with only 52 weeks
+            return null;
+        }
+        date.setUTCDate(date.getUTCDate() + weekday - 4);
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: weekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..3fb2a40
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,183 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "The release is planned for 2026-W42-4.", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date without weekday (YYYY-Www)", () => {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review in 2026-w42, as usual", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(17);
+        expect(result.text).toBe("2026-w42");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W424", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026W42", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "Shipped in 2026w424 already", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026w424");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week-numbering year different from the calendar year", () => {
+    testSingleCase(chrono, "2020-W01-1", new Date(2020, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2020, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2015W53", new Date(2015, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2015W53");
+
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date followed by a time", () => {
+    testSingleCase(chrono, "2026-W42-4 at 10am", new Date(2026, 10 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4 at 10am");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10));
+    });
+});
+
+test("Test - Invalid week number", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W99", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono.strict, "2026-W54-1", new Date(2026, 10 - 1, 1));
+});
+
+test("Test - Week 53 of a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2021, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2021, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2021W537", new Date(2021, 10 - 1, 1));
+    testUnexpectedResult(chrono.strict, "2025-W53", new Date(2025, 10 - 1, 1));
+});
+
+test("Test - Invalid weekday is not recognized as a shorter week date", () => {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W429", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "The release is planned for 2026-W42-8.", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2026, 10 - 1, 1));
+});
+
+test("Test - Malformed week date", () => {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-10", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W4245", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42x", new Date(2026, 10 - 1, 1));
+
+    // Mixing the compact and extended forms
+    testUnexpectedResult(chrono, "2026-W424", new Date(2026, 10 - 1, 1));
+    testUnexpectedResult(chrono, "2026W42-4", new Date(2026, 10 - 1, 1));
+});
