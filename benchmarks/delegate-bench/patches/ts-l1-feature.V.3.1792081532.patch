--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,66 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (weekday 1 = Monday ... 7 = Sunday, defaults to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    `([0-9]{4})` +
+        `(?:-W([0-9]{2})(?:-([0-9]))?|W([0-9]{2})([0-9])?)` +
+        // Don't fall back to a shorter match when more digits follow (e.g. "2020-W10-12" or "2020W10-1")
+        `(?!-?[0-9])(?=\\W|$)`,
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th
+        const mondayOfWeekOne = 4 - ((createUTCDate(year, 0, 4).getUTCDay() + 6) % 7);
+        const date = createUTCDate(year, 0, mondayOfWeekOne + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            year: date.getUTCFullYear(),
+            month: date.getUTCMonth() + 1,
+            day: date.getUTCDate(),
+            weekday: date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+// A year has 53 ISO weeks when it starts or ends on a Thursday
+function getISOWeeksInYear(year: number): number {
+    const startsOnThursday = createUTCDate(year, 0, 1).getUTCDay() === 4;
+    const endsOnThursday = createUTCDate(year, 11, 31).getUTCDay() === 4;
+    return startsOnThursday || endsOnThursday ? 53 : 52;
+}
+
+// Unlike Date.UTC(), setUTCFullYear() doesn't map years 0-99 to 1900-1999
+function createUTCDate(year: number, month: number, day: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..97f637d
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,219 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www) is the Monday of the week", () => {
+    testSingleCase(chrono, "2020-W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W10");
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2008-W39-6", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2008-W39-6");
+        expect(result.start.get("year")).toBe(2008);
+        expect(result.start.get("month")).toBe(9);
+        expect(result.start.get("day")).toBe(27);
+        expect(result.start.get("weekday")).toBe(6);
+        expect(result.start).toBeDate(new Date(2008, 9 - 1, 27, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", () => {
+    testSingleCase(chrono, "2020W10", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2020W105", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020W105");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Lowercase 'w'", () => {
+    testSingleCase(chrono, "2020-w10-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-w10-5");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Lowercase 'w' in compact form", () => {
+    testSingleCase(chrono, "2020w105", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020w105");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Weekday 7 is Sunday", () => {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", () => {
+    testSingleCase(chrono, "2009-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result.start.get("year")).toBe(2008);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 ISO weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year", () => {
+    testSingleCase(chrono, "2009-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 of a year starting on a Thursday", () => {
+    testSingleCase(chrono, "2015W535", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2015W535");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Date components are certain and time is implied", () => {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Weekday defaulting to Monday is certain", () => {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Result is tagged with the parser", () => {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date embedded in a sentence", () => {
+    testSingleCase(chrono, "The release is planned for 2020-W10-5.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2020-W10-5");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Compact week date embedded in a sentence", () => {
+    testSingleCase(chrono, "Sprint ends (2020W105)", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(13);
+        expect(result.text).toBe("2020W105");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2020-W10-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W10-5");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Week date in casual mode", () => {
+    testSingleCase(chrono.casual, "2020-W10-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W10-5");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Reject week 00", () => {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject compact week 00", () => {
+    testUnexpectedResult(chrono, "2020W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject week above 53", () => {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject week 53 in a year with 52 ISO weeks", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject compact week 53 in a year with 52 ISO weeks", () => {
+    testUnexpectedResult(chrono, "2021W537", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject weekday 0 instead of matching the week only", () => {
+    testUnexpectedResult(chrono, "2020-W10-0", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject weekday 8 instead of matching the week only", () => {
+    testUnexpectedResult(chrono, "2020-W10-8", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject weekday 9 instead of matching the week only", () => {
+    testUnexpectedResult(chrono, "2020-W10-9", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject compact weekday 0 instead of matching the week only", () => {
+    testUnexpectedResult(chrono, "2020W100", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject compact weekday 8 instead of matching the week only", () => {
+    testUnexpectedResult(chrono, "2020W108", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject invalid week date embedded in a sentence", () => {
+    testUnexpectedResult(chrono, "The release is planned for 2021-W53-1.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject one-digit week", () => {
+    testUnexpectedResult(chrono, "2020-W1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject two-digit weekday", () => {
+    testUnexpectedResult(chrono, "2020-W10-12", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject extra digits in compact form", () => {
+    testUnexpectedResult(chrono, "2020W1012", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject mixing extended and compact forms", () => {
+    testUnexpectedResult(chrono, "2020-W105", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject mixing compact and extended forms", () => {
+    testUnexpectedResult(chrono, "2020W10-5", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Reject week date inside a word", () => {
+    testUnexpectedResult(chrono, "X2020W10", new Date(2026, 10 - 1, 15));
+});
