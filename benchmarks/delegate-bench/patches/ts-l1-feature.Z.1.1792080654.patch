diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..6e9c8b8
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,61 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (weekday 1 = Monday ... 7 = Sunday, default to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([1-7]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([1-7])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Don't fall back to a shorter match e.g. "2024-W01" in "2024-W01-8" or "2024-W01-12"
+    "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP] ?? "1");
+
+        // The week 1 is the week with January 4th. Calculate in UTC to avoid DST and two-digit year issues.
+        const date = new Date(Date.UTC(year, 0, 4));
+        date.setUTCFullYear(year);
+        const mondayOfWeekOne = date.getUTCDate() - ((date.getUTCDay() + 6) % 7);
+
+        // A week belongs to the year of its Thursday (e.g. week 53 only exists in some years)
+        date.setUTCDate(mondayOfWeekOne + (week - 1) * 7 + 3);
+        if (date.getUTCFullYear() !== year) {
+            return null;
+        }
+
+        date.setUTCDate(date.getUTCDate() - 3 + (weekday - 1));
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..899cdc2
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,187 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2024-W10-3", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2024-W10-3");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week date without weekday means Monday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2024-W01", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2024-W01");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W424", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W424");
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026w424", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026w424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date in a sentence", function () {
+    testSingleCase(chrono, "The sprint ends in 2026-W42-5.", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.index).toBe(19);
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "Release (2026W42) is planned", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.index).toBe(9);
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with time", function () {
+    testSingleCase(chrono, "2026-W42-4 at 10am", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4 at 10am");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10));
+    });
+});
+
+test("Test - Week date across calendar years", function () {
+    testSingleCase(chrono, "2026-W01-1", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W01-1");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2026-W01", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2021-W52-7", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 1 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2026W537", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W537");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2015-W53", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2015-W53");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W54", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Week 53 in years with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2024W537", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono.strict, "2025-W53", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Invalid weekday does not fall back to the week", function () {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W429", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "The sprint ends in 2026-W42-8.", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Malformed week date", function () {
+    testUnexpectedResult(chrono, "2026-W42-12", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W4212", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W421", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W42-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42x", new Date(2026, 1 - 1, 1));
+});
