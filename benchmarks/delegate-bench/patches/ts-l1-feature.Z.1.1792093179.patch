--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,74 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (weekday: 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?" +
+    // Don't fall back to a shorter match (e.g. "2024-W01" in "2024-W01-12")
+    "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+const MILLISECONDS_IN_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        let weekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // The compact (YYYYWwwD) and the hyphenated (YYYY-Www-D) forms can't be mixed
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            weekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+        }
+
+        if (week < 1 || week > getISOWeeksInYear(year) || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = getMondayOfFirstISOWeek(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function getMondayOfFirstISOWeek(year: number): Date {
+    // January 4th is always in the first ISO week of the year
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+function getISOWeeksInYear(year: number): number {
+    const firstMonday = getMondayOfFirstISOWeek(year);
+    const nextYearFirstMonday = getMondayOfFirstISOWeek(year + 1);
+    return (nextYearFirstMonday.getTime() - firstMonday.getTime()) / MILLISECONDS_IN_WEEK;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..df3b435
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,204 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Single Expression (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W05", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W05");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(26);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+
+    testSingleCase(chrono, "The sprint starts in 2026-W12.", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W12");
+
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 16, 12));
+    });
+});
+
+test("Test - Single Expression (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W05-3");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(28);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026-W05-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 1, 12));
+    });
+
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W12-4, please prepare.",
+        new Date(2026, 9, 15),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W12-4");
+
+            expect(result.start).toBeDate(new Date(2026, 3 - 1, 19, 12));
+        }
+    );
+});
+
+test("Test - Single Expression (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W05", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026W05");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+
+    testSingleCase(chrono, "Shipped in 2026W12 as planned", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026W12");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 16, 12));
+    });
+});
+
+test("Test - Single Expression (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W053", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026W053");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "Shipped on 2026W124 as planned", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026W124");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 19, 12));
+    });
+});
+
+test("Test - Lowercase week designator", function () {
+    testSingleCase(chrono, "2026-w05", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-w05");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+
+    testSingleCase(chrono, "2026-w05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-w05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026w053", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026w053");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Week-numbering year differs from calendar year", function () {
+    testSingleCase(chrono, "2026-W01", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2021-W01-1", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2021-W01-1");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2015W537", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W05-3", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W05", new Date(2026, 9, 15), (result) => {
+        expect(result.text).toBe("2026W05");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Invalid week", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026W99", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono.strict, "2026-W00", new Date(2026, 9, 15));
+});
+
+test("Test - Week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2025W537", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono.strict, "2025-W53", new Date(2026, 9, 15));
+});
+
+test("Test - Invalid weekday", function () {
+    testUnexpectedResult(chrono, "2026-W05-0", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W05-8", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W05-9", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026W050", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026W058", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "Due 2026-W05-8 at the latest", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono.strict, "2026-W05-9", new Date(2026, 9, 15));
+});
+
+test("Test - Malformed week dates", function () {
+    testUnexpectedResult(chrono, "2026-W5", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W053", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026W05-3", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026-W05-34", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "2026W0534", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "12026-W05", new Date(2026, 9, 15));
+    testUnexpectedResult(chrono, "X2026-W05", new Date(2026, 9, 15));
+});
