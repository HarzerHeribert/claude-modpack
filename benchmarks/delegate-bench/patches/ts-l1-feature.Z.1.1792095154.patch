index 0000000..07ca644
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,76 @@
+import { ParsingContext } from "../../../chrono";
+import { Weekday } from "../../../types";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week date
+// - YYYY-Www   (e.g. 2020-W10, the Monday of the week)
+// - YYYY-Www-D (e.g. 2020-W10-3)
+// - YYYYWww    (e.g. 2020W10)
+// - YYYYWwwD   (e.g. 2020W103)
+// D is the weekday from 1 (Monday) to 7 (Sunday).
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([1-7]))?" + // YYYY-Www(-D)
+        "|" +
+        "W([0-9]{2})([1-7])?" + // YYYYWww(D)
+    ")" +
+    // Reject the whole expression (instead of matching a shorter one) when followed by an invalid weekday
+    "(?!-?[0-9])(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayNumber = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayNumber ? parseInt(weekdayNumber) : 1;
+
+        if (week < 1 || week > 53 || (week == 53 && !hasISOWeek53(year))) {
+            return null;
+        }
+
+        // The week 1 is the week with the year's first Thursday (i.e. the week containing January 4th)
+        const date = createUTCDate(year, 0, 4);
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - jan4IsoWeekday + (week - 1) * 7 + isoWeekday);
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": isoWeekday % 7,
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks if it starts or ends on Thursday.
+ */
+function hasISOWeek53(year: number): boolean {
+    return (
+        createUTCDate(year, 0, 1).getUTCDay() == Weekday.THURSDAY ||
+        createUTCDate(year, 11, 31).getUTCDay() == Weekday.THURSDAY
+    );
+}
+
+function createUTCDate(year: number, monthIndex: number, day: number): Date {
+    // Use setUTCFullYear() because Date.UTC() maps years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, monthIndex, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..1103028
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,223 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2020-W10-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-3");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date without weekday (YYYY-Www)", () => {
+    testSingleCase(chrono, "2020-W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2020W103", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", () => {
+    testSingleCase(chrono, "2020W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", () => {
+    testSingleCase(chrono, "2020-w10-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-w10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date with lowercase w", () => {
+    testSingleCase(chrono, "2020w103", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020w103");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date with Sunday weekday", () => {
+    testSingleCase(chrono, "2020-W10-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Week date in a sentence", () => {
+    testSingleCase(chrono, "The sprint starts on 2020-W10-3.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date in a sentence", () => {
+    testSingleCase(chrono, "Release planned for 2020W10, see you then", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", () => {
+    testSingleCase(chrono, "2020-W01-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week 1 starting in the same calendar year", () => {
+    testSingleCase(chrono, "2021-W01", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2021-W01");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year", () => {
+    testSingleCase(chrono, "2015-W53-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2015-W53-5");
+        expect(result.start.get("year")).toBe(2016);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Compact week 53 in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2026W537", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026W537");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2020-W10-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2020W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date in casual mode", () => {
+    testSingleCase(chrono.casual, "2020-W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Negative: week 53 in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact week 53 in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2021W531", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: week 00", () => {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact week 00", () => {
+    testUnexpectedResult(chrono, "2020W00", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: week above 53", () => {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact week above 53", () => {
+    testUnexpectedResult(chrono, "2020W99", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: weekday 0", () => {
+    testUnexpectedResult(chrono, "2020-W10-0", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: weekday 8", () => {
+    testUnexpectedResult(chrono, "2020-W10-8", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: weekday 9", () => {
+    testUnexpectedResult(chrono, "2020-W10-9", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact weekday 0", () => {
+    testUnexpectedResult(chrono, "2020W100", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact weekday 8", () => {
+    testUnexpectedResult(chrono, "2020W108", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: compact weekday 9", () => {
+    testUnexpectedResult(chrono, "2020W109", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: invalid weekday in a sentence", () => {
+    testUnexpectedResult(chrono, "The sprint starts on 2020-W10-8.", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: invalid week in a sentence", () => {
+    testUnexpectedResult(chrono, "The sprint starts on 2021-W53.", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: invalid weekday in strict mode", () => {
+    testUnexpectedResult(chrono.strict, "2020-W10-8", new Date(2024, 5, 15));
+});
+
+test("Test - Negative: invalid week in strict mode", () => {
+    testUnexpectedResult(chrono.strict, "2020-W54", new Date(2024, 5, 15));
+});
