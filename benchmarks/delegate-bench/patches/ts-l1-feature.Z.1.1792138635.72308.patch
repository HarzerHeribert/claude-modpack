--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,84 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www   (e.g. 2026-W42, the Monday of week 42)
+    - YYYY-Www-D (e.g. 2026-W42-5, the Friday of week 42)
+    - YYYYWww    (compact)
+    - YYYYWwwD   (compact)
+
+    The weekday is captured as any digit (and the extended form refuses a trailing "-<digit>")
+    so that an invalid weekday is rejected instead of falling back to the Monday-of-week match.
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9])|(?!-[0-9]))" + // YYYY-Www or YYYY-Www-D
+        "|W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+const MILLISECONDS_IN_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const weekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > countISOWeeks(year)) {
+            return null;
+        }
+        if (weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = getFirstISOWeekMonday(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: weekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday (as a UTC date) of the first ISO week of the ISO week-numbering `year`,
+ * which is the week containing January 4th.
+ */
+function getFirstISOWeekMonday(year: number): Date {
+    const date = new Date(Date.UTC(2000, 0, 4));
+    date.setUTCFullYear(year);
+    const isoWeekday = date.getUTCDay() || 7;
+    date.setUTCDate(date.getUTCDate() - (isoWeekday - 1));
+    return date;
+}
+
+/**
+ * Returns the number of ISO weeks (52 or 53) in the ISO week-numbering `year`.
+ */
+function countISOWeeks(year: number): number {
+    const weekOneMonday = getFirstISOWeekMonday(year);
+    const nextWeekOneMonday = getFirstISOWeekMonday(year + 1);
+    return Math.round((nextWeekOneMonday.getTime() - weekOneMonday.getTime()) / MILLISECONDS_IN_WEEK);
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..4a00e07
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,217 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - ISO week date (YYYY-Www)", () => {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "The sprint starts in 2026-W42.", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-1", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-1");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+
+    testSingleCase(chrono, "Deliver the report on 2026-W42-3, please", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(22);
+        expect(result.text).toBe("2026-W42-3");
+
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 14, 12));
+    });
+});
+
+test("Test - Compact ISO week date (YYYYWww and YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026W425", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "Due by 2026W427 at the latest", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2026W427");
+
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w", () => {
+    testSingleCase(chrono, "2026-w42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026-w42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-w42-5");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "2026w42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "2026w425", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026w425");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - ISO week date crossing the calendar year", () => {
+    testSingleCase(chrono, "2026-W01", new Date(2026, 5, 1), (result) => {
+        expect(result.text).toBe("2026-W01");
+
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2008-W01-1", new Date(2008, 5, 1), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2009-W53-7", new Date(2009, 5, 1), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 in years with 53 weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020W537", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020W537");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-1", new Date(2026, 5, 1), (result) => {
+        expect(result.text).toBe("2026-W53-1");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week date in strict and casual mode", () => {
+    testSingleCase(chrono.strict, "2026-W42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.start.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date with an invalid week", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W54", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 0, 1));
+});
+
+test("Test - ISO week 53 in years with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2025, 0, 1));
+    testUnexpectedResult(chrono, "2025W53", new Date(2025, 0, 1));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2021, 0, 1));
+    testUnexpectedResult(chrono, "2021W537", new Date(2021, 0, 1));
+});
+
+test("Test - ISO week date with an invalid weekday", () => {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W429", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W42-85", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "Deliver the report on 2026-W42-8, please", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2026, 0, 1));
+});
+
+test("Test - Malformed ISO week date", () => {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W425", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W42x", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "A2026W42", new Date(2026, 0, 1));
+});
