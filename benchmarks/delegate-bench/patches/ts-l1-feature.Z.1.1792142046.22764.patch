diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..0b0c273
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,81 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+
+    The week and weekday digits are matched loosely and validated in the extraction, so that an invalid
+    week date (e.g. "2026-W05-8") is rejected as a whole instead of matching a shorter one (e.g. "2026-W05").
+*/
+const PATTERN = new RegExp(`([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?(?=\\W|$)(?!-[0-9])`, "i");
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const isoWeekday = match[WEEKDAY_NUMBER_GROUP] ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+
+        // The basic (YYYYWwwD) and extended (YYYY-Www-D) formats cannot be mixed
+        if (match[WEEKDAY_NUMBER_GROUP] && match[WEEK_SEPARATOR_GROUP] !== match[WEEKDAY_SEPARATOR_GROUP]) {
+            return null;
+        }
+        if (week < 1 || week > getISOWeeksInYear(year)) {
+            return null;
+        }
+        if (isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // The week 1 is the week with the year's first Thursday, thus always contains January 4th.
+        const january4th = createUTCDate(year, 0, 4);
+        const daysFromWeek1Monday = (week - 1) * 7 + (isoWeekday - 1);
+        const date = createUTCDate(year, 0, 4 - toISOWeekday(january4th) + 1 + daysFromWeek1Monday);
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks if it starts or ends on a Thursday, otherwise 52.
+ */
+function getISOWeeksInYear(year: number): number {
+    const thursday = 4;
+    if (
+        toISOWeekday(createUTCDate(year, 0, 1)) === thursday ||
+        toISOWeekday(createUTCDate(year, 11, 31)) === thursday
+    ) {
+        return 53;
+    }
+    return 52;
+}
+
+function toISOWeekday(date: Date): number {
+    return date.getUTCDay() || 7;
+}
+
+function createUTCDate(year: number, monthIndex: number, day: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, monthIndex, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..20095ef
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,197 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Single Expression (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W05", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(26);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Single Expression (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W05-3", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(28);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026-W05-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 1, 12));
+    });
+});
+
+test("Test - Single Expression (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W05", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Single Expression (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W053", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026W053");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Lowercase week designator", function () {
+    testSingleCase(chrono, "2026-w05-3", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-w05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026w053", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026w053");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Week dates outside of the calendar year", function () {
+    testSingleCase(chrono, "2026-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2015W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2015W53");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2004-W53-5", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2004-W53-5");
+        expect(result.start).toBeDate(new Date(2004, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - Week date within sentences", function () {
+    testSingleCase(chrono, "The release is planned for 2026-W05-3.", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "Deliver by 2026W12, please", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026W12");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 16, 12));
+    });
+});
+
+test("Test - Week date with time", function () {
+    testSingleCase(chrono, "2026-W05-3 at 10am", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W05-3 at 10am");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 10));
+    });
+});
+
+test("Test - Strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W05-3", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W05", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W05");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W54-1", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday", function () {
+    testUnexpectedResult(chrono, "2026-W05-0", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W05-8", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W05-9", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W050", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W058", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W059", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "The release is planned for 2026-W05-8.", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2026-W05-8", new Date(2012, 7, 10));
+});
+
+test("Test - Mixed basic and extended formats", function () {
+    testUnexpectedResult(chrono, "2026-W053", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026W05-3", new Date(2012, 7, 10));
+});
+
+test("Test - Malformed week dates", function () {
+    testUnexpectedResult(chrono, "2026-W5", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W005", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "2026-W05-10", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono, "12026-W05", new Date(2012, 7, 10));
+});
