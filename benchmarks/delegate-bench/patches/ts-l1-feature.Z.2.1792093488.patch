index 0000000..a1f5c21
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,73 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, defaults to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Don't fall back to a shorter match when there are more digits (e.g. "2024-W05-12")
+    "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const weekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > 53 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+        if (week == 53 && !hasWeek53(year)) {
+            return null;
+        }
+
+        // Week 1 is the week (starting on Monday) that contains January 4th
+        const date = createUTCDate(year, 0, 4);
+        const jan4Weekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - jan4Weekday + (week - 1) * 7 + weekday);
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function hasWeek53(year: number): boolean {
+    // A year has 53 ISO weeks when it starts or ends on a Thursday
+    return createUTCDate(year, 0, 1).getUTCDay() == 4 || createUTCDate(year, 11, 31).getUTCDay() == 4;
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    // Use setUTCFullYear() because Date.UTC() maps the years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..306cc91
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,195 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - ISO week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W05", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W05");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - ISO week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2024-W05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2024-W05-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-1");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2024-W05-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 2 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date in compact form (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2024W05", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W05");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2024W053", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W053");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase 'w'", function () {
+    testSingleCase(chrono, "2024-w05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-w05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2024w053", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024w053");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - ISO week date within a sentence", function () {
+    testSingleCase(chrono, "The sprint starts on 2024-W05-3 as planned.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "Release (2024W05)", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(9);
+        expect(result.text).toBe("2024W05");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2024-W05-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W053", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W053");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - ISO week date crossing calendar years", function () {
+    // 2026 starts on a Thursday, so its week 1 starts in December 2025
+    testSingleCase(chrono, "2026-W01", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    // 2021 starts on a Friday, so January 1st-3rd still belong to the last week of 2020
+    testSingleCase(chrono, "2021-W01-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2021-W01-1");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - ISO week date in week 53", function () {
+    // 2026 starts on a Thursday
+    testSingleCase(chrono, "2026-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    // 2020 is a leap year that ends on a Thursday
+    testSingleCase(chrono, "2020-W53-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    // 2015 starts on a Thursday
+    testSingleCase(chrono, "2015W537", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week date with week 53 in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2024-W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2021W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "2025-W53", new Date(2024, 5, 15));
+});
+
+test("Test - ISO week date with an invalid week", function () {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W54", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W99-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W541", new Date(2024, 5, 15));
+});
+
+test("Test - ISO week date with an invalid weekday", function () {
+    testUnexpectedResult(chrono, "2024-W05-0", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W05-8", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W05-9", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W050", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W058", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W059", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "2024-W05-8", new Date(2024, 5, 15));
+});
+
+test("Test - ISO week date with extra or malformed digits", function () {
+    testUnexpectedResult(chrono, "2024-W05-12", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W5", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W0512", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "12024-W05", new Date(2024, 5, 15));
+});
+
+test("Test - ISO week date mixing extended and compact forms", function () {
+    testUnexpectedResult(chrono, "2024-W053", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W05-3", new Date(2024, 5, 15));
+});
