+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,64 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date: the ISO week-numbering year, the week, and an optional weekday (1 = Monday ... 7 = Sunday).
+    Without the weekday, it refers to the Monday of the week.
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([1-7]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([1-7])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Do not fall back to a shorter match when the weekday position holds something else (e.g. "2024-W01-8")
+    "(?!-[0-9])" +
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const isoWeekday = parseInt(match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP] ?? "1");
+
+        // Week 1 is the week containing January 4th. Use UTC (and setUTCFullYear for years below 100) to avoid DST.
+        const date = new Date(0);
+        date.setUTCFullYear(year, 0, 4);
+        const isoWeekdayOfJan4 = date.getUTCDay() || 7;
+
+        // A week belongs to the year of its Thursday. This rules out week 00, weeks above 53,
+        // and week 53 of a year with only 52 weeks.
+        date.setUTCDate(4 - isoWeekdayOfJan4 + 4 + (week - 1) * 7);
+        if (date.getUTCFullYear() !== year) {
+            return null;
+        }
+
+        date.setUTCDate(date.getUTCDate() - 4 + isoWeekday);
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..45fda88
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,216 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - ISO week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W01");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - ISO week date (YYYY-Www) starting in the previous year", function () {
+    testSingleCase(chrono, "2020-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - ISO week date (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date (YYYY-Www-D) on Sunday", function () {
+    testSingleCase(chrono, "2024-W01-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2024-W01-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 7, 12));
+    });
+});
+
+test("Test - ISO week date (YYYY-Www-D) in the previous calendar year", function () {
+    testSingleCase(chrono, "2008-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - ISO week date (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - ISO week date (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W425", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w in compact form", function () {
+    testSingleCase(chrono, "2026w424", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026w424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date within a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2026-W45-2.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W45-2");
+        expect(result.start).toBeDate(new Date(2026, 11 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week date in compact form within a sentence", function () {
+    testSingleCase(chrono, "Sprint ends in 2026W45, as planned", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2026W45");
+        expect(result.start).toBeDate(new Date(2026, 11 - 1, 2, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", function () {
+    testSingleCase(chrono.strict, "Due 2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date in casual mode", function () {
+    testSingleCase(chrono.casual, "Due 2026-W42-4", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week 53 ending in the next calendar year", function () {
+    testSingleCase(chrono, "2009-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 in a leap year starting on Wednesday", function () {
+    testSingleCase(chrono, "2004W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2004W53");
+        expect(result.start).toBeDate(new Date(2004, 12 - 1, 27, 12));
+    });
+});
+
+test("Test - ISO week date with an implied time merged with a time expression", function () {
+    testSingleCase(chrono, "2026-W42-4 at 10am", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-4 at 10am");
+        expect(result.start.get("hour")).toBe(10);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10));
+    });
+});
+
+test("Test - ISO week date negative: week 00", function () {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: week 00 in compact form", function () {
+    testUnexpectedResult(chrono, "2024W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: week above 53", function () {
+    testUnexpectedResult(chrono, "2024-W54", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: week 99 with a weekday", function () {
+    testUnexpectedResult(chrono, "2024-W99-1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: week 53 of a leap year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2024W537", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: weekday 0", function () {
+    testUnexpectedResult(chrono, "2024-W10-0", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: weekday 8", function () {
+    testUnexpectedResult(chrono, "2024-W10-8", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: weekday 9 in compact form", function () {
+    testUnexpectedResult(chrono, "2024W109", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: weekday 0 in compact form", function () {
+    testUnexpectedResult(chrono, "2024W100", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: weekday 8 within a sentence", function () {
+    testUnexpectedResult(chrono, "The release is planned for 2026-W45-8.", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: one-digit week", function () {
+    testUnexpectedResult(chrono, "2024-W1", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: two-digit weekday", function () {
+    testUnexpectedResult(chrono, "2024-W10-12", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: extra digits in compact form", function () {
+    testUnexpectedResult(chrono, "2024W1012", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: five-digit year", function () {
+    testUnexpectedResult(chrono, "12024-W10", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date negative: followed by letters", function () {
+    testUnexpectedResult(chrono, "2024-W10x", new Date(2026, 10 - 1, 15));
+});
