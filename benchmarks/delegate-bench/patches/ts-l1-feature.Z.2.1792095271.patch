diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..dbc4676
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,70 @@
+import { ParsingContext } from "../../../chrono";
+import { Weekday } from "../../../types";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, the week's Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+    "(?:(-?)([0-9])|(?!-?[0-9]))" + // Don't fall back to a shorter match before an extra digit (e.g. "2020-W01-89")
+    "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        // Either the extended (with "-") or the basic (without) format, not a mix of both
+        if (match[WEEKDAY_NUMBER_GROUP] != null && match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+            return null;
+        }
+
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const isoWeekday = match[WEEKDAY_NUMBER_GROUP] != null ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        const date = createUTCDate(year, 1, 4);
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - (jan4IsoWeekday - 1) + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function getISOWeeksInYear(year: number): number {
+    // A year has 53 ISO weeks if it starts or ends on a Thursday
+    const startsOnThursday = createUTCDate(year, 1, 1).getUTCDay() === Weekday.THURSDAY;
+    const endsOnThursday = createUTCDate(year, 12, 31).getUTCDay() === Weekday.THURSDAY;
+    return startsOnThursday || endsOnThursday ? 53 : 52;
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    const date = new Date(Date.UTC(year, month - 1, day));
+    // Date.UTC() maps the years 0-99 to 1900-1999
+    date.setUTCFullYear(year);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..eb8048b
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,162 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2020-W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2020-W01");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2020-W01-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W01", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W01");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2020W013", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020W013");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2020-w10-5", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-w10-5");
+
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Week date on Sunday (weekday 7)", function () {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week 53 of a year with 53 weeks", function () {
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 of a year starting on Thursday", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2026-W42-5.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "Due on 2026W42", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2026W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date followed by time", function () {
+    testSingleCase(chrono, "2020-W10-5 at 10am", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W10-5 at 10am");
+
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 10));
+    });
+});
+
+test("Test - Negative week 00", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative week above 53", function () {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative week 53 of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative week 53 with weekday of a year with 52 weeks", function () {
+    testUnexpectedResult(chrono.strict, "2021W531", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative weekday 0", function () {
+    testUnexpectedResult(chrono, "2020-W01-0", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative weekday 8", function () {
+    testUnexpectedResult(chrono, "2020-W01-8", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative compact weekday 9", function () {
+    testUnexpectedResult(chrono, "2020W019", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Negative mixed extended and compact format", function () {
+    testUnexpectedResult(chrono, "2020-W013", new Date(2026, 10 - 1, 15));
+});
