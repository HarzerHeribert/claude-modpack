diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..bc4d8d0
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,75 @@
+import { ParsingContext } from "../../../chrono";
+import { Weekday } from "../../../types";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, where D is the weekday (1 = Monday ... 7 = Sunday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+    Without the weekday, the date is the Monday of the week.
+*/
+const PATTERN = new RegExp(
+    `([0-9]{4})(?:-W([0-9]{2})(?:-([0-9]))?|W([0-9]{2})([0-9])?)` +
+        // Do not fall back to a shorter match (e.g. "2020-W01" in "2020-W01-10")
+        "(?!-[0-9])" +
+        "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        if (week < 1 || week > 53 || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+        if (week == 53 && !hasISOWeek53(year)) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th
+        const date = getUTCDate(year, 0, 4);
+        const mondayOfWeekOne = 4 - ((date.getUTCDay() + 6) % 7);
+        date.setUTCDate(mondayOfWeekOne + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks when it starts or ends on a Thursday.
+ */
+function hasISOWeek53(year: number): boolean {
+    return (
+        getUTCDate(year, 0, 1).getUTCDay() === Weekday.THURSDAY ||
+        getUTCDate(year, 11, 31).getUTCDay() === Weekday.THURSDAY
+    );
+}
+
+function getUTCDate(year: number, month: number, day: number): Date {
+    // Use setUTCFullYear() as Date.UTC() maps years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..28cbaee
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,169 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www)", () => {
+    testSingleCase(chrono.casual, "2020-W10", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W10");
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-w10", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020-w10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono.casual, "2020-W10-3", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-W10-7", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", () => {
+    testSingleCase(chrono.casual, "2020W10", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020W103", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020w103", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020w103");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date within text", () => {
+    testSingleCase(chrono.casual, "The sprint starts on 2024-W15-2.", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W15-2");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 9, 12));
+    });
+
+    testSingleCase(chrono.casual, "Release planned for 2024W15 (tentative)", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2024W15");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 8, 12));
+    });
+});
+
+test("Test - Week date in strict mode", () => {
+    testSingleCase(chrono.strict, "Due 2020-W10-3", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2020-W10-3");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.strict, "Due 2020W10", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date components and tag", () => {
+    testSingleCase(chrono.casual, "2020-W10-3", new Date(2024, 0, 1), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date crossing the calendar year", () => {
+    testSingleCase(chrono.casual, "2020-W01-1", new Date(2024, 0, 1), (result) => {
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono.casual, "2009-W01", new Date(2024, 0, 1), (result) => {
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-W53-7", new Date(2024, 0, 1), (result) => {
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 weeks", () => {
+    testSingleCase(chrono.casual, "2020-W53", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026W53", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2026W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.casual, "2015-W53-5", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2015-W53-5");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Invalid week number", () => {
+    testUnexpectedResult(chrono.casual, "2020-W00", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W00", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W54", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W541", new Date(2024, 0, 1));
+});
+
+test("Test - Week 53 in years with 52 weeks", () => {
+    testUnexpectedResult(chrono.casual, "2021-W53", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2021-W53-1", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2021W537", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2024, 0, 1));
+});
+
+test("Test - Invalid weekday without falling back to the week", () => {
+    testUnexpectedResult(chrono.casual, "2020-W01-0", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W01-8", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W01-9", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W01-10", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W010", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W018", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W019", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.strict, "2020-W01-8", new Date(2024, 0, 1));
+});
+
+test("Test - Invalid week date within text", () => {
+    testUnexpectedResult(chrono.casual, "The sprint starts on 2020-W01-8.", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "The sprint starts on 2021W53.", new Date(2024, 0, 1));
+});
+
+test("Test - Not a week date", () => {
+    testUnexpectedResult(chrono.casual, "2020-W1", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W1-3", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020-W011", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "2020W1031", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.casual, "X2020-W10", new Date(2024, 0, 1));
+});
