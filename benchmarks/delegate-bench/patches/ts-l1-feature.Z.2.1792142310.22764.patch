index 0000000..91d5390
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,72 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, in the extended or the compact format:
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+    The weekday D is 1 (Monday) to 7 (Sunday). Without it, the date is the Monday of the week.
+*/
+// The weekday captures all following digits, so an invalid one (e.g. "2020-W01-12") rejects the whole match
+// instead of letting the pattern backtrack to a shorter week date (e.g. "2020-W01").
+const PATTERN = new RegExp(`([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]+))?` + "(?=\\W|$)", "i");
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+
+        let weekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // Reject mixing the extended and compact formats (e.g. "2020-W011" or "2020W01-1")
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            if (!match[WEEKDAY_NUMBER_GROUP].match(/^[1-7]$/)) {
+                return null;
+            }
+            weekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+        }
+
+        const firstMonday = getFirstMondayOfISOWeekYear(year);
+        const nextYearFirstMonday = getFirstMondayOfISOWeekYear(year + 1);
+        const weekCount = (nextYearFirstMonday.getTime() - firstMonday.getTime()) / WEEK_MILLISECONDS;
+        if (week < 1 || week > weekCount) {
+            return null;
+        }
+
+        const date = new Date(firstMonday);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+const WEEK_MILLISECONDS = 7 * 24 * 60 * 60 * 1000;
+
+function getFirstMondayOfISOWeekYear(year: number): Date {
+    // January 4th is always in the first week of the ISO week-numbering year.
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+    date.setUTCDate(4 - daysSinceMonday);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..d37ea95
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,191 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-5", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Week date without weekday (YYYY-Www) is the Monday of the week", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W425", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w42-5", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-w42-5");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono, "2026w42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date with Sunday as weekday 7", function () {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week date in the previous calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2026-W01", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2015W535", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2015W535");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W43, after the review",
+        new Date(2026, 1 - 1, 1),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W43");
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+        }
+    );
+
+    testSingleCase(chrono, "Deadline: 2026W432, no extensions", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.index).toBe(10);
+        expect(result.text).toBe("2026W432");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 20, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-5", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date followed by a time", function () {
+    testSingleCase(chrono, "2026-W42-5 at 10:30", new Date(2026, 1 - 1, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5 at 10:30");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 10, 30));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W541", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W99", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Week 53 in years with only 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2027W53", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2027W537", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Invalid weekday is not shortened to the week", function () {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W429", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W42-12", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "Due 2026-W42-8 at the latest", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Mixed extended and compact formats", function () {
+    testUnexpectedResult(chrono, "2026-W425", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026W42-5", new Date(2026, 1 - 1, 1));
+});
+
+test("Test - Week without two digits", function () {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 1 - 1, 1));
+    testUnexpectedResult(chrono, "2026-W4-1", new Date(2026, 1 - 1, 1));
+});
