--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,65 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (weekday 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+        // Either a weekday digit, or no digit at all (to avoid falling back to a shorter match, e.g. "2024-W01-12")
+        "(?:(-?)([0-9])|(?!-?[0-9]))" +
+        "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const YEAR_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const isoWeekday = match[WEEKDAY_NUMBER_GROUP] ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+
+        // Mixing the basic and extended format (e.g. "2024-W011" or "2024W01-1") is not a week date
+        if (match[WEEKDAY_NUMBER_GROUP] && match[WEEKDAY_SEPARATOR_GROUP] !== match[YEAR_SEPARATOR_GROUP]) {
+            return null;
+        }
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th
+        const date = new Date(Date.UTC(year, 0, 4));
+        const jan4IsoWeekday = date.getUTCDay() || 7;
+        date.setUTCDate(4 - (jan4IsoWeekday - 1) + (week - 1) * 7 + (isoWeekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": isoWeekday % 7,
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * A year has 53 ISO weeks when it starts or ends on a Thursday, otherwise 52.
+ */
+function getISOWeeksInYear(year: number): number {
+    const jan1Weekday = new Date(Date.UTC(year, 0, 1)).getUTCDay();
+    const dec31Weekday = new Date(Date.UTC(year, 11, 31)).getUTCDay();
+    return jan1Weekday === 4 || dec31Weekday === 4 ? 53 : 52;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..aa23527
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,240 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono.casual, "2024-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W01-1");
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date with Sunday (YYYY-Www-7)", function () {
+    testSingleCase(chrono.casual, "2024-W01-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W01-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 7, 12));
+    });
+});
+
+test("Test - Week date without weekday means Monday (YYYY-Www)", function () {
+    testSingleCase(chrono.casual, "2024-W10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", function () {
+    testSingleCase(chrono.casual, "2024W10", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono.casual, "2024W105", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W105");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Lowercase w", function () {
+    testSingleCase(chrono.casual, "2024-w10-2", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-w10-2");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+});
+
+test("Test - Lowercase w in compact form", function () {
+    testSingleCase(chrono.casual, "2024w102", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024w102");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 5, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono.casual, "2009-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result.start.get("year")).toBe(2008);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 1 without weekday starting in the previous calendar year", function () {
+    testSingleCase(chrono.casual, "2025-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2025-W01");
+        expect(result.start).toBeDate(new Date(2024, 12 - 1, 30, 12));
+    });
+});
+
+test("Test - Last week ending in the next calendar year", function () {
+    testSingleCase(chrono.casual, "2009-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in a year starting on Thursday", function () {
+    testSingleCase(chrono.casual, "2026-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 in a leap year starting on Wednesday", function () {
+    testSingleCase(chrono.casual, "2020W534", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020W534");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - Week 52 in a year with 52 weeks", function () {
+    testSingleCase(chrono.casual, "2021-W52-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 1 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2024-W05-3", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Compact week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2024W05", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2024W05");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 29, 12));
+    });
+});
+
+test("Test - Week date embedded in a sentence", function () {
+    testSingleCase(chrono.casual, "The sprint starts on 2024-W05-3.", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 31, 12));
+    });
+});
+
+test("Test - Week date without weekday embedded in a sentence", function () {
+    testSingleCase(chrono.casual, "Release planned for 2024-W10, then review", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2024-W10");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 4, 12));
+    });
+});
+
+test("Test - Compact week date embedded in a sentence", function () {
+    testSingleCase(chrono.casual, "Shipped in (2024W105) as planned", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(12);
+        expect(result.text).toBe("2024W105");
+        expect(result.start).toBeDate(new Date(2024, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W00", new Date(2012, 7, 10));
+});
+
+test("Test - Week 00 with weekday is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W00-1", new Date(2012, 7, 10));
+});
+
+test("Test - Compact week 00 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W00", new Date(2012, 7, 10));
+});
+
+test("Test - Week above 53 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W54", new Date(2012, 7, 10));
+});
+
+test("Test - Week 99 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W991", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2021-W53", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 with weekday in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W53-1", new Date(2012, 7, 10));
+});
+
+test("Test - Compact week 53 in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2023W53", new Date(2012, 7, 10));
+});
+
+test("Test - Weekday 0 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W01-0", new Date(2012, 7, 10));
+});
+
+test("Test - Weekday 8 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W01-8", new Date(2012, 7, 10));
+});
+
+test("Test - Weekday 9 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W01-9", new Date(2012, 7, 10));
+});
+
+test("Test - Compact weekday 0 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W010", new Date(2012, 7, 10));
+});
+
+test("Test - Compact weekday 8 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W018", new Date(2012, 7, 10));
+});
+
+test("Test - Compact weekday 9 is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W019", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday in strict mode is not a week date", function () {
+    testUnexpectedResult(chrono.strict, "2024-W01-8", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday embedded in a sentence is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "The sprint starts on 2024-W01-8.", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in a year with 52 weeks embedded in a sentence is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "The sprint starts on 2021-W53-1.", new Date(2012, 7, 10));
+});
+
+test("Test - Extra weekday digits are not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W01-12", new Date(2012, 7, 10));
+});
+
+test("Test - Single-digit week is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W1", new Date(2012, 7, 10));
+});
+
+test("Test - Mixed compact and hyphenated weekday is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024-W011", new Date(2012, 7, 10));
+});
+
+test("Test - Mixed hyphenated and compact weekday is not a week date", function () {
+    testUnexpectedResult(chrono.casual, "2024W01-1", new Date(2012, 7, 10));
+});
