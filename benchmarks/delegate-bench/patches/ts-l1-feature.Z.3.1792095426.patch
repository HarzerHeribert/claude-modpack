diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..578fadb
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,82 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week date
+// https://en.wikipedia.org/wiki/ISO_week_date
+// - YYYY-Www   (e.g. 2026-W07)
+// - YYYY-Www-D (e.g. 2026-W07-3)
+// - YYYYWww    (e.g. 2026W07)
+// - YYYYWwwD   (e.g. 2026W073)
+// The weekday D is 1 (Monday) to 7 (Sunday). Without it, the week date refers to the Monday of the week.
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+    "(?:(-?)([0-9]))?" +
+    // Don't fall back to a shorter match (e.g. "2026-W07" out of "2026-W07-34")
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        if (week < 1 || week > getISOWeeksInYear(year)) {
+            return null;
+        }
+
+        let isoWeekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // The weekday must use the same (extended "-" or compact) format as the week
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            isoWeekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+            if (isoWeekday < 1 || isoWeekday > 7) {
+                return null;
+            }
+        }
+
+        const date = getMondayOfISOWeekOne(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday of the first ISO week of the (ISO week-numbering) year as a UTC date.
+ * The first ISO week is the week containing January 4th.
+ */
+function getMondayOfISOWeekOne(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+/**
+ * Returns the number of ISO weeks (52 or 53) in the (ISO week-numbering) year.
+ */
+function getISOWeeksInYear(year: number): number {
+    const days = (getMondayOfISOWeekOne(year + 1).getTime() - getMondayOfISOWeekOne(year).getTime()) / 86400000;
+    return Math.round(days / 7);
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..71d63ac
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,184 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - ISO week date (YYYY-Www)", () => {
+    testSingleCase(chrono, "2026-W07", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W07");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(2);
+        expect(result.start.get("day")).toBe(9);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 9, 12));
+    });
+});
+
+test("Test - ISO week date (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W07-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W07-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(2);
+        expect(result.start.get("day")).toBe(11);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+});
+
+test("Test - ISO week date (YYYYWww)", () => {
+    testSingleCase(chrono, "2026W07", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W07");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 9, 12));
+    });
+});
+
+test("Test - ISO week date (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W073", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W073");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+});
+
+test("Test - ISO week date with lowercase w", () => {
+    testSingleCase(chrono, "2026-w07-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-w07-3");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+
+    testSingleCase(chrono, "2026w073", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026w073");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+});
+
+test("Test - ISO week date with Sunday as weekday 7", () => {
+    testSingleCase(chrono, "2026-W07-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W07-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 15, 12));
+    });
+});
+
+test("Test - ISO week date in the previous calendar year", () => {
+    testSingleCase(chrono, "2026-W01-1", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W01-1");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - ISO week date in the next calendar year", () => {
+    testSingleCase(chrono, "2020-W53-7", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2020-W53-7");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - ISO week 53 in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - ISO week date in strict mode", () => {
+    testSingleCase(chrono.strict, "2026-W07-3", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026-W07-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W07", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.text).toBe("2026W07");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 9, 12));
+    });
+});
+
+test("Test - ISO week date within a sentence", () => {
+    testSingleCase(chrono, "The release is planned for 2026-W07.", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W07");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 9, 12));
+    });
+
+    testSingleCase(chrono, "Due on 2026W073, please", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2026W073");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 12));
+    });
+});
+
+test("Test - ISO week date with time", () => {
+    testSingleCase(chrono, "Meeting on 2026-W07-3 at 3pm", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(11);
+        expect(result.text).toBe("2026-W07-3 at 3pm");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 11, 15));
+    });
+});
+
+test("Test - ISO week date range", () => {
+    testSingleCase(chrono, "From 2026-W07 to 2026-W09", new Date(2026, 10 - 1, 15), (result) => {
+        expect(result.index).toBe(5);
+        expect(result.text).toBe("2026-W07 to 2026-W09");
+        expect(result.start).toBeDate(new Date(2026, 2 - 1, 9, 12));
+        expect(result.end).toBeDate(new Date(2026, 2 - 1, 23, 12));
+    });
+});
+
+test("Test - ISO week date with invalid week", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W54", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week 53 in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2025W53", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - ISO week date with invalid weekday", () => {
+    testUnexpectedResult(chrono, "2026-W07-0", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W07-8", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W07-9", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W070", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W078", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W079", new Date(2026, 10 - 1, 15));
+});
+
+test("Test - Malformed ISO week date", () => {
+    testUnexpectedResult(chrono, "2026-W7", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W071", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W07-1", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W07-12", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026W0712", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "12026-W07", new Date(2026, 10 - 1, 15));
+    testUnexpectedResult(chrono, "2026-W07x", new Date(2026, 10 - 1, 15));
+});
