diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..dd8a4dc
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,71 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+// ISO 8601 week date
+// - YYYY-Www   (e.g. 2026-W05, the Monday of that week)
+// - YYYY-Www-D (e.g. 2026-W05-3, D = 1 for Monday ... 7 for Sunday)
+// - YYYYWww    (compact)
+// - YYYYWwwD   (compact)
+//
+// The trailing negative lookahead prevents falling back to a shorter week date (e.g. "2026-W05" in "2026-W05-12").
+
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" +
+        "|" +
+        "W([0-9]{2})([0-9])?" +
+    ")" +
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const isoWeekday = weekdayText ? parseInt(weekdayText) : 1;
+        if (isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // Move to the Monday of the week. Week 53 is only valid if it starts before the next ISO year does.
+        const date = getISOWeekYearStart(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7);
+        if (week < 1 || date >= getISOWeekYearStart(year + 1)) {
+            return null;
+        }
+
+        date.setUTCDate(date.getUTCDate() + isoWeekday - 1);
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": isoWeekday % 7,
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday (as a UTC date) of week 1 of the ISO week-numbering year, i.e. the week containing January 4th.
+ */
+function getISOWeekYearStart(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    date.setUTCDate(4 - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..29ca09d
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,221 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono.casual, "2026-W42-5", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W42-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-1");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W42-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week date without weekday means Monday (YYYY-Www)", function () {
+    testSingleCase(chrono.casual, "2026-W42", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono.casual, "2026W425", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Lowercase week designator", function () {
+    testSingleCase(chrono.casual, "2026-w42-5", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-w42-5");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026w42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026w42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-5", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono.casual, "2026-W01", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono.casual, "2008-W01-1", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono.casual, "2010-W01-5", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2010-W01-5");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 8, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono.casual, "2026-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-W53", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.casual, "2009-W53-7", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono.casual, "2015W535", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2015W535");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(
+        chrono.casual,
+        "The release is planned for 2026-W42-5, see you then",
+        new Date(2012, 7, 10),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W42-5");
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+        }
+    );
+
+    testSingleCase(chrono.casual, "Sprint review (2026W425)", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2026W425");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.casual, "Planning starts 2026-W42.", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(16);
+        expect(result.text).toBe("2026-W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date followed by a time", function () {
+    testSingleCase(chrono.casual, "2026-W42-5 at 10am", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("2026-W42-5 at 10am");
+        expect(result.start.get("hour")).toBe(10);
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 10));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono.casual, "2026-W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W00", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W00-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W54", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W99-1", new Date(2012, 7, 10));
+});
+
+test("Test - Week 53 in years with only 52 ISO weeks", function () {
+    testUnexpectedResult(chrono.casual, "2021-W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2021-W53-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2021W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "See you in 2021-W53 then", new Date(2012, 7, 10));
+});
+
+test("Test - Invalid weekday digit", function () {
+    testUnexpectedResult(chrono.casual, "2026-W42-0", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W42-8", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W42-9", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W420", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W428", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W429", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2012, 7, 10));
+});
+
+test("Test - Malformed week date does not fall back to a shorter one", function () {
+    testUnexpectedResult(chrono.casual, "2026-W42-12", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W4212", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W421", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026W42-1", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "2026-W4", new Date(2012, 7, 10));
+    testUnexpectedResult(chrono.casual, "12026-W42", new Date(2012, 7, 10));
+});
