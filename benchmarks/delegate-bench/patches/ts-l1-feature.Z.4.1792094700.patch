@@ -0,0 +1,74 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, with an optional weekday (1 = Monday ... 7 = Sunday).
+    Without the weekday, the date is the Monday of the week.
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Do not fall back to a shorter match when followed by more digits (e.g. "2020-W01-12" or "2020W01-1")
+    "(?!\\w|-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+const MILLISECONDS_IN_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekdayNumber = match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP];
+        const weekday = weekdayNumber ? parseInt(weekdayNumber) : 1;
+
+        const firstMonday = getMondayOfFirstISOWeek(year);
+        const weeksInYear =
+            (getMondayOfFirstISOWeek(year + 1).getTime() - firstMonday.getTime()) / MILLISECONDS_IN_WEEK;
+        if (week < 1 || week > weeksInYear || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = new Date(firstMonday.getTime());
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday of the ISO week 1 (the week containing January 4th) of the ISO week-numbering year as a UTC date.
+ */
+function getMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(0);
+    date.setUTCFullYear(year, 0, 4);
+    const isoWeekday = date.getUTCDay() || 7;
+    date.setUTCDate(date.getUTCDate() - (isoWeekday - 1));
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..68025da
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,229 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W42-4", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42-4");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(15);
+        expect(result.start.get("weekday")).toBe(4);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.start.isCertain("second")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Week date without weekday means Monday (YYYY-Www)", () => {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42");
+
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W424", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W424");
+
+        expect(result.start.get("weekday")).toBe(4);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", () => {
+    testSingleCase(chrono, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Lowercase week designator", () => {
+    testSingleCase(chrono, "2026-w42-4", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-w42-4");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono, "2026w424", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026w424");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+});
+
+test("Test - Sunday as the last day of the week", () => {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", () => {
+    testSingleCase(chrono, "2020-W01-1", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2008-W01-1", new Date(2008, 5, 1), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 ISO weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2020, 5, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2015W53", new Date(2015, 5, 1), (result) => {
+        expect(result.text).toBe("2015W53");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year", () => {
+    testSingleCase(chrono, "2009-W53-7", new Date(2009, 5, 1), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+
+        expect(result.start.get("year")).toBe(2010);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2004W536", new Date(2004, 5, 1), (result) => {
+        expect(result.text).toBe("2004W536");
+        expect(result.start).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date within a sentence", () => {
+    testSingleCase(chrono, "The release is planned for 2026-W43-5.", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W43-5");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 23, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review (2026W44)", new Date(2026, 9, 15), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2026W44");
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 26, 12));
+    });
+});
+
+test("Test - Strict mode", () => {
+    testSingleCase(chrono.strict, "2026-W42-4", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date followed by time", () => {
+    testSingleCase(chrono, "2026-W42-4 10:30", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-4 10:30");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 15, 10, 30));
+    });
+});
+
+test("Test - Week date range", () => {
+    testSingleCase(chrono, "2026-W42 to 2026-W44", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42 to 2026-W44");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+        expect(result.end).toBeDate(new Date(2026, 10 - 1, 26, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W001", new Date(2026, 0, 1));
+});
+
+test("Test - Week above 53 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W541", new Date(2026, 0, 1));
+});
+
+test("Test - Week 53 in a year with 52 ISO weeks is not a week date", () => {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2021, 0, 1));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2021, 0, 1));
+    testUnexpectedResult(chrono, "2021W537", new Date(2021, 0, 1));
+});
+
+test("Test - Weekday 0 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W42-0", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W420", new Date(2026, 0, 1));
+});
+
+test("Test - Weekday 8 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W42-8", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W428", new Date(2026, 0, 1));
+});
+
+test("Test - Weekday 9 is not a week date", () => {
+    testUnexpectedResult(chrono, "2026-W42-9", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W429", new Date(2026, 0, 1));
+});
+
+test("Test - Invalid week date in strict mode", () => {
+    testUnexpectedResult(chrono.strict, "2021-W53", new Date(2021, 0, 1));
+    testUnexpectedResult(chrono.strict, "2026-W42-8", new Date(2026, 0, 1));
+});
+
+test("Test - Malformed week date", () => {
+    testUnexpectedResult(chrono, "2026-W4", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W421", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W42-4", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026-W42-41", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "2026W4245", new Date(2026, 0, 1));
+    testUnexpectedResult(chrono, "12026-W42", new Date(2026, 0, 1));
+});
