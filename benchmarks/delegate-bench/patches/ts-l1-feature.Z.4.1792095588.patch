diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..5fc35b8
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,73 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www (e.g. 2020-W10, the Monday of the week)
+    - YYYY-Www-D (e.g. 2020-W10-3, D = 1 for Monday ... 7 for Sunday)
+    - YYYYWww (e.g. 2020W10)
+    - YYYYWwwD (e.g. 2020W103)
+*/
+const PATTERN = new RegExp(
+    `([0-9]{4})(-?)W([0-9]{2})` +
+        // When a digit follows the week, it must be the weekday (never fall back to the shorter week-only form)
+        `(?:(-?)([0-9])|(?!-?[0-9]))` +
+        "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        const isoWeekday = match[WEEKDAY_NUMBER_GROUP] ? parseInt(match[WEEKDAY_NUMBER_GROUP]) : 1;
+
+        // Either the extended (YYYY-Www-D) or the basic (YYYYWwwD) format, but not mixed
+        if (match[WEEKDAY_NUMBER_GROUP] && match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+            return null;
+        }
+        if (week < 1 || week > getISOWeeksInYear(year)) {
+            return null;
+        }
+        if (isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // The week 1 is the week with the year's first Thursday (or, the week with January 4th)
+        const date = createUTCDate(year, 0, 4);
+        const mondayOfWeekOne = date.getUTCDate() - ((date.getUTCDay() + 6) % 7);
+        date.setUTCDate(mondayOfWeekOne + (week - 1) * 7 + (isoWeekday - 1));
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function getISOWeeksInYear(year: number): number {
+    // A year has 53 ISO weeks when it starts or ends on a Thursday
+    const isThursday = (date: Date) => date.getUTCDay() == 4;
+    return isThursday(createUTCDate(year, 0, 1)) || isThursday(createUTCDate(year, 11, 31)) ? 53 : 52;
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    // Use setUTCFullYear() because Date.UTC() maps the years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, month, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..7b0f498
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,201 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2020-W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(2);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.strict, "2020-W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.casual, "2020-w10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-w10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2020-W10-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-3");
+
+        expect(result.start.get("year")).toBe(2020);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2020-W10-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-1");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono, "2020-W10-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+
+    testSingleCase(chrono.strict, "2020-w10-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-w10-5");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", function () {
+    testSingleCase(chrono, "2020W10", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono, "2020W103", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020W103");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.strict, "2020w107", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020w107");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 8, 12));
+    });
+});
+
+test("Test - Week date within text", function () {
+    testSingleCase(
+        chrono,
+        "The sprint starts on 2020-W10-2, right after the review",
+        new Date(2024, 5, 15),
+        (result) => {
+            expect(result.index).toBe(21);
+            expect(result.text).toBe("2020-W10-2");
+            expect(result.start).toBeDate(new Date(2020, 3 - 1, 3, 12));
+        }
+    );
+
+    testSingleCase(chrono, "Release (2020W10)", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(9);
+        expect(result.text).toBe("2020W10");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.strict, "Due by 2020W105.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2020W105");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Week-numbering year differs from the calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2010-W01", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2010-W01");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2015-W53-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2015-W53-7");
+        expect(result.start.get("year")).toBe(2016);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026W534", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026W534");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2004-W53-6", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2004-W53-6");
+        expect(result.start).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week date followed by time", function () {
+    testSingleCase(chrono, "2020-W10-2 at 10am", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W10-2 at 10am");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 3, 10));
+    });
+});
+
+test("Test - Invalid week", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W54", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020W99", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W00-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "2020W001", new Date(2024, 5, 15));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2019W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "Due 2021-W53 at the latest", new Date(2024, 5, 15));
+});
+
+test("Test - Invalid weekday", function () {
+    testUnexpectedResult(chrono, "2020-W10-0", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W10-8", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W10-9", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020W100", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020W108", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "Due 2020-W10-8 at the latest", new Date(2024, 5, 15));
+});
+
+test("Test - Malformed week date", function () {
+    testUnexpectedResult(chrono, "2020-W1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W10-12", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020W1012", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W10x", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020W10-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2020-W101", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "12020-W10", new Date(2024, 5, 15));
+});
