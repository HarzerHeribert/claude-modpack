diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..60b0434
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,65 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+    The weekday D is 1 (Monday) to 7 (Sunday). Without it, the date is the Monday of the week.
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" +
+        "|" +
+        "W([0-9]{2})([0-9])?" +
+    ")" +
+    // Do not fall back to a shorter week date (e.g. "2026-W10" out of "2026-W10-35")
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP] ?? "1");
+        if (week < 1 || week > 53 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th, and each week belongs to the year of its Thursday.
+        // (setUTCFullYear() is used, because Date.UTC() maps the years 0-99 to 1900-1999)
+        const thursday = new Date(0);
+        thursday.setUTCFullYear(year, 0, 4);
+        thursday.setUTCDate(4 - (thursday.getUTCDay() || 7) + 4 + (week - 1) * 7);
+        if (thursday.getUTCFullYear() !== year) {
+            // Week 53 of a year with only 52 weeks
+            return null;
+        }
+
+        const date = new Date(thursday);
+        date.setUTCDate(thursday.getUTCDate() + weekday - 4);
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..262f61b
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,219 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Extended week date (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2026-W10-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(3);
+        expect(result.start.get("day")).toBe(4);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "The sprint starts on 2026-W10-1 as planned", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2026-W10-1");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono, "2026-W10-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 8, 12));
+    });
+
+    testSingleCase(chrono, "2026-w10-5", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-w10-5");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Extended week date without weekday (YYYY-Www)", () => {
+    testSingleCase(chrono, "2026-W10", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono, "Release planned for 2026-W43.", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(20);
+        expect(result.text).toBe("2026-W43");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+    });
+
+    testSingleCase(chrono, "2026-w10", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-w10");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww and YYYYWwwD)", () => {
+    testSingleCase(chrono, "2026W103", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W103");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2026W10", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W10");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono, "2026w107", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026w107");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 8, 12));
+    });
+
+    testSingleCase(chrono, "Due by 2026W436, please", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2026W436");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 24, 12));
+    });
+});
+
+test("Test - Week date across the calendar year boundary", () => {
+    testSingleCase(chrono, "2026-W01", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2008-W01-1", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 12 - 1, 31, 12));
+    });
+
+    testSingleCase(chrono, "2010-W01-1", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2010-W01-1");
+        expect(result.start).toBeDate(new Date(2010, 1 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "2025-W52-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2025-W52-7");
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 weeks", () => {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2020W535", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2020W535");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2015-W53-4", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2015-W53-4");
+        expect(result.start).toBeDate(new Date(2015, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - Week date in strict and casual mode", () => {
+    testSingleCase(chrono.strict, "2026-W10-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W10", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W10");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026-W10-3", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 4, 12));
+    });
+
+    testSingleCase(chrono.casual, "2026W10", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026W10");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date with time and range", () => {
+    testSingleCase(chrono, "2026-W10-3 at 10:00", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.text).toBe("2026-W10-3 at 10:00");
+        expect(result.start.isCertain("hour")).toBe(true);
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 4, 10));
+    });
+
+    testSingleCase(chrono, "from 2026-W10 to 2026-W12", new Date(2026, 10 - 1, 16), (result) => {
+        expect(result.index).toBe(5);
+        expect(result.text).toBe("2026-W10 to 2026-W12");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 2, 12));
+        expect(result.end).toBeDate(new Date(2026, 3 - 1, 16, 12));
+    });
+});
+
+test("Test - Invalid week number", () => {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W541", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Week 53 in a year with 52 weeks", () => {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2021W537", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Invalid weekday", () => {
+    testUnexpectedResult(chrono, "2026-W10-0", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W10-8", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W10-9", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W100", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W108", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W109", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2026-W10-8", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono.strict, "2026W108", new Date(2026, 10 - 1, 16));
+});
+
+test("Test - Malformed week date", () => {
+    testUnexpectedResult(chrono, "2026-W1", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W100", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W10-35", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W10-3", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026W1035", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "12026-W10", new Date(2026, 10 - 1, 16));
+    testUnexpectedResult(chrono, "2026-W10x", new Date(2026, 10 - 1, 16));
+});
