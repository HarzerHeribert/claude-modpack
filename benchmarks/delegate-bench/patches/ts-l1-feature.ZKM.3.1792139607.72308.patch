@@ -0,0 +1,71 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week dates (the weekday is 1 = Monday ... 7 = Sunday, defaulting to Monday):
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // YYYY-Www or YYYY-Www-D
+        "|" +
+        "W([0-9]{2})([0-9])?" + // YYYYWww or YYYYWwwD
+    ")" +
+    // Don't fall back to a shorter match on an invalid weekday (e.g. "2024-W01-10")
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP] ?? "1");
+        if (week < 1 || week > getISOWeeksInYear(year) || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = getISOWeekOneMonday(year);
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        return context
+            .createParsingComponents({
+                "year": date.getUTCFullYear(),
+                "month": date.getUTCMonth() + 1,
+                "day": date.getUTCDate(),
+                "weekday": date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+/**
+ * Returns the Monday (as a UTC date) of week 1 of the ISO week-numbering year, i.e. the week with January 4th.
+ */
+function getISOWeekOneMonday(year: number): Date {
+    const date = new Date(Date.UTC(2000, 0, 4));
+    // Date.UTC() maps years 0-99 to 1900-1999
+    date.setUTCFullYear(year);
+    date.setUTCDate(date.getUTCDate() - ((date.getUTCDay() + 6) % 7));
+    return date;
+}
+
+function getISOWeeksInYear(year: number): number {
+    const weekMilliseconds = 7 * 24 * 60 * 60 * 1000;
+    return (getISOWeekOneMonday(year + 1).getTime() - getISOWeekOneMonday(year).getTime()) / weekMilliseconds;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..9de7dcf
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,217 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Single Expression (YYYY-Www)", function () {
+    testSingleCase(chrono, "2024-W01", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W01");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2024-w15", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-w15");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 8, 12));
+    });
+
+    testSingleCase(chrono, "The sprint starts in 2024-W20.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(21);
+        expect(result.text).toBe("2024-W20");
+        expect(result.start).toBeDate(new Date(2024, 5 - 1, 13, 12));
+    });
+});
+
+test("Test - Single Expression (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2024-W01-3", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W01-3");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2024-W01-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W01-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 7, 12));
+    });
+
+    testSingleCase(chrono, "2024-w15-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-w15-5");
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "The release is planned for 2024-W15-1, after review", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W15-1");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 8, 12));
+    });
+});
+
+test("Test - Single Expression (YYYYWww)", function () {
+    testSingleCase(chrono, "2024W01", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W01");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2024w15", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024w15");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 8, 12));
+    });
+
+    testSingleCase(chrono, "Sprint 2024W20 starts", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2024W20");
+        expect(result.start).toBeDate(new Date(2024, 5 - 1, 13, 12));
+    });
+});
+
+test("Test - Single Expression (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2024W013", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W013");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2024w155", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024w155");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono, "Due on 2024W155.", new Date(2024, 5, 15), (result) => {
+        expect(result.index).toBe(7);
+        expect(result.text).toBe("2024W155");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+});
+
+test("Test - Week dates outside the calendar year", function () {
+    testSingleCase(chrono, "2020-W01-1", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53-7", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2026-W53-7");
+
+        expect(result.start.get("year")).toBe(2027);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(3);
+        expect(result.start.get("weekday")).toBe(0);
+
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2015W537", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Certain date and implied time", function () {
+    testSingleCase(chrono, "2024-W15-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W15-5");
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Strict and casual mode", function () {
+    testSingleCase(chrono.strict, "2024-W15-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W15-5");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W155", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W155");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024-W15-5", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024-W15-5");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024W155", new Date(2024, 5, 15), (result) => {
+        expect(result.text).toBe("2024W155");
+        expect(result.start).toBeDate(new Date(2024, 4 - 1, 12, 12));
+    });
+});
+
+test("Test - Invalid week", function () {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W00-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W001", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono, "2024-W54", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W99-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W54", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono, "2024-W1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W123", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono.strict, "2024-W00", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "2024W54", new Date(2024, 5, 15));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", function () {
+    testUnexpectedResult(chrono, "2024-W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W53-1", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W53", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2021W537", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono, "The deadline is 2024-W53.", new Date(2024, 5, 15));
+});
+
+test("Test - Invalid weekday", function () {
+    testUnexpectedResult(chrono, "2024-W01-0", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W01-8", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024-W01-9", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W010", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W018", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W019", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono, "2024-W01-10", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W0110", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono, "The deadline is 2024-W01-8.", new Date(2024, 5, 15));
+
+    testUnexpectedResult(chrono.strict, "2024-W01-8", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono.strict, "2024W010", new Date(2024, 5, 15));
+});
+
+test("Test - Mixed extended and compact forms", function () {
+    testUnexpectedResult(chrono, "2024-W013", new Date(2024, 5, 15));
+    testUnexpectedResult(chrono, "2024W01-3", new Date(2024, 5, 15));
+});
