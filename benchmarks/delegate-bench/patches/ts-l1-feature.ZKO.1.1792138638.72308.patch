diff --git a/src/locales/en/parsers/ENISOWeekDateParser.ts b/src/locales/en/parsers/ENISOWeekDateParser.ts
new file mode 100644
index 0000000..e0079ae
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,75 @@
+import { ParsingContext } from "../../../chrono";
+import { Weekday } from "../../../types";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date, with an optional weekday (1 = Monday ... 7 = Sunday).
+    Without the weekday, it refers to the Monday of the week.
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    "([0-9]{4})(-?)W([0-9]{2})" +
+        // A digit in the weekday position must be the weekday (never fall back to a shorter match)
+        "(?:(-?)([0-9])|(?!-?[0-9]))" +
+        "(?=\\W|$)",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        let isoWeekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP]) {
+            // Basic (YYYYWwwD) and extended (YYYY-Www-D) formats can't be mixed
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            isoWeekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+        }
+
+        if (week < 1 || week > getISOWeeksInYear(year) || isoWeekday < 1 || isoWeekday > 7) {
+            return null;
+        }
+
+        // January 4th is always in the first ISO week of its year
+        const january4th = createUTCDate(year, 1, 4);
+        const january4thISOWeekday = january4th.getUTCDay() || 7;
+        const date = createUTCDate(year, 1, 4 - january4thISOWeekday + (week - 1) * 7 + isoWeekday);
+
+        const components = context.createParsingComponents({
+            year: date.getUTCFullYear(),
+            month: date.getUTCMonth() + 1,
+            day: date.getUTCDate(),
+            weekday: date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+function getISOWeeksInYear(year: number): number {
+    // A year has 53 ISO weeks if it starts or ends on a Thursday
+    const startsOnThursday = createUTCDate(year, 1, 1).getUTCDay() === Weekday.THURSDAY;
+    const endsOnThursday = createUTCDate(year, 12, 31).getUTCDay() === Weekday.THURSDAY;
+    return startsOnThursday || endsOnThursday ? 53 : 52;
+}
+
+function createUTCDate(year: number, month: number, day: number): Date {
+    // Use setUTCFullYear() as Date.UTC() maps the years 0-99 to 1900-1999
+    const date = new Date(0);
+    date.setUTCFullYear(year, month - 1, day);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..e4fc6dd
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,201 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date (YYYY-Www)", () => {
+    testSingleCase(chrono, "2024-W05", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+
+    testSingleCase(chrono, "2024-w05", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024-w05");
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+
+    testSingleCase(chrono, "The release is planned for 2024-W05.", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2024-W05");
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", () => {
+    testSingleCase(chrono, "2024-W05-3", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2024);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(31);
+        expect(result.start.get("weekday")).toBe(3);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+
+    testSingleCase(chrono, "2024-W05-7", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024-W05-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2024, 1, 4, 12));
+    });
+
+    testSingleCase(chrono, "The sprint review is on 2024-W05-5, as agreed", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(24);
+        expect(result.text).toBe("2024-W05-5");
+        expect(result.start).toBeDate(new Date(2024, 1, 2, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", () => {
+    testSingleCase(chrono, "2024W05", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024W05");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+
+    testSingleCase(chrono, "Due 2024w05", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2024w05");
+        expect(result.start).toBeDate(new Date(2024, 0, 29, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", () => {
+    testSingleCase(chrono, "2024W053", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2024W053");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+
+    testSingleCase(chrono, "Due 2024W056 at the latest", new Date(2024, 0, 1), (result) => {
+        expect(result.index).toBe(4);
+        expect(result.text).toBe("2024W056");
+        expect(result.start).toBeDate(new Date(2024, 1, 3, 12));
+    });
+});
+
+test("Test - Week date across calendar years", () => {
+    testSingleCase(chrono, "2020-W01-1", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W01-1");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 11, 30, 12));
+    });
+
+    testSingleCase(chrono, "2008-W01-1", new Date(2008, 0, 1), (result) => {
+        expect(result.text).toBe("2008-W01-1");
+        expect(result.start).toBeDate(new Date(2007, 11, 31, 12));
+    });
+
+    testSingleCase(chrono, "2021-W52-7", new Date(2021, 0, 1), (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 0, 2, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", () => {
+    testSingleCase(chrono, "2020-W53", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 11, 28, 12));
+    });
+
+    testSingleCase(chrono, "2020-W53-5", new Date(2020, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2021, 0, 1, 12));
+    });
+
+    testSingleCase(chrono, "2009-W53-7", new Date(2009, 0, 1), (result) => {
+        expect(result.text).toBe("2009-W53-7");
+        expect(result.start).toBeDate(new Date(2010, 0, 3, 12));
+    });
+
+    testSingleCase(chrono, "2026W53", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W53");
+        expect(result.start).toBeDate(new Date(2026, 11, 28, 12));
+    });
+});
+
+test("Test - Week date in strict and casual mode", () => {
+    testSingleCase(chrono.strict, "2024-W05-3", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+
+    testSingleCase(chrono.casual, "2024-W05-3", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024-W05-3");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+
+    testSingleCase(chrono.strict, "2024W053", new Date(2024, 0, 1), (result) => {
+        expect(result.text).toBe("2024W053");
+        expect(result.start).toBeDate(new Date(2024, 0, 31, 12));
+    });
+});
+
+test("Test - Invalid week number", () => {
+    testUnexpectedResult(chrono, "2024-W00", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W00-1", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W00", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W54", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W99-1", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W541", new Date(2024, 0, 1));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks", () => {
+    testUnexpectedResult(chrono, "2023-W53", new Date(2023, 0, 1));
+    testUnexpectedResult(chrono, "2024-W53-1", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2021W53", new Date(2021, 0, 1));
+    testUnexpectedResult(chrono, "2021W537", new Date(2021, 0, 1));
+});
+
+test("Test - Invalid weekday", () => {
+    testUnexpectedResult(chrono, "2024-W05-0", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W05-8", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W05-9", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W050", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W058", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W059", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "Due 2024-W05-8.", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono.strict, "2024-W05-9", new Date(2024, 0, 1));
+});
+
+test("Test - Not a week date", () => {
+    testUnexpectedResult(chrono, "2024-W05-12", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W0512", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W5", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W053", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024W05-3", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "12024-W05", new Date(2024, 0, 1));
+    testUnexpectedResult(chrono, "2024-W05x", new Date(2024, 0, 1));
+});
