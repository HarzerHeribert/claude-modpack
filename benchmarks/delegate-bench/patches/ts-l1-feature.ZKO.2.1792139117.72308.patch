index 0000000..7000a83
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,65 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, default to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp(
+    `([0-9]{4})` +
+        `(?:-W([0-9]{2})(?:-([0-9]))?|W([0-9]{2})([0-9])?)` +
+        // Not followed by a word or a "-digit" (e.g. "2020-W01-10"), so a shorter week date is never matched
+        "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const EXTENDED_WEEK_NUMBER_GROUP = 2;
+const EXTENDED_WEEKDAY_NUMBER_GROUP = 3;
+const BASIC_WEEK_NUMBER_GROUP = 4;
+const BASIC_WEEKDAY_NUMBER_GROUP = 5;
+
+const MILLISECONDS_PER_WEEK = 7 * 24 * 60 * 60 * 1000;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[EXTENDED_WEEK_NUMBER_GROUP] ?? match[BASIC_WEEK_NUMBER_GROUP]);
+        const weekdayText = match[EXTENDED_WEEKDAY_NUMBER_GROUP] ?? match[BASIC_WEEKDAY_NUMBER_GROUP];
+        const weekday = weekdayText ? parseInt(weekdayText) : 1;
+
+        const firstMonday = getMondayOfFirstISOWeek(year);
+        const weeksInYear =
+            (getMondayOfFirstISOWeek(year + 1).getTime() - firstMonday.getTime()) / MILLISECONDS_PER_WEEK;
+        if (week < 1 || week > weeksInYear || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        const date = new Date(firstMonday.getTime());
+        date.setUTCDate(date.getUTCDate() + (week - 1) * 7 + (weekday - 1));
+
+        const components = context.createParsingComponents({
+            "year": date.getUTCFullYear(),
+            "month": date.getUTCMonth() + 1,
+            "day": date.getUTCDate(),
+            "weekday": weekday % 7,
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
+
+// The first ISO week of a year is the week (starting on Monday) that contains January 4th.
+function getMondayOfFirstISOWeek(year: number): Date {
+    const date = new Date(Date.UTC(2000, 0, 4));
+    date.setUTCFullYear(year);
+    const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+    date.setUTCDate(date.getUTCDate() - daysSinceMonday);
+    return date;
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..8102207
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,219 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Extended week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(0);
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Extended week date without weekday (YYYY-Www) means Monday", function () {
+    testSingleCase(chrono, "2026-W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W425", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W425");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(16);
+        expect(result.start.get("weekday")).toBe(5);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww) means Monday", function () {
+    testSingleCase(chrono, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(10);
+        expect(result.start.get("day")).toBe(12);
+        expect(result.start.get("weekday")).toBe(1);
+
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Lowercase w", function () {
+    testSingleCase(chrono, "2020-w10-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2020-w10-5");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+
+    testSingleCase(chrono, "2020w105", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2020w105");
+        expect(result.start).toBeDate(new Date(2020, 3 - 1, 6, 12));
+    });
+});
+
+test("Test - Sunday is weekday 7", function () {
+    testSingleCase(chrono, "2026-W42-7", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 18, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono, "2020-W01", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W01");
+        expect(result.start.get("year")).toBe(2019);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(30);
+        expect(result.start).toBeDate(new Date(2019, 12 - 1, 30, 12));
+    });
+
+    testSingleCase(chrono, "2020-W01-3", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W01-3");
+        expect(result.start).toBeDate(new Date(2020, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2019W011", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2019W011");
+        expect(result.start).toBeDate(new Date(2018, 12 - 1, 31, 12));
+    });
+});
+
+test("Test - Week 53 in years with 53 ISO weeks", function () {
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2015W537", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2015W537");
+        expect(result.start).toBeDate(new Date(2016, 1 - 1, 3, 12));
+    });
+
+    testSingleCase(chrono, "2026-W53", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Last week in years with 52 ISO weeks", function () {
+    testSingleCase(chrono, "2021-W52-7", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2021-W52-7");
+        expect(result.start).toBeDate(new Date(2022, 1 - 1, 2, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(
+        chrono,
+        "The release is planned for 2026-W42-1, please be ready.",
+        new Date(2026, 0, 1),
+        (result) => {
+            expect(result.index).toBe(27);
+            expect(result.text).toBe("2026-W42-1");
+            expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+        }
+    );
+
+    testSingleCase(chrono, "Sprint (2026W43) starts", new Date(2026, 0, 1), (result) => {
+        expect(result.index).toBe(8);
+        expect(result.text).toBe("2026W43");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 19, 12));
+    });
+});
+
+test("Test - Strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W42-5", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026-W42-5");
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 16, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W42", new Date(2026, 0, 1), (result) => {
+        expect(result.text).toBe("2026W42");
+        expect(result.start).toBeDate(new Date(2026, 10 - 1, 12, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W00", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020-W00-1", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W00", new Date(2026, 0, 1));
+});
+
+test("Test - Week above 53 is not a week date", function () {
+    testUnexpectedResult(chrono, "2020-W54", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W99", new Date(2026, 0, 1));
+});
+
+test("Test - Week 53 in years with 52 ISO weeks is not a week date", function () {
+    testUnexpectedResult(chrono, "2021-W53", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2021-W53-1", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2021W53", new Date(2026, 0, 1));
+});
+
+test("Test - Weekday 0, 8 or 9 is not a week date (not even a shorter one)", function () {
+    testUnexpectedResult(chrono, "2020-W01-0", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020-W01-8", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020-W01-9", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W010", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W018", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W019", new Date(2026, 0, 1));
+});
+
+test("Test - Malformed week dates are not recognized (not even a shorter one)", function () {
+    testUnexpectedResult(chrono, "2020-W1", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020-W01-10", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020-W011", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W01-1", new Date(2026, 0, 1));
+
+    testUnexpectedResult(chrono, "2020W0111", new Date(2026, 0, 1));
+});
