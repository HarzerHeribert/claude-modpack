+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,61 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (the weekday is 1 = Monday ... 7 = Sunday, Monday if omitted)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+// prettier-ignore
+const PATTERN = new RegExp(
+    "([0-9]{4})" +
+    "(?:" +
+        "-W([0-9]{2})(?:-([0-9]))?" + // extended: YYYY-Www[-D]
+        "|" +
+        "W([0-9]{2})([0-9])?" + // compact: YYYYWww[D]
+    ")" +
+    // Do not fall back to a shorter match (e.g. "2026-W01" out of "2026-W01-8")
+    "(?=\\W|$)(?!-[0-9])",
+    "i"
+);
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_NUMBER_GROUP = 2;
+const WEEKDAY_NUMBER_GROUP = 3;
+const COMPACT_WEEK_NUMBER_GROUP = 4;
+const COMPACT_WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP] ?? match[COMPACT_WEEK_NUMBER_GROUP]);
+        const weekday = parseInt(match[WEEKDAY_NUMBER_GROUP] ?? match[COMPACT_WEEKDAY_NUMBER_GROUP] ?? "1");
+        if (week < 1 || week > 53 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th. Find its Monday as a day of January (may be <= 0).
+        const firstMonday = 4 - ((new Date(Date.UTC(year, 0, 4)).getUTCDay() + 6) % 7);
+        const monday = firstMonday + (week - 1) * 7;
+
+        // A week belongs to the year of its Thursday, so week 53 only exists in years with 53 weeks.
+        if (new Date(Date.UTC(year, 0, monday + 3)).getUTCFullYear() !== year) {
+            return null;
+        }
+
+        const date = new Date(Date.UTC(year, 0, monday + weekday - 1));
+        const components = context.createParsingComponents({
+            year: date.getUTCFullYear(),
+            month: date.getUTCMonth() + 1,
+            day: date.getUTCDate(),
+            weekday: date.getUTCDay(),
+        });
+        return components.addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..235248b
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,238 @@
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import * as chrono from "../../src";
+
+test("Test - Week date (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W15", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(6);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 6, 12));
+    });
+});
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W15-5", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15-5");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(4);
+        expect(result.start.get("day")).toBe(10);
+        expect(result.start.get("weekday")).toBe(5);
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Compact week date (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W15", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W15");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 6, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W155", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W155");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w15-5", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-w15-5");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Compact week date with lowercase w", function () {
+    testSingleCase(chrono, "2026w155", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026w155");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Week date with Sunday (7)", function () {
+    testSingleCase(chrono, "2026-W15-7", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 12, 12));
+    });
+});
+
+test("Test - Week date assigns the date and implies the time", function () {
+    testSingleCase(chrono, "2026-W15-5", new Date(2026, 9, 16), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2026-W15-5.", new Date(2026, 9, 16), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W15-5");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Compact week date within a sentence", function () {
+    testSingleCase(chrono, "Sprint ends 2026W155, then we ship", new Date(2026, 9, 16), (result) => {
+        expect(result.index).toBe(12);
+        expect(result.text).toBe("2026W155");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W15-5", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15-5");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 12));
+    });
+});
+
+test("Test - Week 1 starting in the previous calendar year", function () {
+    testSingleCase(chrono, "2026-W01", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W01");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 1 starting in the same calendar year", function () {
+    testSingleCase(chrono, "2024-W01", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2024-W01");
+        expect(result.start).toBeDate(new Date(2024, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Week 1 starting after January 1st", function () {
+    testSingleCase(chrono, "2021-W01", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2021-W01");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2026-W53", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W53");
+        expect(result.start).toBeDate(new Date(2026, 12 - 1, 28, 12));
+    });
+});
+
+test("Test - Week 53 ending in the next calendar year", function () {
+    testSingleCase(chrono, "2020-W53-5", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2020-W53-5");
+        expect(result.start.get("year")).toBe(2021);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 1, 12));
+    });
+});
+
+test("Test - Compact week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2020W537", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2020W537");
+        expect(result.start).toBeDate(new Date(2021, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week date followed by a time", function () {
+    testSingleCase(chrono, "2026-W15-5 at 10am", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15-5 at 10am");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 10, 10));
+    });
+});
+
+test("Test - Week date range", function () {
+    testSingleCase(chrono, "2026-W15 - 2026-W17", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W15 - 2026-W17");
+        expect(result.start).toBeDate(new Date(2026, 4 - 1, 6, 12));
+        expect(result.end).toBeDate(new Date(2026, 4 - 1, 20, 12));
+    });
+});
+
+test("Test - Week 00 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 9, 16));
+});
+
+test("Test - Compact week 00 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 9, 16));
+});
+
+test("Test - Week 00 with weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W00-1", new Date(2026, 9, 16));
+});
+
+test("Test - Week 54 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 9, 16));
+});
+
+test("Test - Compact week 54 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W54", new Date(2026, 9, 16));
+});
+
+test("Test - Week 99 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 9, 16));
+});
+
+test("Test - Week 53 in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 9, 16));
+});
+
+test("Test - Week 53 with weekday in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 9, 16));
+});
+
+test("Test - Compact week 53 in a year with 52 weeks is not a week date", function () {
+    testUnexpectedResult(chrono, "2025W537", new Date(2026, 9, 16));
+});
+
+test("Test - Weekday 0 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W15-0", new Date(2026, 9, 16));
+});
+
+test("Test - Weekday 8 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W15-8", new Date(2026, 9, 16));
+});
+
+test("Test - Weekday 9 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W15-9", new Date(2026, 9, 16));
+});
+
+test("Test - Compact weekday 0 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W150", new Date(2026, 9, 16));
+});
+
+test("Test - Compact weekday 8 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W158", new Date(2026, 9, 16));
+});
+
+test("Test - Compact weekday 9 is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W159", new Date(2026, 9, 16));
+});
+
+test("Test - Invalid weekday within a sentence is not a week date", function () {
+    testUnexpectedResult(chrono, "The release is planned for 2026-W15-8.", new Date(2026, 9, 16));
+});
+
+test("Test - Invalid week date in strict mode", function () {
+    testUnexpectedResult(chrono.strict, "2026-W15-8", new Date(2026, 9, 16));
+});
+
+test("Test - Extended week with compact weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W155", new Date(2026, 9, 16));
+});
+
+test("Test - Compact week with extended weekday is not a week date", function () {
+    testUnexpectedResult(chrono, "2026W15-5", new Date(2026, 9, 16));
+});
+
+test("Test - Single digit week is not a week date", function () {
+    testUnexpectedResult(chrono, "2026-W5", new Date(2026, 9, 16));
+});
