index 0000000..f0d395a
--- /dev/null
+++ b/src/locales/en/parsers/ENISOWeekDateParser.ts
@@ -0,0 +1,58 @@
+import { ParsingContext } from "../../../chrono";
+import { AbstractParserWithWordBoundaryChecking } from "../../../common/parsers/AbstractParserWithWordBoundary";
+
+/*
+    ISO 8601 week date (weekday: 1 = Monday ... 7 = Sunday, defaults to Monday)
+    - YYYY-Www
+    - YYYY-Www-D
+    - YYYYWww
+    - YYYYWwwD
+*/
+const PATTERN = new RegExp("([0-9]{4})(-?)W([0-9]{2})(?:(-?)([0-9]))?" + "(?=\\W|$)", "i");
+
+const YEAR_NUMBER_GROUP = 1;
+const WEEK_SEPARATOR_GROUP = 2;
+const WEEK_NUMBER_GROUP = 3;
+const WEEKDAY_SEPARATOR_GROUP = 4;
+const WEEKDAY_NUMBER_GROUP = 5;
+
+export default class ENISOWeekDateParser extends AbstractParserWithWordBoundaryChecking {
+    innerPattern(): RegExp {
+        return PATTERN;
+    }
+
+    innerExtract(context: ParsingContext, match: RegExpMatchArray) {
+        const year = parseInt(match[YEAR_NUMBER_GROUP]);
+        const week = parseInt(match[WEEK_NUMBER_GROUP]);
+        let weekday = 1;
+        if (match[WEEKDAY_NUMBER_GROUP] != null) {
+            // Either the extended (YYYY-Www-D) or the basic (YYYYWwwD) form, but not a mix of both
+            if (match[WEEKDAY_SEPARATOR_GROUP] !== match[WEEK_SEPARATOR_GROUP]) {
+                return null;
+            }
+            weekday = parseInt(match[WEEKDAY_NUMBER_GROUP]);
+        }
+        if (week < 1 || week > 53 || weekday < 1 || weekday > 7) {
+            return null;
+        }
+
+        // Week 1 is the week containing January 4th. Every week's Thursday falls within its week-numbering year.
+        const date = new Date(0);
+        date.setUTCFullYear(year, 0, 4);
+        date.setUTCDate(4 - ((date.getUTCDay() + 6) % 7) + (week - 1) * 7 + 3);
+        if (date.getUTCFullYear() !== year) {
+            // Week 53 of a year with only 52 weeks
+            return null;
+        }
+        date.setUTCDate(date.getUTCDate() + weekday - 4);
+
+        return context
+            .createParsingComponents({
+                year: date.getUTCFullYear(),
+                month: date.getUTCMonth() + 1,
+                day: date.getUTCDate(),
+                weekday: date.getUTCDay(),
+            })
+            .addTag("parser/ENISOWeekDateParser");
+    }
+}
diff --git a/test/en/en_iso_week_date.test.ts b/test/en/en_iso_week_date.test.ts
new file mode 100644
index 0000000..5a55e28
--- /dev/null
+++ b/test/en/en_iso_week_date.test.ts
@@ -0,0 +1,160 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+
+test("Test - Week date with weekday (YYYY-Www-D)", function () {
+    testSingleCase(chrono, "2026-W05-3", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(28);
+        expect(result.start.get("weekday")).toBe(3);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date without weekday (YYYY-Www)", function () {
+    testSingleCase(chrono, "2026-W05", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W05");
+        expect(result.start.get("year")).toBe(2026);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(26);
+        expect(result.start.get("weekday")).toBe(1);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Compact week date with weekday (YYYYWwwD)", function () {
+    testSingleCase(chrono, "2026W053", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W053");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Compact week date without weekday (YYYYWww)", function () {
+    testSingleCase(chrono, "2026W05", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W05");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Week date with lowercase w", function () {
+    testSingleCase(chrono, "2026-w05-3", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-w05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2026w053", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026w053");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+});
+
+test("Test - Week date with Sunday as weekday 7", function () {
+    testSingleCase(chrono, "2026-W01-7", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W01-7");
+        expect(result.start.get("weekday")).toBe(0);
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 4, 12));
+    });
+});
+
+test("Test - Week date falling in the previous calendar year", function () {
+    testSingleCase(chrono, "2026-W01-1", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W01-1");
+        expect(result.start.get("year")).toBe(2025);
+        expect(result.start.get("month")).toBe(12);
+        expect(result.start.get("day")).toBe(29);
+        expect(result.start).toBeDate(new Date(2025, 12 - 1, 29, 12));
+    });
+
+    testSingleCase(chrono, "2009-W01-1", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2009-W01-1");
+        expect(result.start).toBeDate(new Date(2008, 12 - 1, 29, 12));
+    });
+});
+
+test("Test - Week 53 in a year with 53 weeks", function () {
+    testSingleCase(chrono, "2020-W53", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2020-W53");
+        expect(result.start).toBeDate(new Date(2020, 12 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "2004-W53-6", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2004-W53-6");
+        expect(result.start.get("year")).toBe(2005);
+        expect(result.start.get("month")).toBe(1);
+        expect(result.start.get("day")).toBe(1);
+        expect(result.start).toBeDate(new Date(2005, 1 - 1, 1, 12));
+    });
+
+    testSingleCase(chrono, "2026W537", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W537");
+        expect(result.start).toBeDate(new Date(2027, 1 - 1, 3, 12));
+    });
+});
+
+test("Test - Week date within a sentence", function () {
+    testSingleCase(chrono, "The release is planned for 2026-W05-3 at the latest", new Date(2026, 9, 16), (result) => {
+        expect(result.index).toBe(27);
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono, "Sprint review: 2026W12.", new Date(2026, 9, 16), (result) => {
+        expect(result.index).toBe(15);
+        expect(result.text).toBe("2026W12");
+        expect(result.start).toBeDate(new Date(2026, 3 - 1, 16, 12));
+    });
+});
+
+test("Test - Week date certainty and tag", function () {
+    testSingleCase(chrono, "2026-W05-3", new Date(2026, 9, 16), (result) => {
+        expect(result.start.isCertain("year")).toBe(true);
+        expect(result.start.isCertain("month")).toBe(true);
+        expect(result.start.isCertain("day")).toBe(true);
+        expect(result.start.isCertain("weekday")).toBe(true);
+        expect(result.start.isCertain("hour")).toBe(false);
+        expect(result.start.isCertain("minute")).toBe(false);
+        expect(result.tags()).toContain("parser/ENISOWeekDateParser");
+    });
+});
+
+test("Test - Week date in strict mode", function () {
+    testSingleCase(chrono.strict, "2026-W05-3", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026-W05-3");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 28, 12));
+    });
+
+    testSingleCase(chrono.strict, "2026W05", new Date(2026, 9, 16), (result) => {
+        expect(result.text).toBe("2026W05");
+        expect(result.start).toBeDate(new Date(2026, 1 - 1, 26, 12));
+    });
+});
+
+test("Test - Invalid week number", function () {
+    testUnexpectedResult(chrono, "2026-W00", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026-W54", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026-W99-1", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W00", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W541", new Date(2026, 9, 16));
+});
+
+test("Test - Week 53 in a year with 52 weeks", function () {
+    testUnexpectedResult(chrono, "2025-W53", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2025-W53-1", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2025W537", new Date(2026, 9, 16));
+});
+
+test("Test - Invalid weekday number", function () {
+    testUnexpectedResult(chrono, "2026-W05-0", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026-W05-8", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026-W05-9", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W050", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W058", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W059", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "Planned for 2026-W05-8.", new Date(2026, 9, 16));
+});
+
+test("Test - Mixed extended and compact week date forms", function () {
+    testUnexpectedResult(chrono, "2026-W053", new Date(2026, 9, 16));
+    testUnexpectedResult(chrono, "2026W05-3", new Date(2026, 9, 16));
+});
