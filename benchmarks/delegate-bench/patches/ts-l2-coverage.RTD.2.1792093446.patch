+import { parseDuration, parseNumberPattern, parseYear } from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with apostrophe article", () => {
+    expect(parseNumberPattern("un'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with 'qualche'", () => {
+    expect(parseNumberPattern("qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with 'mezzo'", () => {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with 'paio di'", () => {
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with 'alcuni'", () => {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with digits", () => {
+    expect(parseNumberPattern("2.5")).toBe(2.5);
+});
+
+test("Test - parseYear with Buddhist Era", () => {
+    expect(parseYear("2555 BE")).toBe(2012);
+});
+
+test("Test - parseYear with BC", () => {
+    expect(parseYear("100 BC")).toBe(-100);
+});
+
+test("Test - parseYear with BCE", () => {
+    expect(parseYear("100 BCE")).toBe(-100);
+});
+
+test("Test - parseYear with AD", () => {
+    expect(parseYear("100 AD")).toBe(100);
+});
+
+test("Test - parseYear with CE", () => {
+    expect(parseYear("100 CE")).toBe(100);
+});
+
+test("Test - parseYear with two digits", () => {
+    expect(parseYear("12")).toBe(2012);
+});
+
+test("Test - parseDuration with valid text", () => {
+    expect(parseDuration("2 ore e 3 minuti")).toEqual({ hour: 2, minute: 3 });
+});
+
+test("Test - parseDuration with no match", () => {
+    expect(parseDuration("niente")).toBeNull();
+});
+
+test("Test - parseDuration ignoring letters-only match", () => {
+    expect(parseDuration("unmin")).toBeNull();
+});
