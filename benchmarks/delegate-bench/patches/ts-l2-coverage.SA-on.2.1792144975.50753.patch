diff --git a/test/it/it_constants_more.test.ts b/test/it/it_constants_more.test.ts
new file mode 100644
index 0000000..6c3c994
--- /dev/null
+++ b/test/it/it_constants_more.test.ts
@@ -0,0 +1,106 @@
+import {
+    parseNumberPattern,
+    parseOrdinalNumberPattern,
+    parseYear,
+    parseDuration,
+} from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with integer words", () => {
+    expect(parseNumberPattern("due")).toBe(2);
+});
+
+test("Test - parseNumberPattern with integer words in uppercase", () => {
+    expect(parseNumberPattern("Dodici")).toBe(12);
+});
+
+test("Test - parseNumberPattern with elided article un'", () => {
+    expect(parseNumberPattern("un'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with qualche", () => {
+    expect(parseNumberPattern("qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with mezzo", () => {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with mezza", () => {
+    expect(parseNumberPattern("mezza")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with paio di", () => {
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with alcuni", () => {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with digits", () => {
+    expect(parseNumberPattern("15")).toBe(15);
+});
+
+test("Test - parseNumberPattern with decimal digits", () => {
+    expect(parseNumberPattern("1.5")).toBe(1.5);
+});
+
+test("Test - parseOrdinalNumberPattern with ordinal word", () => {
+    expect(parseOrdinalNumberPattern("ventunesimo")).toBe(21);
+});
+
+test("Test - parseOrdinalNumberPattern with masculine ordinal indicator", () => {
+    expect(parseOrdinalNumberPattern("5º")).toBe(5);
+});
+
+test("Test - parseOrdinalNumberPattern with plain digits", () => {
+    expect(parseOrdinalNumberPattern("12")).toBe(12);
+});
+
+test("Test - parseYear with Buddhist Era", () => {
+    expect(parseYear("2555 BE")).toBe(2012);
+});
+
+test("Test - parseYear with BC", () => {
+    expect(parseYear("500 BC")).toBe(-500);
+});
+
+test("Test - parseYear with BCE", () => {
+    expect(parseYear("300 BCE")).toBe(-300);
+});
+
+test("Test - parseYear with AD", () => {
+    expect(parseYear("2000 AD")).toBe(2000);
+});
+
+test("Test - parseYear with CE", () => {
+    expect(parseYear("1999 CE")).toBe(1999);
+});
+
+test("Test - parseYear with four-digit year", () => {
+    expect(parseYear("2024")).toBe(2024);
+});
+
+test("Test - parseDuration with a single unit", () => {
+    expect(parseDuration("2 giorni")).toStrictEqual({ day: 2 });
+});
+
+test("Test - parseDuration with multiple units", () => {
+    expect(parseDuration("1 ora e 30 minuti")).toStrictEqual({ hour: 1, minute: 30 });
+});
+
+test("Test - parseDuration with abbreviated units", () => {
+    expect(parseDuration("3 gg")).toStrictEqual({ day: 3 });
+});
+
+test("Test - parseDuration with mezza ora", () => {
+    expect(parseDuration("mezza ora")).toStrictEqual({ hour: 0.5 });
+});
+
+test("Test - parseDuration without any time unit", () => {
+    expect(parseDuration("niente")).toBeNull();
+});
+
+test("Test - parseDuration ignores letters-only matches without separator", () => {
+    expect(parseDuration("duesettimane")).toBeNull();
+});
