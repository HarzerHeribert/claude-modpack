diff --git a/test/it/it_constants_more.test.ts b/test/it/it_constants_more.test.ts
new file mode 100644
index 0000000..e96bb64
--- /dev/null
+++ b/test/it/it_constants_more.test.ts
@@ -0,0 +1,167 @@
+import * as chrono from "../../src";
+import { testSingleCase, testUnexpectedResult } from "../test_util";
+import {
+    parseDuration,
+    parseNumberPattern,
+    parseOrdinalNumberPattern,
+    parseYear,
+} from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with integer words", function () {
+    expect(parseNumberPattern("due")).toBe(2);
+    expect(parseNumberPattern("Dodici")).toBe(12);
+    expect(parseNumberPattern("una")).toBe(1);
+});
+
+test("Test - parseNumberPattern with un'", function () {
+    expect(parseNumberPattern("un'")).toBe(1);
+    expect(parseNumberPattern("UN'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with qualche", function () {
+    expect(parseNumberPattern("qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with mezzo/mezza", function () {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+    expect(parseNumberPattern("mezza ")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with paio", function () {
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with alcuni", function () {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with digits", function () {
+    expect(parseNumberPattern("15")).toBe(15);
+    expect(parseNumberPattern("1.5")).toBe(1.5);
+});
+
+test("Test - parseOrdinalNumberPattern", function () {
+    expect(parseOrdinalNumberPattern("ventunesimo")).toBe(21);
+    expect(parseOrdinalNumberPattern("3ª")).toBe(3);
+    expect(parseOrdinalNumberPattern("5º")).toBe(5);
+    expect(parseOrdinalNumberPattern("15")).toBe(15);
+});
+
+test("Test - parseYear with Buddhist Era", function () {
+    expect(parseYear("2555 BE")).toBe(2012);
+    expect(parseYear("2555be")).toBe(2012);
+});
+
+test("Test - parseYear with BC", function () {
+    expect(parseYear("500 BC")).toBe(-500);
+});
+
+test("Test - parseYear with BCE", function () {
+    expect(parseYear("500 BCE")).toBe(-500);
+});
+
+test("Test - parseYear with AD", function () {
+    expect(parseYear("2012 AD")).toBe(2012);
+});
+
+test("Test - parseYear with CE", function () {
+    expect(parseYear("2012 CE")).toBe(2012);
+});
+
+test("Test - parseYear without era", function () {
+    expect(parseYear("2012")).toBe(2012);
+    expect(parseYear("99")).toBe(1999);
+});
+
+test("Test - parseDuration with multiple units", function () {
+    expect(parseDuration("2 ore e 30 minuti")).toStrictEqual({ hour: 2, minute: 30 });
+});
+
+test("Test - parseDuration without any time unit", function () {
+    expect(parseDuration("domani")).toBeNull();
+    expect(parseDuration("")).toBeNull();
+});
+
+test("Test - parseDuration ignores number and unit glued into a single word", function () {
+    expect(parseDuration("unoh")).toBeNull();
+    expect(parseDuration("duem")).toBeNull();
+});
+
+test("Test - Time units ago with un'", function () {
+    testSingleCase(chrono.it, "un'ora fa", new Date(2012, 7, 10, 12, 0), (result) => {
+        expect(result.text).toBe("un'ora fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 11, 0));
+    });
+});
+
+test("Test - Time units ago with qualche", function () {
+    testSingleCase(chrono.it, "qualche giorno fa", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("qualche giorno fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 7));
+    });
+});
+
+test("Test - Time units ago with mezza", function () {
+    testSingleCase(chrono.it, "mezza ora fa", new Date(2012, 7, 10, 12, 0), (result) => {
+        expect(result.text).toBe("mezza ora fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 11, 30));
+    });
+});
+
+test("Test - Time units ago with paio di", function () {
+    testSingleCase(chrono.it, "un paio di giorni fa", new Date(2012, 7, 10), (result) => {
+        expect(result.index).toBe(3);
+        expect(result.text).toBe("paio di giorni fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 8));
+    });
+});
+
+test("Test - Time units ago with alcuni", function () {
+    testSingleCase(chrono.it, "alcuni giorni fa", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("alcuni giorni fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 3));
+    });
+});
+
+test("Test - Month name with Buddhist Era year", function () {
+    testSingleCase(chrono.it, "10 agosto 2555 BE", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("10 agosto 2555 BE");
+        expect(result.start.get("year")).toBe(2012);
+        expect(result.start.get("month")).toBe(8);
+        expect(result.start.get("day")).toBe(10);
+    });
+});
+
+test("Test - Month name with BC year", function () {
+    testSingleCase(chrono.it, "10 agosto 500 BC", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("10 agosto 500 BC");
+        expect(result.start.get("year")).toBe(-500);
+        expect(result.start.get("month")).toBe(8);
+        expect(result.start.get("day")).toBe(10);
+    });
+});
+
+test("Test - Month name with BCE year", function () {
+    testSingleCase(chrono.it, "10 agosto 500 BCE", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("10 agosto 500 BCE");
+        expect(result.start.get("year")).toBe(-500);
+    });
+});
+
+test("Test - Month name with AD year", function () {
+    testSingleCase(chrono.it, "10 agosto 2012 AD", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("10 agosto 2012 AD");
+        expect(result.start.get("year")).toBe(2012);
+    });
+});
+
+test("Test - Month name with CE year", function () {
+    testSingleCase(chrono.it, "10 agosto 2012 CE", new Date(2012, 7, 10), (result) => {
+        expect(result.text).toBe("10 agosto 2012 CE");
+        expect(result.start.get("year")).toBe(2012);
+    });
+});
+
+test("Test - Within expression with number glued to unit", function () {
+    testUnexpectedResult(chrono.it, "tra unoh", new Date(2012, 7, 10));
+});
