diff --git a/test/it/it_constants_more.test.ts b/test/it/it_constants_more.test.ts
new file mode 100644
index 0000000..af5777e
--- /dev/null
+++ b/test/it/it_constants_more.test.ts
@@ -0,0 +1,132 @@
+import * as chrono from "../../src";
+import { testSingleCase } from "../test_util";
+import {
+    parseDuration,
+    parseNumberPattern,
+    parseOrdinalNumberPattern,
+    parseYear,
+} from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with integer words", () => {
+    expect(parseNumberPattern("due")).toBe(2);
+    expect(parseNumberPattern("Dodici")).toBe(12);
+    expect(parseNumberPattern("un")).toBe(1);
+    expect(parseNumberPattern("una")).toBe(1);
+    expect(parseNumberPattern("uno")).toBe(1);
+});
+
+test("Test - parseNumberPattern with elided article", () => {
+    expect(parseNumberPattern("un'")).toBe(1);
+    expect(parseNumberPattern("UN'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with qualche", () => {
+    expect(parseNumberPattern("qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with mezzo", () => {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+    expect(parseNumberPattern("mezza")).toBe(0.5);
+    expect(parseNumberPattern("mezz")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with paio", () => {
+    expect(parseNumberPattern("paio")).toBe(2);
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with alcuni", () => {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with digits", () => {
+    expect(parseNumberPattern("15")).toBe(15);
+    expect(parseNumberPattern("2.5")).toBe(2.5);
+});
+
+test("Test - parseOrdinalNumberPattern with ordinal words", () => {
+    expect(parseOrdinalNumberPattern("primo")).toBe(1);
+    expect(parseOrdinalNumberPattern("Ventunesima")).toBe(21);
+    expect(parseOrdinalNumberPattern("3°")).toBe(3);
+    expect(parseOrdinalNumberPattern("31ª")).toBe(31);
+});
+
+test("Test - parseOrdinalNumberPattern with digits", () => {
+    expect(parseOrdinalNumberPattern("15")).toBe(15);
+    expect(parseOrdinalNumberPattern("15º")).toBe(15);
+    expect(parseOrdinalNumberPattern("32°")).toBe(32);
+});
+
+test("Test - parseYear with Buddhist Era", () => {
+    expect(parseYear("2555 BE")).toBe(2012);
+    expect(parseYear("2555be")).toBe(2012);
+});
+
+test("Test - parseYear with Before Christ", () => {
+    expect(parseYear("500 BC")).toBe(-500);
+    expect(parseYear("500 BCE")).toBe(-500);
+    expect(parseYear("44bc")).toBe(-44);
+});
+
+test("Test - parseYear with Anno Domini", () => {
+    expect(parseYear("2012 AD")).toBe(2012);
+    expect(parseYear("2012 CE")).toBe(2012);
+    expect(parseYear("79ad")).toBe(79);
+});
+
+test("Test - parseYear with plain years", () => {
+    expect(parseYear("2012")).toBe(2012);
+    expect(parseYear("1999")).toBe(1999);
+    expect(parseYear("95")).toBe(1995);
+    expect(parseYear("20")).toBe(2020);
+});
+
+test("Test - parseDuration with single time unit", () => {
+    expect(parseDuration("5 giorni")).toStrictEqual({ day: 5 });
+    expect(parseDuration("un'ora")).toStrictEqual({ hour: 1 });
+    expect(parseDuration("mezza ora")).toStrictEqual({ hour: 0.5 });
+    expect(parseDuration("qualche minuto")).toStrictEqual({ minute: 3 });
+    expect(parseDuration("alcuni giorni")).toStrictEqual({ day: 7 });
+    expect(parseDuration("2.5 h")).toStrictEqual({ hour: 2.5 });
+});
+
+test("Test - parseDuration with multiple time units", () => {
+    expect(parseDuration("2 ore 30 minuti")).toStrictEqual({ hour: 2, minute: 30 });
+    expect(parseDuration("1 anno 3 mesi 2 settimane")).toStrictEqual({ year: 1, month: 3, week: 2 });
+    expect(parseDuration("3 trim 10 sec")).toStrictEqual({ quarter: 3, second: 10 });
+});
+
+test("Test - parseDuration without any time unit", () => {
+    expect(parseDuration("")).toBeNull();
+    expect(parseDuration("ciao")).toBeNull();
+});
+
+test("Test - parseDuration ignores time units glued to number words", () => {
+    expect(parseDuration("unoh")).toBeNull();
+    expect(parseDuration("duesec")).toBeNull();
+});
+
+test("Test - parseDuration skips glued time units before valid ones", () => {
+    expect(parseDuration("duesec 5 minuti")).toStrictEqual({ minute: 5 });
+});
+
+test("Test - Elided article in relative expression", () => {
+    testSingleCase(chrono.it, "un'ora fa", new Date(2012, 7, 10, 12, 0), (result) => {
+        expect(result.text).toBe("un'ora fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 10, 11, 0));
+    });
+});
+
+test("Test - Qualche in relative expression", () => {
+    testSingleCase(chrono.it, "qualche giorno fa", new Date(2012, 7, 10, 12, 0), (result) => {
+        expect(result.text).toBe("qualche giorno fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 7, 12, 0));
+    });
+});
+
+test("Test - Alcuni in relative expression", () => {
+    testSingleCase(chrono.it, "alcuni giorni fa", new Date(2012, 7, 10, 12, 0), (result) => {
+        expect(result.text).toBe("alcuni giorni fa");
+        expect(result.start).toBeDate(new Date(2012, 7, 3, 12, 0));
+    });
+});
