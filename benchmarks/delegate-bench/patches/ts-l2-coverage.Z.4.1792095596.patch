diff --git a/test/it/it_constants_more.test.ts b/test/it/it_constants_more.test.ts
new file mode 100644
index 0000000..8ee6d0a
--- /dev/null
+++ b/test/it/it_constants_more.test.ts
@@ -0,0 +1,94 @@
+import {
+    parseDuration,
+    parseNumberPattern,
+    parseOrdinalNumberPattern,
+    parseYear,
+} from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with dictionary words", function () {
+    expect(parseNumberPattern("uno")).toBe(1);
+    expect(parseNumberPattern("una")).toBe(1);
+    expect(parseNumberPattern("un")).toBe(1);
+    expect(parseNumberPattern("Dodici")).toBe(12);
+});
+
+test("Test - parseNumberPattern with elided article", function () {
+    expect(parseNumberPattern("un'")).toBe(1);
+    expect(parseNumberPattern("UN'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with 'qualche'", function () {
+    expect(parseNumberPattern("qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with 'mezzo' / 'mezza'", function () {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+    expect(parseNumberPattern("mezza")).toBe(0.5);
+    expect(parseNumberPattern("mezz")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with 'paio'", function () {
+    expect(parseNumberPattern("paio")).toBe(2);
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with 'alcuni'", function () {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with digits", function () {
+    expect(parseNumberPattern("15")).toBe(15);
+    expect(parseNumberPattern("2.5")).toBe(2.5);
+});
+
+test("Test - parseOrdinalNumberPattern", function () {
+    expect(parseOrdinalNumberPattern("primo")).toBe(1);
+    expect(parseOrdinalNumberPattern("Trentunesima")).toBe(31);
+    expect(parseOrdinalNumberPattern("3°")).toBe(3);
+    expect(parseOrdinalNumberPattern("21º")).toBe(21);
+    expect(parseOrdinalNumberPattern("7")).toBe(7);
+});
+
+test("Test - parseYear with Buddhist Era", function () {
+    expect(parseYear("2555 BE")).toBe(2012);
+    expect(parseYear("2555be")).toBe(2012);
+});
+
+test("Test - parseYear with BC / BCE", function () {
+    expect(parseYear("500 BC")).toBe(-500);
+    expect(parseYear("500 BCE")).toBe(-500);
+    expect(parseYear("44bc")).toBe(-44);
+});
+
+test("Test - parseYear with AD / CE", function () {
+    expect(parseYear("2012 AD")).toBe(2012);
+    expect(parseYear("2012 CE")).toBe(2012);
+    expect(parseYear("79ad")).toBe(79);
+});
+
+test("Test - parseYear without era", function () {
+    expect(parseYear("2012")).toBe(2012);
+    expect(parseYear("94")).toBe(1994);
+    expect(parseYear("12")).toBe(2012);
+});
+
+test("Test - parseDuration with a single unit", function () {
+    expect(parseDuration("5 giorni")).toStrictEqual({ day: 5 });
+    expect(parseDuration("qualche minuto")).toStrictEqual({ minute: 3 });
+    expect(parseDuration("un'ora")).toStrictEqual({ hour: 1 });
+});
+
+test("Test - parseDuration with multiple units", function () {
+    expect(parseDuration("2 ore e 30 minuti")).toStrictEqual({ hour: 2, minute: 30 });
+    expect(parseDuration("1 anno, 2 mesi")).toStrictEqual({ year: 1, month: 2 });
+});
+
+test("Test - parseDuration ignores letter-only fragments", function () {
+    expect(parseDuration("treore")).toBeNull();
+    expect(parseDuration("unora")).toBeNull();
+});
+
+test("Test - parseDuration without any time unit", function () {
+    expect(parseDuration("")).toBeNull();
+    expect(parseDuration("niente")).toBeNull();
+});
