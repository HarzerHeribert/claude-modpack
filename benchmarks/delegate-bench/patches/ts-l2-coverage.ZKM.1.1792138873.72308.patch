diff --git a/test/it/it_constants_more.test.ts b/test/it/it_constants_more.test.ts
new file mode 100644
index 0000000..9b70930
--- /dev/null
+++ b/test/it/it_constants_more.test.ts
@@ -0,0 +1,103 @@
+import {
+    parseDuration,
+    parseNumberPattern,
+    parseOrdinalNumberPattern,
+    parseYear,
+} from "../../src/locales/it/constants";
+
+test("Test - parseNumberPattern with integer words", () => {
+    expect(parseNumberPattern("due")).toBe(2);
+    expect(parseNumberPattern("Dodici")).toBe(12);
+});
+
+test("Test - parseNumberPattern with apostrophe article", () => {
+    expect(parseNumberPattern("un'")).toBe(1);
+    expect(parseNumberPattern("UN'")).toBe(1);
+});
+
+test("Test - parseNumberPattern with 'qualche'", () => {
+    expect(parseNumberPattern("qualche")).toBe(3);
+    expect(parseNumberPattern("Qualche")).toBe(3);
+});
+
+test("Test - parseNumberPattern with 'mezzo' / 'mezza'", () => {
+    expect(parseNumberPattern("mezzo")).toBe(0.5);
+    expect(parseNumberPattern("mezza")).toBe(0.5);
+    expect(parseNumberPattern("mezz")).toBe(0.5);
+});
+
+test("Test - parseNumberPattern with 'paio'", () => {
+    expect(parseNumberPattern("paio")).toBe(2);
+    expect(parseNumberPattern("paio di")).toBe(2);
+});
+
+test("Test - parseNumberPattern with 'alcuni'", () => {
+    expect(parseNumberPattern("alcuni")).toBe(7);
+});
+
+test("Test - parseNumberPattern with numeric values", () => {
+    expect(parseNumberPattern("15")).toBe(15);
+    expect(parseNumberPattern("1.5")).toBe(1.5);
+});
+
+test("Test - parseOrdinalNumberPattern with ordinal words", () => {
+    expect(parseOrdinalNumberPattern("primo")).toBe(1);
+    expect(parseOrdinalNumberPattern("Trentunesima")).toBe(31);
+    expect(parseOrdinalNumberPattern("15°")).toBe(15);
+    expect(parseOrdinalNumberPattern("2ª")).toBe(2);
+});
+
+test("Test - parseOrdinalNumberPattern with numeric values", () => {
+    expect(parseOrdinalNumberPattern("7")).toBe(7);
+    expect(parseOrdinalNumberPattern("15º")).toBe(15);
+    expect(parseOrdinalNumberPattern("31")).toBe(31);
+});
+
+test("Test - parseYear with Buddhist Era", () => {
+    expect(parseYear("2555 BE")).toBe(2012);
+    expect(parseYear("2555be")).toBe(2012);
+});
+
+test("Test - parseYear with Before Christ / Before Common Era", () => {
+    expect(parseYear("500 BC")).toBe(-500);
+    expect(parseYear("500 BCE")).toBe(-500);
+    expect(parseYear("44bc")).toBe(-44);
+});
+
+test("Test - parseYear with Anno Domini / Common Era", () => {
+    expect(parseYear("2012 AD")).toBe(2012);
+    expect(parseYear("2012 CE")).toBe(2012);
+    expect(parseYear("79ad")).toBe(79);
+});
+
+test("Test - parseYear with plain years", () => {
+    expect(parseYear("2012")).toBe(2012);
+    expect(parseYear("1995")).toBe(1995);
+    expect(parseYear("95")).toBe(1995);
+});
+
+test("Test - parseDuration with single time unit", () => {
+    expect(parseDuration("5 giorni")).toStrictEqual({ day: 5 });
+    expect(parseDuration("un'ora")).toStrictEqual({ hour: 1 });
+    expect(parseDuration("mezza ora")).toStrictEqual({ hour: 0.5 });
+});
+
+test("Test - parseDuration with multiple time units", () => {
+    expect(parseDuration("2 ore e 30 minuti")).toStrictEqual({ hour: 2, minute: 30 });
+    expect(parseDuration("1 anno, 2 mesi e 3 settimane")).toStrictEqual({ year: 1, month: 2, week: 3 });
+});
+
+test("Test - parseDuration with abbreviated time units", () => {
+    expect(parseDuration("3 gg")).toStrictEqual({ day: 3 });
+    expect(parseDuration("10 min")).toStrictEqual({ minute: 10 });
+});
+
+test("Test - parseDuration without any time unit", () => {
+    expect(parseDuration("niente")).toBeNull();
+    expect(parseDuration("")).toBeNull();
+});
+
+test("Test - parseDuration ignores time units glued to number words", () => {
+    expect(parseDuration("dueore")).toBeNull();
+    expect(parseDuration("treanni")).toBeNull();
+});
