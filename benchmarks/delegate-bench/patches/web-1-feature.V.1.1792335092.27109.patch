diff --git a/src/features/discussions/components/discussions-search.tsx b/src/features/discussions/components/discussions-search.tsx
new file mode 100644
index 0000000..8898933
--- /dev/null
+++ b/src/features/discussions/components/discussions-search.tsx
@@ -0,0 +1,68 @@
+import * as React from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+const SEARCH_DEBOUNCE_MS = 300;
+
+export const DiscussionsSearch = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const search = searchParams.get('search') ?? '';
+
+  // The input keeps its own value so that typing stays responsive while the
+  // route loader is still fetching the results for the previous URL update
+  const [value, setValue] = React.useState(search);
+  // The search this input expects to be in the URL, including pending updates
+  const expectedSearch = React.useRef(search);
+  const updateTimeout = React.useRef<ReturnType<typeof setTimeout>>();
+
+  // Follow URL changes that didn't come from this input, e.g. back/forward or a link to the unfiltered list
+  React.useEffect(() => {
+    if (search !== expectedSearch.current) {
+      clearTimeout(updateTimeout.current);
+      expectedSearch.current = search;
+      setValue(search);
+    }
+  }, [search]);
+
+  React.useEffect(() => () => clearTimeout(updateTimeout.current), []);
+
+  const updateSearch = (nextSearch: string) => {
+    if (nextSearch === expectedSearch.current) return;
+    expectedSearch.current = nextSearch;
+
+    setSearchParams(
+      (params) => {
+        const nextParams = new URLSearchParams(params);
+        if (nextSearch) {
+          nextParams.set('search', nextSearch);
+        } else {
+          nextParams.delete('search');
+        }
+        // a new search starts at the first page
+        nextParams.delete('page');
+        return nextParams;
+      },
+      { replace: true },
+    );
+  };
+
+  return (
+    <div role="search" className="max-w-sm">
+      <Input
+        type="search"
+        label="Search discussions"
+        value={value}
+        onChange={(event) => {
+          const nextSearch = event.target.value;
+          setValue(nextSearch);
+          clearTimeout(updateTimeout.current);
+          updateTimeout.current = setTimeout(
+            () => updateSearch(nextSearch),
+            SEARCH_DEBOUNCE_MS,
+          );
+        }}
+      />
+    </div>
+  );
+};
