@@ -0,0 +1,59 @@
+import { useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+const SEARCH_DEBOUNCE_MS = 300;
+
+export const DiscussionsSearch = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const search = searchParams.get('search') ?? '';
+
+  const [value, setValue] = useState(search);
+  // the search this input last wrote to the URL
+  const submittedSearch = useRef(search);
+
+  useEffect(() => {
+    // the URL changed without typing here (back/forward, a link), so show its search
+    if (search !== submittedSearch.current) {
+      submittedSearch.current = search;
+      setValue(search);
+    }
+  }, [search]);
+
+  useEffect(() => {
+    const term = value.trim();
+    if (term === submittedSearch.current.trim()) return;
+
+    const timeout = setTimeout(() => {
+      submittedSearch.current = term;
+      setSearchParams(
+        (prev) => {
+          const params = new URLSearchParams(prev);
+          if (term) {
+            params.set('search', term);
+          } else {
+            params.delete('search');
+          }
+          // a new search starts at the first page
+          params.delete('page');
+          return params;
+        },
+        { replace: true },
+      );
+    }, SEARCH_DEBOUNCE_MS);
+
+    return () => clearTimeout(timeout);
+  }, [value, setSearchParams]);
+
+  return (
+    <div className="max-w-sm">
+      <Input
+        type="search"
+        label="Search discussions"
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+      />
+    </div>
+  );
+};
