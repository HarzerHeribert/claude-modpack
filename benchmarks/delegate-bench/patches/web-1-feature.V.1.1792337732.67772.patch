@@ -0,0 +1,81 @@
+import {
+  createDiscussion,
+  createUser,
+  loginAsUser,
+} from '@/testing/test-utils';
+
+import { getDiscussions } from '../get-discussions';
+
+const setupTeamDiscussions = async () => {
+  const user = await createUser();
+  const otherUser = await createUser();
+
+  for (let i = 1; i <= 15; i++) {
+    await createDiscussion({
+      teamId: user.teamId,
+      authorId: user.id,
+      title: `Release notes ${i}`,
+    });
+  }
+  for (let i = 1; i <= 5; i++) {
+    await createDiscussion({
+      teamId: user.teamId,
+      authorId: user.id,
+      title: `Hiring plan ${i}`,
+    });
+  }
+  await createDiscussion({
+    teamId: otherUser.teamId,
+    authorId: otherUser.id,
+    title: 'Release notes from another team',
+  });
+
+  await loginAsUser(user);
+};
+
+test('should return all team discussions when there is no search', async () => {
+  await setupTeamDiscussions();
+
+  const { data, meta } = await getDiscussions();
+
+  expect(meta).toEqual({ page: 1, total: 20, totalPages: 2 });
+  expect(data).toHaveLength(10);
+});
+
+test('should search titles of all team discussions ignoring case and paginate the results', async () => {
+  await setupTeamDiscussions();
+
+  const firstPage = await getDiscussions({ search: 'rELEASE NOTES' });
+
+  expect(firstPage.meta).toEqual({ page: 1, total: 15, totalPages: 2 });
+  expect(firstPage.data.map(({ title }) => title)).toEqual(
+    Array.from({ length: 10 }, (_, i) => `Release notes ${i + 1}`),
+  );
+
+  const secondPage = await getDiscussions({ page: 2, search: 'release notes' });
+
+  expect(secondPage.meta).toEqual({ page: 2, total: 15, totalPages: 2 });
+  expect(secondPage.data.map(({ title }) => title)).toEqual(
+    Array.from({ length: 5 }, (_, i) => `Release notes ${i + 11}`),
+  );
+});
+
+test('should find matches that are not on the first page', async () => {
+  await setupTeamDiscussions();
+
+  const { data, meta } = await getDiscussions({ search: 'hiring' });
+
+  expect(meta).toEqual({ page: 1, total: 5, totalPages: 1 });
+  expect(data.map(({ title }) => title)).toEqual(
+    Array.from({ length: 5 }, (_, i) => `Hiring plan ${i + 1}`),
+  );
+});
+
+test('should return no discussions when nothing matches', async () => {
+  await setupTeamDiscussions();
+
+  const { data, meta } = await getDiscussions({ search: 'no such title' });
+
+  expect(data).toEqual([]);
+  expect(meta).toEqual({ page: 1, total: 0, totalPages: 0 });
+});
