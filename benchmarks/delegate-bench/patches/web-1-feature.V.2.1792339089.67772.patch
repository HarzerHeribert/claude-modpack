diff --git a/src/features/discussions/components/search-discussions.tsx b/src/features/discussions/components/search-discussions.tsx
new file mode 100644
index 0000000..5266d73
--- /dev/null
+++ b/src/features/discussions/components/search-discussions.tsx
@@ -0,0 +1,58 @@
+import { useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+const SEARCH_DEBOUNCE_MS = 300;
+
+export const SearchDiscussions = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const search = searchParams.get('search') || '';
+
+  const [value, setValue] = useState(search);
+  // the search this input last wrote to the URL, so that URL changes coming
+  // from elsewhere (back/forward, links) can be told apart from our own
+  const lastSearchRef = useRef(search);
+
+  useEffect(() => {
+    if (search !== lastSearchRef.current) {
+      lastSearchRef.current = search;
+      setValue(search);
+    }
+  }, [search]);
+
+  useEffect(() => {
+    const nextSearch = value.trim();
+    if (nextSearch === lastSearchRef.current) return;
+
+    const timeout = setTimeout(() => {
+      lastSearchRef.current = nextSearch;
+      setSearchParams(
+        (prev) => {
+          const params = new URLSearchParams(prev);
+          if (nextSearch) {
+            params.set('search', nextSearch);
+          } else {
+            params.delete('search');
+          }
+          // a new search starts at the first page
+          params.delete('page');
+          return params;
+        },
+        { replace: true },
+      );
+    }, SEARCH_DEBOUNCE_MS);
+
+    return () => clearTimeout(timeout);
+  }, [value, setSearchParams]);
+
+  return (
+    <div className="w-full max-w-sm">
+      <Input
+        label="Search discussions"
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+      />
+    </div>
+  );
+};
