@@ -0,0 +1,77 @@
+import {
+  createDiscussion,
+  createUser,
+  loginAsUser,
+} from '@/testing/test-utils';
+
+import { getDiscussions } from '../get-discussions';
+
+const setup = async (titles: string[]) => {
+  const user = await createUser();
+  await loginAsUser(user);
+  for (const title of titles) {
+    await createDiscussion({ teamId: user.teamId, title });
+  }
+  return user;
+};
+
+const weeklySyncs = Array.from(
+  { length: 12 },
+  (_, i) => `Weekly sync ${i + 1}`,
+);
+
+test('should search the titles of all the team discussions, ignoring case', async () => {
+  // the matches come after the first page of discussions
+  await setup([...weeklySyncs, 'Roadmap planning', 'Q3 ROADMAP review']);
+  await createDiscussion({ teamId: 'another-team', title: 'Roadmap' });
+
+  const { data, meta } = await getDiscussions({ search: 'roadMap' });
+
+  expect(data.map(({ title }) => title)).toEqual([
+    'Roadmap planning',
+    'Q3 ROADMAP review',
+  ]);
+  expect(meta).toEqual({ page: 1, total: 2, totalPages: 1 });
+});
+
+test('should paginate the search results', async () => {
+  const roadmapItems = Array.from(
+    { length: 12 },
+    (_, i) => `Roadmap item ${i + 1}`,
+  );
+  await setup([...weeklySyncs, ...roadmapItems]);
+
+  const firstPage = await getDiscussions({ search: 'roadmap' });
+  expect(firstPage.data.map(({ title }) => title)).toEqual(
+    roadmapItems.slice(0, 10),
+  );
+  expect(firstPage.meta).toEqual({ page: 1, total: 12, totalPages: 2 });
+
+  const secondPage = await getDiscussions({ search: 'roadmap', page: 2 });
+  expect(secondPage.data.map(({ title }) => title)).toEqual(
+    roadmapItems.slice(10),
+  );
+  expect(secondPage.meta).toEqual({ page: 2, total: 12, totalPages: 2 });
+});
+
+test('should return all the team discussions without a search', async () => {
+  await setup([...weeklySyncs, 'Roadmap planning']);
+
+  const { data, meta } = await getDiscussions({ page: 2 });
+
+  expect(data.map(({ title }) => title)).toEqual([
+    'Weekly sync 11',
+    'Weekly sync 12',
+    'Roadmap planning',
+  ]);
+  expect(meta).toEqual({ page: 2, total: 13, totalPages: 2 });
+});
+
+test('should return no discussions when nothing matches', async () => {
+  await setup(weeklySyncs);
+
+  const { data, meta } = await getDiscussions({ search: 'roadmap' });
+
+  expect(data).toEqual([]);
+  expect(meta).toEqual({ page: 1, total: 0, totalPages: 0 });
+});
