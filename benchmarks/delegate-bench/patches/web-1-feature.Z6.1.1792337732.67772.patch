diff --git a/src/features/discussions/components/discussions-search.tsx b/src/features/discussions/components/discussions-search.tsx
new file mode 100644
index 0000000..a5d1027
--- /dev/null
+++ b/src/features/discussions/components/discussions-search.tsx
@@ -0,0 +1,61 @@
+import { useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+const SEARCH_DEBOUNCE_MS = 300;
+
+export const DiscussionsSearch = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const search = searchParams.get('search') || '';
+
+  // The input keeps its own value because the URL only updates once the
+  // route loader has fetched the results, which would lag behind typing.
+  const [value, setValue] = useState(search);
+  // The last search written to the URL by this input
+  const requestedSearch = useRef(search);
+
+  // Follow URL changes made elsewhere, e.g. a link or back/forward navigation
+  useEffect(() => {
+    if (search !== requestedSearch.current) {
+      requestedSearch.current = search;
+      setValue(search);
+    }
+  }, [search]);
+
+  useEffect(() => {
+    const nextSearch = value.trim();
+    if (nextSearch === requestedSearch.current) return;
+
+    const timeout = setTimeout(() => {
+      requestedSearch.current = nextSearch;
+      setSearchParams(
+        (params) => {
+          const nextParams = new URLSearchParams(params);
+          if (nextSearch) {
+            nextParams.set('search', nextSearch);
+          } else {
+            nextParams.delete('search');
+          }
+          // A new search starts at the first page
+          nextParams.delete('page');
+          return nextParams;
+        },
+        { replace: true },
+      );
+    }, SEARCH_DEBOUNCE_MS);
+
+    return () => clearTimeout(timeout);
+  }, [value, setSearchParams]);
+
+  return (
+    <div className="max-w-sm">
+      <Input
+        label="Search discussions"
+        registration={{}}
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+      />
+    </div>
+  );
+};
