@@ -0,0 +1,178 @@
+import { useLocation } from 'react-router';
+import type { Mock } from 'vitest';
+
+import {
+  createDiscussion,
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  waitFor,
+  within,
+} from '@/testing/test-utils';
+
+import { default as DiscussionsRoute } from '../discussions';
+
+beforeAll(() => {
+  vi.spyOn(console, 'error').mockImplementation(() => {});
+});
+
+afterAll(() => {
+  (console.error as Mock).mockRestore();
+});
+
+const LocationSearch = () => {
+  const location = useLocation();
+  return <div data-testid="location-search">{location.search}</div>;
+};
+
+const renderDiscussions = async ({
+  titles,
+  url = '/',
+}: {
+  titles: string[];
+  url?: string;
+}) => {
+  const user = await createUser();
+  for (const title of titles) {
+    await createDiscussion({ title, teamId: user.teamId, authorId: user.id });
+  }
+
+  return renderApp(
+    <>
+      <DiscussionsRoute />
+      <LocationSearch />
+    </>,
+    { user, url },
+  );
+};
+
+const getSearchInput = () =>
+  screen.getByRole('textbox', { name: /search discussions/i });
+
+const getRenderedTitles = () =>
+  screen
+    .queryAllByRole('row')
+    .slice(1) // header row
+    .map((row) => within(row).getAllByRole('cell')[0].textContent);
+
+const expectLocationSearch = (search: string) =>
+  waitFor(() =>
+    expect(screen.getByTestId('location-search')).toHaveTextContent(search),
+  );
+
+test(
+  'searches the titles of all the team discussions ignoring case',
+  { timeout: 10000 },
+  async () => {
+    await createDiscussion({ title: 'Release notes', teamId: 'other-team' });
+
+    await renderDiscussions({
+      titles: [
+        ...Array.from({ length: 11 }, (_, i) => `Filler ${i + 1}`),
+        'Release Planning',
+      ],
+    });
+
+    // the matching discussion is not on the first page
+    expect(getRenderedTitles()).toHaveLength(10);
+    expect(screen.queryByText('Release Planning')).not.toBeInTheDocument();
+
+    await userEvent.type(getSearchInput(), 'rElEaSe');
+
+    expect(
+      await screen.findByRole(
+        'cell',
+        { name: 'Release Planning' },
+        { timeout: 3000 },
+      ),
+    ).toBeInTheDocument();
+    expect(getRenderedTitles()).toEqual(['Release Planning']);
+    await expectLocationSearch('?search=rElEaSe');
+  },
+);
+
+test(
+  'starts a new search at page 1 and paginates the results',
+  { timeout: 10000 },
+  async () => {
+    await renderDiscussions({
+      titles: [
+        ...Array.from({ length: 12 }, (_, i) => `Topic ${i + 1}`),
+        ...Array.from({ length: 3 }, (_, i) => `Other ${i + 1}`),
+      ],
+      url: '/?page=2',
+    });
+
+    expect(getRenderedTitles()).toEqual([
+      'Topic 11',
+      'Topic 12',
+      'Other 1',
+      'Other 2',
+      'Other 3',
+    ]);
+
+    await userEvent.type(getSearchInput(), 'topic');
+
+    expect(
+      await screen.findByRole('cell', { name: 'Topic 1' }, { timeout: 3000 }),
+    ).toBeInTheDocument();
+    await expectLocationSearch('?search=topic');
+    expect(getRenderedTitles()).toEqual(
+      Array.from({ length: 10 }, (_, i) => `Topic ${i + 1}`),
+    );
+
+    const secondPageLink = screen.getByRole('link', { name: '2' });
+    expect(secondPageLink).toHaveAttribute('href', '/?search=topic&page=2');
+
+    await userEvent.click(secondPageLink);
+
+    expect(
+      await screen.findByRole('cell', { name: 'Topic 12' }, { timeout: 3000 }),
+    ).toBeInTheDocument();
+    expect(getRenderedTitles()).toEqual(['Topic 11', 'Topic 12']);
+    expect(getSearchInput()).toHaveValue('topic');
+  },
+);
+
+test('shows the search results from the url', { timeout: 10000 }, async () => {
+  await renderDiscussions({
+    titles: ['Alpha launch', 'Beta launch', 'alphabet soup'],
+    url: '/?search=alpha',
+  });
+
+  expect(getSearchInput()).toHaveValue('alpha');
+  expect(getRenderedTitles()).toEqual(['Alpha launch', 'alphabet soup']);
+});
+
+test(
+  'shows a message when nothing matches and restores the list when cleared',
+  { timeout: 10000 },
+  async () => {
+    await renderDiscussions({ titles: ['First topic', 'Second topic'] });
+
+    expect(getRenderedTitles()).toEqual(['First topic', 'Second topic']);
+
+    await userEvent.type(getSearchInput(), 'nothing like this');
+
+    expect(
+      await screen.findByText(/no discussions found/i, {}, { timeout: 3000 }),
+    ).toBeInTheDocument();
+    expect(screen.queryByRole('table')).not.toBeInTheDocument();
+
+    await userEvent.clear(getSearchInput());
+
+    expect(
+      await screen.findByRole(
+        'cell',
+        { name: 'First topic' },
+        { timeout: 3000 },
+      ),
+    ).toBeInTheDocument();
+    expect(getRenderedTitles()).toEqual(['First topic', 'Second topic']);
+    expect(screen.queryByText(/no discussions found/i)).not.toBeInTheDocument();
+    await waitFor(() =>
+      expect(screen.getByTestId('location-search')).toBeEmptyDOMElement(),
+    );
+  },
+);
