+import {
+  createDiscussion,
+  createUser,
+  renderApp,
+  screen,
+  userEvent,
+  within,
+} from '@/testing/test-utils';
+
+import { DiscussionsList } from '../discussions-list';
+
+const createDiscussions = async (user: any, titles: string[]) => {
+  for (const title of titles) {
+    await createDiscussion({ title, teamId: user.teamId, authorId: user.id });
+  }
+};
+
+const range = (count: number, title: (n: number) => string) =>
+  Array.from({ length: count }, (_, i) => title(i + 1));
+
+const getSearchInput = () => screen.getByLabelText(/search discussions/i);
+
+const getTitles = () =>
+  screen
+    .getAllByRole('row')
+    .slice(1)
+    .map((row) => within(row).getAllByRole('cell')[0].textContent);
+
+const getSearchParams = (router: any) =>
+  new URLSearchParams(router.state.location.search);
+
+test("searches the titles of all the team's discussions, ignoring case", async () => {
+  const user = await createUser();
+  // the matching discussions are only on the second page without a search
+  await createDiscussions(user, [
+    ...range(11, (n) => `General topic ${n}`),
+    'Learning React',
+    'testing react apps',
+  ]);
+  await createDiscussion({ title: 'React elsewhere', teamId: 'other-team' });
+
+  const { router } = await renderApp(<DiscussionsList />, { user });
+
+  expect(getTitles()).toHaveLength(10);
+  expect(screen.queryByText('Learning React')).not.toBeInTheDocument();
+
+  await userEvent.type(getSearchInput(), 'REACT');
+
+  expect(await screen.findByText('Learning React')).toBeInTheDocument();
+  expect(getTitles()).toEqual(['Learning React', 'testing react apps']);
+  expect(getSearchParams(router).get('search')).toBe('REACT');
+});
+
+test('paginates the search results and starts a new search at page 1', async () => {
+  const user = await createUser();
+  await createDiscussions(user, [
+    ...range(12, (n) => `Match ${n}`),
+    ...range(3, (n) => `Other ${n}`),
+  ]);
+
+  const { router } = await renderApp(<DiscussionsList />, { user });
+
+  await userEvent.type(getSearchInput(), 'match');
+  await screen.findByRole('link', { name: '2' });
+  expect(getTitles()).toEqual(range(10, (n) => `Match ${n}`));
+
+  await userEvent.click(screen.getByRole('link', { name: '2' }));
+
+  expect(await screen.findByText('Match 11')).toBeInTheDocument();
+  expect(getTitles()).toEqual(['Match 11', 'Match 12']);
+  expect(getSearchParams(router).get('search')).toBe('match');
+  expect(getSearchParams(router).get('page')).toBe('2');
+
+  await userEvent.type(getSearchInput(), ' 1');
+
+  expect(await screen.findByText('Match 1')).toBeInTheDocument();
+  expect(getTitles()).toEqual(['Match 1', 'Match 10', 'Match 11', 'Match 12']);
+  expect(getSearchParams(router).get('search')).toBe('match 1');
+  expect(getSearchParams(router).get('page')).toBeNull();
+});
+
+test('shows the search results of a shared link', async () => {
+  const user = await createUser();
+  await createDiscussions(user, ['React hooks', 'Vue basics']);
+
+  await renderApp(<DiscussionsList />, { user, url: '/?search=hooks' });
+
+  expect(getSearchInput()).toHaveValue('hooks');
+  expect(getTitles()).toEqual(['React hooks']);
+});
+
+test('shows "No discussions found" when nothing matches and the discussions again when cleared', async () => {
+  const user = await createUser();
+  await createDiscussions(user, ['React hooks', 'Vue basics']);
+
+  const { router } = await renderApp(<DiscussionsList />, { user });
+
+  await userEvent.type(getSearchInput(), 'angular');
+
+  expect(await screen.findByText('No discussions found')).toBeInTheDocument();
+  expect(screen.queryByRole('table')).not.toBeInTheDocument();
+
+  await userEvent.clear(getSearchInput());
+
+  expect(await screen.findByText('React hooks')).toBeInTheDocument();
+  expect(getTitles()).toEqual(['React hooks', 'Vue basics']);
+  expect(screen.queryByText('No discussions found')).not.toBeInTheDocument();
+  expect(getSearchParams(router).has('search')).toBe(false);
+});
