@@ -0,0 +1,41 @@
+import * as React from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+export const DiscussionsSearch = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const search = searchParams.get('search') || '';
+
+  // The URL only updates once the route loader has fetched the results,
+  // so the typed value is kept locally to keep the input responsive
+  const [value, setValue] = React.useState(search);
+
+  // Follow URL changes made elsewhere (e.g. back/forward navigation)
+  React.useEffect(() => {
+    setValue((value) => (value.trim() === search ? value : search));
+  }, [search]);
+
+  const onChange = (event: React.ChangeEvent<HTMLInputElement>) => {
+    const term = event.target.value.trim();
+    setValue(event.target.value);
+    setSearchParams(
+      (prev) => {
+        const params = new URLSearchParams(prev);
+        if (term === (params.get('search') || '')) return params;
+
+        if (term) {
+          params.set('search', term);
+        } else {
+          params.delete('search');
+        }
+        // a new search starts at the first page
+        params.delete('page');
+        return params;
+      },
+      { replace: true },
+    );
+  };
+
+  return <Input label="Search discussions" value={value} onChange={onChange} />;
+};
