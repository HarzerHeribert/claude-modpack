diff --git a/src/features/discussions/components/search-discussions.tsx b/src/features/discussions/components/search-discussions.tsx
new file mode 100644
index 0000000..5f784b5
--- /dev/null
+++ b/src/features/discussions/components/search-discussions.tsx
@@ -0,0 +1,59 @@
+import { useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router';
+
+import { Input } from '@/components/ui/form';
+
+const SEARCH_DEBOUNCE_MS = 300;
+
+export const SearchDiscussions = () => {
+  const [searchParams, setSearchParams] = useSearchParams();
+  const urlSearch = searchParams.get('search') ?? '';
+
+  const [value, setValue] = useState(urlSearch);
+  // the search last written to or read from the URL
+  const syncedSearch = useRef(urlSearch);
+
+  // show searches changed outside of the input (back/forward, links) in it
+  useEffect(() => {
+    if (urlSearch !== syncedSearch.current) {
+      syncedSearch.current = urlSearch;
+      setValue(urlSearch);
+    }
+  }, [urlSearch]);
+
+  // write the search to the URL once the user stops typing
+  useEffect(() => {
+    const search = value.trim();
+    if (search === syncedSearch.current) return;
+
+    const timeout = setTimeout(() => {
+      syncedSearch.current = search;
+      setSearchParams(
+        (prev) => {
+          const params = new URLSearchParams(prev);
+          if (search) {
+            params.set('search', search);
+          } else {
+            params.delete('search');
+          }
+          // a new search starts at the first page
+          params.delete('page');
+          return params;
+        },
+        { replace: true },
+      );
+    }, SEARCH_DEBOUNCE_MS);
+
+    return () => clearTimeout(timeout);
+  }, [value, setSearchParams]);
+
+  return (
+    <Input
+      type="search"
+      label="Search discussions"
+      placeholder="Search by title"
+      value={value}
+      onChange={(e) => setValue(e.target.value)}
+    />
+  );
+};
