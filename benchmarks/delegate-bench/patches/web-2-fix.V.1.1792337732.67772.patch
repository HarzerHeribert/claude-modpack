+  });
+
+  test('user can delete their own comment', () => {
+    const user = buildUser();
+
+    expect(POLICIES['comment:delete'](user, buildComment(user))).toBe(true);
+  });
+
+  test("user cannot delete a teammate's comment", () => {
+    const user = buildUser();
+    const teammate = buildUser({ id: 'user-2', teamId: user.teamId });
