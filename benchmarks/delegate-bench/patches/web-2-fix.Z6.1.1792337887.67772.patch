+describe('comment:delete policy', () => {
+  const canDeleteComment = POLICIES['comment:delete'];
+
+  const buildUser = (overrides: Partial<User>) =>
+    generateUser(overrides) as User;
+
+  const buildComment = (author: User) =>
+    ({
+      ...createComment({ discussionId: 'discussion-1' }),
+      author,
+    }) as Comment;
+
+  const admin = buildUser({ role: 'ADMIN', teamId: 'team-1' });
+  const user = buildUser({ role: 'USER', teamId: 'team-1' });
+  const teammate = buildUser({ role: 'USER', teamId: 'team-1' });
+
+  test('admin can delete any comment', () => {
+    expect(canDeleteComment(admin, buildComment(admin))).toBe(true);
+    expect(canDeleteComment(admin, buildComment(user))).toBe(true);
+  });
+
+  test('user can delete their own comment', () => {
+    expect(canDeleteComment(user, buildComment(user))).toBe(true);
+  });
+
+  test('user cannot delete a comment written by someone else', () => {
+    expect(canDeleteComment(user, buildComment(teammate))).toBe(false);
+    expect(canDeleteComment(user, buildComment(admin))).toBe(false);
+  });
+});
