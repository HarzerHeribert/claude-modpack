+
+describe("POLICIES['comment:delete']", () => {
+  const makeUser = (overrides: Partial<User> = {}): User => ({
+    id: 'user-1',
+    createdAt: Date.now(),
+    firstName: 'Jane',
+    lastName: 'Doe',
+    email: 'jane@example.com',
+    role: ROLES.USER,
+    teamId: 'team-1',
+    bio: '',
+    ...overrides,
+  });
+
+  const makeComment = (author: User): Comment => ({
+    id: 'comment-1',
+    createdAt: Date.now(),
+    body: 'Hello',
+    discussionId: 'discussion-1',
+    author,
+  });
+
+  test('allows a USER to delete their own comment', () => {
+    const user = makeUser();
+
+    expect(POLICIES['comment:delete'](user, makeComment(user))).toBe(true);
+  });
+
+  test("does not allow a USER to delete someone else's comment", () => {
+    const user = makeUser();
+    const otherUser = makeUser({ id: 'user-2' });
+
+    expect(POLICIES['comment:delete'](user, makeComment(otherUser))).toBe(
+      false,
+    );
+  });
+
+  test('does not allow a USER to delete a comment whose author id matches their team id', () => {
+    const user = makeUser({ id: 'user-1', teamId: 'team-1' });
+    const otherUser = makeUser({ id: 'team-1' });
+
+    expect(POLICIES['comment:delete'](user, makeComment(otherUser))).toBe(
+      false,
+    );
+  });
+
+  test('allows an ADMIN to delete any comment', () => {
+    const admin = makeUser({ id: 'admin-1', role: ROLES.ADMIN });
+    const otherUser = makeUser({ id: 'user-2' });
+
+    expect(POLICIES['comment:delete'](admin, makeComment(otherUser))).toBe(
+      true,
+    );
+  });
+});
