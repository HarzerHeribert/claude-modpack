+
+describe('comment:delete policy', () => {
+  const canDeleteComment = POLICIES['comment:delete'];
+
+  const commentBy = (author: User) =>
+    ({ ...createComment({ discussionId: 'discussion-1' }), author }) as Comment;
+
+  test('should allow an admin to delete any comment', () => {
+    const admin = generateUser({ role: ROLES.ADMIN }) as User;
+    const otherUser = generateUser({ role: ROLES.USER }) as User;
+
+    expect(canDeleteComment(admin, commentBy(admin))).toBe(true);
+    expect(canDeleteComment(admin, commentBy(otherUser))).toBe(true);
+  });
+
+  test('should allow a user to delete their own comment', () => {
+    const user = generateUser({ role: ROLES.USER }) as User;
+
+    expect(canDeleteComment(user, commentBy(user))).toBe(true);
+  });
+
+  test('should not allow a user to delete comments of other users, even from the same team', () => {
+    const user = generateUser({ role: ROLES.USER }) as User;
+    const teammate = generateUser({
+      role: ROLES.USER,
+      teamId: user.teamId,
+    }) as User;
+    const outsider = generateUser({ role: ROLES.USER }) as User;
+
+    expect(canDeleteComment(user, commentBy(teammate))).toBe(false);
+    expect(canDeleteComment(user, commentBy(outsider))).toBe(false);
+  });
+});
