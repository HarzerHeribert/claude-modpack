+
+describe('comment:delete policy', () => {
+  const buildUser = (role: User['role']) => generateUser({ role }) as User;
+
+  const buildComment = (author: User) =>
+    ({
+      ...generateComment(),
+      discussionId: 'discussion-id',
+      author,
+    }) as Comment;
+
+  const canDelete = POLICIES['comment:delete'];
+
+  test('admin can delete any comment', () => {
+    const admin = buildUser(ROLES.ADMIN);
+    const otherUser = buildUser(ROLES.USER);
+
+    expect(canDelete(admin, buildComment(admin))).toBe(true);
+    expect(canDelete(admin, buildComment(otherUser))).toBe(true);
+  });
+
+  test('user can delete their own comment', () => {
+    const user = buildUser(ROLES.USER);
+
+    expect(canDelete(user, buildComment(user))).toBe(true);
+  });
+
+  test('user cannot delete comments by other users, including teammates', () => {
+    const user = buildUser(ROLES.USER);
+    const teammate = { ...buildUser(ROLES.USER), teamId: user.teamId };
+    const outsider = buildUser(ROLES.USER);
+
+    expect(canDelete(user, buildComment(teammate))).toBe(false);
+    expect(canDelete(user, buildComment(outsider))).toBe(false);
+  });
+});
