+
+describe('comment:delete policy', () => {
+  const buildUser = (overrides: Partial<User>): User =>
+    ({
+      id: 'user-1',
+      createdAt: Date.now(),
+      firstName: 'Jane',
+      lastName: 'Doe',
+      email: 'jane@example.com',
+      role: ROLES.USER,
+      teamId: 'team-1',
+      bio: '',
+      ...overrides,
+    }) as User;
+
+  const buildComment = (author: User): Comment => ({
+    id: 'comment-1',
+    createdAt: Date.now(),
+    body: 'A comment',
+    discussionId: 'discussion-1',
+    author,
+  });
+
+  test('allows a regular user to delete their own comment', () => {
+    const user = buildUser({ id: 'user-1', role: ROLES.USER });
+
+    expect(POLICIES['comment:delete'](user, buildComment(user))).toBe(true);
+  });
+
+  test('does not allow a regular user to delete a comment by someone else, even on the same team', () => {
+    const user = buildUser({
+      id: 'user-1',
+      teamId: 'team-1',
+      role: ROLES.USER,
+    });
+    const teammate = buildUser({
+      id: 'user-2',
+      teamId: 'team-1',
+      role: ROLES.USER,
+    });
+
+    expect(POLICIES['comment:delete'](user, buildComment(teammate))).toBe(
+      false,
+    );
+  });
+
+  test('allows an admin to delete any comment', () => {
+    const admin = buildUser({ id: 'admin-1', role: ROLES.ADMIN });
+    const otherUser = buildUser({ id: 'user-2', role: ROLES.USER });
+
+    expect(POLICIES['comment:delete'](admin, buildComment(otherUser))).toBe(
+      true,
+    );
+  });
+});
