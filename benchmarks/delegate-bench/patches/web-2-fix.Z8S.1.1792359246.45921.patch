+describe('comment:delete policy', () => {
+  const makeUser = (overrides: Partial<User> = {}): User => ({
+    id: 'user-1',
+    createdAt: Date.now(),
+    firstName: 'Jane',
+    lastName: 'Doe',
+    email: 'jane@example.com',
+    role: ROLES.USER,
+    teamId: 'team-1',
+    bio: '',
+    ...overrides,
+  });
+
+  const makeComment = (author: User): Comment => ({
+    id: 'comment-1',
+    createdAt: Date.now(),
+    body: 'Hello',
+    discussionId: 'discussion-1',
+    author,
+  });
+
+  test('allows a regular user to delete their own comment', () => {
+    const user = makeUser();
+
+    expect(POLICIES['comment:delete'](user, makeComment(user))).toBe(true);
+  });
+
+  test('does not allow a regular user to delete a comment by someone else', () => {
+    const user = makeUser();
+    const otherUser = makeUser({ id: 'user-2' });
+
+    expect(POLICIES['comment:delete'](user, makeComment(otherUser))).toBe(
+      false,
+    );
+  });
+
+  test('does not allow a regular user to delete a comment by a teammate whose id matches their team id', () => {
+    const user = makeUser();
+    const teammate = makeUser({ id: user.teamId });
+
+    expect(POLICIES['comment:delete'](user, makeComment(teammate))).toBe(false);
+  });
+
+  test('allows an admin to delete any comment', () => {
+    const admin = makeUser({ id: 'admin-1', role: ROLES.ADMIN });
+    const otherUser = makeUser({ id: 'user-2' });
+
+    expect(POLICIES['comment:delete'](admin, makeComment(otherUser))).toBe(
+      true,
+    );
+  });
+});
+
