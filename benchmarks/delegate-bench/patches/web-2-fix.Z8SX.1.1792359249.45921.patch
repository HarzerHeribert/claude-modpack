+test('should only show the delete comment button on own comments for regular users', async () => {
+  const fakeUser = await createUser({ role: 'USER' });
+  const otherUser = await createUser({
+    role: 'USER',
+    teamId: fakeUser.teamId,
+  });
+  const fakeDiscussion = await createDiscussion({ teamId: fakeUser.teamId });
+
+  db.comment.create({
+    body: 'My own comment',
+    authorId: fakeUser.id,
+    discussionId: fakeDiscussion.id,
+  });
+  db.comment.create({
+    body: 'Comment from another user',
+    authorId: otherUser.id,
+    discussionId: fakeDiscussion.id,
+  });
+
+  await renderApp(<DiscussionRoute />, {
+    user: fakeUser,
+    path: `/app/discussions/:discussionId`,
+    url: `/app/discussions/${fakeDiscussion.id}`,
+  });
+
+  const commentsList = await screen.findByRole('list', {
+    name: 'comments',
+  });
+
+  const ownComment = await within(commentsList).findByRole('listitem', {
+    name: /my own comment/i,
+  });
+  const otherComment = within(commentsList).getByRole('listitem', {
+    name: /comment from another user/i,
+  });
+
+  expect(
+    within(ownComment).getByRole('button', { name: /delete comment/i }),
+  ).toBeInTheDocument();
+  expect(
+    within(otherComment).queryByRole('button', { name: /delete comment/i }),
+  ).not.toBeInTheDocument();
+});
