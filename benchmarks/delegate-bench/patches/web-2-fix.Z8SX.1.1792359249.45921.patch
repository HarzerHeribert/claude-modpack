+test('comment:delete policy should allow admins to delete any comment', async () => {
+  const admin = await createUser({ role: ROLES.ADMIN });
+  const author = await createUser({ role: ROLES.USER });
+
+  expect(POLICIES['comment:delete'](admin, createCommentBy(author))).toBe(true);
+});
+
+test('comment:delete policy should allow users to delete their own comments', async () => {
+  const user = await createUser({ role: ROLES.USER });
+
+  expect(POLICIES['comment:delete'](user, createCommentBy(user))).toBe(true);
+});
+
+test("comment:delete policy should not allow users to delete other users' comments", async () => {
+  const user = await createUser({ role: ROLES.USER });
+  const author = await createUser({ role: ROLES.USER, teamId: user.teamId });
+
+  expect(POLICIES['comment:delete'](user, createCommentBy(author))).toBe(false);
+});
