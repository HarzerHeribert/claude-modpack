+import {
+  createComment,
+  createUser as generateUser,
+} from '@/testing/data-generators';
 import { createUser, renderApp, screen } from '@/testing/test-utils';
+import { Comment, User } from '@/types/api';
 
-import { Authorization, ROLES } from '../authorization';
+import { Authorization, POLICIES, ROLES } from '../authorization';
+
+const buildUser = (role: User['role'], overrides?: Partial<User>): User => ({
+  ...generateUser(),
+  role,
+  ...overrides,
+});
+
+const buildComment = (author: User): Comment => ({
+  ...createComment(),
+  discussionId: 'discussion-1',
+  author,
+});
+
+describe('comment:delete policy', () => {
+  test('should allow an admin to delete any comment', () => {
+    const admin = buildUser(ROLES.ADMIN);
+    const comment = buildComment(buildUser(ROLES.USER));
+
+    expect(POLICIES['comment:delete'](admin, comment)).toBe(true);
+  });
+
+  test('should allow a user to delete their own comment', () => {
+    const user = buildUser(ROLES.USER);
+    const comment = buildComment(user);
+
+    expect(POLICIES['comment:delete'](user, comment)).toBe(true);
+  });
+
+  test('should not allow a user to delete a comment by another user on the same team', () => {
+    const user = buildUser(ROLES.USER);
+    const teammate = buildUser(ROLES.USER, { teamId: user.teamId });
+    const comment = buildComment(teammate);
+
+    expect(POLICIES['comment:delete'](user, comment)).toBe(false);
+  });
+
+  test('should not allow a user to delete a comment whose author id matches their team id', () => {
+    const user = buildUser(ROLES.USER);
+    const comment = buildComment(buildUser(ROLES.USER, { id: user.teamId }));
+
+    expect(POLICIES['comment:delete'](user, comment)).toBe(false);
+  });
+});
 
