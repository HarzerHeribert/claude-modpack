+
+describe('comment:delete policy', () => {
+  const createUserWithRole = (
+    role: User['role'],
+    overrides?: Partial<User>,
+  ): User => ({ ...generateUser(overrides), role });
+
+  const createCommentBy = (author: Comment['author']): Comment => ({
+    ...createComment(),
+    discussionId: 'discussion-1',
+    author,
+  });
+
+  test('allows an admin to delete any comment', () => {
+    const admin = createUserWithRole(ROLES.ADMIN);
+    const comment = createCommentBy(createUserWithRole(ROLES.USER));
+
+    expect(POLICIES['comment:delete'](admin, comment)).toBe(true);
+  });
+
+  test('allows a user to delete their own comment', () => {
+    const user = createUserWithRole(ROLES.USER);
+    const comment = createCommentBy(user);
+
+    expect(POLICIES['comment:delete'](user, comment)).toBe(true);
+  });
+
+  test("does not allow a user to delete someone else's comment", () => {
+    const user = createUserWithRole(ROLES.USER);
+    const teammate = createUserWithRole(ROLES.USER, { teamId: user.teamId });
+    const comment = createCommentBy(teammate);
+
+    expect(POLICIES['comment:delete'](user, comment)).toBe(false);
+  });
+});
