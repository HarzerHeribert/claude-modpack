+
+describe('comment:delete policy', () => {
+  const createPolicyUser = (
+    overrides: Pick<User, 'role'> & Partial<User>,
+  ): User => ({ ...generateUser(), ...overrides });
+
+  const createCommentBy = (author: User): Comment => ({
+    ...createComment(),
+    discussionId: 'discussion-id',
+    author,
+  });
+
+  test('should allow a user to delete their own comment', () => {
+    const user = createPolicyUser({ role: ROLES.USER });
+
+    expect(POLICIES['comment:delete'](user, createCommentBy(user))).toBe(true);
+  });
+
+  test('should not allow a user to delete a comment by someone else', () => {
+    const user = createPolicyUser({ role: ROLES.USER });
+    // a teammate whose user id happens to equal the user's team id
+    const otherUser = createPolicyUser({
+      id: user.teamId,
+      role: ROLES.USER,
+      teamId: user.teamId,
+    });
+
+    expect(POLICIES['comment:delete'](user, createCommentBy(otherUser))).toBe(
+      false,
+    );
+  });
+
+  test('should allow an admin to delete any comment', () => {
+    const admin = createPolicyUser({ role: ROLES.ADMIN });
+    const otherUser = createPolicyUser({ role: ROLES.USER });
+
+    expect(POLICIES['comment:delete'](admin, createCommentBy(otherUser))).toBe(
+      true,
+    );
+  });
+});
