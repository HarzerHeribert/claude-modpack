+
+describe('comment:delete policy', () => {
+  const buildUser = (overrides: Partial<User>): User => ({
+    id: 'user-id',
+    createdAt: Date.now(),
+    firstName: 'First',
+    lastName: 'Last',
+    email: 'user@example.com',
+    role: 'USER',
+    teamId: 'team-id',
+    bio: '',
+    ...overrides,
+  });
+
+  const buildComment = (author: User): Comment => ({
+    id: 'comment-id',
+    createdAt: Date.now(),
+    body: 'comment body',
+    discussionId: 'discussion-id',
+    author,
+  });
+
+  const user = buildUser({ id: 'user-1', teamId: 'team-1', role: 'USER' });
+  const teammate = buildUser({ id: 'user-2', teamId: 'team-1', role: 'USER' });
+  const admin = buildUser({ id: 'admin-1', teamId: 'team-1', role: 'ADMIN' });
+
+  test('allows a user to delete their own comment', () => {
+    expect(POLICIES['comment:delete'](user, buildComment(user))).toBe(true);
+  });
+
+  test("does not allow a user to delete someone else's comment", () => {
+    expect(POLICIES['comment:delete'](user, buildComment(teammate))).toBe(
+      false,
+    );
+    expect(POLICIES['comment:delete'](user, buildComment(admin))).toBe(false);
+  });
+
+  test("does not allow a user to delete a comment whose author id matches the user's team id", () => {
+    const author = buildUser({ id: user.teamId });
+    expect(POLICIES['comment:delete'](user, buildComment(author))).toBe(false);
+  });
+
+  test('allows an admin to delete any comment', () => {
+    expect(POLICIES['comment:delete'](admin, buildComment(admin))).toBe(true);
+    expect(POLICIES['comment:delete'](admin, buildComment(user))).toBe(true);
+  });
+});
