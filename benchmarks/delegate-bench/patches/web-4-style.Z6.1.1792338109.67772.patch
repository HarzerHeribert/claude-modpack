diff --git a/src/components/ui/table/__tests__/table.test.tsx b/src/components/ui/table/__tests__/table.test.tsx
new file mode 100644
index 0000000..d863455
--- /dev/null
+++ b/src/components/ui/table/__tests__/table.test.tsx
@@ -0,0 +1,42 @@
+import { rtlRender, screen } from '@/testing/test-utils';
+
+import { Table } from '../table';
+
+const data = [
+  { id: '1', createdAt: 1, title: 'First' },
+  { id: '2', createdAt: 2, title: 'Second' },
+];
+
+test('should apply a column className to its header and cells', () => {
+  rtlRender(
+    <Table
+      data={data}
+      columns={[
+        { title: 'Title', field: 'title' },
+        {
+          title: 'Created At',
+          field: 'createdAt',
+          className: 'hidden md:table-cell',
+        },
+      ]}
+    />,
+  );
+
+  expect(screen.getByRole('columnheader', { name: 'Created At' })).toHaveClass(
+    'hidden',
+    'md:table-cell',
+  );
+  expect(screen.getByRole('cell', { name: '1' })).toHaveClass(
+    'hidden',
+    'md:table-cell',
+  );
+  expect(screen.getByRole('cell', { name: '2' })).toHaveClass(
+    'hidden',
+    'md:table-cell',
+  );
+
+  expect(screen.getByRole('columnheader', { name: 'Title' })).not.toHaveClass(
+    'hidden',
+  );
+  expect(screen.getByRole('cell', { name: 'First' })).not.toHaveClass('hidden');
+});
